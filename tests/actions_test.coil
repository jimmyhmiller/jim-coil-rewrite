(module jim.actions-test)
(import "jim.palette" :as palette)
(import "jim.actions" :as actions)
(import "jim.native" :use [ns])
(import "coil.primitive" :as p)

(deftest command-t-opens-terminal-but-plain-t-does-not
         (assert (= (actions/key-action (p/cast u16 17) (p/cast u64 1048576)) 0))
         (assert (= (actions/key-action (p/cast u16 17) (p/cast u64 0)) -1))
         (assert (= (actions/key-action (p/cast u16 45) (p/cast u64 1048576)) 0)))

(deftest palette-search-ranks-consecutive-word-starts
         (assert (> (actions/score (ns c"term") (ns c"Terminal: New terminal"))
                    (actions/score (ns c"term") (ns c"the earlier room"))))
         (assert (= (actions/score (ns c"xyz") (ns c"Terminal: New terminal")) -1))
         (assert (= (actions/score (ns c"") (ns c"anything")) 0)))

(deftest palette-search-supports-case-and-keywords
         (assert (>= (actions/match-score (ns c"FPS") 10) 0))
         (assert (>= (actions/match-score (ns c"ghostty") 0) 0))
         (assert (>= (actions/match-score (ns c"cwd") 19) 0))
         (assert (>= (actions/match-score (ns c"pwd") 19) 0))
         (assert (>= (actions/score (ns c"É") (ns c"éclair")) 0)))

(deftest original-zoom-shortcuts-stay-distinct
         (assert (= (actions/key-action (p/cast u16 29) (p/cast u64 1048576)) 3))
         (assert (= (actions/key-action (p/cast u16 29) (p/cast u64 1179648)) 2))
         (assert (= (actions/key-action (p/cast u16 6) (p/cast u64 1048576)) -1))
         (assert (= (actions/key-action (p/cast u16 6) (p/cast u64 1179648)) 7)))

(deftest exact-fps-keyword-outranks-scattered-letters
         (assert (> (actions/match-score (ns c"fps") 10) (actions/match-score (ns c"fps") 4))))

(deftest palette-selection-is-consumed-exactly-once
         (let [state (palette/state)]
           (store! (field state pending) 10)
           (assert (= (palette/take-action!) 10))
           (assert (= (palette/take-action!) -1))))
