(module jim.atelier-test)
(import "jim.atelier-model" :as model)
(import "coil.primitive" :as p)

(deftest drag-clamps-every-edge-with-the-whole-card-visible
         (let [(mut card) (p/zeroed model/Slip)]
           (model/move! (mut card) -1000.0 -500.0 744.0 424.0)
           (assert (p/fcmp-eq (.x card) 30.0))
           (assert (p/fcmp-eq (.y card) 160.0))
           (model/move! (mut card) 9000.0 9000.0 744.0 424.0)
           (assert (p/fcmp-eq (+ (.x card) 744.0) 1250.0))
           (assert (p/fcmp-eq (+ (.y card) 424.0) 744.0))))

(deftest material-specimen-has-bounded-geometry
         (assert (= (model/petals -9223372036854775807) 3))
         (assert (= (model/petals 9223372036854775807) 24))
         (assert (= (model/petals 12) 12)))
