(module jim.processes-test)
(import "coil.primitive" :as p)
(import "coil.alloc" :as alloc)
(import "coil.arraylist" :use *)
(import "coil.slice" :use *)
(import "coil.str" :use [str-eq])
(import "jim.widget-api" :as api)
(import "jim.services" :as services)

(extern usleep :cc c [u32] (-> i32))

(defn wait [(h (dyn api/Host)) (handle i64) (out (ptr (ArrayList u8)))] (-> i64)
  (let [(mut code) api/PROCESS-RUNNING]
    (while (= (load code) api/PROCESS-RUNNING)
      (usleep (p/cast u32 1000))
      (set! code (api/poll h handle out)))
    (load code)))

(deftest spawn-returns-at-once-and-collects-output
         (let [h (services/host (services/services-new))
               (mut out) (al-new [u8] (alloc/malloc-allocator))
               handle
                 (api/spawn h
                            ["sh" "-c" "printf 'a\\nb'; echo err 1>&2; exit 3"]
                            "/tmp")]
           (assert (= (wait h handle (mut out)) 3))
           (assert (= (al-slice out) "a\nberr\n"))
           (api/release h handle)
           (al-free! (mut out))))

(deftest missing-programs-fail-with-a-message
         (let [h (services/host (services/services-new))
               (mut out) (al-new [u8] (alloc/malloc-allocator))
               handle (api/spawn h ["jim-no-such-program-anywhere"] "/tmp")]
           (assert (= (wait h handle (mut out)) -1))
           (assert (= (al-slice out)
                      "could not start jim-no-such-program-anywhere"))
           (api/release h handle)
           (al-free! (mut out))))

(deftest releasing-a-running-process-stops-it
         (let [h (services/host (services/services-new))
               (mut out) (al-new [u8] (alloc/malloc-allocator))
               handle (api/spawn h ["sleep" "30"] "/tmp")]
           (usleep (p/cast u32 50000))
           (assert (= (api/poll h handle (mut out)) api/PROCESS-RUNNING))
           (api/release h handle)
           (al-free! (mut out))))

(deftest children-see-git-optional-locks-off
         (let [h (services/host (services/services-new))
               (mut out) (al-new [u8] (alloc/malloc-allocator))
               handle
                 (api/spawn h
                            ["sh" "-c" "printf %s \"$GIT_OPTIONAL_LOCKS\""]
                            "/tmp")]
           (assert (= (wait h handle (mut out)) 0))
           (assert (= (al-slice out) "0"))
           (api/release h handle)
           (al-free! (mut out))))

(defstruct Sum [(n i64) (total i64)])

(impl api/Task Sum
  (run [(self (ptr Sum))]
       (-> void)
       (let [(mut t) 0]
         (for [i 0 (.n self)] (set! t (+ (load t) i)))
         (set! (.total self) (load t))
         (do))))

(deftest tasks-run-on-a-worker-and-report-done
         (let [s (services/services-new)
               h (services/host s)
               sum
                 (alloc/box! (alloc/malloc-allocator)
                             Sum
                             (Sum :n 1000000 :total 0))
               handle (api/start-task h sum)]
           (while (not (api/task-done? h handle)) (usleep (p/cast u32 1000)))
           (assert (= (.total sum) 499999500000))
           (assert (not (services/busy? s)))
           (api/release-task h handle)
           (services/free! s)))
