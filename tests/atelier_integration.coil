(module jim.atelier-integration)
(import "jim.atelier" :as app)
(import "jim.atelier-host" :as host)
(import "jim.atelier-model" :as model)
(import "jim.atelier-plugin" :as plugin)
(import "jim.atelier-ui" :as ui)
(import "paper.platform" :as paper)
(import "jim.native" :use *)
(import "jim.storage" :as storage)
(import "jim.terminal" :as terminal)
(import "jim.ghostty" :as g)
(import "coil.primitive" :as p)

(defn step [] (-> (ptr i64))
  (p/alloc-static i64))

(defn return-key [] (-> (ptr i8))
  (msg (ptr i8)
       (class c"NSEvent")
       (sel c"keyEventWithType:location:modifierFlags:timestamp:windowNumber:context:characters:charactersIgnoringModifiers:isARepeat:keyCode:")
       [u64 Point u64 f64 i64 (ptr i8) (ptr i8) (ptr i8) bool u16]
       10
       (Point :x 0.0 :y 0.0)
       0
       0.0
       (msg i64 (.window (paper/host)) (sel c"windowNumber") [])
       (nil)
       (ns c"\r")
       (ns c"\r")
       false
       (p/cast u16 36)))

(defn event [(kind i64) (id i64) (x f64) (y f64)] (-> i64)
  (app/event kind id x y)
  (when (= kind 6)
    (set! (step) (+ (load (step)) 1))
    (case (load (step)) 1
          (do
            (app/activate! 40)
            (assert (.attached (app/runtime)))
            (msg bool (app/prefs) (sel c"synchronize") [])
            (app/activate! 11)
            (paper/refresh)
            0)
            2
          (do
            (msg i64
                 (paper/input-view 500)
                 (sel c"setStringValue:")
                 [(ptr i8)]
                 (ns c"A thought retained across reopening."))
            (app/activate! 50)
            (assert (> (storage/count (.notes (model/state))) 0))
            (app/activate! 13)
            0)
            3
          (do (app/activate! 72) (assert (.paused (plugin/state))) 0) 4
          (do
            (app/activate! 72)
            (assert (not (.paused (plugin/state))))
            (app/activate! 12)
            (app/activate! 63)
            (app/activate! 10)
            (paper/refresh)
            0)
            5
          (let [t (.terminal (app/runtime))
                command (getenv c"JIM_ATELIER_TEST_COMMAND")]
            (assert (not (msg bool (.view t) (sel c"isHidden") [])))
            (when (!= command (nil))
              (g/ghostty_surface_text (.surface t) command (strlen command))
              (assert (app/native-event (return-key)))
              0)
            0)
            0)
    (when (and (>= (load (step)) 6)
               (or (>= (load (step)) 150)
                   (and (= (.task (plugin/state)) (nil))
                        (msg bool
                             (msg (ptr i8)
                                  (class c"NSFileManager")
                                  (sel c"defaultManager")
                                  [])
                             (sel c"fileExistsAtPath:")
                             [(ptr i8)]
                             (ns (getenv c"JIM_ATELIER_TEST_PID"))))))
      (do
        (let [data (storage/dictionary)]
          (storage/put! data c"session" (.session-id (app/runtime)))
          (storage/put! data
                        c"notes"
                        (storage/number (p/cast f64
                                                (storage/count (.notes (model/state))))))
          (storage/put! data
                        c"plugin-phase"
                        (storage/number (p/cast f64 (.phase (plugin/state)))))
          (storage/put! data
                        c"plugin-value"
                        (storage/number (p/cast f64 (.value (plugin/state)))))
          (let [json
                  (msg (ptr i8)
                       (class c"NSJSONSerialization")
                       (sel c"dataWithJSONObject:options:error:")
                       [(ptr i8) u64 (ptr i8)]
                       data
                       1
                       (nil))]
            (assert (msg bool
                         json
                         (sel c"writeToFile:atomically:")
                         [(ptr i8) bool]
                         (ns (getenv c"JIM_ATELIER_TEST_REPORT"))
                         true))))
        (msg i64 (.window (paper/host)) (sel c"close") [])
        0)))
  0)

(export-c [event :as "jim_atelier_integration_event"])

(defn main [] (-> i64)
  (let [pool (new c"NSAutoreleasePool")]
    (setenv c"GHOSTTY_RESOURCES_DIR"
            c"build/ghostty/share/ghostty"
            (p/cast i32 1))
    (paper/paper_configure c"Jim Atelier — integration check" 1280.0 800.0)
    (let [result
            (host/run! (p/fnptr-of app/draw)
                       (p/fnptr-of event)
                       (p/fnptr-of app/native-event))]
      (app/save!)
      (msg bool (app/prefs) (sel c"synchronize") [])
      (plugin/stop!)
      (when (.attached (app/runtime))
        (terminal/free! (.terminal (app/runtime)))
        0)
      (when (.started (app/runtime)) (terminal/stop!) 0)
      (release pool)
      result)))
