(module jim.core-test)
(import "jim.workspace" :as workspace)
(import "jim.reload" :as reload)
(import "jim.ghostty" :as ghostty)
(import "jim.native" :use *)
(import "coil.primitive" :as p)

(defn near? [(x f64) (y f64)] (-> bool)
  (and (< (- x y) 0.000001) (> (- x y) -0.000001)))

(deftest workspace-navigation-wraps-both-directions
         (assert (= (workspace/wrap -1 4) 3))
         (assert (= (workspace/wrap 4 4) 0))
         (assert (= (workspace/wrap -9 4) 3)))

(deftest front-workspace-exactly-matches-flat-plane
         (let [face
                 (CATransform3DTranslate (workspace/face-transform 0 4 1000.0)
                                         0.0
                                         0.0
                                         500.0)
               root (workspace/root-transform 0.0 false 1000.0)]
           (assert (near? (+ (.m43 face) (.m43 root)) 0.0))
           (assert (near? (.m11 face) 1.0))
           (assert (near? (.m22 face) 1.0))))

(deftest adjacent-faces-have-perpendicular-normals
         (let [a (workspace/face-transform 0 4 1000.0)
               b (workspace/face-transform 1 4 1000.0)]
           (assert (near? (+ (* (.m31 a) (.m31 b)) (* (.m33 a) (.m33 b))) 0.0))))

(deftest ghostty-abi-matches-c-header
         (assert (= (p/sizeof ghostty/SurfaceConfig) 88))
         (assert (= (p/sizeof ghostty/Key) 32))
         (assert (= (p/sizeof ghostty/Runtime) 64))
         (assert (= (p/sizeof ghostty/Target) 16))
         (assert (= (p/sizeof ghostty/Action) 32)))

(deftest hot-load-copies-values-without-retaining-code
         (let [(mut config) (reload/defaults)]
           (assert (reload/load-config! c"build/shell-test.dylib" config))
           (assert (near? (.duration config) 0.42))
           (assert (near? (.sidebar config) 224.0))
           (assert (not (reload/load-config! c"build/no-such-image.dylib"
                                             config)))
           (assert (near? (.sidebar config) 224.0))))

(deftest invalid-hot-load-values-are-rejected
         (let [(mut config) (reload/defaults)]
           (set! (.duration config) -1.0)
           (assert (not (reload/valid? (load config))))
           (set! config (reload/defaults))
           (set! (.sidebar config) 10000.0)
           (assert (not (reload/valid? (load config))))))

(deftest native-index-formatting-uses-the-real-integer
         (let [pool (new c"NSAutoreleasePool")]
           (assert (= (strcmp (utf8 (indexed-string c"Terminal " 2 c""))
                              c"Terminal 2")
                      (p/cast i32 0)))
           (assert (= (strcmp (utf8 (indexed-string c"build/config-"
                                                    12
                                                    c".dylib"))
                              c"build/config-12.dylib")
                      (p/cast i32 0)))
           (release pool)))
