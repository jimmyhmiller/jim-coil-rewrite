(module jim.core-test)
(import "jim.workspace" :as workspace)
(import "jim.theme" :as theme)
(import "coil.alloc" :as alloc)
(import "coil.arraylist" :use *)
(import "jim.ghostty" :as ghostty)
(import "jim.native" :use *)
(import "coil.math" :use [Float])
(import "coil.primitive" :as p)

(defn near? [(x f64) (y f64)] (-> bool)
  (and (< (- x y) 0.000001) (> (- x y) -0.000001)))

(deftest workspace-navigation-wraps-both-directions
  (assert (= (workspace/wrap -1 4) 3))
  (assert (= (workspace/wrap 4 4) 0))
  (assert (= (workspace/wrap -9 4) 3)))

(defn tipped-view [(shift f64)
                   (lift f64)
                   (distance f64)
                   (yaw f64)
                   (tilt f64)
                   (rise f64)
                   (focal f64)] (-> workspace/View)
  (workspace/View
    :shift shift
    :lift lift
    :distance distance
    :yaw yaw
    :tilt tilt
    :rise rise
    :focal focal))

(defn view [(shift f64) (lift f64) (distance f64) (yaw f64) (focal f64)]
  (-> workspace/View)
  (tipped-view shift lift distance yaw 0.0 0.0 focal))

;;; Where a corner of face INDEX lands on the stage.
(defn corner [(camera Transform)
              (index i64)
              (count i64)
              (radius f64)
              (x f64)
              (y f64)] (-> workspace/Vec3)
  (workspace/apply camera
                   (workspace/apply (workspace/face-placement index
                                                              count
                                                              radius)
                                    (workspace/Vec3
                                      :x x
                                      :y y
                                      :z 0.0))))

(deftest flat-view-lays-the-chosen-face-exactly-on-the-window
  (let [radius (workspace/face-radius 4 1200.0)
        focal (* workspace/FOCAL 800.0)
        camera
          (workspace/camera-transform (view 110.0
                                            0.0
                                            (+ radius focal)
                                            (workspace/facing-yaw 1 4)
                                            focal))
        top-right (corner camera 1 4 radius 600.0 400.0)
        bottom-left (corner camera 1 4 radius -600.0 -400.0)]
    (assert (near? (.x top-right) 710.0))
    (assert (near? (.y top-right) 400.0))
    (assert (near? (.z top-right) 0.0))
    (assert (near? (.x bottom-left) -490.0))
    (assert (near? (.y bottom-left) -400.0))
    (assert (near? (.z bottom-left) 0.0))))

(deftest overview-camera-looks-down-at-the-axis
  (let [focal 1000.0
        camera (workspace/camera-transform (view 0.0 160.0 2000.0 0.0 focal))
        axis
          (workspace/apply camera
                           (workspace/Vec3
                             :x 0.0
                             :y 0.0
                             :z 0.0))
        above
          (workspace/apply camera
                           (workspace/Vec3
                             :x 0.0
                             :y 100.0
                             :z 0.0))
        range (sqrt (+ (* 160.0 160.0) (* 2000.0 2000.0)))]
    (assert (near? (.x axis) 0.0))
    (assert (near? (.y axis) 0.0))
    (assert (near? (.z axis) (- focal range)))
    (assert (> (.y above) 0.0))))

(deftest the-reflection-mirrors-across-the-floor
  (let [camera (workspace/camera-transform (view 0.0 160.0 2000.0 0.7 1000.0))
        mirrored
          (workspace/apply (workspace/mirror-transform camera -400.0)
                           (workspace/apply camera
                                            (workspace/Vec3
                                              :x 30.0
                                              :y -350.0
                                              :z 20.0)))
        expected
          (workspace/apply camera
                           (workspace/Vec3
                             :x 30.0
                             :y -450.0
                             :z 20.0))]
    (assert (< (abs (- (.x mirrored) (.x expected))) 0.0001))
    (assert (< (abs (- (.y mirrored) (.y expected))) 0.0001))
    (assert (< (abs (- (.z mirrored) (.z expected))) 0.0001))))

(deftest quads-contain-the-points-inside-them
  (let [a (Point :x 0.0 :y 0.0)
        b (Point :x 10.0 :y 1.0)
        c (Point :x 9.0 :y 8.0)
        d (Point :x -1.0 :y 9.0)]
    (assert (workspace/quad-contains? (Point :x 5.0 :y 5.0) a b c d))
    (assert (workspace/quad-contains? (Point :x 5.0 :y 5.0) d c b a))
    (assert (not (workspace/quad-contains? (Point :x 12.0 :y 5.0) a b c d)))))

(deftest faces-meet-at-their-edges-for-any-count
  (assert (near? (workspace/face-radius 4 1000.0) 500.0))
  ; Six faces 1000 wide form a hexagon whose apothem is 500 * sqrt 3.
  (assert (near? (workspace/face-radius 6 1000.0) 866.0254037844386))
  (let [radius (workspace/face-radius 6 1000.0)
        camera
          (workspace/camera-transform (view 0.0 0.0 (+ radius 900.0) 0.0 900.0))
        ; Neighbouring faces 0 and 1 share an edge.
        right-of-0 (corner camera 0 6 radius 500.0 0.0)
        left-of-1 (corner camera 1 6 radius -500.0 0.0)]
    (assert (< (abs (- (.x right-of-0) (.x left-of-1))) 0.0001))
    (assert (< (abs (- (.z right-of-0) (.z left-of-1))) 0.0001))))

;;; ---- the tilt ----

(deftest tilting-shows-the-cube-top-to-the-viewer
  (let [radius (workspace/face-radius 4 1000.0)
        camera
          (workspace/camera-transform (tipped-view 0.0
                                                   0.0
                                                   2000.0
                                                   0.0
                                                   0.3
                                                   0.0
                                                   1000.0))
        level (workspace/camera-transform (view 0.0 0.0 2000.0 0.0 1000.0))
        top (corner camera 0 4 radius 0.0 400.0)
        bottom (corner camera 0 4 radius 0.0 -400.0)]
    (assert (> (.z top) (.z (corner level 0 4 radius 0.0 400.0))))
    (assert (< (.z bottom) (.z (corner level 0 4 radius 0.0 -400.0))))))

(deftest the-cube-tips-about-the-screens-horizontal-axis-however-it-is-turned
  (let [radius (workspace/face-radius 4 1000.0)
        tipped
          (workspace/camera-transform (tipped-view 0.0
                                                   0.0
                                                   2000.0
                                                   0.7
                                                   0.5
                                                   0.0
                                                   1000.0))
        level (workspace/camera-transform (view 0.0 0.0 2000.0 0.7 1000.0))]
    (for [i 0 4]
      (let [a (corner tipped i 4 radius 500.0 400.0)
            b (corner level i 4 radius 500.0 400.0)]
        (assert (< (abs (- (.x a) (.x b))) 0.0001))))))

(deftest a-tipped-cube-rises-to-rest-on-the-floor
  (assert (near? (workspace/rise 4 500.0 500.0 400.0 0.3 0.0) 0.0))
  (let [tilt 0.5
        rise (workspace/rise 4 500.0 500.0 400.0 0.0 tilt)
        camera
          (workspace/camera-transform (tipped-view 0.0
                                                   0.0
                                                   2000.0
                                                   0.0
                                                   tilt
                                                   rise
                                                   1000.0))
        floor
          (workspace/apply (workspace/camera-transform (view 0.0
                                                             0.0
                                                             2000.0
                                                             0.0
                                                             1000.0))
                           (workspace/Vec3
                             :x 0.0
                             :y -400.0
                             :z 0.0))]
    ; The front bottom edge is lowest: 400 cos t + 500 sin t below the axis.
    (assert (near? rise (- (+ (* 400.0 (cos tilt)) (* 500.0 (sin tilt))) 400.0)))
    (assert (near? (.y (corner camera 0 4 500.0 500.0 -400.0)) (.y floor)))))

(deftest only-faces-turned-to-the-eye-face-it
  (let [camera (workspace/camera-transform (view 0.0 160.0 2000.0 0.0 1000.0))]
    (assert (workspace/faces-eye? camera
                                  (workspace/face-placement 0 4 500.0)
                                  1000.0))
    (assert (not (workspace/faces-eye? camera
                                       (workspace/face-placement 2 4 500.0)
                                       1000.0)))))

;;; Where a spring from START degrees has reached after SECONDS at 60 Hz, and
;;; the lowest it went, both in degrees.
(defstruct Sprung [(angle f64) (lowest f64)])

(defn spring-from [(start f64) (seconds f64)] (-> Sprung)
  (let [degrees 57.29577951308232
        (mut t) (workspace/Tilt :angle (/ start degrees) :speed 0.0)
        (mut lowest) start]
    (for [frame 0 (p/cast i64 (* seconds 60.0))]
      (set! t (workspace/spring-tilt (load t) (/ 1.0 60.0)))
      (set! lowest (min (load lowest) (* (.angle (load t)) degrees))))
    (Sprung :angle (* (.angle (load t)) degrees) :lowest (load lowest))))

(deftest a-released-tilt-springs-back-exactly-level
  ; Halfway back from 30° in under 0.2 s, at rest within half a second.
  (assert (< (.angle (spring-from 30.0 0.2)) 15.0))
  (let [done (spring-from 30.0 0.5)]
    (assert (= (.angle done) 0.0))
    (assert (> (.lowest done) -0.2)))
  ; From 90° it swings past level by under 2° before settling.
  (let [done (spring-from 90.0 1.0)]
    (assert (= (.angle done) 0.0))
    (assert (< (.lowest done) 0.0))
    (assert (> (.lowest done) -2.0))))

(deftest ghostty-abi-matches-c-header
  (assert (= (sizeof ghostty/SurfaceConfig) 88))
  (assert (= (sizeof ghostty/Key) 32))
  (assert (= (sizeof ghostty/Runtime) 64))
  (assert (= (sizeof ghostty/Target) 16))
  (assert (= (sizeof ghostty/Action) 32)))

(defn problem-of [(text (slice u8))] (-> (ArrayList u8))
  (let [(mut t) (theme/defaults)
        (mut problem) (ArrayList::new [u8] (alloc/malloc-allocator))]
    (assert (not (theme/parse! text (mut t) (mut problem))))
    ; a refused theme leaves the last good one alone
    (assert (= (load t) (theme/defaults)))
    (load problem)))

(defn refused-with? [(text (slice u8)) (expected (slice u8))] (-> bool)
  (let [(mut problem) (problem-of text)
        same (= (slice problem) expected)]
    (when (not same) (println "theme refused with: {s}" (slice problem)) 0)
    (ArrayList::free! (mut problem))
    same))

(deftest the-shipped-theme-is-the-default
  (let [(mut t) (theme/defaults)
        (mut problem) (ArrayList::new [u8] (alloc/malloc-allocator))]
    (set! (.duration t) 1.0)
    (assert (theme/load! "config/theme" (mut t) (mut problem)))
    (assert (= (load t) (theme/defaults)))
    (ArrayList::free! (mut problem))))

(defn theme-text [(duration (slice u8)) (extra (slice u8))] (-> (ArrayList u8))
  (let [(mut text) (ArrayList::new [u8] (alloc/malloc-allocator))]
    (theme/push-str! (mut text) "; a theme\n(Theme\n  duration ")
    (theme/push-str! (mut text) duration)
    (theme/push-str! (mut text)
                     "\n  accent-r 0.4 accent-g 0.78 accent-b 0.96
  canvas-r 0.055 canvas-g 0.07 canvas-b 0.095
  rail-r 0.075 rail-g 0.09 rail-b 0.12
  pane-r 0.105 pane-g 0.135 pane-b 0.18
  ink-r 0.88 ink-g 0.91 ink-b 0.96
  muted-r 0.51 muted-g 0.57 muted-b 0.65
  shadow-r 0.005 shadow-g 0.009 shadow-b 0.018
  edge-width 140 edge-distance 600 edge-strength 0.95")
    (theme/push-str! (mut text) extra)
    (theme/push-str! (mut text) ")\n")
    (load text)))

(deftest a-theme-reads-every-value
  (let [(mut text) (theme-text "1.5" "")
        (mut t) (theme/defaults)
        (mut problem) (ArrayList::new [u8] (alloc/malloc-allocator))]
    (assert (theme/parse! (slice text) (mut t) (mut problem)))
    (assert (near? (.duration t) 1.5))
    (assert (near? (.edge-distance t) 600.0))
    (assert (near? (.shadow-b t) 0.018))
    (ArrayList::free! (mut problem))
    (ArrayList::free! (mut text))))

(deftest a-theme-out-of-range-is-refused-by-name
  (let [(mut text) (theme-text "5" "")]
    (assert (refused-with? (slice text)
                           "duration is out of range"))
    (ArrayList::free! (mut text))))

(deftest a-misspelt-theme-value-is-refused-with-its-line
  (let [(mut text) (theme-text "0.42" "\n  edge-strenght 0.5")]
    (assert (refused-with? (slice text)
                           "unknown field edge-strenght"))
    (ArrayList::free! (mut text))))

(deftest a-theme-missing-a-value-is-refused
  (assert (refused-with? "(Theme duration 0.42)"
                         "missing field Theme.accent-r")))

(deftest a-theme-that-is-not-one-is-refused
  (assert (refused-with? "(Thme duration 0.42"
                         "line 1: malformed input invalid s-expression"))
  (assert (refused-with? "; a theme\n(Theme\n  duration \"fast\")"
                         "line 3: expected a number"))
  (let [(mut t) (theme/defaults)
        (mut problem) (ArrayList::new [u8] (alloc/malloc-allocator))]
    (assert (not (theme/load! "config/no-such-theme" (mut t) (mut problem))))
    (assert (= (slice problem) "cannot read it"))
    (ArrayList::free! (mut problem))))

(deftest native-index-formatting-uses-the-real-integer
  (let [pool (new c"NSAutoreleasePool")]
    (assert (= (strcmp (utf8 (indexed-string c"Terminal " 2 c""))
                       c"Terminal 2")
               (: 0 i32)))
    (assert (= (strcmp (utf8 (indexed-string c"build/config-"
                                             12
                                             c".dylib"))
                       c"build/config-12.dylib")
               (: 0 i32)))
    (release pool)))
