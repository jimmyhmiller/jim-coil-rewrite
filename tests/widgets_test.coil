(module jim.widgets-test)
(import "coil.cc" :as cc)
(import "coil.alloc" :as alloc)
(import "coil.arraylist" :use *)
(import "coil.slice" :use *)
(import "coil.fs" :as fs)
(import "coil.str" :use [StrBuf])
(import "jim.widget-api" :as api)
(import "jim.widgets" :as widgets)
(import "coil.time" :as time)

(extern usleep :cc (cc/C) [u32] (-> i32))

(defn find-id [(r (ptr widgets/Runtime)) (id (slice u8))] (-> i64)
  (let [ui (field r ui)
        (mut found) -1]
    (for [i 0 (len (.nodes (.ui r)))]
      (when (= (api/node-id ui (api/node ui i)) id) (set! found i)))
    (load found)))

(defn has-text? [(r (ptr widgets/Runtime)) (text (slice u8))] (-> bool)
  (let [ui (field r ui)
        (mut found) false]
    (for [i 0 (len (.nodes (.ui r)))]
      (let [n (api/node ui i)]
        (when (and (= (.kind n) api/TEXT) (= (api/node-text ui n) text))
          (set! found true))))
    (load found)))

(defn click! [(r (ptr widgets/Runtime)) (id (slice u8))] (-> void)
  (assert (widgets/activate! r (find-id r id)))
  (assert (widgets/render! r 400.0 300.0 0.0)))

(deftest counter-widget-loads-and-handles-clicks
  (let [r (widgets/create "counter" "." "")]
    (widgets/reload! r)
    (assert (widgets/settle! r))
    (assert (widgets/render! r 400.0 300.0 0.0))
    (assert (has-text? r "n = 0"))
    (click! r "inc")
    (click! r "inc")
    (click! r "dec")
    (assert (has-text? r "n = 1"))
    (assert (has-text? r "click: dec"))
    (click! r "dark")
    (assert (has-text? r "toggle: dark"))
    (widgets/free! r)))

(defn boots? [(name (slice u8))] (-> bool)
  (let [r (widgets/create name "." "")]
    (widgets/reload! r)
    (let [ok (and (widgets/settle! r) (widgets/render! r 400.0 300.0 0.0))]
      (when (not ok) (println "{}: {}" name (widgets/diagnostic r)) 0)
      (widgets/free! r)
      ok)))

(deftest every-widget-compiles-and-boots
  (assert (boots? "counter"))
  (assert (boots? "git"))
  (assert (boots? "stage"))
  (assert (boots? "markdown"))
  (assert (boots? "branches"))
  (assert (boots? "diff"))
  (assert (boots? "diffwall")))

(defn probe-source [(label (slice u8)) (extra bool)] (-> (slice u8))
  (let [(mut b) (StrBuf::new (alloc/malloc-allocator))]
    (push-str! (mut b)
               "(module widgets.probe)\n(import \"coil.primitive\" :as p)\n(import \"coil.alloc\" :as alloc)\n(import \"jim.widget-api\" :use *)\n")
    (push-str! (mut b)
               (if extra
                   "(defstruct Probe [(n i64) (step i64)])\n"
                   "(defstruct Probe [(n i64)])\n"))
    (push-str! (mut b)
               "(impl Widget Probe\n  (render [(self (ptr Probe)) (ui (ptr Ui))] (-> void)\n    (hstack! ui 4.0 0.0) (text! ui \"")
    (push-str! (mut b) label)
    (push-str! (mut b)
               " \" 12.0 0 false) (append-i64! ui (.n self)) (button! ui \"go\" \"go\") (end! ui))\n  (event [(self (ptr Probe)) (e (ptr Event))] (-> void)\n    (when (clicked? e \"go\") (set! (.n self) (+ (.n self) ")
    (push-str! (mut b) (if extra "(.step self)" "1"))
    (push-str! (mut b)
               ")) 0))\n  (save [(self (ptr Probe)) (s (ptr Snapshot))] (-> void)\n    (put-i64! s \"n\" (.n self))")
    (push-str! (mut b)
               (if extra " (put-i64! s \"step\" (.step self)))\n" ")\n"))
    (push-str! (mut b)
               "  (animating? [(self (ptr Probe))] (-> bool) false)\n  (destroy! [(self (ptr Probe))] (-> void) (alloc/destroy [Probe] (alloc/malloc-allocator) self) (do)))\n(defn boot [(saved (ptr Snapshot)) (out (ptr (dyn Widget)))] (-> void)\n  (set! out (alloc/box! (alloc/malloc-allocator) Probe (Probe :n (get-i64 saved \"n\" 0)")
    (push-str! (mut b) (if extra " :step (get-i64 saved \"step\" 10)" ""))
    (push-str! (mut b) "))))\n")
    (str b)))

(defn write-probe! [(source (slice u8))] (-> void)
  (assert (try (let [_
                       (try-or! (fs/write-file (alloc/malloc-allocator)
                                               "build/widget-tests/probe.coil"
                                               source)
                                false)]
                 true))))

(extern mkdir :cc (cc/C) [(ptr i8) u16] (-> i32))

(deftest panes-of-a-source-share-one-compile
  (mkdir c"build" (: 493 u16))
  (mkdir c"build/widget-tests" (: 493 u16))
  (write-probe! (probe-source "one" false))
  (let [first (widgets/create-in "build/widget-tests" "probe" "." "")
        second (widgets/create-in "build/widget-tests" "probe" "." "")]
    (widgets/reload! first)
    ; Waiting on the same compile, not queueing another.
    (widgets/reload! second)
    (assert (widgets/settle! first))
    (assert (widgets/live? second))
    ; Pane state stays per pane.
    (assert (widgets/render! first 400.0 300.0 0.0))
    (assert (widgets/render! second 400.0 300.0 0.0))
    (click! first "go")
    (assert (has-text? first "one 1"))
    (assert (has-text? second "one 0"))
    ; A later pane boots at once from the generation already compiled.
    (let [third (widgets/create-in "build/widget-tests" "probe" "." "")]
      (widgets/reload! third)
      (assert (widgets/live? third))
      (assert (not (widgets/loading? third)))
      ; One save moves every pane to the new generation, with its own state.
      (write-probe! (probe-source "two" false))
      (assert (widgets/changed? third))
      (widgets/reload! third)
      (assert (not (widgets/changed? first)))
      (assert (widgets/settle! third))
      (assert (widgets/render! first 400.0 300.0 0.0))
      (assert (widgets/render! second 400.0 300.0 0.0))
      (assert (widgets/render! third 400.0 300.0 0.0))
      (assert (has-text? first "two 1"))
      (assert (has-text? second "two 0"))
      (assert (has-text? third "two 0"))
      ; Closing one pane leaves the others' code alone.
      (widgets/free! second)
      (widgets/service-poll!)
      (click! first "go")
      (assert (has-text? first "two 2"))
      (widgets/free! third))
    (widgets/free! first)
    ; With no pane left the next one starts over, so it sees a new compile.
    (let [again (widgets/create-in "build/widget-tests" "probe" "." "")]
      (widgets/reload! again)
      (assert (widgets/loading? again))
      (assert (widgets/settle! again))
      (widgets/free! again))))

(deftest reload-carries-state-and-rejects-broken-versions
  (mkdir c"build" (: 493 u16))
  (mkdir c"build/widget-tests" (: 493 u16))
  (let [r (widgets/create-in "build/widget-tests" "probe" "." "")]
    (write-probe! (probe-source "one" false))
    (widgets/reload! r)
    (assert (widgets/settle! r))
    (assert (widgets/render! r 400.0 300.0 0.0))
    (click! r "go")
    (click! r "go")
    (assert (has-text? r "one 2"))
    ; A new field defaults; existing state carries over.
    (write-probe! (probe-source "two" true))
    (widgets/reload! r)
    (assert (widgets/settle! r))
    (assert (widgets/render! r 400.0 300.0 0.0))
    (assert (has-text? r "two 2"))
    (click! r "go")
    (assert (has-text? r "two 12"))
    ; A type error keeps the running generation and explains why.
    (write-probe! "(module widgets.probe)\n(defn boot [] (-> i64) \"not a number\")\n")
    (widgets/reload! r)
    (widgets/settle! r)
    (assert (< (widgets/take-update! r) 0))
    (assert (> (len (widgets/diagnostic r)) 0))
    (assert (widgets/render! r 400.0 300.0 0.0))
    (assert (has-text? r "two 12"))
    ; Dropping the field again still boots from the saved state.
    (write-probe! (probe-source "three" false))
    (widgets/reload! r)
    (assert (widgets/settle! r))
    (assert (widgets/render! r 400.0 300.0 0.0))
    (assert (has-text? r "three 12"))
    (widgets/free! r)))

;;; A widget whose state is a struct deriving Serialize and Deserialize.
;;; FIELDS, OPTIONS, STEP and FRESH vary the struct between versions.
(defn tally-source [(label (slice u8))
                    (fields (slice u8))
                    (options (slice u8))
                    (step (slice u8))
                    (fresh (slice u8))] (-> (slice u8))
  (let [(mut b) (StrBuf::new (alloc/malloc-allocator))]
    (push-str! (mut b)
               "(module widgets.tally)\n(import \"coil.alloc\" :as alloc)\n(import \"coil.arraylist\" :use *)\n(import \"jim.widget-kit.text\" :use [push-str!])\n(import \"coil.serde\" :use *)\n(import \"coil.serde.derive\" :use *)\n(import \"jim.widget-api\" :use *)\n(defstruct Tally [(n i64) (note (ArrayList u8)) ")
    (push-str! (mut b) fields)
    (push-str! (mut b)
               "])\n(derive (Serialize (field note (with text-ser text-de)))\n        (Deserialize (field note (with text-ser text-de)) ")
    (push-str! (mut b) options)
    (push-str! (mut b)
               ")\n        Tally)\n(impl Widget Tally\n  (render [(self (ptr Tally)) (ui (ptr Ui))] (-> void)\n    (hstack! ui 4.0 0.0) (text! ui \"")
    (push-str! (mut b) label)
    (push-str! (mut b)
               " \" 12.0 0 false) (append-i64! ui (.n self))\n    (text! ui (slice (.note self)) 12.0 0 false) (button! ui \"go\" \"go\") (end! ui))\n  (event [(self (ptr Tally)) (e (ptr Event))] (-> void)\n    (when (clicked? e \"go\") (set! (.n self) (+ (.n self) ")
    (push-str! (mut b) step)
    (push-str! (mut b)
               ")) (push-str! (mut (.note self)) \"!\") 0))\n  (save [(self (ptr Tally)) (s (ptr Snapshot))] (-> void) (save-state! s (load self)))\n  (animating? [(self (ptr Tally))] (-> bool) false)\n  (destroy! [(self (ptr Tally))] (-> void)\n    (free! (mut (.note self)))\n    (alloc/destroy [Tally] (alloc/malloc-allocator) self)\n    (do)))\n(defn boot [(saved (ptr Snapshot)) (out (ptr (dyn Widget)))] (-> void)\n  (match (load-state [Tally] saved)\n    (Fresh [] (set! out (alloc/box! (alloc/malloc-allocator) Tally (Tally :n 0 :note (ArrayList::new [u8] (alloc/malloc-allocator)) ")
    (push-str! (mut b) fresh)
    (push-str! (mut b)
               "))))\n    (Loaded [t] (set! out (alloc/box! (alloc/malloc-allocator) Tally t)))\n    (Refused [] (do))))\n")
    (str b)))

(defn write-tally! [(source (slice u8))] (-> void)
  (assert (try (let [_
                       (try-or! (fs/write-file (alloc/malloc-allocator)
                                               "build/widget-tests/tally.coil"
                                               source)
                                false)]
                 true))))

(defn contains? [(s (slice u8)) (needle (slice u8))] (-> bool)
  (let [(mut found) false]
    (for [i 0 (+ (- (len s) (len needle)) 1)]
      (when (= (subslice s i (+ i (len needle))) needle) (set! found true)))
    (load found)))

(deftest derived-state-reloads-and-refuses-what-no-longer-fits
  (mkdir c"build" (: 493 u16))
  (mkdir c"build/widget-tests" (: 493 u16))
  (let [r (widgets/create-in "build/widget-tests" "tally" "." "")]
    (write-tally! (tally-source "one" "" "" "1" ""))
    (widgets/reload! r)
    (assert (widgets/settle! r))
    (assert (widgets/render! r 400.0 300.0 0.0))
    (click! r "go")
    (click! r "go")
    (assert (has-text? r "one 2"))
    (assert (has-text? r "!!"))
    ; A new field with a default takes it; n and the owned note carry over.
    (write-tally! (tally-source "two"
                                "(step i64)"
                                "(field step (default 10))"
                                "(.step self)"
                                ":step 10"))
    (widgets/reload! r)
    (assert (widgets/settle! r))
    (assert (widgets/render! r 400.0 300.0 0.0))
    (assert (has-text? r "two 2"))
    (click! r "go")
    (assert (has-text? r "two 12"))
    (assert (has-text? r "!!!"))
    ; A new field without a default cannot be decoded from the saved state:
    ; the reload is refused, says which field, and version two keeps running.
    (write-tally! (tally-source "three"
                                "(step i64) (bonus i64)"
                                "(field step (default 10))"
                                "(+ (.step self) (.bonus self))"
                                ":step 10 :bonus 0"))
    (widgets/reload! r)
    (widgets/settle! r)
    (assert (< (widgets/take-update! r) 0))
    (assert (contains? (widgets/diagnostic r) "missing field"))
    (assert (contains? (widgets/diagnostic r) "Tally.bonus"))
    (assert (widgets/render! r 400.0 300.0 0.0))
    (assert (has-text? r "two 12"))
    ; Dropping step again: the saved step is skipped, the rest carries.
    (write-tally! (tally-source "four" "" "" "1" ""))
    (widgets/reload! r)
    (assert (widgets/settle! r))
    (assert (widgets/render! r 400.0 300.0 0.0))
    (assert (has-text? r "four 12"))
    (assert (has-text? r "!!!"))
    (widgets/free! r)))

(deftest render-faults-are-reported-not-drawn
  (let [(mut ui) (api/ui-new (alloc/malloc-allocator))]
    (api/ui-clear! (mut ui) 100.0 100.0 0.0)
    (api/end! (mut ui))
    (assert (= (.fault ui) api/FAULT-END-WITHOUT-CONTAINER))
    (api/ui-clear! (mut ui) 100.0 100.0 0.0)
    (api/vstack! (mut ui) 0.0 0.0)
    (api/button! (mut ui) "a" "a")
    (api/append! (mut ui) "x")
    (assert (= (.fault ui) api/FAULT-APPEND-WITHOUT-TEXT))
    (api/ui-free! (mut ui))))

(deftest render-faults-cover-orphans-and-styles
  (let [(mut ui) (api/ui-new (alloc/malloc-allocator))]
    (api/ui-clear! (mut ui) 100.0 100.0 0.0)
    (api/text! (mut ui) "loose" 12.0 0 false)
    (assert (= (.fault ui) api/FAULT-CHILD-OF-LEAF))
    (api/ui-clear! (mut ui) 100.0 100.0 0.0)
    (api/bg! (mut ui) 0x112233)
    (assert (= (.fault ui) api/FAULT-STYLE-WITHOUT-ELEMENT))
    (api/ui-free! (mut ui))))

(deftest styles-apply-to-the-latest-element
  (let [(mut ui) (api/ui-new (alloc/malloc-allocator))]
    (api/ui-clear! (mut ui) 100.0 100.0 0.0)
    (api/vstack! (mut ui) 4.0 8.0)
    (api/bg! (mut ui) 0x101010)
    (api/button! (mut ui) "go" "Go")
    (api/variant! (mut ui) api/PRIMARY)
    (api/input! (mut ui) "q" "value" "hint")
    (api/end! (mut ui))
    (assert (= (.fault ui) 0))
    (assert (= (.background (api/node (mut ui) 0)) 0x101010))
    (assert (= (.variant (api/node (mut ui) 1)) api/PRIMARY))
    (assert (= (api/node-placeholder (mut ui) (api/node (mut ui) 2))
               "hint"))
    (assert (= (api/node-text (mut ui) (api/node (mut ui) 2)) "value"))
    (api/ui-free! (mut ui))))

(deftest snapshot-later-entries-win
  (let [(mut s) (api/snapshot-new (alloc/malloc-allocator))]
    (api/put-text! (mut s) "jim.dir" "saved")
    (api/put-text! (mut s) "jim.dir" "current")
    (api/put-i64! (mut s) "n" 7)
    (assert (= (api/get-text (mut s) "jim.dir" "") "current"))
    (assert (= (api/get-i64 (mut s) "n" 0) 7))
    (assert (= (api/get-i64 (mut s) "missing" -3) -3))
    (api/snapshot-free! (mut s))))

(deftest restored-state-is-kept-until-a-generation-boots
  (let [r (widgets/create "counter" "." "")
        (mut restored) (api/snapshot-new (alloc/malloc-allocator))]
    (api/put-text! (mut restored)
                   "state"
                   "{\"n\":41,\"dark\":false,\"last\":0}")
    (widgets/restore-state! r (load restored))
    ; Saved again before any compile, as when Jim quits early.
    (let [(mut again) (api/snapshot-new (alloc/malloc-allocator))]
      (assert (widgets/save-state! r (mut again)))
      (assert (= (api/get-text (mut again) "state" "")
                 "{\"n\":41,\"dark\":false,\"last\":0}"))
      (api/snapshot-free! (mut again)))
    (widgets/reload! r)
    (assert (widgets/settle! r))
    (assert (widgets/render! r 400.0 300.0 0.0))
    (assert (has-text? r "n = 41"))
    (widgets/free! r)))

(defn now-ms [] (-> i64)
  (try (let [v (try-or! (time/monotonic-now-ms) 0)] v)))

(deftest reload-returns-before-the-compile-finishes
  (let [r (widgets/create "counter" "." "")
        t0 (now-ms)]
    (widgets/reload! r)
    ; Starting a reload only queues it; the compile runs on the worker.
    (assert (< (- (now-ms) t0) 20))
    (assert (widgets/loading? r))
    (assert (widgets/settle! r))
    (assert (not (widgets/loading? r)))
    (widgets/free! r)))

(deftest state-survives-a-restart
  (let [r (widgets/create "counter" "." "")]
    (widgets/reload! r)
    (assert (widgets/settle! r))
    (assert (widgets/render! r 400.0 300.0 0.0))
    (click! r "inc")
    (click! r "inc")
    (click! r "inc")
    (let [(mut saved) (api/snapshot-new (alloc/malloc-allocator))]
      (assert (widgets/save-state! r (mut saved)))
      (widgets/free! r)
      ; A new runtime, as after relaunching Jim with the saved layout.
      (let [again (widgets/create "counter" "." "")]
        (widgets/restore-state! again (load saved))
        (widgets/reload! again)
        (assert (widgets/settle! again))
        (assert (widgets/render! again 400.0 300.0 0.0))
        (assert (has-text? again "n = 3"))
        (widgets/free! again)))))

(defn listener-source [] (-> (slice u8))
  "(module widgets.listener)
(import \"coil.alloc\" :as alloc)
(import \"jim.widget-api\" :use *)
(defstruct Listener [(heard (array u8 64)) (n i64)])
(impl Widget Listener
  (render [(self (ptr Listener)) (ui (ptr Ui))] (-> void)
    (vstack! ui 0.0 0.0)
    (watch! ui \"/tmp\")
    (text! ui \"heard \" 12.0 0 false)
    (append-i64! ui (.n self))
    (end! ui))
  (event [(self (ptr Listener)) (e (ptr Event))] (-> void)
    (when (or (message? e \"ping\") (files-changed? e)) (set! (.n self) (+ (.n self) 1)) 0))
  (save [(self (ptr Listener)) (s (ptr Snapshot))] (-> void) (do))
  (animating? [(self (ptr Listener))] (-> bool) false)
  (destroy! [(self (ptr Listener))] (-> void) (alloc/destroy [Listener] (alloc/malloc-allocator) self) (do)))
(defn boot [(saved (ptr Snapshot)) (out (ptr (dyn Widget)))] (-> void)
  (set! out (alloc/box! (alloc/malloc-allocator) Listener (Listener :heard (zeroed (array u8 64)) :n 0))))
")

(deftest messages-and-file-changes-reach-the-widget
  (mkdir c"build" (: 493 u16))
  (mkdir c"build/widget-tests" (: 493 u16))
  (assert (try (let [_
                       (try-or! (fs/write-file (alloc/malloc-allocator)
                                               "build/widget-tests/listener.coil"
                                               (listener-source))
                                false)]
                 true)))
  (let [r (widgets/create-in "build/widget-tests" "listener" "." "")]
    (widgets/reload! r)
    (assert (widgets/settle! r))
    (assert (widgets/render! r 400.0 300.0 0.0))
    ; The frame declared its watch.
    (assert (= (len (.watches (.ui r))) 1))
    (widgets/message! r "ping" "")
    (widgets/message! r "other" "")
    (widgets/files-changed! r "/tmp" "/tmp/x")
    (assert (widgets/render! r 400.0 300.0 0.0))
    (assert (has-text? r "heard 2"))
    (widgets/free! r)))

(defn sleeper-source [(label (slice u8))] (-> (slice u8))
  (let [(mut b) (StrBuf::new (alloc/malloc-allocator))]
    (push-str! (mut b)
               "(module widgets.sleeper)
(import \"coil.primitive\" :as p)
(import \"coil.alloc\" :as alloc)
(import \"coil.cc\" :as cc)
(import \"jim.widget-api\" :use *)
(extern usleep :cc (cc/C) [u32] (-> i32))
(defstruct Nap [(ms i64)])
(impl Task Nap (run [(self (ptr Nap))] (-> void) (usleep (p/cast u32 (* 1000 (.ms self)))) (do)))
(defstruct Sleeper [(nap (ptr Nap)) (handle i64) (host (dyn Host))])
(impl Widget Sleeper
  (render [(self (ptr Sleeper)) (ui (ptr Ui))] (-> void) (vstack! ui 0.0 0.0) (text! ui \"")
    (push-str! (mut b) label)
    (push-str! (mut b)
               "\" 12.0 0 false) (end! ui))
  (event [(self (ptr Sleeper)) (e (ptr Event))] (-> void) (do))
  (save [(self (ptr Sleeper)) (s (ptr Snapshot))] (-> void) (do))
  (animating? [(self (ptr Sleeper))] (-> bool) false)
  (destroy! [(self (ptr Sleeper))] (-> void) (release-task (.host self) (.handle self)) (alloc/destroy [Sleeper] (alloc/malloc-allocator) self) (do)))
(defn boot [(saved (ptr Snapshot)) (out (ptr (dyn Widget)))] (-> void)
  (let [a (alloc/malloc-allocator)
        nap (alloc/box! a Nap (Nap :ms 300))
        h (host saved)]
    (set! out (alloc/box! a Sleeper (Sleeper :nap nap :handle (start-task h nap) :host h)))))
")
    (str b)))

(deftest retiring-waits-for-running-tasks
  (mkdir c"build" (: 493 u16))
  (mkdir c"build/widget-tests" (: 493 u16))
  (let [r (widgets/create-in "build/widget-tests" "sleeper" "." "")]
    (assert (try (let [_
                         (try-or! (fs/write-file (alloc/malloc-allocator)
                                                 "build/widget-tests/sleeper.coil"
                                                 (sleeper-source "one"))
                                  false)]
                   true)))
    (widgets/reload! r)
    (assert (widgets/settle! r))
    (assert (try (let [_
                         (try-or! (fs/write-file (alloc/malloc-allocator)
                                                 "build/widget-tests/sleeper.coil"
                                                 (sleeper-source "two"))
                                  false)]
                   true)))
    (widgets/reload! r)
    (assert (widgets/settle! r))
    (assert (widgets/render! r 400.0 300.0 0.0))
    (assert (has-text? r "two"))
    ; Generation one's 300 ms task may still run, so it waits to retire.
    (let [t0 (now-ms)]
      (while (> (len (.retiring r)) 0)
        (usleep (: 2000 u32))
        (widgets/service-poll!))
      (assert (< (- (now-ms) t0) 1000)))
    (widgets/free! r)))

(deftest a-save-during-a-compile-is-compiled-after-it
  (mkdir c"build" (: 493 u16))
  (mkdir c"build/widget-tests" (: 493 u16))
  (let [r (widgets/create-in "build/widget-tests" "probe" "." "")]
    (write-probe! (probe-source "one" false))
    (widgets/reload! r)
    ; "one" is compiling; this save supersedes it.
    (write-probe! (probe-source "two" false))
    (widgets/reload! r)
    (assert (widgets/settle! r))
    (assert (widgets/render! r 400.0 300.0 0.0))
    (assert (has-text? r "two 0"))
    (widgets/free! r)))

;;; ---- the diff wall ------------------------------------------------------------
(extern system :cc (cc/C) [(ptr i8)] (-> i32))

(const WALL-REPO "build/widget-tests/wall-repo")

(defn in-wall-repo! [(script (ptr i8))] (-> void)
  (assert (= (system script) (: 0 i32))))

(defn make-wall-repo! [] (-> void)
  (mkdir c"build" (: 493 u16))
  (mkdir c"build/widget-tests" (: 493 u16))
  (in-wall-repo! c"rm -rf build/widget-tests/wall-repo && mkdir build/widget-tests/wall-repo && cd build/widget-tests/wall-repo && git init -q && printf 'one\ntwo\nthree\n' > a.txt && printf 'keep\n' > b.txt && git add . && git -c user.name=t -c user.email=t@t -c commit.gpgsign=false -c core.hooksPath=/dev/null commit -qm first && printf 'one\nTWO\nthree\n' > a.txt && printf 'brand new\n' > new.txt"))

;;; Tick R until it has asked for requests of KIND, returning how many it has.
(defn tick-for! [(r (ptr widgets/Runtime)) (kind i64) (wanted i64)] (-> i64)
  (let [t0 (now-ms)
        (mut found) 0]
    (while (and (< (load found) wanted) (< (- (now-ms) t0) 20000))
      (widgets/service-poll!)
      (widgets/tick! r 0.016)
      (usleep (: 5000 u32))
      (let [q (widgets/requests r)]
        (set! found 0)
        (for [i 0 (len (.items q))]
          (when (= (.kind (get (.items q) i)) kind)
            (set! found (+ (load found) 1))))))
    (load found)))

(defn nth-request [(r (ptr widgets/Runtime)) (kind i64) (n i64)]
  (-> (slice u8))
  (let [q (widgets/requests r)
        (mut seen) 0
        (mut out) ""]
    (for [i 0 (len (.items q))]
      (let [item (get (.items q) i)]
        (when (= (.kind item) kind)
          (when (= (load seen) n) (set! out (api/request-text q item)))
          (set! seen (+ (load seen) 1)))))
    (load out)))

(defn request-count [(r (ptr widgets/Runtime)) (kind i64)] (-> i64)
  (let [q (widgets/requests r)
        (mut seen) 0]
    (for [i 0 (len (.items q))]
      (when (= (.kind (get (.items q) i)) kind) (set! seen (+ (load seen) 1))))
    (load seen)))

(defn after-space [(s (slice u8))] (-> (slice u8))
  (let [(mut at) 0]
    (for [i 0 (len s)]
      (when (and (= (load at) 0) (= (get s i) (: 32 u8))) (set! at (+ i 1))))
    (subslice s (load at) (len s))))

;;; Tick R, rendering, until its text includes NEEDLE.
(defn shows? [(r (ptr widgets/Runtime)) (needle (slice u8))] (-> bool)
  (let [t0 (now-ms)
        (mut found) false]
    (while (and (not (load found)) (< (- (now-ms) t0) 20000))
      (widgets/service-poll!)
      (widgets/tick! r 0.016)
      (usleep (: 5000 u32))
      (when (widgets/render! r 800.0 600.0 0.0)
        (let [ui (widgets/ui-of r)]
          (for [i 0 (len (.nodes (load ui)))]
            (let [n (api/node ui i)]
              (when (and (= (.kind n) api/TEXT)
                         (contains-text? (api/node-text ui n) needle))
                (set! found true)))))
        0))
    (load found)))

;;; Run WALL, handing its notices to its tiles as Jim's broadcast does, until
;;; TILE shows NEEDLE.
(defn forwards-until-shown? [(wall (ptr widgets/Runtime))
                             (tile (ptr widgets/Runtime))
                             (other (ptr widgets/Runtime))
                             (needle (slice u8))] (-> bool)
  (let [t0 (now-ms)
        (mut found) false]
    (while (and (not (load found)) (< (- (now-ms) t0) 20000))
      (widgets/service-poll!)
      (widgets/tick! wall 0.016)
      (let [q (widgets/requests wall)]
        (for [i 0 (len (.items q))]
          (let [item (get (.items q) i)]
            (when (= (.kind item) api/EMIT)
              (widgets/message! tile
                                (api/request-text q item)
                                (api/request-text2 q item))
              (widgets/message! other
                                (api/request-text q item)
                                (api/request-text2 q item)))))
        (api/requests-clear! q))
      (set! found (shows-now? tile needle))
      (usleep (: 5000 u32)))
    (load found)))

(defn shows-now? [(r (ptr widgets/Runtime)) (needle (slice u8))] (-> bool)
  (widgets/tick! r 0.016)
  (let [(mut found) false]
    (when (widgets/render! r 800.0 600.0 0.0)
      (let [ui (widgets/ui-of r)]
        (for [i 0 (len (.nodes (load ui)))]
          (let [n (api/node ui i)]
            (when (and (= (.kind n) api/TEXT)
                       (contains-text? (api/node-text ui n) needle))
              (set! found true)))))
      0)
    (load found)))

(defn contains-text? [(s (slice u8)) (needle (slice u8))] (-> bool)
  (match (find s needle) (Some [_] true) (None [] false)))

(deftest the-diff-wall-tiles-a-repository-and-stays-current
  (make-wall-repo!)
  (let [wall (widgets/create "diffwall" WALL-REPO "")]
    (widgets/reload! wall)
    (assert (widgets/settle! wall))
    (assert (widgets/render! wall 600.0 400.0 0.0))
    ; A tracked change and an untracked file, placed and framed.
    (assert (= (tick-for! wall api/OPEN-WIDGET-AT 2) 2))
    (assert (= (request-count wall api/FIT-CANVAS) 1))
    (assert (= (request-count wall api/MOVE-SELF) 1))
    (let [(mut first) (text-copy (nth-request wall api/OPEN-WIDGET-AT 0))
          (mut second) (text-copy (nth-request wall api/OPEN-WIDGET-AT 1))
          q (widgets/requests wall)
          (mut placed-tile) 0.0]
      (for [i 0 (len (.items q))]
        (let [item (get (.items q) i)]
          (when (= (.kind item) api/OPEN-WIDGET-AT)
            (assert (>= (.w item) 320.0))
            (assert (>= (.h item) 180.0))
            (assert (>= (.y item) 40.0))
            (set! placed-tile (.h item)))))
      (assert (> (load placed-tile) 0.0))
      (assert (= (subslice (slice first) 0 10) "diff tile "))
      (api/requests-clear! q)
      ; The tiles show what the wall left for them.
      (assert (shows? wall "a.txt"))
      (assert (shows? wall "new.txt"))
      (let [tile (widgets/create "diff" WALL-REPO (after-space (slice first)))
            other (widgets/create "diff" WALL-REPO (after-space (slice second)))]
        ; Same source as each other: already compiled for the first, booted
        ; together for the second.
        (widgets/reload! tile)
        (widgets/reload! other)
        (assert (widgets/settle! tile))
        (assert (widgets/live? other))
        (assert (shows? tile "TWO"))
        ; The pane's title names the file; the tile does not repeat it.
        (assert (= (api/title (widgets/ui-of tile)) "a.txt"))
        (assert (shows? other "brand new"))
        ; An edit reaches the tile through the wall, by way of one notice.
        (in-wall-repo! c"cd build/widget-tests/wall-repo && printf 'one\nTWO\nTHREE\n' > a.txt")
        (widgets/message! wall "git.changed" WALL-REPO)
        (assert (forwards-until-shown? wall tile other "THREE"))
        (api/requests-clear! (widgets/requests wall))
        ; A new file gets a tile, and reverting one closes its tile.
        (in-wall-repo! c"cd build/widget-tests/wall-repo && git checkout -q a.txt && printf 'more\n' > more.txt")
        (widgets/message! wall "git.changed" WALL-REPO)
        (assert (= (tick-for! wall api/CLOSE-WIDGET 1) 1))
        (assert (= (nth-request wall api/CLOSE-WIDGET 0) (slice first)))
        (assert (>= (tick-for! wall api/OPEN-WIDGET-AT 1) 1))
        (assert (shows? wall "more.txt"))
        ; A live update does not take the camera away from anyone.
        (assert (= (request-count wall api/FIT-CANVAS) 0))
        (api/requests-clear! (widgets/requests wall))
        ; After a restart the wall knows its tiles and opens none of them again.
        (let [(mut saved) (api/snapshot-new (alloc/malloc-allocator))]
          (assert (widgets/save-state! wall (mut saved)))
          (let [again (widgets/create "diffwall" WALL-REPO "")]
            (widgets/restore-state! again (load saved))
            (widgets/reload! again)
            (assert (widgets/live? again))
            (assert (shows? again "more.txt"))
            (widgets/message! again "git.changed" WALL-REPO)
            (assert (shows? again "more.txt"))
            (let [t0 (now-ms)]
              (while (< (- (now-ms) t0) 1000)
                (widgets/service-poll!)
                (widgets/tick! again 0.016)
                (usleep (: 5000 u32))))
            (assert (= (request-count again api/OPEN-WIDGET-AT) 0))
            (assert (= (request-count again api/CLOSE-WIDGET) 0))
            (widgets/free! again)))
        (widgets/free! tile)
        (widgets/free! other))
      (free! (mut first))
      (free! (mut second)))
    (widgets/free! wall)))

(deftest the-diff-wall-says-what-it-cannot-do
  (mkdir c"build" (: 493 u16))
  (mkdir c"build/widget-tests" (: 493 u16))
  (let [bad (widgets/create "diffwall" "." "banana")
        outside (widgets/create "diffwall" "/" "")]
    (widgets/reload! bad)
    (widgets/reload! outside)
    (assert (widgets/settle! bad))
    (assert (shows? bad "don't understand 'banana'"))
    (assert (shows? outside "not a git repository"))
    (widgets/free! bad)
    (widgets/free! outside)))

(defn text-copy [(s (slice u8))] (-> (ArrayList u8))
  (let [(mut out) (ArrayList::new [u8] (alloc/malloc-allocator))]
    (extend! (mut out) (data s) (len s))
    (load out)))
