font-family = JetBrains Mono
font-size = 13
background = 11151c
foreground = d9e2ef
cursor-color = 72c7ec
selection-background = 30475f
window-padding-x = 16
window-padding-y = 12
shell-integration = detect
confirm-close-surface = false
clipboard-read = deny
clipboard-write = allow

# Original Jim moves about a line per 9 points of trackpad travel on a Retina
# display. Ghostty's core, unscaled, moves one per cell height in pixels.
mouse-scroll-multiplier = precision:4,discrete:3

# Invalid input should never produce an audible bell.
bell-features = no-system,no-audio
