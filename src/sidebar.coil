(module jim.sidebar)
(import "jim.native" :use *)
(import "jim.projects" :as projects)
(import "jim.storage" :as s)
(import "jim.controls" :as controls)
(import "coil.primitive" :as p)

(defstruct Sidebar
  [(view (ptr i8))
   (scroll (ptr i8))
   (document (ptr i8))
   (header (ptr i8))
   (footer (ptr i8))
   (add-project (ptr i8))
   (add-profile (ptr i8))
   (target (ptr i8))
   (swipe f64)
   (switched bool)
   (model (ptr i8))
   (rows (ptr i8))
   (show-hidden bool)
   (pending i64)
   (pressed i64)
   (start Point)
   (dragging bool)
   (resizing bool)
   (width f64)
   (height f64)])

(defn state [] (-> (ptr Sidebar))
  (p/alloc-static Sidebar))

(defn width [] (-> f64)
  (.width (state)))

(defn row-id [(index i64)] (-> i64)
  (projects/id (s/at (.rows (state)) index)))

(defn control [(parent (ptr i8)) (title (ptr i8)) (bounds Rect)] (-> (ptr i8))
  (let [b (controls/button title (.target (state)) (sel c"clicked:"))]
    (do
      (frame! b bounds)
      (msg i64 b (sel c"setAlignment:") [i64] 0)
      (msg i64 b (sel c"setBordered:") [i8] (p/cast i8 0))
      (msg i64 b (sel c"setFont:") [(ptr i8)] (msg (ptr i8) (class c"NSFont") (sel c"systemFontOfSize:") [f64] 13.0))
      (msg i64 parent (sel c"addSubview:") [(ptr i8)] b)
      b)))

(defn refresh! [] (-> void)
  (let [st (state)
        root (.model st)
        rows (s/array)
        children (msg (ptr i8) (.document st) (sel c"subviews") [])
        copy (msg (ptr i8) children (sel c"copy") [])
        clip (msg (ptr i8) (.scroll st) (sel c"contentView") [])
        clip-bounds (msg Rect clip (sel c"bounds") [])
        old-bounds (msg Rect (.document st) (sel c"bounds") [])
        from-top (- (.h old-bounds) (+ (.y clip-bounds) (.h clip-bounds)))]
    (do
      (for [i 0 (s/count copy)] (msg i64 (s/at copy i) (sel c"removeFromSuperview") []))
      (release copy)
      (for [i 0 (s/count (projects/list root))]
        (let [record (s/at (projects/list root) i)]
          (if (or (.show-hidden st) (not (projects/hidden? (projects/profile root) (projects/id record))))
              (s/add! rows record)
              0)))
      (release (.rows st))
      (set! (.rows st) (msg (ptr i8) rows (sel c"retain") []))
      (let [height
              (if (> (* (p/cast f64 (s/count rows)) 40.0) (- (.height st) 94.0))
                  (* (p/cast f64 (s/count rows)) 40.0)
                  (- (.height st) 94.0))]
        (do
          (frame! (.document st) (rect 0.0 0.0 (- (.width st) 16.0) height))
          (let [y (- height (+ (.h clip-bounds) (if (> from-top 0.0) from-top 0.0)))]
            (msg i64 clip (sel c"scrollToPoint:") [Point] (Point :x 0.0 :y (if (> y 0.0) y 0.0))))
          (msg i64 (.scroll st) (sel c"reflectScrolledClipView:") [(ptr i8)] clip)
          (for [i 0 (s/count rows)]
            (let [record (s/at rows i)
                  hidden (projects/hidden? (projects/profile root) (projects/id record))
                  b
                    (control (.document st)
                             (utf8 (s/get record c"name"))
                             (rect 0.0 (- height (* (p/cast f64 (+ i 1)) 40.0)) (- (.width st) 44.0) 38.0))]
              (do
                (msg i64
                     b
                     (sel c"setTitle:")
                     [(ptr i8)]
                     (msg (ptr i8)
                          (s/get record c"name")
                          (sel c"stringByAppendingString:")
                          [(ptr i8)]
                          (ns (if hidden c"  ◌" c""))))
                (msg i64 b (sel c"setTag:") [i64] (+ 100 (* (projects/id record) 2)))
                (msg i64 b (sel c"setToolTip:") [(ptr i8)] (s/get record c"directory"))
                (msg i64 b (sel c"setAlphaValue:") [f64] (if hidden 0.5 1.0))
                (controls/select! b (= (projects/id record) (projects/active root)))
                (let [eye
                        (control (.document st)
                                 (if hidden c"+" c"−")
                                 (rect (- (.width st) 44.0) (+ (- height (* (p/cast f64 (+ i 1)) 40.0)) 3.0) 26.0 30.0))]
                  (msg i64 eye (sel c"setTag:") [i64] (+ 101 (* (projects/id record) 2)))))))))
      (msg i64 (.header st) (sel c"removeAllItems") [])
      (for [i 0 (s/count (projects/profiles root))]
        (let [profile (s/at (projects/profiles root) i)
              item
                (msg (ptr i8)
                     (msg (ptr i8) (class c"NSMenuItem") (sel c"alloc") [])
                     (sel c"initWithTitle:action:keyEquivalent:")
                     [(ptr i8) (ptr i8) (ptr i8)]
                     (s/get profile c"name")
                     (nil)
                     (ns c""))]
          (do
            (msg i64 item (sel c"setTag:") [i64] (projects/id profile))
            (msg i64 (msg (ptr i8) (.header st) (sel c"menu") []) (sel c"addItem:") [(ptr i8)] item)
            (release item))))
      (msg i8 (.header st) (sel c"selectItemWithTag:") [i64] (projects/id (projects/profile root)))
      (msg i64
           (.footer st)
           (sel c"setTitle:")
           [(ptr i8)]
           (ns (if (.show-hidden st) c"Hide hidden projects" c"Show hidden projects")))
      (do))))

(defn layout! [(height f64)] (-> void)
  (let [st (state)]
    (do
      (set! (.height st) height)
      (frame! (.view st) (rect 0.0 0.0 (.width st) height))
      (frame! (.header st) (rect 12.0 (- height 42.0) (- (.width st) 54.0) 30.0))
      (frame! (.scroll st) (rect 8.0 48.0 (- (.width st) 16.0) (- height 94.0)))
      (frame! (.footer st) (rect 12.0 8.0 (- (.width st) 48.0) 30.0))
      (frame! (.add-project st) (rect (- (.width st) 34.0) 8.0 26.0 30.0))
      (frame! (.add-profile st) (rect (- (.width st) 34.0) (- height 42.0) 26.0 30.0))
      (refresh!))))

(defn clicked [(self (ptr i8)) (cmd (ptr i8)) (sender (ptr i8))] (-> void)
  (let [st (state)
        tag (msg i64 sender (sel c"tag") [])]
    (do
      (cond (>= tag 100)
              (let [id (/ (- tag 100) 2)]
                (do
                  (if (= (% tag 2) 0)
                      (projects/select! (.model st) id)
                      (projects/hide! (.model st) id (not (projects/hidden? (projects/profile (.model st)) id))))
                  (set! (.pending st) -2)
                  (do)))
            (= tag 23) (do (set! (.show-hidden st) (not (.show-hidden st))) (refresh!))
            :else (do (set! (.pending st) tag) (do)))
      (do))))

(defn profile-selected [(self (ptr i8)) (cmd (ptr i8)) (sender (ptr i8))] (-> void)
  (do
    (projects/switch-profile! (.model (state))
                              (msg i64 (msg (ptr i8) sender (sel c"selectedItem") []) (sel c"tag") []))
    (set! (.pending (state)) -2)
    (do)))

(defn setup! [(parent (ptr i8)) (model (ptr i8))] (-> void)
  (let [st (state)
        saved (s/value model c"sidebar_width")]
    (do
      (set! (.model st) model)
      (set! (.width st) (if (and (>= saved 160.0) (<= saved 480.0)) saved 220.0))
      (set! (.pending st) -1)
      (set! (.view st) (view parent (rect 0.0 0.0 (.width st) 860.0)))
      (background! (.view st) 0.075 0.09 0.12)
      (let [cls (objc_allocateClassPair (class c"NSObject") c"JimSidebarActions" 0)]
        (do
          (method! cls c"clicked:" (p/cast (ptr i8) (p/fnptr-of clicked)) c"v@:@")
          (method! cls c"profileSelected:" (p/cast (ptr i8) (p/fnptr-of profile-selected)) c"v@:@")
          (objc_registerClassPair cls)
          (set! (.target st) (new c"JimSidebarActions"))))
      (set! (.header st)
            (msg (ptr i8)
                 (msg (ptr i8) (class c"NSPopUpButton") (sel c"alloc") [])
                 (sel c"initWithFrame:pullsDown:")
                 [Rect i8]
                 (rect 12.0 816.0 170.0 30.0)
                 (p/cast i8 0)))
      (msg i64 (.header st) (sel c"setBordered:") [i8] (p/cast i8 0))
      (msg i64 (.header st) (sel c"setTarget:") [(ptr i8)] (.target st))
      (msg i64 (.header st) (sel c"setAction:") [(ptr i8)] (sel c"profileSelected:"))
      (msg i64 (.view st) (sel c"addSubview:") [(ptr i8)] (.header st))
      (release (.header st))
      (set! (.add-profile st) (control (.view st) c"+" (rect 186.0 816.0 26.0 30.0)))
      (msg i64 (.add-profile st) (sel c"setTag:") [i64] 20)
      (msg i64 (.add-profile st) (sel c"setToolTip:") [(ptr i8)] (ns c"New profile"))
      (set! (.add-project st) (control (.view st) c"+" (rect 186.0 8.0 26.0 30.0)))
      (msg i64 (.add-project st) (sel c"setTag:") [i64] 15)
      (msg i64 (.add-project st) (sel c"setToolTip:") [(ptr i8)] (ns c"New project"))
      (set! (.footer st) (control (.view st) c"Show hidden projects" (rect 12.0 8.0 170.0 30.0)))
      (msg i64 (.footer st) (sel c"setTag:") [i64] 23)
      (set! (.scroll st) (new c"NSScrollView"))
      (msg i64 (.scroll st) (sel c"setDrawsBackground:") [i8] (p/cast i8 0))
      (msg i64 (.scroll st) (sel c"setHasVerticalScroller:") [i8] (p/cast i8 1))
      (msg i64 (.view st) (sel c"addSubview:") [(ptr i8)] (.scroll st))
      ;; The scroll view takes ownership only in setDocumentView:.
      (set! (.document st)
            (msg (ptr i8)
                 (msg (ptr i8) (class c"NSView") (sel c"alloc") [])
                 (sel c"initWithFrame:")
                 [Rect]
                 (rect 0.0 0.0 204.0 720.0)))
      (msg i64 (.scroll st) (sel c"setDocumentView:") [(ptr i8)] (.document st))
      (release (.document st))
      (layout! 860.0))))

(defn take-action! [] (-> i64)
  (let [value (.pending (state))] (do (set! (.pending (state)) -1) value)))

;;; Capture row gestures before NSButton starts its own tracking loop.
(defn handle! [(event (ptr i8))] (-> bool)
  (let [st (state)
        kind (msg i64 event (sel c"type") [])
        pt
          (msg Point
               (.view st)
               (sel c"convertPoint:fromView:")
               [Point (ptr i8)]
               (msg Point event (sel c"locationInWindow") [])
               (nil))
        doc
          (msg Point
               (.document st)
               (sel c"convertPoint:fromView:")
               [Point (ptr i8)]
               (msg Point event (sel c"locationInWindow") [])
               (nil))
        bounds (msg Rect (.document st) (sel c"bounds") [])
        row (p/cast i64 (/ (- (.h bounds) (.y doc)) 40.0))
        in-row (and (>= (.y pt) 48.0) (< (.y pt) (- (.height st) 46.0)) (>= row 0) (< row (s/count (.rows st))))]
    (cond (and (= kind 22)
               (>= (.x pt) 0.0)
               (< (.x pt) (.width st))
               (let [dx (msg f64 event (sel c"scrollingDeltaX") [])
                     dy (msg f64 event (sel c"scrollingDeltaY") [])]
                 (> (* dx dx) (* dy dy))))
            (let [phase (msg u64 event (sel c"phase") [])
                  dx (msg f64 event (sel c"scrollingDeltaX") [])]
              (do
                (if (or (= phase (p/cast u64 1)) (= phase (p/cast u64 0)))
                    (do (set! (.swipe st) 0.0) (set! (.switched st) false))
                    0)
                (set! (.swipe st) (+ (.swipe st) dx))
                (if (and (not (.switched st)) (or (> (.swipe st) 40.0) (< (.swipe st) -40.0)))
                    (do (set! (.pending st) (if (> (.swipe st) 0.0) 25 24)) (set! (.switched st) true))
                    0)
                true))
          (and (= kind 1) (>= (.x pt) 0.0) (< (.x pt) (- (.width st) 40.0)) (> (.y pt) (- (.height st) 46.0))) false
          (and (= kind 1) (>= (.x pt) (- (.width st) 4.0)) (<= (.x pt) (+ (.width st) 4.0)))
            (do (set! (.resizing st) true) true)
          (.resizing st)
            (do
              (if (= kind 6)
                  (do
                    (set! (.width st) (if (< (.x pt) 160.0) 160.0 (if (> (.x pt) 480.0) 480.0 (.x pt))))
                    (s/put! (.model st) c"sidebar_width" (s/number (.width st)))
                    (set! (.pending st) -2))
                  0)
              (if (= kind 2) (set! (.resizing st) false) 0)
              true)
          (and (= kind 6) (> (.pressed st) 0))
            (do
              (msg i8 (.document st) (sel c"autoscroll:") [(ptr i8)] event)
              (if (or (> (- (.y pt) (.y (.start st))) 4.0) (< (- (.y pt) (.y (.start st))) -4.0))
                  (set! (.dragging st) true)
                  0)
              (if (and (.dragging st) in-row (!= (row-id row) (.pressed st)))
                  (do
                    (projects/reorder-at! (.model st) (.pressed st) (row-id row) (< (.y pt) (.y (.start st))))
                    (refresh!)
                    (set! (.pending st) -2)
                    (do))
                  (do))
              true)
          (and (= kind 2) (> (.pressed st) 0))
            (do
              (if (not (.dragging st))
                  (do (projects/select! (.model st) (.pressed st)) (set! (.pending st) -2) (do))
                  (do))
              (set! (.pressed st) 0)
              (set! (.dragging st) false)
              true)
          (and (= kind 1) (>= (.x pt) 0.0) (< (.x pt) (.width st)))
            (do
              (cond (> (.y pt) (- (.height st) 46.0)) (do (set! (.pending st) 20) (do))
                    (< (.y pt) 46.0)
                      (if (> (.x pt) (- (.width st) 40.0))
                          (do (set! (.pending st) 15) (do))
                          (do (set! (.show-hidden st) (not (.show-hidden st))) (refresh!)))
                    in-row
                      (if (> (.x pt) (- (.width st) 44.0))
                          (do
                            (projects/hide! (.model st)
                                            (row-id row)
                                            (not (projects/hidden? (projects/profile (.model st)) (row-id row))))
                            (refresh!)
                            (set! (.pending st) -2)
                            (do))
                          (do (set! (.pressed st) (row-id row)) (set! (.start st) pt) (do)))
                    :else (do))
              true)
          :else false)))

(defn free! [] (-> void)
  (do (release (.rows (state))) (release (.scroll (state))) (release (.target (state))) (do)))
