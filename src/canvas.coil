(module jim.canvas)
(import "jim.native" :use *)
(import "jim.terminal" :as terminal)
(import "jim.widget-view" :as widget-view)
(import "jim.widget-api" :as api)
(import "jim.ghostty" :as g)
(import "jim.theme" :as theme)
(import "jim.storage" :as storage)
(import "jim.sessions" :as sessions)
(import "jim.animation" :as animation)
(import "jim.canvas-model" :as model)
(import "coil.math" :use [Float])
(import "coil.primitive" :as p)
(import "coil.cc" :as cc)
(import "coil.alloc" :as alloc)
(import "coil.arraylist" :as al)

(defstruct Pane
  [(id i64)
   (view (ptr i8))
   (title (ptr i8))
   (header (ptr i8))
   ;; The line under the header, which marks the focused pane.
   (divider (ptr i8))
   ;; Each label's text height: a label draws at the top of its frame, so a frame
   ;; this tall is what centers its text in the header.
   (title-height f64)
   (close-height f64)
   (message (ptr i8))
   (close (ptr i8))
   (terminal (ptr terminal/Terminal))
   ;; Exactly one of terminal and widget is set.
   (widget (ptr widget-view/WidgetPane))
   (bounds Rect)
   ;; Pinned to the background, as in Jim: behind every other pane and never raised,
   ;; without its chrome, and never focused. Pointer events pass through it to what is
   ;; behind, except where a widget has something to click.
   (pinned bool)
   ;; Where Exposé shows the pane, in the canvas view's top-down coordinates.
   (slot Rect)
   (render-scale f64)
   (render-w f64)
   (render-h f64)])

(defstruct Canvas
  [(view (ptr i8))
   (directory (ptr i8))
   (panes (al/ArrayList (ptr Pane)))
   (camera model/Camera)
   (edges (array (ptr i8) 4))
   (focused (ptr Pane))
   (next-id i64)
   (dirty bool)
   (width f64)
   (height f64)
   (scale f64)
   (visible bool)
   ;; Laid out for the cube by cube-pose!: every pane shown, ignoring the
   ;; camera's view.
   (fitted bool)
   ;; Exposé is open: the panes are spread into a grid, every one shown. They
   ;; are carried there by their layers' transforms, never moved or resized.
   ;; HOVERED is lifted; EXPOSED-AT is when the spread settles, and
   ;; RETURNING-AT when the panes are home after it closes.
   (exposed bool)
   (hovered (ptr Pane))
   (exposed-at f64)
   (returning-at f64)
   (theme theme/Theme)
   (zoom-enabled bool)
   (space-held bool)
   (last-click f64)
   (click-point Point)
   (click-pane (ptr Pane))
   (gesture i64)
   (start Point)
   (start-world Point)
   (pointer Point)
   (start-bounds Rect)
   (drag-pane (ptr Pane))
   ;; The model/EDGE-* bits a resize gesture drags.
   (resize-edges i64)])

(defn display-camera [(c (ptr Canvas))] (-> model/Camera)
  (if (.zoom-enabled c)
      (.camera c)
      (model/Camera
        :x (.x (.camera c))
        :y (.y (.camera c))
        :zoom 1.0)))

(defn count [(c (ptr Canvas))] (-> i64)
  (len (.panes c)))

(defn pane [(c (ptr Canvas)) (index i64)] (-> (ptr Pane))
  (get (.panes c) index))

(defn term-of [(v (ptr Pane))] (-> (ptr terminal/Terminal))
  (.terminal v))

(defn widget? [(v (ptr Pane))] (-> bool)
  (!= (p/cast i64 (.widget v)) 0))

;;; How many times C's terminals have asked for attention since this was last called.
(defn take-bells! [(c (ptr Canvas))] (-> i64)
  (let [(mut bells) 0]
    (for [i 0 (count c)]
      (let [v (pane c i)]
        (when (not (widget? v))
          (set! bells (+ (load bells) (terminal/take-bells! (term-of v)))))))
    (load bells)))

;;; The native view that takes keyboard focus for a pane.
(defn content-view [(v (ptr Pane))] (-> (ptr i8))
  (if (widget? v) (.view (.widget v)) (.view (term-of v))))

(defn content-bounds [(bounds Rect)] (-> Rect)
  (rect 0.0 0.0 (.w bounds) (- (.h bounds) model/HEADER)))

(defn edge [(c (ptr Canvas)) (index i64)] (-> (ptr i8))
  (load (p/index (field c edges) index)))

(defn no-pane [] (-> (ptr Pane))
  (p/cast (ptr Pane) 0))

(defn point [(c (ptr Canvas)) (event (ptr i8))] (-> Point)
  (let [pt
          (msg Point
               (.view c)
               (sel c"convertPoint:fromView:")
               [Point (ptr i8)]
               (msg Point event (sel c"locationInWindow") [])
               (nil))]
    (Point :x (.x pt) :y (- (.height c) (.y pt)))))

;;; How far the focused pane's header lifts above the pane color. Focus is this color,
;;; with bright text; every pane has the same faint edge against the canvas.
(const FOCUS-LIFT 0.1)

(defn paint-header! [(c (ptr Canvas)) (v (ptr Pane)) (active bool)] (-> void)
  (let [cfg (.theme c)
        r (if active (+ (.pane-r cfg) FOCUS-LIFT) (.rail-r cfg))
        g (if active (+ (.pane-g cfg) FOCUS-LIFT) (.rail-g cfg))
        b (if active (+ (.pane-b cfg) FOCUS-LIFT) (.rail-b cfg))]
    (background! (.header v) r g b)
    (background! (.divider v) (+ r 0.05) (+ g 0.05) (+ b 0.05))
    (msg i64
         (layer (.view v))
         (sel c"setBorderWidth:")
         [f64]
         (if (.pinned v) 0.0 1.0))
    (msg i64
         (layer (.view v))
         (sel c"setBorderColor:")
         [(ptr i8)]
         (msg (ptr i8) (color 1.0 1.0 1.0 0.07) (sel c"CGColor") []))
    (msg i64
         (.title v)
         (sel c"setTextColor:")
         [(ptr i8)]
         (if active
             (color (.ink-r cfg) (.ink-g cfg) (.ink-b cfg) 1.0)
             (color (.muted-r cfg) (.muted-g cfg) (.muted-b cfg) 0.9)))
    (msg i64
         (.close v)
         (sel c"setTextColor:")
         [(ptr i8)]
         (color (.muted-r cfg)
                (.muted-g cfg)
                (.muted-b cfg)
                (if active 1.0 0.7)))
    (do)))

;;; Lay the chrome out in a pane W×H: the header across the top, its title and close
;;; button centered in it, the close button in the square at its right end.
(defn frame-chrome! [(v (ptr Pane)) (w f64) (h f64)] (-> void)
  (let [top (- h model/HEADER)]
    (frame! (.header v) (rect 0.0 top w model/HEADER))
    (frame! (.divider v) (rect 0.0 top w 1.0))
    (frame! (.title v)
            (rect 12.0
                  (+ top (/ (- model/HEADER (.title-height v)) 2.0))
                  (- w 12.0 model/HEADER)
                  (.title-height v)))
    (frame! (.close v)
            (rect (- w model/HEADER)
                  (+ top (/ (- model/HEADER (.close-height v)) 2.0))
                  model/HEADER
                  (.close-height v)))
    (do)))

;;; The pane's own background: the pane color, or nothing behind a pinned pane, which
;;; shows only its content.
(defn paint-pane! [(c (ptr Canvas)) (v (ptr Pane))] (-> void)
  (let [cfg (.theme c)]
    (if (.pinned v)
        (msg i64
             (layer (.view v))
             (sel c"setBackgroundColor:")
             [(ptr i8)]
             (nil))
        (background! (.view v) (.pane-r cfg) (.pane-g cfg) (.pane-b cfg)))
    (paint-header! c v (= (p/cast i64 v) (p/cast i64 (.focused c))))))

;;; Show or hide the header, its title and close button.
(defn chrome-shown! [(v (ptr Pane)) (shown bool)] (-> void)
  (let [hidden (p/cast i8 (if shown 0 1))]
    (msg i64 (.header v) (sel c"setHidden:") [i8] hidden)
    (msg i64 (.divider v) (sel c"setHidden:") [i8] hidden)
    (msg i64 (.title v) (sel c"setHidden:") [i8] hidden)
    (msg i64 (.close v) (sel c"setHidden:") [i8] hidden)
    (do)))

(defn focus! [(c (ptr Canvas)) (chosen (ptr Pane))] (-> void)
  (do
    (set! (.focused c) chosen)
    (set! (.dirty c) true)
    (for [i 0 (count c)]
      (let [v (pane c i)
            active (= (p/cast i64 v) (p/cast i64 chosen))]
        (paint-header! c v active)))
    (msg i8
         (msg (ptr i8) (.view c) (sel c"window") [])
         (sel c"makeFirstResponder:")
         [(ptr i8)]
         (if (= (p/cast i64 chosen) 0) (nil) (content-view chosen)))))

;;; Focus the terminal pane whose view is VIEW, if it is on this canvas.
(defn focus-terminal! [(c (ptr Canvas)) (view (ptr i8))] (-> void)
  (for [i 0 (count c)]
    (let [v (pane c i)]
      (when (and (not (widget? v))
                 (= (p/cast i64 (.view (term-of v))) (p/cast i64 view)))
        (front! c v)
        (do))))
  (do))

;;; ---- the stack ------------------------------------------------------------------
;;; Array order and native subview order are one z-order, back to front. Pinned panes
;;; come first, so every other pane is in front of them.

(defn pinned-count [(c (ptr Canvas))] (-> i64)
  (let [(mut n) 0]
    (for [i 0 (count c)]
      (when (.pinned (pane c i)) (set! n (+ (load n) 1))))
    (load n)))

;;; The pane in front, if it isn't pinned: the one to focus when the focused pane goes.
(defn topmost-unpinned [(c (ptr Canvas))] (-> (ptr Pane))
  (if (and (> (count c) 0) (not (.pinned (pane c (- (count c) 1)))))
      (pane c (- (count c) 1))
      (no-pane)))

;;; Where CHOSEN is in the stack, or -1.
(defn stack-index [(c (ptr Canvas)) (chosen (ptr Pane))] (-> i64)
  (let [(mut found) -1]
    (for [i 0 (count c)]
      (when (= (p/cast i64 (pane c i)) (p/cast i64 chosen)) (set! found i)))
    (load found)))

;;; Take CHOSEN out of the stack, closing the gap. Its view stays where it is.
(defn unstack! [(c (ptr Canvas)) (chosen (ptr Pane))] (-> void)
  (let [found (stack-index c chosen)]
    (when (>= found 0)
      (for [i found (- (count c) 1)]
        (set! (mut (.panes c)) i (pane c (+ i 1))))
      (pop! [(ptr Pane)] (mut (.panes c)))
      0))
  (do))

;;; Put CHOSEN into the stack at INDEX, in front of those before it.
(defn stack-at! [(c (ptr Canvas)) (chosen (ptr Pane)) (index i64)] (-> void)
  (push! [(ptr Pane)] (mut (.panes c)) chosen)
  (let [(mut i) (- (count c) 1)]
    (while (> (load i) index)
      (set! (mut (.panes c)) (load i) (pane c (- (load i) 1)))
      (set! i (- (load i) 1)))
    (set! (mut (.panes c)) index chosen))
  (do))

;;; Lay the native views in the stack's order.
(defn restack! [(c (ptr Canvas))] (-> void)
  (for [i 0 (count c)]
    (msg i64
         (.view c)
         (sel c"addSubview:positioned:relativeTo:")
         [(ptr i8) i64 (ptr i8)]
         (.view (pane c i))
         1
         (nil)))
  (do))

;;; Bring CHOSEN to the front, unless it is pinned: pinned panes stay behind.
(defn raise! [(c (ptr Canvas)) (chosen (ptr Pane))] (-> void)
  (when (not (.pinned chosen))
    (unstack! c chosen)
    (push! [(ptr Pane)] (mut (.panes c)) chosen)
    (msg i64
         (.view c)
         (sel c"addSubview:positioned:relativeTo:")
         [(ptr i8) i64 (ptr i8)]
         (.view chosen)
         1
         (nil))
    0)
  (do))

;;; Raise and focus CHOSEN. A pinned pane takes neither.
(defn front! [(c (ptr Canvas)) (chosen (ptr Pane))] (-> void)
  (when (not (.pinned chosen))
    (raise! c chosen)
    (focus! c chosen))
  (do))

;;; After the panes Exposé spreads have changed: spread what is left, or close it when
;;; nothing is.
(defn respread! [(c (ptr Canvas))] (-> void)
  (when (.exposed c)
    (if (> (- (count c) (pinned-count c)) 0)
        (spread! c EXPOSE-TIME)
        (do
          (set! (.exposed c) false)
          (set! (.hovered c) (no-pane))
          (project! c))))
  (do))

;;; Let go of CHOSEN as the target of whatever the pointer is doing.
(defn release-pointer! [(c (ptr Canvas)) (chosen (ptr Pane))] (-> void)
  (when (= (p/cast i64 (.drag-pane c)) (p/cast i64 chosen))
    (set! (.gesture c) 0)
    (set! (.drag-pane c) (no-pane)))
  (when (= (p/cast i64 (.hovered c)) (p/cast i64 chosen))
    (set! (.hovered c) (no-pane)))
  (when (= (p/cast i64 (.click-pane c)) (p/cast i64 chosen))
    (set! (.click-pane c) (no-pane)))
  (do))

;;; Pin CHOSEN to the background, in front of the panes already pinned. The keyboard
;;; leaves it for the pane in front.
(defn pin! [(c (ptr Canvas)) (chosen (ptr Pane))] (-> void)
  (when (not (.pinned chosen))
    (release-pointer! c chosen)
    (unstack! c chosen)
    (stack-at! c chosen (pinned-count c))
    (set! (.pinned chosen) true)
    (restack! c)
    (chrome-shown! chosen false)
    (paint-pane! c chosen)
    (when (= (p/cast i64 (.focused c)) (p/cast i64 chosen))
      (focus! c (topmost-unpinned c)))
    (set! (.dirty c) true)
    (project! c)
    (respread! c))
  (do))

;;; Unpin CHOSEN, bringing it in front of every pane with its chrome back. The keyboard
;;; stays where it is, as in Jim.
(defn unpin! [(c (ptr Canvas)) (chosen (ptr Pane))] (-> void)
  (when (.pinned chosen)
    (set! (.pinned chosen) false)
    (chrome-shown! chosen true)
    (paint-pane! c chosen)
    (raise! c chosen)
    (set! (.dirty c) true)
    (project! c)
    (respread! c))
  (do))

(defn gradient! [(c (ptr Canvas))
                 (i i64)
                 (bounds Rect)
                 (start Point)
                 (end Point)
                 (intensity f64)] (-> void)
  (let [l (edge c i)
        cfg (.theme c)
        colors (msg (ptr i8) (class c"NSMutableArray") (sel c"array") [])]
    (do
      (msg i64
           colors
           (sel c"addObject:")
           [(ptr i8)]
           (msg (ptr i8)
                (color (.shadow-r cfg)
                       (.shadow-g cfg)
                       (.shadow-b cfg)
                       (* intensity (.edge-strength cfg)))
                (sel c"CGColor")
                []))
      (msg i64
           colors
           (sel c"addObject:")
           [(ptr i8)]
           (msg (ptr i8)
                (color (.shadow-r cfg) (.shadow-g cfg) (.shadow-b cfg) 0.0)
                (sel c"CGColor")
                []))
      (msg i64 l (sel c"setFrame:") [Rect] bounds)
      (msg i64 l (sel c"setStartPoint:") [Point] start)
      (msg i64 l (sel c"setEndPoint:") [Point] end)
      (msg i64 l (sel c"setColors:") [(ptr i8)] colors))))

(defn project! [(c (ptr Canvas))] (-> void)
  (let [w (.width c)
        h (.height c)
        cfg (.theme c)
        thick (.edge-width cfg)
        depths (model/edges (display-camera c) w h (.edge-distance cfg))
        display (display-camera c)
        scale (* (.scale c) (.zoom display))]
    (do
      (set! (.dirty c) true)
      (if (and (>= (.gesture c) 2) (!= (p/cast i64 (.drag-pane c)) 0))
          (set! (field (load (field c drag-pane)) bounds)
                (model/dragged-bounds display
                                      (.start-world c)
                                      (.pointer c)
                                      (.start-bounds c)
                                      (if (= (.gesture c) 3)
                                          (.resize-edges c)
                                          0)))
          0)
      (transaction! 0.0)
      (msg i64
           (class c"CATransaction")
           (sel c"setDisableActions:")
           [i8]
           (: 1 i8))
      (gradient! c
                 0
                 (rect 0.0 0.0 thick h)
                 (Point :x 0.0 :y 0.5)
                 (Point :x 1.0 :y 0.5)
                 (.left depths))
      (gradient! c
                 1
                 (rect (- w thick) 0.0 thick h)
                 (Point :x 1.0 :y 0.5)
                 (Point :x 0.0 :y 0.5)
                 (.right depths))
      (gradient! c
                 2
                 (rect 0.0 (- h thick) w thick)
                 (Point :x 0.5 :y 1.0)
                 (Point :x 0.5 :y 0.0)
                 (.top depths))
      (gradient! c
                 3
                 (rect 0.0 0.0 w thick)
                 (Point :x 0.5 :y 0.0)
                 (Point :x 0.5 :y 1.0)
                 (.bottom depths))
      (for [i 0 (count c)]
        (let [v (pane c i)
              world (.bounds v)
              ; Exposé leaves pinned panes where they are.
              spread (and (.exposed c) (not (.pinned v)))
              screen
                (if (or spread (.fitted c))
                    (.slot v)
                    (model/project display world))
              shown
                (or (.fitted c)
                    spread
                    (> (.returning-at c) 0.0)
                    (model/visible? screen w h))
              visible (and (.visible c) shown)]
          (do
            (frame! (.view v)
                    (rect (.x screen)
                          (- h (+ (.y screen) (.h screen)))
                          (.w screen)
                          (.h screen)))
            (msg i64
                 (.view v)
                 (sel c"setBoundsSize:")
                 [Size]
                 (Size :w (.w world) :h (.h world)))
            (frame-chrome! v (.w world) (.h world))
            (msg i64
                 (.view v)
                 (sel c"setHidden:")
                 [i8]
                 (p/cast i8 (if shown 0 1)))
            (if (and (not (widget? v))
                     (!= (p/cast i64 (.surface (term-of v))) 0))
                (g/ghostty_surface_set_occlusion (.surface (term-of v)) visible)
                (do))
            (if (or (< (.render-scale v) scale)
                    (> (.render-scale v) scale)
                    (< (.render-w v) (.w world))
                    (> (.render-w v) (.w world))
                    (< (.render-h v) (.h world))
                    (> (.render-h v) (.h world)))
                (do
                  (if (widget? v)
                      (widget-view/resize! (.widget v) (content-bounds world))
                      (terminal/resize! (term-of v)
                                        (content-bounds world)
                                        scale))
                  (set! (.render-scale v) scale)
                  (set! (.render-w v) (.w world))
                  (set! (.render-h v) (.h world)))
                0))))
      (commit!)
      (do))))

(defn apply-theme! [(c (ptr Canvas)) (cfg theme/Theme)] (-> void)
  (do
    (set! (.theme c) cfg)
    (for [i 0 (count c)]
      (paint-pane! c (pane c i)))
    (project! c)))

(defn create! [(parent (ptr i8)) (width f64) (height f64) (cfg theme/Theme)]
  (-> (ptr Canvas))
  (let [c (alloc/box! (alloc/malloc-allocator) Canvas (zeroed Canvas))]
    (do
      ; A 3D container, so panes can float off the project's face; the face's
      ; plate behind it carries the background.
      (set! (.view c)
            (layer-view parent (rect 0.0 0.0 width height) c"CATransformLayer"))
      (set! (.panes c)
            (al/ArrayList::new [(ptr Pane)] (alloc/malloc-allocator)))
      (set! (.camera c) (model/camera))
      (set! (.width c) width)
      (set! (.height c) height)
      (set! (.scale c) 1.0)
      (set! (.zoom-enabled c) true)
      (set! (.theme c) cfg)
      (set! (.directory c)
            (msg (ptr i8)
                 (msg (ptr i8)
                      (ns c"~")
                      (sel c"stringByExpandingTildeInPath")
                      [])
                 (sel c"retain")
                 []))
      (for [i 0 4]
        (let [l (msg (ptr i8) (class c"CAGradientLayer") (sel c"layer") [])]
          (do
            (set! (index (field c edges) i) l)
            (msg i64 l (sel c"setZPosition:") [f64] -1.0)
            (msg i64 (layer (.view c)) (sel c"addSublayer:") [(ptr i8)] l))))
      (apply-theme! c cfg)
      c)))

;;; ---- the pane's view -------------------------------------------------------------
;;; A pane's view knows its pane, so that a pinned one can let the pointer through.

(defn pane-key [] (-> (ptr i8))
  (p/alloc-static i8))

(defn pane-of-view [(view (ptr i8))] (-> (ptr Pane))
  (p/cast (ptr Pane) (objc_getAssociatedObject view (pane-key))))

(extern class_getMethodImplementation
        :cc
        (cc/C)
        [(ptr i8) (ptr i8)]
        (-> (fnptr (cc/C) [(ptr i8) (ptr i8) Point] (ptr i8))))

;;; NSView's hitTest:, except that a pinned pane isn't there for the pointer, which
;;; reaches whatever is behind it, unless it is over something its widget reacts to: an
;;; element that takes clicks, or a text field. PT is in the superview's coordinates.
(defn pane-hit-test [(self (ptr i8)) (cmd (ptr i8)) (pt Point)] (-> (ptr i8))
  (let [inherited (class_getMethodImplementation (class c"NSView") cmd)
        found (inherited self cmd pt)
        v (pane-of-view self)]
    (cond (or (= (p/cast i64 found) 0)
              (= (p/cast i64 v) 0)
              (not (.pinned v)))
            found
          (not (widget? v)) (nil)
          :else
            (let [content (.view (.widget v))]
              (cond (= (p/cast i64 found) (p/cast i64 content))
                      (if (widget-view/reacts-at? (.widget v)
                                                  (msg Point
                                                       content
                                                       (sel c"convertPoint:fromView:")
                                                       [Point (ptr i8)]
                                                       pt
                                                       (msg (ptr i8)
                                                            self
                                                            (sel c"superview")
                                                            [])))
                          found
                          (nil))
                    (!= (msg i8
                             found
                             (sel c"isDescendantOf:")
                             [(ptr i8)]
                             content)
                        (: 0 i8))
                      found
                    :else (nil))))))

(export-c [pane-hit-test :as "jim_pane_hit_test"])

(defn pane-view-class [] (-> (ptr i8))
  (let [existing (class c"JimPaneView")]
    (if (!= (p/cast i64 existing) 0)
        existing
        (let [cls (objc_allocateClassPair (class c"NSView") c"JimPaneView" 0)]
          (method! cls
                   c"hitTest:"
                   (p/cast (ptr i8) (fnptr-of pane-hit-test))
                   c"@@:{CGPoint=dd}")
          (objc_registerClassPair cls)
          cls))))

(defn new-pane [(c (ptr Canvas)) (bounds Rect)] (-> (ptr Pane))
  ; A pane opened during Exposé is laid out among the others, so the grid
  ; makes way for it.
  (when (.exposed c) (unexpose! c (no-pane)))
  (let [v (alloc/box! (alloc/malloc-allocator) Pane (zeroed Pane))]
    (set! (.next-id c) (+ (.next-id c) 1))
    (set! (.id v) (.next-id c))
    (set! (.view v)
          (class-layer-view (.view c)
                            (rect 0.0 0.0 (.w bounds) (.h bounds))
                            (pane-view-class)
                            c"CALayer"))
    (objc_setAssociatedObject (.view v) (pane-key) (p/cast (ptr i8) v) 0)
    (set! (.bounds v) bounds)
    v))

;;; Free pane V and its view, which forgets it first.
(defn destroy-pane! [(v (ptr Pane))] (-> void)
  (objc_setAssociatedObject (.view v) (pane-key) (nil) 0)
  (msg i64 (.view v) (sel c"removeFromSuperview") [])
  (alloc/destroy [Pane] (alloc/malloc-allocator) v)
  (do))

;;; Header, title and close button above the pane's content.
(defn attach-chrome! [(c (ptr Canvas)) (v (ptr Pane)) (title (ptr i8))]
  (-> void)
  (let [host (.view v)
        bounds (.bounds v)]
    (set! (.header v) (view host (rect 0.0 0.0 0.0 0.0)))
    (set! (.divider v) (view host (rect 0.0 0.0 0.0 0.0)))
    (set! (.title v) (label host c"Terminal" (rect 0.0 0.0 0.0 0.0) 12.0 false))
    (msg i64 (.title v) (sel c"setStringValue:") [(ptr i8)] title)
    (set! (.close v) (label host c"×" (rect 0.0 0.0 0.0 0.0) 15.0 true))
    (msg i64
         (.close v)
         (sel c"setFont:")
         [(ptr i8)]
         (msg (ptr i8)
              (class c"NSFont")
              (sel c"systemFontOfSize:weight:")
              [f64 f64]
              15.0
              -0.4))
    ; NSTextAlignmentCenter on arm64, the only architecture Jim is built for.
    (msg i64 (.close v) (sel c"setAlignment:") [i64] 1)
    (set! (.title-height v)
          (.h (msg Size (.title v) (sel c"fittingSize") [])))
    (set! (.close-height v)
          (.h (msg Size (.close v) (sel c"fittingSize") [])))
    (frame-chrome! v (.w bounds) (.h bounds))
    (msg i64 (layer host) (sel c"setCornerRadius:") [f64] 9.0)
    (msg i64 (layer host) (sel c"setMasksToBounds:") [i8] (: 1 i8))
    (push! [(ptr Pane)] (mut (.panes c)) v)
    (background! (.view v)
                 (.pane-r (.theme c))
                 (.pane-g (.theme c))
                 (.pane-b (.theme c)))
    (paint-header! c v false)))

(defn add-chrome! [(c (ptr Canvas)) (v (ptr Pane)) (title (ptr i8))] (-> void)
  (attach-chrome! c v title)
  (project! c)
  (focus! c v))

(defn session-pane! [(c (ptr Canvas))
                     (bounds Rect)
                     (session-id (ptr i8))
                     (directory (ptr i8))
                     (original i64)] (-> (ptr Pane))
  (let [v (new-pane c bounds)
        t
          (terminal/create! (.view v)
                            (content-bounds bounds)
                            (utf8 directory)
                            session-id
                            original)]
    (set! (.terminal v) t)
    (attach-chrome! c v (indexed-string c"Terminal " (.id v) c""))
    (set! (.message v)
          (label (.view v)
                 c"Session unavailable. Use Terminal: Reconnect in the action palette."
                 (rect 16.0 40.0 (- (.w bounds) 32.0) 48.0)
                 12.0
                 false))
    (msg i64
         (.message v)
         (sel c"setHidden:")
         [i8]
         (p/cast i8 (if (= (p/cast i64 (.surface t)) 0) 0 1)))
    v))

;;; A terminal pane for SESSION-ID whose shell starts in DIRECTORY, adopting the
;;; original Jim daemon ORIGINAL unless that is sessions/NOT-ORIGINAL.
(defn add-session-in! [(c (ptr Canvas))
                       (bounds Rect)
                       (session-id (ptr i8))
                       (directory (ptr i8))
                       (original i64)] (-> bool)
  (let [v (session-pane! c bounds session-id directory original)]
    (project! c)
    (focus! c v)
    true))

;;; A new terminal at BOUNDS that leaves the keyboard where it is.
(defn add-terminal-behind! [(c (ptr Canvas)) (bounds Rect) (directory (ptr i8))]
  (-> (ptr Pane))
  (let [v
          (session-pane! c
                         bounds
                         (sessions/identifier)
                         directory
                         sessions/NOT-ORIGINAL)]
    (set! (.dirty c) true)
    (project! c)
    v))

(defn add-session! [(c (ptr Canvas))
                    (bounds Rect)
                    (session-id (ptr i8))
                    (original i64)] (-> bool)
  (add-session-in! c bounds session-id (.directory c) original))

;;; Where panes may be added without overlapping any: past the rightmost pane, or at
;;; the origin of an empty canvas.
(defn right-edge [(c (ptr Canvas))] (-> f64)
  (let [(mut edge) 0.0]
    (for [i 0 (count c)]
      (let [r (.bounds (pane c i))]
        (when (> (+ (.x r) (.w r) 36.0) (load edge))
          (set! edge (+ (.x r) (.w r) 36.0))
          0)))
    (load edge)))

(defn bytes-of [(s (ptr i8))] (-> (slice u8))
  (let [bytes (utf8 s)]
    (slice::new (p/cast (ptr u8) bytes) (p/cast i64 (strlen bytes)))))

(defn widget-title [(v (ptr Pane))] (-> (ptr i8))
  (let [chosen (widget-view/title (.widget v))]
    (if (> (len chosen) 0)
        (widget-view/string chosen)
        (msg (ptr i8)
             (ns c"Widget · ")
             (sel c"stringByAppendingString:")
             [(ptr i8)]
             (widget-view/string (widget-view/name (.widget v)))))))

;;; A pane running SPEC, "NAME ARGS…" for widgets/NAME.coil. A widget that
;;; fails to load still gets its pane, which shows the diagnostic and loads the
;;; next saved edit.
(defn add-widget! [(c (ptr Canvas))
                   (bounds Rect)
                   (spec (ptr i8))
                   (state (ptr i8))] (-> bool)
  (let [v (new-pane c bounds)]
    (set! (.widget v)
          (widget-view/create! (.view v)
                               (content-bounds bounds)
                               (bytes-of spec)
                               (bytes-of (.directory c))
                               state))
    (widget-view/take-title-change! (.widget v))
    (add-chrome! c v (widget-title v))
    true))

;;; A widget pane at BOUNDS that leaves the keyboard where it is. For panes a
;;; widget places on its own, which may arrive while someone is typing elsewhere.
(defn add-widget-behind! [(c (ptr Canvas)) (bounds Rect) (spec (ptr i8))]
  (-> (ptr Pane))
  (let [v (new-pane c bounds)]
    (set! (.widget v)
          (widget-view/create! (.view v)
                               (content-bounds bounds)
                               (bytes-of spec)
                               (bytes-of (.directory c))
                               (nil)))
    (widget-view/take-title-change! (.widget v))
    (attach-chrome! c v (widget-title v))
    (set! (.dirty c) true)
    v))

;;; The pane with ID, or no-pane.
(defn pane-with-id [(c (ptr Canvas)) (id i64)] (-> (ptr Pane))
  (let [(mut found) (no-pane)]
    (for [i 0 (count c)]
      (when (= (.id (pane c i)) id) (set! found (pane c i))))
    (load found)))

;;; The widget pane running SPEC, or no-pane.
(defn widget-pane [(c (ptr Canvas)) (spec (slice u8))] (-> (ptr Pane))
  (let [(mut found) (no-pane)]
    (for [i 0 (count c)]
      (let [v (pane c i)]
        (when (and (widget? v) (widget-view/spec-is? (.widget v) spec))
          (set! found v)
          0)))
    (load found)))

;;; Put pane V at BOUNDS and show it there; project! resizes its content.
(defn place-pane! [(c (ptr Canvas)) (v (ptr Pane)) (bounds Rect)] (-> void)
  (set! (.bounds v) bounds)
  (set! (.dirty c) true)
  (project! c))

;;; A size a saved layout can restore.
(defn storable [(x f64) (y f64) (w f64) (h f64)] (-> Rect)
  (model/reachable (rect x
                         y
                         (model/clamp w 320.0 4096.0)
                         (model/clamp h 180.0 4096.0))))

;;; Bring the camera to V at full size, its corner a little inside the view, and
;;; raise and focus it unless it is pinned.
(defn reveal! [(c (ptr Canvas)) (v (ptr Pane))] (-> void)
  (set! (.camera c)
        (model/clamp-camera (model/Camera
                              :x (- (.x (.bounds v)) 32.0)
                              :y (- (.y (.bounds v)) 32.0)
                              :zoom 1.0)))
  (set! (.dirty c) true)
  (front! c v)
  (project! c))

(defn copy-to-clipboard! [(text (slice u8))] (-> void)
  (let [board
          (msg (ptr i8) (class c"NSPasteboard") (sel c"generalPasteboard") [])]
    (msg i64 board (sel c"clearContents") [])
    (msg i8
         board
         (sel c"setString:forType:")
         [(ptr i8) (ptr i8)]
         (widget-view/string text)
         (ns c"public.utf8-plain-text"))
    (do)))

(defn next-bounds [(c (ptr Canvas)) (width f64) (height f64)] (-> Rect)
  (let [camera (.camera c)
        offset (* (p/cast f64 (% (count c) 5)) 28.0)]
    (rect (+ (.x camera) (+ 36.0 offset))
          (+ (.y camera) (+ 36.0 offset))
          width
          height)))

(defn add-widget-visible! [(c (ptr Canvas)) (spec (ptr i8))] (-> bool)
  (add-widget! c (next-bounds c 760.0 600.0) spec (nil)))

;;; Carry out what a widget asked for while handling its events.
(defn serve-requests! [(c (ptr Canvas)) (v (ptr Pane))] (-> void)
  (let [w (.widget v)
        r (widget-view/requests w)
        count (len (.items r))
        (mut placed) false]
    (for [k 0 count]
      (let [item (get (.items r) k)
            text (api/request-text r item)
            kind (.kind item)]
        (cond (= kind api/OPEN-WIDGET)
                (do (add-widget-visible! c (widget-view/string text)) 0)
              (= kind api/OPEN-TERMINAL)
                (do
                  (add-session-in! c
                                   (next-bounds c 640.0 430.0)
                                   (sessions/identifier)
                                   (widget-view/string text)
                                   sessions/NOT-ORIGINAL)
                  0)
              (= kind api/OPEN-WIDGET-AT)
                (do
                  (add-widget-behind! c
                                      (storable (.x item)
                                                (.y item)
                                                (.w item)
                                                (.h item))
                                      (widget-view/string text))
                  (set! placed true)
                  0)
              (= kind api/MOVE-WIDGET)
                (let [target (widget-pane c text)]
                  (when (!= (p/cast i64 target) 0)
                    (place-pane! c
                                 target
                                 (storable (.x item)
                                           (.y item)
                                           (.w item)
                                           (.h item)))
                    0)
                  0)
              (= kind api/MOVE-SELF)
                (do
                  (place-pane! c
                               v
                               (storable (.x item)
                                         (.y item)
                                         (.w item)
                                         (.h item)))
                  0)
              (= kind api/CLOSE-WIDGET)
                (let [target (widget-pane c text)]
                  (when (and (!= (p/cast i64 target) 0)
                             (!= (p/cast i64 target) (p/cast i64 v)))
                    (close! c target)
                    0)
                  0)
              (= kind api/REVEAL-WIDGET)
                (let [target (widget-pane c text)]
                  (when (!= (p/cast i64 target) 0) (reveal! c target) 0)
                  0)
              (= kind api/FIT-CANVAS) (do (fit-within! c 1.0) 0)
              (= kind api/COPY-TEXT) (do (copy-to-clipboard! text) 0)
              (= kind api/CHOOSE-FILE) (do (widget-view/choose-file! w text) 0)
              (= kind api/CHOOSE-SAVE-PATH)
                (do
                  (widget-view/choose-save-path! w
                                                 text
                                                 (api/request-text2 r item))
                  0)
              (= kind api/SCROLL-TO)
                (do (widget-view/scroll-to! w (.value item)) 0)
              (= kind api/EMIT)
                (do
                  (widget-view/broadcast! w text (api/request-text2 r item))
                  0)
              :else 0)))
    (api/requests-clear! r)
    ; Panes placed behind are laid out together, once.
    (when (load placed) (project! c) 0)
    (when (widget-view/take-title-change! w)
      (msg i64 (.title v) (sel c"setStringValue:") [(ptr i8)] (widget-title v))
      0)
    ; Widget state is saved with the layout, so a state change dirties it.
    (when (widget-view/take-state-dirty! w) (set! (.dirty c) true) 0)
    (do)))

;;; Serve what this canvas's widgets asked for. Compiles, reloads and ticks for
;;; every widget happen once per pass in widget-view/maintain!.
(defn widgets-serve! [(c (ptr Canvas))] (-> void)
  ; Serving a request can add panes, which wait for the next pass, and close
  ; them, which shifts those after one onto indices already walked. A pane missed
  ; that way keeps its requests until then.
  (let [(mut remaining) (count c)
        (mut i) 0]
    (while (and (> (load remaining) 0) (< (load i) (count c)))
      (let [v (pane c (load i))]
        (when (widget? v) (serve-requests! c v) 0))
      (set! i (+ (load i) 1))
      (set! remaining (- (load remaining) 1))))
  (do))

(defn reconnect! [(c (ptr Canvas)) (v (ptr Pane))] (-> bool)
  (if (widget? v) false (reconnect-terminal! c v)))

(defn reconnect-terminal! [(c (ptr Canvas)) (v (ptr Pane))] (-> bool)
  (let [old (term-of v)
        bounds (.bounds v)
        t
          (terminal/create! (.view v)
                            (content-bounds bounds)
                            (utf8 (.directory old))
                            (.session-id old)
                            (.original old))]
    (if (= (p/cast i64 (.surface t)) 0)
        (do (terminal/free! t) false)
        (do
          (set! (.terminal v) t)
          (terminal/free! old)
          (msg i64 (.message v) (sel c"setHidden:") [i8] (: 1 i8))
          (set! (.render-scale v) 0.0)
          (project! c)
          (focus! c v)
          true))))

;;; The Ghostty surface of the terminal running session ID, if it's in this canvas.
(defn surface-of-session [(c (ptr Canvas)) (id (ptr i8))] (-> (ptr i8))
  (let [(mut found) (nil)]
    (for [i 0 (count c)]
      (let [v (pane c i)]
        (when (and (not (widget? v))
                   (!= (msg i8
                            (.session-id (term-of v))
                            (sel c"isEqualToString:")
                            [(ptr i8)]
                            id)
                       (: 0 i8)))
          (set! found (.surface (term-of v)))
          0)))
    (load found)))

(defn add! [(c (ptr Canvas)) (bounds Rect)] (-> bool)
  (add-session! c bounds (sessions/identifier) sessions/NOT-ORIGINAL))

(defn add-visible! [(c (ptr Canvas))] (-> bool)
  (let [camera (.camera c)
        offset (* (p/cast f64 (% (count c) 5)) 28.0)]
    (add! c
          (rect (+ (.x camera) (+ 36.0 offset))
                (+ (.y camera) (+ 36.0 offset))
                640.0
                430.0))))

;;; Closing a terminal pane ends its session; app shutdown only detaches.
(defn free-content! [(v (ptr Pane)) (closing bool)] (-> void)
  (if (widget? v)
      (widget-view/free! (.widget v))
      (do
        (when closing
          (sessions/kill! (.session-id (term-of v)) (.original (term-of v)))
          0)
        (terminal/free! (term-of v))))
  (do))

;;; Take CHOSEN off this canvas, leaving its view where it is. Closing another pane
;;; leaves the keyboard where it is; closing the focused one gives it to the pane in
;;; front. Exposé closes up the gap the pane leaves.
(defn detach! [(c (ptr Canvas)) (chosen (ptr Pane))] (-> void)
  (let [was-focused (= (p/cast i64 (.focused c)) (p/cast i64 chosen))]
    (release-pointer! c chosen)
    (unstack! c chosen)
    (when was-focused (focus! c (topmost-unpinned c)))
    (set! (.dirty c) true)
    (project! c)
    (respread! c))
  (do))

(defn close! [(c (ptr Canvas)) (chosen (ptr Pane))] (-> void)
  (when (>= (stack-index c chosen) 0)
    (detach! c chosen)
    (free-content! chosen true)
    (destroy-pane! chosen))
  (do))

;;; Move CHOSEN from canvas FROM to canvas TO, where it keeps its place on the canvas and
;;; whether it is pinned, and is given an id of TO's. Its terminal keeps its session.
(defn transfer! [(from (ptr Canvas)) (to (ptr Canvas)) (chosen (ptr Pane))]
  (-> void)
  (when (and (>= (stack-index from chosen) 0)
             (!= (p/cast i64 from) (p/cast i64 to)))
    (detach! from chosen)
    (when (.exposed to) (unexpose! to (no-pane)))
    (set! (.next-id to) (+ (.next-id to) 1))
    (set! (.id chosen) (.next-id to))
    (msg i64 (.view to) (sel c"addSubview:") [(ptr i8)] (.view chosen))
    (stack-at! to chosen (if (.pinned chosen) (pinned-count to) (count to)))
    (restack! to)
    ; Laid out afresh at TO's zoom.
    (set! (.render-scale chosen) 0.0)
    (paint-pane! to chosen)
    (set! (.dirty to) true)
    (project! to))
  (do))

(defn topmost-at [(c (ptr Canvas)) (world Point) (pinned bool)] (-> (ptr Pane))
  (let [(mut found) (no-pane)]
    (for [i 0 (count c)]
      (let [v (pane c i)]
        (when (and (= (.pinned v) pinned) (model/contains? (.bounds v) world))
          (set! found v))))
    (load found)))

;;; The pane the pointer acts on at WORLD: the topmost there, ignoring pinned panes,
;;; which it passes through.
(defn hit [(c (ptr Canvas)) (world Point)] (-> (ptr Pane))
  (topmost-at c world false))

;;; The pane a secondary click EVENT opens the menu of, or no-pane: a right click, or a
;;; Control-click as anywhere on macOS, on a pane's chrome or anywhere on a pinned pane.
;;; Never while Exposé is open or the pointer is busy.
(defn menu-pane [(c (ptr Canvas)) (event (ptr i8))] (-> (ptr Pane))
  (let [kind (msg i64 event (sel c"type") [])
        control
          (!= (& (msg u64 event (sel c"modifierFlags") []) 262144) (: 0 u64))
        screen (point c event)
        world (model/screen-to-world (display-camera c) screen)
        unpinned (hit c world)
        v (if (= (p/cast i64 unpinned) 0) (topmost-at c world true) unpinned)]
    (if (or (not (or (= kind 3) (and (= kind 1) control)))
            (.exposed c)
            (> (.gesture c) 0)
            (not (model/contains? (rect 0.0 0.0 (.width c) (.height c)) screen))
            (= (p/cast i64 v) 0))
        (no-pane)
        (let [r (.bounds v)]
          (if (model/opens-pane-menu? (.pinned v)
                                      (.w r)
                                      (.h r)
                                      (- (.x world) (.x r))
                                      (- (.y world) (.y r))
                                      (/ 6.0 (.zoom (display-camera c))))
              v
              (no-pane))))))

(defn home! [(c (ptr Canvas))] (-> void)
  (do (set! (.camera c) (model/camera)) (project! c)))

(defn fit! [(c (ptr Canvas))] (-> void)
  (fit-within! c 4.0))

;;; Show every pane, zooming in no further than LARGEST.
(defn fit-within! [(c (ptr Canvas)) (largest f64)] (-> void)
  (if (= (count c) 0)
      (home! c)
      (let [first (.bounds (pane c 0))
            (mut x) (.x first)
            (mut y) (.y first)
            (mut right) (+ (.x first) (.w first))
            (mut bottom) (+ (.y first) (.h first))]
        (do
          (for [i 1 (count c)]
            (let [r (.bounds (pane c i))]
              (do
                (if (< (.x r) (load x)) (set! x (.x r)) 0)
                (if (< (.y r) (load y)) (set! y (.y r)) 0)
                (if (> (+ (.x r) (.w r)) (load right))
                    (set! right (+ (.x r) (.w r)))
                    0)
                (if (> (+ (.y r) (.h r)) (load bottom))
                    (set! bottom (+ (.y r) (.h r)))
                    0))))
          (let [zx (/ (- (.width c) 64.0) (- (load right) (load x)))
                zy (/ (- (.height c) 64.0) (- (load bottom) (load y)))
                z (model/clamp (if (< zx zy) zx zy) 0.2 largest)]
            (set! (.camera c)
                  (model/clamp-camera (model/Camera
                                        :x (- (load x) (/ 32.0 z))
                                        :y (- (load y) (/ 32.0 z))
                                        :zoom z))))
          (project! c)))))

;;; Gesture capture is independent of the pane under the current pointer.
;;; Dragging beyond the viewport therefore neither loses a pane nor types into
;;; a terminal. Ordinary wheel events inside a terminal remain terminal scroll.
(defn handle! [(c (ptr Canvas)) (event (ptr i8))] (-> bool)
  (if (.exposed c)
      (do (clear-resize-cursor!) (expose-handle! c event))
      (handle-panes! c event)))

;;; ---- resize cursor ----------------------------------------------------------------
;;; Like Jim: a double-headed cursor over the band a press would resize from. One app
;;; has one cursor, whichever canvas set it, so what it shows is kept here.
(defn cursor-edges-cell [] (-> (ptr i64))
  (p/alloc-static i64))

(defn show-resize-cursor! [(edges i64)] (-> void)
  (when (!= edges (load (cursor-edges-cell)))
    (set! (cursor-edges-cell) edges)
    (msg i64
         (if (= edges 0)
             (msg (ptr i8) (class c"NSCursor") (sel c"arrowCursor") [])
             (msg (ptr i8)
                  (class c"NSCursor")
                  (sel c"frameResizeCursorFromPosition:inDirections:")
                  [u64 u64]
                  (model/cursor-position edges)
                  (: 3 u64)))
         (sel c"set")
         [])
    0)
  (do))

(defn clear-resize-cursor! [] (-> void)
  (show-resize-cursor! 0))

;;; The edges a press at WORLD would resize, by the same rules as the press.
(defn edges-under [(c (ptr Canvas)) (world Point)] (-> i64)
  (let [v (hit c world)]
    (if (or (.space-held c) (= (p/cast i64 v) 0))
        0
        (let [r (.bounds v)
              local-x (- (.x world) (.x r))
              local-y (- (.y world) (.y r))]
          (if (model/on-close? (.w r) local-x local-y)
              0
              (model/edges-at (.w r)
                              (.h r)
                              local-x
                              local-y
                              (/ 6.0 (.zoom (display-camera c)))))))))

(defn hover! [(c (ptr Canvas)) (event (ptr i8))] (-> void)
  (when (= (.gesture c) 0)
    (let [screen (point c event)]
      (show-resize-cursor! (if (model/contains? (rect 0.0
                                                      0.0
                                                      (.width c)
                                                      (.height c))
                                                screen)
                               (edges-under c
                                            (model/screen-to-world (display-camera c)
                                                                   screen))
                               0))
      0))
  (do))

(defn handle-panes! [(c (ptr Canvas)) (event (ptr i8))] (-> bool)
  (let [kind (msg i64 event (sel c"type") [])
        flags (msg u64 event (sel c"modifierFlags") [])
        relevant
          (or (= kind 1)
              (= kind 2)
              (= kind 6)
              (= kind 25)
              (= kind 26)
              (= kind 27)
              (= kind 22)
              (= kind 30))]
    (if (or (= kind 10) (= kind 11))
        (do
          (if (= (msg u16 event (sel c"keyCode") []) (: 49 u16))
              (set! (.space-held c) (= kind 10))
              0)
          false)
        (if (not relevant)
            (do (when (= kind 5) (hover! c event) 0) false)
            (let [screen (point c event)
                  world (model/screen-to-world (display-camera c) screen)
                  v (hit c world)
                  inside
                    (model/contains? (rect 0.0 0.0 (.width c) (.height c))
                                     screen)
                  alt (!= (& flags 524288) (: 0 u64))
                  command (!= (& flags 1048576) (: 0 u64))]
              (do
                (set! (.pointer c) screen)
                (cond (and (or (= kind 6) (= kind 27)) (> (.gesture c) 0))
                        (do
                          (if (= (.gesture c) 1)
                              (do
                                (set! (.camera c)
                                      (model/pan-by (.camera c)
                                                    (- (.x screen)
                                                       (.x (.start c)))
                                                    (- (.y screen)
                                                       (.y (.start c)))))
                                (set! (.start c) screen))
                              0)
                          (project! c)
                          true)
                      (and (or (= kind 2) (= kind 26)) (> (.gesture c) 0))
                        (do
                          (set! (.gesture c) 0)
                          (set! (.drag-pane c) (no-pane))
                          true)
                      (not inside) false
                      (or (= kind 1) (= kind 25))
                        (do
                          (set! (.start c) screen)
                          (set! (.start-world c) world)
                          (cond (or (.space-held c)
                                    (and (= kind 25)
                                         (= (msg i64
                                                 event
                                                 (sel c"buttonNumber")
                                                 [])
                                            2)))
                                  (do (set! (.gesture c) 1) true)
                                (= (p/cast i64 v) 0) false
                                :else
                                  (let [r (.bounds v)
                                        local-x (- (.x world) (.x r))
                                        local-y (- (.y world) (.y r))]
                                    (do
                                      (front! c v)
                                      (let [now (animation/animation-now)
                                            dx
                                              (- (.x screen)
                                                 (.x (.click-point c)))
                                            dy
                                              (- (.y screen)
                                                 (.y (.click-point c)))]
                                        (if (and (= (p/cast i64 (.click-pane c))
                                                    (p/cast i64 v))
                                                 (and (< (- now (.last-click c))
                                                         0.5)
                                                      (< (+ (* dx dx) (* dy dy))
                                                         64.0)))
                                            (do
                                              (set! (.last-click c) 0.0)
                                              (if (or (< (.zoom (.camera c))
                                                         0.999)
                                                      (> (.zoom (.camera c))
                                                         1.001))
                                                  (do
                                                    (set! (.camera c)
                                                          (model/jump-to-pane r))
                                                    (project! c))
                                                  (do)))
                                            (do
                                              (set! (.last-click c) now)
                                              (set! (.click-point c) screen)
                                              (set! (.click-pane c) v)
                                              (do))))
                                      (set! (.start-world c)
                                            (model/screen-to-world (display-camera c)
                                                                   screen))
                                      (set! (.start-bounds c) r)
                                      (set! (.drag-pane c) v)
                                      ; Like Jim: the close button, then a
                                      ; 6 point band along every edge (two
                                      ; at a corner), then the header.
                                      (let [edges
                                              (model/edges-at (.w r)
                                                              (.h r)
                                                              local-x
                                                              local-y
                                                              (/ 6.0
                                                                 (.zoom (display-camera c))))]
                                        (cond (model/on-close? (.w r)
                                                               local-x
                                                               local-y)
                                                (do
                                                  (set! (.drag-pane c)
                                                        (no-pane))
                                                  (close! c v)
                                                  true)
                                              (!= edges 0)
                                                (do
                                                  (set! (.resize-edges c) edges)
                                                  (set! (.gesture c) 3)
                                                  true)
                                              (model/in-header? local-y)
                                                (do
                                                  (set! (.gesture c) 2)
                                                  true)
                                              :else false))))))
                      (= kind 30)
                        (if (.zoom-enabled c)
                            (do
                              (set! (.camera c)
                                    (model/zoom-at (.camera c)
                                                   screen
                                                   (model/pinch-factor (msg f64
                                                                            event
                                                                            (sel c"magnification")
                                                                            []))))
                              (project! c)
                              true)
                            false)
                      (= kind 22)
                        (let [scale
                                (model/wheel-scale (!= (msg i8
                                                            event
                                                            (sel c"hasPreciseScrollingDeltas")
                                                            [])
                                                       (: 0 i8))
                                                   (.scale c))
                              dx
                                (* (msg f64 event (sel c"scrollingDeltaX") [])
                                   scale)
                              dy
                                (* (msg f64 event (sel c"scrollingDeltaY") [])
                                   scale)
                              route
                                (model/wheel-route command
                                                   alt
                                                   (.zoom-enabled c))]
                          (cond (= route 2)
                                  (do
                                    (set! (.camera c)
                                          (model/zoom-at (.camera c)
                                                         screen
                                                         (model/wheel-factor dy)))
                                    (project! c)
                                    true)
                                (= route 1)
                                  (do
                                    (set! (.camera c)
                                          (model/pan-by (.camera c) dx dy))
                                    (project! c)
                                    true)
                                :else false))
                      :else false)))))))

(defn resize! [(c (ptr Canvas)) (width f64) (height f64) (scale f64)] (-> void)
  (do
    (set! (.width c) width)
    (set! (.height c) height)
    (set! (.scale c) scale)
    (frame! (.view c) (rect 0.0 0.0 width height))
    (project! c)
    (when (.exposed c) (spread! c 0.0))))

;;; The bounding box of every pane, in canvas units.
(defn extent [(c (ptr Canvas))] (-> Rect)
  (let [first (.bounds (pane c 0))
        (mut left) (.x first)
        (mut top) (.y first)
        (mut right) (+ (.x first) (.w first))
        (mut bottom) (+ (.y first) (.h first))]
    (for [i 1 (count c)]
      (let [r (.bounds (pane c i))]
        (when (< (.x r) (load left)) (set! left (.x r)))
        (when (< (.y r) (load top)) (set! top (.y r)))
        (when (> (+ (.x r) (.w r)) (load right)) (set! right (+ (.x r) (.w r))))
        (when (> (+ (.y r) (.h r)) (load bottom))
          (set! bottom (+ (.y r) (.h r))))))
    (rect (load left)
          (load top)
          (- (load right) (load left))
          (- (load bottom) (load top)))))

;;; The layer transform that carries a pane from where the canvas lays it out
;;; (its view's FRAME, around the layer's POSITION) to TARGET, LIFT points off
;;; the canvas. Both rects are in the canvas view's coordinates.
(defn carry [(frame Rect) (position Point) (target Rect) (lift f64)]
  (-> Transform)
  (let [scale (/ (.w target) (.w frame))]
    (CATransform3DScale (CATransform3DMakeTranslation (- (.x target)
                                                         (.x position)
                                                         (* scale
                                                            (- (.x frame)
                                                               (.x position))))
                                                      (- (.y target)
                                                         (.y position)
                                                         (* scale
                                                            (- (.y frame)
                                                               (.y position))))
                                                      lift)
                        scale
                        scale
                        1.0)))

;;; The transform that carries pane V from its frame onto TARGET, LIFT
;;; points off the canvas. A zoomed pane's layer is as big as its bounds, and
;;; AppKit shrinks it onto the frame with the layer's own transform, so the
;;; carry starts from that scale. The layer's position is worked out from the
;;; frame too: AppKit updates a view's layer only on its next layout, so just
;;; after a frame change the layer still says where the view was.
(defn carry-pane [(v (ptr Pane)) (target Rect) (lift f64)] (-> Transform)
  (let [frame (msg Rect (.view v) (sel c"frame") [])
        bounds (msg Rect (.view v) (sel c"bounds") [])
        fit (/ (.w frame) (max (.w bounds) 1.0))]
    (CATransform3DConcat (CATransform3DMakeScale fit fit 1.0)
                         (carry frame (pivot v) target lift))))

;;; Where pane V's layer is positioned, worked out from the view's frame.
(defn pivot [(v (ptr Pane))] (-> Point)
  (let [frame (msg Rect (.view v) (sel c"frame") [])
        anchor (msg Point (layer (.view v)) (sel c"anchorPoint") [])]
    (Point
      :x (+ (.x frame) (* (.x anchor) (.w frame)))
      :y (+ (.y frame) (* (.y anchor) (.h frame))))))

;;; Where a pane's layer was positioned and the transform it was shown with,
;;; so a pane given a new frame can start out exactly where it was seen.
(defstruct Seen [(at Point) (shown Transform)])

(defn seen [(c (ptr Canvas))] (-> (al/ArrayList Seen))
  (let [(mut all) (al/ArrayList::new [Seen] (alloc/malloc-allocator))]
    (for [i 0 (count c)]
      (let [l (layer (.view (pane c i)))
            shown (msg (ptr i8) l (sel c"presentationLayer") [])]
        (push! (mut all)
               (Seen
                 :at (pivot (pane c i))
                 :shown
                   (msg Transform
                        (if (= (p/cast i64 shown) 0) l shown)
                        (sel c"transform")
                        [])))))
    all))

;;; The transform that shows pane V, from its frame now, where it was SEEN.
(defn seen-from [(v (ptr Pane)) (was Seen)] (-> Transform)
  (let [at (pivot v)]
    (CATransform3DConcat (.shown was)
                         (CATransform3DMakeTranslation (- (.x (.at was))
                                                          (.x at))
                                                       (- (.y (.at was))
                                                          (.y at))
                                                       0.0))))

;;; Move every pane over DURATION from where it was SEEN to its frame now,
;;; LIFT points off the canvas plus STEP per place in the stack, and grown
;;; by HOVER-LIFT if hovered. Each starts DELAY later than the one before.
;;; Panes are moved by their frames, so AppKit draws them wherever they land;
;;; their transforms only carry them on the way.
(defn glide! [(c (ptr Canvas))
              (was (al/ArrayList Seen))
              (duration f64)
              (delay f64)
              (lift f64)
              (step f64)] (-> void)
  (for [i 0 (count c)]
    (let [v (pane c i)
          frame (msg Rect (.view v) (sel c"frame") [])
          grow (if (= (p/cast i64 v) (p/cast i64 (.hovered c))) HOVER-LIFT 1.0)
          ; Pinned panes lie on the face, as in Jim's cube.
          off (if (.pinned v) 0.0 (+ lift (* step (p/cast f64 i))))]
      (tween! (layer (.view v))
              (seen-from v (get was i))
              (carry-pane v
                          (rect (- (.x frame) (* 0.5 (.w frame) (- grow 1.0)))
                                (- (.y frame) (* 0.5 (.h frame) (- grow 1.0)))
                                (* (.w frame) grow)
                                (* (.h frame) grow))
                          off)
              duration
              (ease-out-cubic)
              (* delay (p/cast f64 i)))))
  (do))

;;; Pane V's transform at rest, lying on its frame.
(defn rest [(v (ptr Pane))] (-> Transform)
  (carry-pane v (msg Rect (.view v) (sel c"frame") []) 0.0))

;;; Lay the panes out for the cube, as Jim does. When FIT, the whole layout is
;;; scaled to fill 80% of the face and centered, whatever the camera shows, and
;;; each pane floats LIFT points off the face plus STEP per place in the stack.
;;; Otherwise the panes lie flat where the camera puts them. Animates over
;;; DURATION.
(defn cube-pose! [(c (ptr Canvas))
                  (fit bool)
                  (lift f64)
                  (step f64)
                  (duration f64)] (-> void)
  (let [(mut was) (seen c)]
    ; The cube lays the panes out itself.
    (set! (.exposed c) false)
    (set! (.hovered c) (no-pane))
    (set! (.returning-at c) 0.0)
    (set! (.fitted c) fit)
    (when (and fit (> (count c) 0))
      (let [box (extent c)
            k
              (min (/ (* (.width c) 0.8) (max (.w box) 1.0))
                   (/ (* (.height c) 0.8) (max (.h box) 1.0)))
            cx (+ (.x box) (* (.w box) 0.5))
            cy (+ (.y box) (* (.h box) 0.5))]
        (for [i 0 (count c)]
          (let [v (pane c i)
                r (.bounds v)]
            (set! (.slot v)
                  (rect (+ (* (.width c) 0.5) (* (- (.x r) cx) k))
                        (+ (* (.height c) 0.5) (* (- (.y r) cy) k))
                        (* (.w r) k)
                        (* (.h r) k)))))))
    (project! c)
    (if fit
        (glide! c was duration 0.0 lift step)
        (glide! c was duration 0.0 0.0 0.0))
    (free! (mut was)))
  (do))

(defn visibility! [(c (ptr Canvas)) (visible bool)] (-> void)
  ; A project put away closes its Exposé at once.
  (let [closing (and (not visible) (.exposed c))]
    (when closing
      (set! (.exposed c) false)
      (set! (.hovered c) (no-pane)))
    (set! (.returning-at c) 0.0)
    (set! (.visible c) visible)
    (project! c)
    (when closing
      (for [i 0 (count c)]
        (transform! (layer (.view (pane c i))) (rest (pane c i)) 0.0))))
  (do))

;;; Exposé, after Jim's ⌘⇧E. It spreads over EXPOSE-TIME with a cascade of
;;; EXPOSE-STAGGER per pane; the hovered pane grows by HOVER-LIFT.
(const EXPOSE-TIME 0.3)

(const EXPOSE-STAGGER 0.01)

(const HOVER-LIFT 1.07)

(const HOVER-TIME 0.14)

;;; The transform that grows pane V by LIFT about the center of its frame.
(defn lifted [(v (ptr Pane)) (lift f64)] (-> Transform)
  (let [frame (msg Rect (.view v) (sel c"frame") [])
        grow (- lift 1.0)]
    (carry-pane v
                (rect (- (.x frame) (* 0.5 (.w frame) grow))
                      (- (.y frame) (* 0.5 (.h frame) grow))
                      (* (.w frame) lift)
                      (* (.h frame) lift))
                0.0)))

;;; Grow pane V by LIFT over DURATION, from wherever it is shown now.
(defn lift! [(v (ptr Pane)) (lift f64) (duration f64)] (-> void)
  (eased-transform! (layer (.view v))
                    (lifted v lift)
                    duration
                    (ease-out-cubic)
                    0.0)
  (do))

;;; Lay every pane out in Exposé's grid over DURATION.
(defn spread! [(c (ptr Canvas)) (duration f64)] (-> void)
  ; Pinned panes stay where they are, behind the spread: the first PINNED of the stack.
  (let [pinned (pinned-count c)
        n (- (count c) pinned)
        display (display-camera c)
        region
          (rect model/EXPOSE-PAD
                model/EXPOSE-PAD
                (max (- (.width c) (* 2.0 model/EXPOSE-PAD)) 1.0)
                (max (- (.height c) (* 2.0 model/EXPOSE-PAD)) 1.0))
        grid (model/expose-grid n (.w region) (.h region))
        stagger (if (> duration 0.0) EXPOSE-STAGGER 0.0)
        (mut was) (seen c)
        (mut centers) (al/ArrayList::new [Point] (alloc/malloc-allocator))]
    (for [i 0 n]
      (let [r (model/project display (.bounds (pane c (+ pinned i))))]
        (push! (mut centers)
               (Point :x (+ (.x r) (* 0.5 (.w r))) :y (+ (.y r) (* 0.5 (.h r)))))))
    (let [(mut cells) (model/expose-cells (slice centers) grid)]
      (for [i 0 n]
        (let [v (pane c (+ pinned i))
              screen (model/project display (.bounds v))]
          (set! (.slot v)
                (model/expose-slot grid
                                   region
                                   (get cells i)
                                   (.w screen)
                                   (.h screen)))))
      (free! (mut cells)))
    (project! c)
    (glide! c was duration stagger 0.0 0.0)
    (free! (mut was))
    (free! (mut centers))
    (set! (.exposed-at c)
          ; glide! staggers by place in the whole stack.
          (+ (animation/animation-now)
             duration
             (* stagger (p/cast f64 (count c)))))
    (do)))

;;; Spread the panes out, every one shown where it can be seen at once.
(defn expose! [(c (ptr Canvas))] (-> void)
  (when (and (not (.exposed c)) (> (count c) (pinned-count c)))
    (set! (.exposed c) true)
    (set! (.hovered c) (no-pane))
    (set! (.returning-at c) 0.0)
    (set! (.gesture c) 0)
    (set! (.drag-pane c) (no-pane))
    (spread! c EXPOSE-TIME))
  (do))

;;; Bring the panes home. CHOSEN, when set, is focused and brought to the
;;; front; the camera moves only if none of it would be in view at home.
(defn unexpose! [(c (ptr Canvas)) (chosen (ptr Pane))] (-> void)
  (when (.exposed c)
    (let [(mut was) (seen c)]
      (set! (.exposed c) false)
      (set! (.hovered c) (no-pane))
      (set! (.returning-at c) (+ (animation/animation-now) EXPOSE-TIME))
      (when (!= (p/cast i64 chosen) 0)
        (let [home (model/project (display-camera c) (.bounds chosen))]
          (when (not (model/visible? home (.width c) (.height c)))
            (set! (.camera c)
                  (model/clamp-camera (model/Camera
                                        :x (- (.x (.bounds chosen)) 24.0)
                                        :y (- (.y (.bounds chosen)) 24.0)
                                        :zoom (.zoom (.camera c)))))
            0)))
      (project! c)
      (glide! c was EXPOSE-TIME 0.0 0.0 0.0)
      (free! (mut was))
      ; Raised after the glide is set up, since raising reorders the panes.
      (when (!= (p/cast i64 chosen) 0) (front! c chosen))))
  (do))

(defn toggle-expose! [(c (ptr Canvas))] (-> void)
  (if (.exposed c) (unexpose! c (no-pane)) (expose! c)))

;;; The topmost pane whose Exposé slot holds the top-down point PT.
(defn expose-hit [(c (ptr Canvas)) (pt Point)] (-> (ptr Pane))
  (let [(mut found) (no-pane)]
    (for [i 0 (count c)]
      (let [v (pane c i)]
        (when (and (not (.pinned v)) (model/contains? (.slot v) pt))
          (set! found v))))
    (load found)))

;;; Lift the pane under PT, once the spread has settled. The hovered pane
;;; takes the focus as well, as in Jim, so the header marks it.
(defn expose-hover! [(c (ptr Canvas)) (pt Point)] (-> void)
  (when (>= (animation/animation-now) (.exposed-at c))
    (let [v (expose-hit c pt)
          old (.hovered c)]
      (when (!= (p/cast i64 v) (p/cast i64 old))
        (when (!= (p/cast i64 old) 0)
          (lift! old 1.0 HOVER-TIME))
        (set! (.hovered c) v)
        (when (!= (p/cast i64 v) 0)
          (lift! v HOVER-LIFT HOVER-TIME)
          (focus! c v)))))
  (do))

;;; The pointer now, in the canvas's top-down coordinates.
(defn mouse [(c (ptr Canvas))] (-> Point)
  (let [window (msg (ptr i8) (.view c) (sel c"window") [])
        pt
          (msg Point
               (.view c)
               (sel c"convertPoint:fromView:")
               [Point (ptr i8)]
               (msg Point window (sel c"mouseLocationOutsideOfEventStream") [])
               (nil))]
    (Point :x (.x pt) :y (- (.height c) (.y pt)))))

;;; Finish Exposé's animations: hover what the pointer rests on once the
;;; spread settles, and hide panes out of view once they are home.
(defn settle-expose! [(c (ptr Canvas)) (now f64)] (-> void)
  (when (and (.exposed c) (> (.exposed-at c) 0.0) (>= now (.exposed-at c)))
    (set! (.exposed-at c) 0.0)
    (expose-hover! c (mouse c)))
  (when (and (> (.returning-at c) 0.0) (>= now (.returning-at c)))
    (set! (.returning-at c) 0.0)
    (project! c))
  (do))

;;; While Exposé is open it owns the pointer: a click picks the pane under
;;; it and Esc closes. Keys with ⌘ still reach the app's shortcuts; other
;;; keys go nowhere.
(defn expose-handle! [(c (ptr Canvas)) (event (ptr i8))] (-> bool)
  (let [kind (msg i64 event (sel c"type") [])
        command
          (!= (& (msg u64 event (sel c"modifierFlags") []) 1048576) (: 0 u64))]
    (cond (= kind 10)
            (cond (= (msg u16 event (sel c"keyCode") []) (: 53 u16))
                    (do (unexpose! c (no-pane)) true)
                  command false
                  :else true)
          (= kind 11) (not command)
          (= kind 1)
            (let [v (expose-hit c (point c event))]
              (when (!= (p/cast i64 v) 0) (unexpose! c v))
              true)
          (or (= kind 5) (= kind 6)) (do (expose-hover! c (point c event)) true)
          (or (= kind 2)
              (= kind 3)
              (= kind 4)
              (= kind 7)
              (= kind 22)
              (= kind 25)
              (= kind 26)
              (= kind 27)
              (= kind 29)
              (= kind 30)
              (= kind 31)
              (= kind 32))
            true
          :else false)))

(defn free! [(c (ptr Canvas))] (-> void)
  (do
    (for [i 0 (count c)]
      (let [v (pane c i)]
        (do
          (free-content! v false)
          (destroy-pane! v))))
    (al/ArrayList::free! (mut (.panes c)))
    (release (.directory c))
    (msg i64 (.view c) (sel c"removeFromSuperview") [])
    (alloc/destroy [Canvas] (alloc/malloc-allocator) c)))

(defn snapshot [(c (ptr Canvas))] (-> (ptr i8))
  (let [dict (storage/dictionary)
        panes (storage/array)]
    (do
      (storage/put! dict c"x" (storage/number (.x (.camera c))))
      (storage/put! dict c"y" (storage/number (.y (.camera c))))
      (storage/put! dict c"zoom" (storage/number (.zoom (.camera c))))
      (for [i 0 (count c)]
        (let [v (pane c i)
              r (.bounds v)
              item (storage/dictionary)]
          (do
            (storage/put! item c"x" (storage/number (.x r)))
            (storage/put! item c"y" (storage/number (.y r)))
            (if (widget? v)
                (let [state (widget-view/state-array (.widget v))]
                  (storage/put! item
                                c"widget"
                                (widget-view/spec-string (.widget v)))
                  (when (!= (p/cast i64 state) 0)
                    (storage/put! item c"state" state)
                    0)
                  0)
                (do
                  (storage/put! item c"session" (.session-id (term-of v)))
                  (when (!= (.original (term-of v)) sessions/NOT-ORIGINAL)
                    (storage/put! item
                                  c"original"
                                  (storage/number (p/cast f64
                                                          (.original (term-of v)))))
                    0)
                  0))
            (storage/put! item c"width" (storage/number (.w r)))
            (storage/put! item c"height" (storage/number (.h r)))
            (when (.pinned v)
              (storage/put! item c"pinned" (storage/flag true))
              0)
            (storage/add! panes item)
            (if (= (p/cast i64 v) (p/cast i64 (.focused c)))
                (storage/put! dict c"focused" (storage/number (p/cast f64 i)))
                0))))
      (storage/put! dict c"panes" panes)
      dict)))

(defn restorable? [(dict (ptr i8))] (-> bool)
  (let [panes (storage/get dict c"panes")
        (mut valid)
          (and (storage/kind? panes c"NSArray")
               (and (storage/numeric? dict c"zoom")
                    (and (theme/bounded? (storage/value dict c"x")
                                         0.0
                                         1000000000.0)
                         (and (theme/bounded? (storage/value dict c"y")
                                              0.0
                                              1000000000.0)
                              (theme/bounded? (storage/value dict c"zoom")
                                              0.2
                                              4.0)))))]
    (do
      (for [i 0 (storage/count panes)]
        (let [r (storage/at panes i)]
          (if (not (and (theme/bounded? (storage/value r c"x")
                                        -1000000000.0
                                        1000000000.0)
                        (and (theme/bounded? (storage/value r c"y")
                                             -1000000000.0
                                             1000000000.0)
                             (and (theme/bounded? (storage/value r c"width")
                                                  320.0
                                                  4096.0)
                                  (theme/bounded? (storage/value r c"height")
                                                  180.0
                                                  4096.0)))))
              (set! valid false)
              0)))
      (load valid))))

(defn restore! [(c (ptr Canvas)) (dict (ptr i8))] (-> bool)
  (if (not (restorable? dict))
      false
      (let [panes (storage/get dict c"panes")
            (mut ok) true]
        (do
          (set! (.camera c)
                (model/Camera
                  :x (storage/value dict c"x")
                  :y (storage/value dict c"y")
                  :zoom (storage/value dict c"zoom")))
          (for [i 0 (storage/count panes)]
            (let [r (storage/at panes i)
                  added (count c)]
              (if (not (let [; Layouts saved before drags were kept in reach
                             ; may hold panes the camera cannot pan to.
                             bounds
                               (model/reachable (rect (storage/value r c"x")
                                                      (storage/value r c"y")
                                                      (storage/value r c"width")
                                                      (storage/value r
                                                                     c"height")))
                             widget (storage/get r c"widget")]
                         (if (storage/kind? widget c"NSString")
                             (add-widget! c
                                          bounds
                                          widget
                                          (storage/get r c"state"))
                             (add-session! c
                                           bounds
                                           (let [id (storage/get r c"session")]
                                             (if (and (storage/kind? id
                                                                     c"NSString")
                                                      (sessions/valid-id? id))
                                                 id
                                                 (sessions/identifier)))
                                           (if (storage/numeric? r c"original")
                                               (p/cast i64
                                                       (storage/value r
                                                                      c"original"))
                                               sessions/NOT-ORIGINAL)))))
                  (set! ok false)
                  0)
              ; Saved in stack order, so pinning each in turn keeps their order.
              (when (and (> (count c) added) (storage/flag? r c"pinned"))
                (pin! c (pane c added))
                0)))
          (let [focused (storage/value dict c"focused")]
            (when (and (>= focused 0.0)
                       (< focused (p/cast f64 (count c)))
                       (not (.pinned (pane c (p/cast i64 focused)))))
              (set! (.focused c) (pane c (p/cast i64 focused)))
              0))
          (load ok)))))

(defn zoom-key! [(c (ptr Canvas)) (factor f64)] (-> void)
  (if (.zoom-enabled c)
      (let [window (msg (ptr i8) (.view c) (sel c"window") [])
            root (msg (ptr i8) window (sel c"contentView") [])
            bounds (msg Rect root (sel c"bounds") [])
            center
              (msg Point
                   (.view c)
                   (sel c"convertPoint:fromView:")
                   [Point (ptr i8)]
                   (Point :x (* (.w bounds) 0.5) :y (* (.h bounds) 0.5))
                   root)]
        (do
          (set! (.camera c)
                (model/zoom-at (.camera c)
                               (Point
                                 :x (.x center)
                                 :y (- (.height c) (.y center)))
                               factor))
          (project! c)))
      (do)))

(defn reset-zoom! [(c (ptr Canvas))] (-> void)
  (do (set! (.camera c) (model/reset-zoom (.camera c))) (project! c)))
