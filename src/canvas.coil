(module jim.canvas)
(import "jim.native" :use *)
(import "jim.terminal" :as terminal)
(import "jim.widget-view" :as widget-view)
(import "jim.widget-api" :as api)
(import "jim.ghostty" :as g)
(import "jim.theme" :as theme)
(import "jim.storage" :as storage)
(import "jim.sessions" :as sessions)
(import "jim.animation" :as animation)
(import "jim.canvas-model" :as model)
(import "coil.math" :use [Float])
(import "coil.primitive" :as p)
(import "coil.alloc" :as alloc)
(import "coil.arraylist" :as al)

(defstruct Pane
  [(id i64)
   (view (ptr i8))
   (title (ptr i8))
   (header (ptr i8))
   (message (ptr i8))
   (close (ptr i8))
   (terminal (ptr terminal/Terminal))
   ;; Exactly one of terminal and widget is set.
   (widget (ptr widget-view/WidgetPane))
   (bounds Rect)
   ;; Where Exposé shows the pane, in the canvas view's top-down coordinates.
   (slot Rect)
   (render-scale f64)
   (render-w f64)
   (render-h f64)])

(defstruct Canvas
  [(view (ptr i8))
   (directory (ptr i8))
   (panes (al/ArrayList (ptr Pane)))
   (camera model/Camera)
   (edges (array (ptr i8) 4))
   (focused (ptr Pane))
   (next-id i64)
   (dirty bool)
   (width f64)
   (height f64)
   (scale f64)
   (visible bool)
   ;; Laid out for the cube by cube-pose!: every pane shown, ignoring the
   ;; camera's view.
   (fitted bool)
   ;; Exposé is open: the panes are spread into a grid, every one shown. They
   ;; are carried there by their layers' transforms, never moved or resized.
   ;; HOVERED is lifted; EXPOSED-AT is when the spread settles, and
   ;; RETURNING-AT when the panes are home after it closes.
   (exposed bool)
   (hovered (ptr Pane))
   (exposed-at f64)
   (returning-at f64)
   (theme theme/Theme)
   (zoom-enabled bool)
   (space-held bool)
   (last-click f64)
   (click-point Point)
   (click-pane (ptr Pane))
   (gesture i64)
   (start Point)
   (start-world Point)
   (pointer Point)
   (start-bounds Rect)
   (drag-pane (ptr Pane))
   ;; The model/EDGE-* bits a resize gesture drags.
   (resize-edges i64)])

(defn display-camera [(c (ptr Canvas))] (-> model/Camera)
  (if (.zoom-enabled c)
      (.camera c)
      (model/Camera
        :x (.x (.camera c))
        :y (.y (.camera c))
        :zoom 1.0)))

(defn count [(c (ptr Canvas))] (-> i64)
  (len (.panes c)))

(defn pane [(c (ptr Canvas)) (index i64)] (-> (ptr Pane))
  (get (.panes c) index))

(defn term-of [(v (ptr Pane))] (-> (ptr terminal/Terminal))
  (.terminal v))

(defn widget? [(v (ptr Pane))] (-> bool)
  (!= (p/cast i64 (.widget v)) 0))

;;; The native view that takes keyboard focus for a pane.
(defn content-view [(v (ptr Pane))] (-> (ptr i8))
  (if (widget? v) (.view (.widget v)) (.view (term-of v))))

(defn content-bounds [(bounds Rect)] (-> Rect)
  (rect 1.0 12.0 (- (.w bounds) 2.0) (- (.h bounds) 48.0)))

(defn edge [(c (ptr Canvas)) (index i64)] (-> (ptr i8))
  (load (p/index (field c edges) index)))

(defn no-pane [] (-> (ptr Pane))
  (p/cast (ptr Pane) 0))

(defn point [(c (ptr Canvas)) (event (ptr i8))] (-> Point)
  (let [pt
          (msg Point
               (.view c)
               (sel c"convertPoint:fromView:")
               [Point (ptr i8)]
               (msg Point event (sel c"locationInWindow") [])
               (nil))]
    (Point :x (.x pt) :y (- (.height c) (.y pt)))))

;;; A header is always lighter than its pane's body, and more so on the
;;; focused pane. The terminal has its own background.
(defn paint-header! [(c (ptr Canvas)) (v (ptr Pane)) (active bool)] (-> void)
  (let [cfg (.theme c)
        lift (if active 0.08 0.04)]
    (background! (.header v)
                 (+ (.pane-r cfg) lift)
                 (+ (.pane-g cfg) lift)
                 (+ (.pane-b cfg) lift))
    (do)))

(defn focus! [(c (ptr Canvas)) (chosen (ptr Pane))] (-> void)
  (do
    (set! (.focused c) chosen)
    (set! (.dirty c) true)
    (for [i 0 (count c)]
      (let [v (pane c i)
            active (= (p/cast i64 v) (p/cast i64 chosen))
            cfg (.theme c)]
        (do
          (msg i64 (layer (.view v)) (sel c"setBorderWidth:") [f64] 0.0)
          (paint-header! c v active))))
    (msg i8
         (msg (ptr i8) (.view c) (sel c"window") [])
         (sel c"makeFirstResponder:")
         [(ptr i8)]
         (if (= (p/cast i64 chosen) 0) (nil) (content-view chosen)))))

(defn front! [(c (ptr Canvas)) (chosen (ptr Pane))] (-> void)
  (do
    ; Array order and native subview order are one z-order, back to front.
    (let [(mut found) -1]
      (do
        (for [i 0 (count c)]
          (if (= (p/cast i64 (pane c i)) (p/cast i64 chosen))
              (set! found i)
              0))
        (if (>= (load found) 0)
            (do
              (for [i (load found) (- (count c) 1)]
                (set! (mut (.panes c)) i (pane c (+ i 1))))
              (set! (mut (.panes c)) (- (count c) 1) chosen))
            0)))
    (msg i64
         (.view c)
         (sel c"addSubview:positioned:relativeTo:")
         [(ptr i8) i64 (ptr i8)]
         (.view chosen)
         1
         (nil))
    (focus! c chosen)))

(defn gradient! [(c (ptr Canvas))
                 (i i64)
                 (bounds Rect)
                 (start Point)
                 (end Point)
                 (intensity f64)] (-> void)
  (let [l (edge c i)
        cfg (.theme c)
        colors (msg (ptr i8) (class c"NSMutableArray") (sel c"array") [])]
    (do
      (msg i64
           colors
           (sel c"addObject:")
           [(ptr i8)]
           (msg (ptr i8)
                (color (.shadow-r cfg)
                       (.shadow-g cfg)
                       (.shadow-b cfg)
                       (* intensity (.edge-strength cfg)))
                (sel c"CGColor")
                []))
      (msg i64
           colors
           (sel c"addObject:")
           [(ptr i8)]
           (msg (ptr i8)
                (color (.shadow-r cfg) (.shadow-g cfg) (.shadow-b cfg) 0.0)
                (sel c"CGColor")
                []))
      (msg i64 l (sel c"setFrame:") [Rect] bounds)
      (msg i64 l (sel c"setStartPoint:") [Point] start)
      (msg i64 l (sel c"setEndPoint:") [Point] end)
      (msg i64 l (sel c"setColors:") [(ptr i8)] colors))))

(defn project! [(c (ptr Canvas))] (-> void)
  (let [w (.width c)
        h (.height c)
        cfg (.theme c)
        thick (.edge-width cfg)
        depths (model/edges (display-camera c) w h (.edge-distance cfg))
        display (display-camera c)
        scale (* (.scale c) (.zoom display))]
    (do
      (set! (.dirty c) true)
      (if (and (>= (.gesture c) 2) (!= (p/cast i64 (.drag-pane c)) 0))
          (set! (field (load (field c drag-pane)) bounds)
                (model/dragged-bounds display
                                      (.start-world c)
                                      (.pointer c)
                                      (.start-bounds c)
                                      (if (= (.gesture c) 3)
                                          (.resize-edges c)
                                          0)))
          0)
      (transaction! 0.0)
      (msg i64
           (class c"CATransaction")
           (sel c"setDisableActions:")
           [i8]
           (: 1 i8))
      (gradient! c
                 0
                 (rect 0.0 0.0 thick h)
                 (Point :x 0.0 :y 0.5)
                 (Point :x 1.0 :y 0.5)
                 (.left depths))
      (gradient! c
                 1
                 (rect (- w thick) 0.0 thick h)
                 (Point :x 1.0 :y 0.5)
                 (Point :x 0.0 :y 0.5)
                 (.right depths))
      (gradient! c
                 2
                 (rect 0.0 (- h thick) w thick)
                 (Point :x 0.5 :y 1.0)
                 (Point :x 0.5 :y 0.0)
                 (.top depths))
      (gradient! c
                 3
                 (rect 0.0 0.0 w thick)
                 (Point :x 0.5 :y 0.0)
                 (Point :x 0.5 :y 1.0)
                 (.bottom depths))
      (for [i 0 (count c)]
        (let [v (pane c i)
              world (.bounds v)
              screen
                (if (or (.exposed c) (.fitted c))
                    (.slot v)
                    (model/project display world))
              shown
                (or (.fitted c)
                    (.exposed c)
                    (> (.returning-at c) 0.0)
                    (model/visible? screen w h))
              visible (and (.visible c) shown)]
          (do
            (frame! (.view v)
                    (rect (.x screen)
                          (- h (+ (.y screen) (.h screen)))
                          (.w screen)
                          (.h screen)))
            (msg i64
                 (.view v)
                 (sel c"setBoundsSize:")
                 [Size]
                 (Size :w (.w world) :h (.h world)))
            (frame! (.header v) (rect 0.0 (- (.h world) 36.0) (.w world) 36.0))
            (frame! (.title v)
                    (rect 16.0 (- (.h world) 29.0) (- (.w world) 80.0) 22.0))
            (frame! (.close v)
                    (rect (- (.w world) 31.0) (- (.h world) 28.0) 24.0 24.0))
            (msg i64
                 (.view v)
                 (sel c"setHidden:")
                 [i8]
                 (p/cast i8 (if shown 0 1)))
            (if (and (not (widget? v))
                     (!= (p/cast i64 (.surface (term-of v))) 0))
                (g/ghostty_surface_set_occlusion (.surface (term-of v)) visible)
                (do))
            (if (or (< (.render-scale v) scale)
                    (> (.render-scale v) scale)
                    (< (.render-w v) (.w world))
                    (> (.render-w v) (.w world))
                    (< (.render-h v) (.h world))
                    (> (.render-h v) (.h world)))
                (do
                  (if (widget? v)
                      (widget-view/resize! (.widget v) (content-bounds world))
                      (terminal/resize! (term-of v)
                                        (content-bounds world)
                                        scale))
                  (set! (.render-scale v) scale)
                  (set! (.render-w v) (.w world))
                  (set! (.render-h v) (.h world)))
                0))))
      (commit!)
      (do))))

(defn apply-theme! [(c (ptr Canvas)) (cfg theme/Theme)] (-> void)
  (do
    (set! (.theme c) cfg)
    (for [i 0 (count c)]
      (let [v (pane c i)]
        (do
          (background! (.view v) (.pane-r cfg) (.pane-g cfg) (.pane-b cfg))
          (paint-header! c v (= (p/cast i64 v) (p/cast i64 (.focused c))))
          (msg i64
               (.title v)
               (sel c"setTextColor:")
               [(ptr i8)]
               (color (.ink-r cfg) (.ink-g cfg) (.ink-b cfg) 1.0))
          (msg i64
               (.close v)
               (sel c"setTextColor:")
               [(ptr i8)]
               (color (.muted-r cfg) (.muted-g cfg) (.muted-b cfg) 1.0)))))
    (project! c)))

(defn create! [(parent (ptr i8)) (width f64) (height f64) (cfg theme/Theme)]
  (-> (ptr Canvas))
  (let [c (alloc/box! (alloc/malloc-allocator) Canvas (zeroed Canvas))]
    (do
      ; A 3D container, so panes can float off the project's face; the face's
      ; plate behind it carries the background.
      (set! (.view c)
            (layer-view parent (rect 0.0 0.0 width height) c"CATransformLayer"))
      (set! (.panes c)
            (al/ArrayList::new [(ptr Pane)] (alloc/malloc-allocator)))
      (set! (.camera c) (model/camera))
      (set! (.width c) width)
      (set! (.height c) height)
      (set! (.scale c) 1.0)
      (set! (.zoom-enabled c) true)
      (set! (.theme c) cfg)
      (set! (.directory c)
            (msg (ptr i8)
                 (msg (ptr i8)
                      (ns c"~")
                      (sel c"stringByExpandingTildeInPath")
                      [])
                 (sel c"retain")
                 []))
      (for [i 0 4]
        (let [l (msg (ptr i8) (class c"CAGradientLayer") (sel c"layer") [])]
          (do
            (set! (index (field c edges) i) l)
            (msg i64 l (sel c"setZPosition:") [f64] -1.0)
            (msg i64 (layer (.view c)) (sel c"addSublayer:") [(ptr i8)] l))))
      (apply-theme! c cfg)
      c)))

(defn new-pane [(c (ptr Canvas)) (bounds Rect)] (-> (ptr Pane))
  ; A pane opened during Exposé is laid out among the others, so the grid
  ; makes way for it.
  (when (.exposed c) (unexpose! c (no-pane)))
  (let [v (alloc/box! (alloc/malloc-allocator) Pane (zeroed Pane))]
    (set! (.next-id c) (+ (.next-id c) 1))
    (set! (.id v) (.next-id c))
    (set! (.view v) (view (.view c) (rect 0.0 0.0 (.w bounds) (.h bounds))))
    (set! (.bounds v) bounds)
    v))

;;; Header, title and close button above the pane's content.
(defn add-chrome! [(c (ptr Canvas)) (v (ptr Pane)) (title (ptr i8))] (-> void)
  (let [host (.view v)
        bounds (.bounds v)]
    (set! (.header v)
          (view host (rect 0.0 (- (.h bounds) 36.0) (.w bounds) 36.0)))
    (set! (.title v)
          (label host
                 c"Terminal"
                 (rect 16.0 (- (.h bounds) 29.0) 300.0 22.0)
                 12.0
                 false))
    (msg i64 (.title v) (sel c"setStringValue:") [(ptr i8)] title)
    (set! (.close v)
          (label host
                 c"×"
                 (rect (- (.w bounds) 31.0) (- (.h bounds) 28.0) 24.0 24.0)
                 17.0
                 true))
    (msg i64 (layer host) (sel c"setCornerRadius:") [f64] 8.0)
    (msg i64 (layer host) (sel c"setMasksToBounds:") [i8] (: 1 i8))
    (push! [(ptr Pane)] (mut (.panes c)) v)
    (apply-theme! c (.theme c))
    (focus! c v)))

;;; A terminal pane for SESSION-ID whose shell starts in DIRECTORY.
(defn add-session-in! [(c (ptr Canvas))
                       (bounds Rect)
                       (session-id (ptr i8))
                       (directory (ptr i8))] (-> bool)
  (let [v (new-pane c bounds)
        t
          (terminal/create! (.view v)
                            (content-bounds bounds)
                            (utf8 directory)
                            session-id)]
    (do
      (set! (.terminal v) t)
      (add-chrome! c v (indexed-string c"Terminal " (.id v) c""))
      (set! (.message v)
            (label (.view v)
                   c"Session unavailable. Use Terminal: Reconnect in the action palette."
                   (rect 16.0 40.0 (- (.w bounds) 32.0) 48.0)
                   12.0
                   false))
      (msg i64
           (.message v)
           (sel c"setHidden:")
           [i8]
           (p/cast i8 (if (= (p/cast i64 (.surface t)) 0) 0 1)))
      true)))

(defn add-session! [(c (ptr Canvas)) (bounds Rect) (session-id (ptr i8))]
  (-> bool)
  (add-session-in! c bounds session-id (.directory c)))

(defn bytes-of [(s (ptr i8))] (-> (slice u8))
  (let [bytes (utf8 s)]
    (slice::new (p/cast (ptr u8) bytes) (p/cast i64 (strlen bytes)))))

(defn widget-title [(v (ptr Pane))] (-> (ptr i8))
  (let [chosen (widget-view/title (.widget v))]
    (if (> (len chosen) 0)
        (widget-view/string chosen)
        (msg (ptr i8)
             (ns c"Widget · ")
             (sel c"stringByAppendingString:")
             [(ptr i8)]
             (widget-view/string (widget-view/name (.widget v)))))))

;;; A pane running SPEC, "NAME ARGS…" for widgets/NAME.coil. A widget that
;;; fails to load still gets its pane, which shows the diagnostic and loads the
;;; next saved edit.
(defn add-widget! [(c (ptr Canvas))
                   (bounds Rect)
                   (spec (ptr i8))
                   (state (ptr i8))] (-> bool)
  (let [v (new-pane c bounds)]
    (set! (.widget v)
          (widget-view/create! (.view v)
                               (content-bounds bounds)
                               (bytes-of spec)
                               (bytes-of (.directory c))
                               state))
    (widget-view/take-title-change! (.widget v))
    (add-chrome! c v (widget-title v))
    true))

(defn next-bounds [(c (ptr Canvas)) (width f64) (height f64)] (-> Rect)
  (let [camera (.camera c)
        offset (* (p/cast f64 (% (count c) 5)) 28.0)]
    (rect (+ (.x camera) (+ 36.0 offset))
          (+ (.y camera) (+ 36.0 offset))
          width
          height)))

(defn add-widget-visible! [(c (ptr Canvas)) (spec (ptr i8))] (-> bool)
  (add-widget! c (next-bounds c 760.0 600.0) spec (nil)))

;;; Carry out what a widget asked for while handling its events.
(defn serve-requests! [(c (ptr Canvas)) (v (ptr Pane))] (-> void)
  (let [w (.widget v)
        r (widget-view/requests w)
        count (len (.items r))]
    (for [k 0 count]
      (let [item (get (.items r) k)
            text (api/request-text r item)
            kind (.kind item)]
        (cond (= kind api/OPEN-WIDGET)
                (do (add-widget-visible! c (widget-view/string text)) 0)
              (= kind api/OPEN-TERMINAL)
                (do
                  (add-session-in! c
                                   (next-bounds c 640.0 430.0)
                                   (sessions/identifier)
                                   (widget-view/string text))
                  0)
              (= kind api/SCROLL-TO)
                (do (widget-view/scroll-to! w (.value item)) 0)
              (= kind api/EMIT)
                (do
                  (widget-view/broadcast! w text (api/request-text2 r item))
                  0)
              :else 0)))
    (api/requests-clear! r)
    (when (widget-view/take-title-change! w)
      (msg i64 (.title v) (sel c"setStringValue:") [(ptr i8)] (widget-title v))
      0)
    ; Widget state is saved with the layout, so a state change dirties it.
    (when (widget-view/take-state-dirty! w) (set! (.dirty c) true) 0)
    (do)))

;;; Serve what this canvas's widgets asked for. Compiles, reloads and ticks for
;;; every widget happen once per pass in widget-view/maintain!.
(defn widgets-serve! [(c (ptr Canvas))] (-> void)
  ; Serving a request can add panes, so walk the panes that existed before.
  (let [n (count c)]
    (for [i 0 n]
      (let [v (pane c i)]
        (when (widget? v) (serve-requests! c v) 0))))
  (do))

(defn reconnect! [(c (ptr Canvas)) (v (ptr Pane))] (-> bool)
  (if (widget? v) false (reconnect-terminal! c v)))

(defn reconnect-terminal! [(c (ptr Canvas)) (v (ptr Pane))] (-> bool)
  (let [old (term-of v)
        bounds (.bounds v)
        t
          (terminal/create! (.view v)
                            (rect 1.0
                                  12.0
                                  (- (.w bounds) 2.0)
                                  (- (.h bounds) 48.0))
                            (utf8 (.directory old))
                            (.session-id old))]
    (if (= (p/cast i64 (.surface t)) 0)
        (do (terminal/free! t) false)
        (do
          (set! (.terminal v) t)
          (terminal/free! old)
          (msg i64 (.message v) (sel c"setHidden:") [i8] (: 1 i8))
          (set! (.render-scale v) 0.0)
          (project! c)
          (focus! c v)
          true))))

(defn add! [(c (ptr Canvas)) (bounds Rect)] (-> bool)
  (add-session! c bounds (sessions/identifier)))

(defn add-visible! [(c (ptr Canvas))] (-> bool)
  (let [camera (.camera c)
        offset (* (p/cast f64 (% (count c) 5)) 28.0)]
    (add! c
          (rect (+ (.x camera) (+ 36.0 offset))
                (+ (.y camera) (+ 36.0 offset))
                640.0
                430.0))))

;;; Closing a terminal pane ends its session; app shutdown only detaches.
(defn free-content! [(v (ptr Pane)) (closing bool)] (-> void)
  (if (widget? v)
      (widget-view/free! (.widget v))
      (do
        (when closing (sessions/kill! (.session-id (term-of v))) 0)
        (terminal/free! (term-of v))))
  (do))

(defn close! [(c (ptr Canvas)) (chosen (ptr Pane))] (-> void)
  (do
    (if (= (p/cast i64 (.drag-pane c)) (p/cast i64 chosen))
        (do (set! (.gesture c) 0) (set! (.drag-pane c) (no-pane)))
        0)
    (let [(mut found) -1]
      (do
        (for [i 0 (count c)]
          (if (= (p/cast i64 (pane c i)) (p/cast i64 chosen))
              (set! found i)
              0))
        (if (>= (load found) 0)
            (do
              (for [i (load found) (- (count c) 1)]
                (set! (mut (.panes c)) i (pane c (+ i 1))))
              (pop! [(ptr Pane)] (mut (.panes c)))
              (when (= (p/cast i64 (.hovered c)) (p/cast i64 chosen))
                (set! (.hovered c) (no-pane)))
              (free-content! chosen true)
              (msg i64 (.view chosen) (sel c"removeFromSuperview") [])
              (alloc/destroy [Pane] (alloc/malloc-allocator) chosen)
              (focus! c (if (> (count c) 0) (pane c (- (count c) 1)) (no-pane))))
            (do))))
    (project! c)
    ; Exposé closes up the gap the pane leaves.
    (when (.exposed c)
      (if (> (count c) 0) (spread! c EXPOSE-TIME) (set! (.exposed c) false)))
    (do)))

(defn hit [(c (ptr Canvas)) (world Point)] (-> (ptr Pane))
  (let [(mut found) (no-pane)]
    (do
      (for [i 0 (count c)]
        (if (model/contains? (.bounds (pane c i)) world)
            (set! found (pane c i))
            0))
      (load found))))

(defn home! [(c (ptr Canvas))] (-> void)
  (do (set! (.camera c) (model/camera)) (project! c)))

(defn fit! [(c (ptr Canvas))] (-> void)
  (if (= (count c) 0)
      (home! c)
      (let [first (.bounds (pane c 0))
            (mut x) (.x first)
            (mut y) (.y first)
            (mut right) (+ (.x first) (.w first))
            (mut bottom) (+ (.y first) (.h first))]
        (do
          (for [i 1 (count c)]
            (let [r (.bounds (pane c i))]
              (do
                (if (< (.x r) (load x)) (set! x (.x r)) 0)
                (if (< (.y r) (load y)) (set! y (.y r)) 0)
                (if (> (+ (.x r) (.w r)) (load right))
                    (set! right (+ (.x r) (.w r)))
                    0)
                (if (> (+ (.y r) (.h r)) (load bottom))
                    (set! bottom (+ (.y r) (.h r)))
                    0))))
          (let [zx (/ (- (.width c) 64.0) (- (load right) (load x)))
                zy (/ (- (.height c) 64.0) (- (load bottom) (load y)))
                z (model/clamp (if (< zx zy) zx zy) 0.2 4.0)]
            (set! (.camera c)
                  (model/clamp-camera (model/Camera
                                        :x (- (load x) (/ 32.0 z))
                                        :y (- (load y) (/ 32.0 z))
                                        :zoom z))))
          (project! c)))))

;;; Gesture capture is independent of the pane under the current pointer.
;;; Dragging beyond the viewport therefore neither loses a pane nor types into
;;; a terminal. Ordinary wheel events inside a terminal remain terminal scroll.
(defn handle! [(c (ptr Canvas)) (event (ptr i8))] (-> bool)
  (if (.exposed c) (expose-handle! c event) (handle-panes! c event)))

(defn handle-panes! [(c (ptr Canvas)) (event (ptr i8))] (-> bool)
  (let [kind (msg i64 event (sel c"type") [])
        flags (msg u64 event (sel c"modifierFlags") [])
        relevant
          (or (= kind 1)
              (= kind 2)
              (= kind 6)
              (= kind 25)
              (= kind 26)
              (= kind 27)
              (= kind 22)
              (= kind 30))]
    (if (or (= kind 10) (= kind 11))
        (do
          (if (= (msg u16 event (sel c"keyCode") []) (: 49 u16))
              (set! (.space-held c) (= kind 10))
              0)
          false)
        (if (not relevant)
            false
            (let [screen (point c event)
                  world (model/screen-to-world (display-camera c) screen)
                  v (hit c world)
                  inside
                    (model/contains? (rect 0.0 0.0 (.width c) (.height c))
                                     screen)
                  alt (!= (& flags 524288) (: 0 u64))
                  command (!= (& flags 1048576) (: 0 u64))]
              (do
                (set! (.pointer c) screen)
                (cond (and (or (= kind 6) (= kind 27)) (> (.gesture c) 0))
                        (do
                          (if (= (.gesture c) 1)
                              (do
                                (set! (.camera c)
                                      (model/pan-by (.camera c)
                                                    (- (.x screen)
                                                       (.x (.start c)))
                                                    (- (.y screen)
                                                       (.y (.start c)))))
                                (set! (.start c) screen))
                              0)
                          (project! c)
                          true)
                      (and (or (= kind 2) (= kind 26)) (> (.gesture c) 0))
                        (do
                          (set! (.gesture c) 0)
                          (set! (.drag-pane c) (no-pane))
                          true)
                      (not inside) false
                      (or (= kind 1) (= kind 25))
                        (do
                          (set! (.start c) screen)
                          (set! (.start-world c) world)
                          (cond (or (.space-held c)
                                    (and (= kind 25)
                                         (= (msg i64
                                                 event
                                                 (sel c"buttonNumber")
                                                 [])
                                            2)))
                                  (do (set! (.gesture c) 1) true)
                                (= (p/cast i64 v) 0) false
                                :else
                                  (let [r (.bounds v)
                                        local-x (- (.x world) (.x r))
                                        local-y (- (.y world) (.y r))]
                                    (do
                                      (front! c v)
                                      (let [now (animation/animation-now)
                                            dx
                                              (- (.x screen)
                                                 (.x (.click-point c)))
                                            dy
                                              (- (.y screen)
                                                 (.y (.click-point c)))]
                                        (if (and (= (p/cast i64 (.click-pane c))
                                                    (p/cast i64 v))
                                                 (and (< (- now (.last-click c))
                                                         0.5)
                                                      (< (+ (* dx dx) (* dy dy))
                                                         64.0)))
                                            (do
                                              (set! (.last-click c) 0.0)
                                              (if (or (< (.zoom (.camera c))
                                                         0.999)
                                                      (> (.zoom (.camera c))
                                                         1.001))
                                                  (do
                                                    (set! (.camera c)
                                                          (model/jump-to-pane r))
                                                    (project! c))
                                                  (do)))
                                            (do
                                              (set! (.last-click c) now)
                                              (set! (.click-point c) screen)
                                              (set! (.click-pane c) v)
                                              (do))))
                                      (set! (.start-world c)
                                            (model/screen-to-world (display-camera c)
                                                                   screen))
                                      (set! (.start-bounds c) r)
                                      (set! (.drag-pane c) v)
                                      ; Like Jim: the close button, then a
                                      ; 6 point band along every edge (two
                                      ; at a corner), then the header.
                                      (let [edges
                                              (model/edges-at (.w r)
                                                              (.h r)
                                                              local-x
                                                              local-y
                                                              (/ 6.0
                                                                 (.zoom (display-camera c))))]
                                        (cond (and (< local-y 36.0)
                                                   (> local-x (- (.w r) 36.0)))
                                                (do
                                                  (set! (.drag-pane c)
                                                        (no-pane))
                                                  (close! c v)
                                                  true)
                                              (!= edges 0)
                                                (do
                                                  (set! (.resize-edges c) edges)
                                                  (set! (.gesture c) 3)
                                                  true)
                                              (< local-y 36.0)
                                                (do
                                                  (set! (.gesture c) 2)
                                                  true)
                                              :else false))))))
                      (= kind 30)
                        (if (.zoom-enabled c)
                            (do
                              (set! (.camera c)
                                    (model/zoom-at (.camera c)
                                                   screen
                                                   (model/pinch-factor (msg f64
                                                                            event
                                                                            (sel c"magnification")
                                                                            []))))
                              (project! c)
                              true)
                            false)
                      (= kind 22)
                        (let [scale
                                (model/wheel-scale (!= (msg i8
                                                            event
                                                            (sel c"hasPreciseScrollingDeltas")
                                                            [])
                                                       (: 0 i8))
                                                   (.scale c))
                              dx
                                (* (msg f64 event (sel c"scrollingDeltaX") [])
                                   scale)
                              dy
                                (* (msg f64 event (sel c"scrollingDeltaY") [])
                                   scale)
                              route
                                (model/wheel-route command
                                                   alt
                                                   (.zoom-enabled c))]
                          (cond (= route 2)
                                  (do
                                    (set! (.camera c)
                                          (model/zoom-at (.camera c)
                                                         screen
                                                         (model/wheel-factor dy)))
                                    (project! c)
                                    true)
                                (= route 1)
                                  (do
                                    (set! (.camera c)
                                          (model/pan-by (.camera c) dx dy))
                                    (project! c)
                                    true)
                                :else false))
                      :else false)))))))

(defn resize! [(c (ptr Canvas)) (width f64) (height f64) (scale f64)] (-> void)
  (do
    (set! (.width c) width)
    (set! (.height c) height)
    (set! (.scale c) scale)
    (frame! (.view c) (rect 0.0 0.0 width height))
    (project! c)
    (when (.exposed c) (spread! c 0.0))))

;;; The bounding box of every pane, in canvas units.
(defn extent [(c (ptr Canvas))] (-> Rect)
  (let [first (.bounds (pane c 0))
        (mut left) (.x first)
        (mut top) (.y first)
        (mut right) (+ (.x first) (.w first))
        (mut bottom) (+ (.y first) (.h first))]
    (for [i 1 (count c)]
      (let [r (.bounds (pane c i))]
        (when (< (.x r) (load left)) (set! left (.x r)))
        (when (< (.y r) (load top)) (set! top (.y r)))
        (when (> (+ (.x r) (.w r)) (load right)) (set! right (+ (.x r) (.w r))))
        (when (> (+ (.y r) (.h r)) (load bottom))
          (set! bottom (+ (.y r) (.h r))))))
    (rect (load left)
          (load top)
          (- (load right) (load left))
          (- (load bottom) (load top)))))

;;; The layer transform that carries a pane from where the canvas lays it out
;;; (its view's FRAME, around the layer's POSITION) to TARGET, LIFT points off
;;; the canvas. Both rects are in the canvas view's coordinates.
(defn carry [(frame Rect) (position Point) (target Rect) (lift f64)]
  (-> Transform)
  (let [scale (/ (.w target) (.w frame))]
    (CATransform3DScale (CATransform3DMakeTranslation (- (.x target)
                                                         (.x position)
                                                         (* scale
                                                            (- (.x frame)
                                                               (.x position))))
                                                      (- (.y target)
                                                         (.y position)
                                                         (* scale
                                                            (- (.y frame)
                                                               (.y position))))
                                                      lift)
                        scale
                        scale
                        1.0)))

;;; The transform that carries pane V from its frame onto TARGET, LIFT
;;; points off the canvas. A zoomed pane's layer is as big as its bounds, and
;;; AppKit shrinks it onto the frame with the layer's own transform, so the
;;; carry starts from that scale. The layer's position is worked out from the
;;; frame too: AppKit updates a view's layer only on its next layout, so just
;;; after a frame change the layer still says where the view was.
(defn carry-pane [(v (ptr Pane)) (target Rect) (lift f64)] (-> Transform)
  (let [frame (msg Rect (.view v) (sel c"frame") [])
        bounds (msg Rect (.view v) (sel c"bounds") [])
        fit (/ (.w frame) (max (.w bounds) 1.0))]
    (CATransform3DConcat (CATransform3DMakeScale fit fit 1.0)
                         (carry frame (pivot v) target lift))))

;;; Where pane V's layer is positioned, worked out from the view's frame.
(defn pivot [(v (ptr Pane))] (-> Point)
  (let [frame (msg Rect (.view v) (sel c"frame") [])
        anchor (msg Point (layer (.view v)) (sel c"anchorPoint") [])]
    (Point
      :x (+ (.x frame) (* (.x anchor) (.w frame)))
      :y (+ (.y frame) (* (.y anchor) (.h frame))))))

;;; Where a pane's layer was positioned and the transform it was shown with,
;;; so a pane given a new frame can start out exactly where it was seen.
(defstruct Seen [(at Point) (shown Transform)])

(defn seen [(c (ptr Canvas))] (-> (al/ArrayList Seen))
  (let [(mut all) (al/ArrayList::new [Seen] (alloc/malloc-allocator))]
    (for [i 0 (count c)]
      (let [l (layer (.view (pane c i)))
            shown (msg (ptr i8) l (sel c"presentationLayer") [])]
        (push! (mut all)
               (Seen
                 :at (pivot (pane c i))
                 :shown
                   (msg Transform
                        (if (= (p/cast i64 shown) 0) l shown)
                        (sel c"transform")
                        [])))))
    all))

;;; The transform that shows pane V, from its frame now, where it was SEEN.
(defn seen-from [(v (ptr Pane)) (was Seen)] (-> Transform)
  (let [at (pivot v)]
    (CATransform3DConcat (.shown was)
                         (CATransform3DMakeTranslation (- (.x (.at was))
                                                          (.x at))
                                                       (- (.y (.at was))
                                                          (.y at))
                                                       0.0))))

;;; Move every pane over DURATION from where it was SEEN to its frame now,
;;; LIFT points off the canvas plus STEP per place in the stack, and grown
;;; by HOVER-LIFT if hovered. Each starts DELAY later than the one before.
;;; Panes are moved by their frames, so AppKit draws them wherever they land;
;;; their transforms only carry them on the way.
(defn glide! [(c (ptr Canvas))
              (was (al/ArrayList Seen))
              (duration f64)
              (delay f64)
              (lift f64)
              (step f64)] (-> void)
  (for [i 0 (count c)]
    (let [v (pane c i)
          frame (msg Rect (.view v) (sel c"frame") [])
          grow (if (= (p/cast i64 v) (p/cast i64 (.hovered c))) HOVER-LIFT 1.0)]
      (tween! (layer (.view v))
              (seen-from v (get was i))
              (carry-pane v
                          (rect (- (.x frame) (* 0.5 (.w frame) (- grow 1.0)))
                                (- (.y frame) (* 0.5 (.h frame) (- grow 1.0)))
                                (* (.w frame) grow)
                                (* (.h frame) grow))
                          (+ lift (* step (p/cast f64 i))))
              duration
              (ease-out-cubic)
              (* delay (p/cast f64 i)))))
  (do))

;;; Pane V's transform at rest, lying on its frame.
(defn rest [(v (ptr Pane))] (-> Transform)
  (carry-pane v (msg Rect (.view v) (sel c"frame") []) 0.0))

;;; Lay the panes out for the cube, as Jim does. When FIT, the whole layout is
;;; scaled to fill 80% of the face and centered, whatever the camera shows, and
;;; each pane floats LIFT points off the face plus STEP per place in the stack.
;;; Otherwise the panes lie flat where the camera puts them. Animates over
;;; DURATION.
(defn cube-pose! [(c (ptr Canvas))
                  (fit bool)
                  (lift f64)
                  (step f64)
                  (duration f64)] (-> void)
  (let [(mut was) (seen c)]
    ; The cube lays the panes out itself.
    (set! (.exposed c) false)
    (set! (.hovered c) (no-pane))
    (set! (.returning-at c) 0.0)
    (set! (.fitted c) fit)
    (when (and fit (> (count c) 0))
      (let [box (extent c)
            k
              (min (/ (* (.width c) 0.8) (max (.w box) 1.0))
                   (/ (* (.height c) 0.8) (max (.h box) 1.0)))
            cx (+ (.x box) (* (.w box) 0.5))
            cy (+ (.y box) (* (.h box) 0.5))]
        (for [i 0 (count c)]
          (let [v (pane c i)
                r (.bounds v)]
            (set! (.slot v)
                  (rect (+ (* (.width c) 0.5) (* (- (.x r) cx) k))
                        (+ (* (.height c) 0.5) (* (- (.y r) cy) k))
                        (* (.w r) k)
                        (* (.h r) k)))))))
    (project! c)
    (if fit
        (glide! c was duration 0.0 lift step)
        (glide! c was duration 0.0 0.0 0.0))
    (free! (mut was)))
  (do))

(defn visibility! [(c (ptr Canvas)) (visible bool)] (-> void)
  ; A project put away closes its Exposé at once.
  (let [closing (and (not visible) (.exposed c))]
    (when closing
      (set! (.exposed c) false)
      (set! (.hovered c) (no-pane)))
    (set! (.returning-at c) 0.0)
    (set! (.visible c) visible)
    (project! c)
    (when closing
      (for [i 0 (count c)]
        (transform! (layer (.view (pane c i))) (rest (pane c i)) 0.0))))
  (do))

;;; Exposé, after Jim's ⌘⇧E. It spreads over EXPOSE-TIME with a cascade of
;;; EXPOSE-STAGGER per pane; the hovered pane grows by HOVER-LIFT.
(const EXPOSE-TIME 0.3)

(const EXPOSE-STAGGER 0.01)

(const HOVER-LIFT 1.07)

(const HOVER-TIME 0.14)

;;; The transform that grows pane V by LIFT about the center of its frame.
(defn lifted [(v (ptr Pane)) (lift f64)] (-> Transform)
  (let [frame (msg Rect (.view v) (sel c"frame") [])
        grow (- lift 1.0)]
    (carry-pane v
                (rect (- (.x frame) (* 0.5 (.w frame) grow))
                      (- (.y frame) (* 0.5 (.h frame) grow))
                      (* (.w frame) lift)
                      (* (.h frame) lift))
                0.0)))

;;; Grow pane V by LIFT over DURATION, from wherever it is shown now.
(defn lift! [(v (ptr Pane)) (lift f64) (duration f64)] (-> void)
  (eased-transform! (layer (.view v))
                    (lifted v lift)
                    duration
                    (ease-out-cubic)
                    0.0)
  (do))

;;; Lay every pane out in Exposé's grid over DURATION.
(defn spread! [(c (ptr Canvas)) (duration f64)] (-> void)
  (let [n (count c)
        display (display-camera c)
        region
          (rect model/EXPOSE-PAD
                model/EXPOSE-PAD
                (max (- (.width c) (* 2.0 model/EXPOSE-PAD)) 1.0)
                (max (- (.height c) (* 2.0 model/EXPOSE-PAD)) 1.0))
        grid (model/expose-grid n (.w region) (.h region))
        stagger (if (> duration 0.0) EXPOSE-STAGGER 0.0)
        (mut was) (seen c)
        (mut centers) (al/ArrayList::new [Point] (alloc/malloc-allocator))]
    (for [i 0 n]
      (let [r (model/project display (.bounds (pane c i)))]
        (push! (mut centers)
               (Point :x (+ (.x r) (* 0.5 (.w r))) :y (+ (.y r) (* 0.5 (.h r)))))))
    (let [(mut cells) (model/expose-cells (slice centers) grid)]
      (for [i 0 n]
        (let [v (pane c i)
              screen (model/project display (.bounds v))]
          (set! (.slot v)
                (model/expose-slot grid
                                   region
                                   (get cells i)
                                   (.w screen)
                                   (.h screen)))))
      (free! (mut cells)))
    (project! c)
    (glide! c was duration stagger 0.0 0.0)
    (free! (mut was))
    (free! (mut centers))
    (set! (.exposed-at c)
          (+ (animation/animation-now) duration (* stagger (p/cast f64 n))))
    (do)))

;;; Spread the panes out, every one shown where it can be seen at once.
(defn expose! [(c (ptr Canvas))] (-> void)
  (when (and (not (.exposed c)) (> (count c) 0))
    (set! (.exposed c) true)
    (set! (.hovered c) (no-pane))
    (set! (.returning-at c) 0.0)
    (set! (.gesture c) 0)
    (set! (.drag-pane c) (no-pane))
    (spread! c EXPOSE-TIME))
  (do))

;;; Bring the panes home. CHOSEN, when set, is focused and brought to the
;;; front; the camera moves only if none of it would be in view at home.
(defn unexpose! [(c (ptr Canvas)) (chosen (ptr Pane))] (-> void)
  (when (.exposed c)
    (let [(mut was) (seen c)]
      (set! (.exposed c) false)
      (set! (.hovered c) (no-pane))
      (set! (.returning-at c) (+ (animation/animation-now) EXPOSE-TIME))
      (when (!= (p/cast i64 chosen) 0)
        (let [home (model/project (display-camera c) (.bounds chosen))]
          (when (not (model/visible? home (.width c) (.height c)))
            (set! (.camera c)
                  (model/clamp-camera (model/Camera
                                        :x (- (.x (.bounds chosen)) 24.0)
                                        :y (- (.y (.bounds chosen)) 24.0)
                                        :zoom (.zoom (.camera c)))))
            0)))
      (project! c)
      (glide! c was EXPOSE-TIME 0.0 0.0 0.0)
      (free! (mut was))
      ; Raised after the glide is set up, since raising reorders the panes.
      (when (!= (p/cast i64 chosen) 0) (front! c chosen))))
  (do))

(defn toggle-expose! [(c (ptr Canvas))] (-> void)
  (if (.exposed c) (unexpose! c (no-pane)) (expose! c)))

;;; The topmost pane whose Exposé slot holds the top-down point PT.
(defn expose-hit [(c (ptr Canvas)) (pt Point)] (-> (ptr Pane))
  (let [(mut found) (no-pane)]
    (for [i 0 (count c)]
      (when (model/contains? (.slot (pane c i)) pt) (set! found (pane c i))))
    (load found)))

;;; Lift the pane under PT, once the spread has settled. The hovered pane
;;; takes the focus as well, as in Jim, so the header marks it.
(defn expose-hover! [(c (ptr Canvas)) (pt Point)] (-> void)
  (when (>= (animation/animation-now) (.exposed-at c))
    (let [v (expose-hit c pt)
          old (.hovered c)]
      (when (!= (p/cast i64 v) (p/cast i64 old))
        (when (!= (p/cast i64 old) 0)
          (lift! old 1.0 HOVER-TIME))
        (set! (.hovered c) v)
        (when (!= (p/cast i64 v) 0)
          (lift! v HOVER-LIFT HOVER-TIME)
          (focus! c v)))))
  (do))

;;; The pointer now, in the canvas's top-down coordinates.
(defn mouse [(c (ptr Canvas))] (-> Point)
  (let [window (msg (ptr i8) (.view c) (sel c"window") [])
        pt
          (msg Point
               (.view c)
               (sel c"convertPoint:fromView:")
               [Point (ptr i8)]
               (msg Point window (sel c"mouseLocationOutsideOfEventStream") [])
               (nil))]
    (Point :x (.x pt) :y (- (.height c) (.y pt)))))

;;; Finish Exposé's animations: hover what the pointer rests on once the
;;; spread settles, and hide panes out of view once they are home.
(defn settle-expose! [(c (ptr Canvas)) (now f64)] (-> void)
  (when (and (.exposed c) (> (.exposed-at c) 0.0) (>= now (.exposed-at c)))
    (set! (.exposed-at c) 0.0)
    (expose-hover! c (mouse c)))
  (when (and (> (.returning-at c) 0.0) (>= now (.returning-at c)))
    (set! (.returning-at c) 0.0)
    (project! c))
  (do))

;;; While Exposé is open it owns the pointer: a click picks the pane under
;;; it and Esc closes. Keys with ⌘ still reach the app's shortcuts; other
;;; keys go nowhere.
(defn expose-handle! [(c (ptr Canvas)) (event (ptr i8))] (-> bool)
  (let [kind (msg i64 event (sel c"type") [])
        command
          (!= (& (msg u64 event (sel c"modifierFlags") []) 1048576) (: 0 u64))]
    (cond (= kind 10)
            (cond (= (msg u16 event (sel c"keyCode") []) (: 53 u16))
                    (do (unexpose! c (no-pane)) true)
                  command false
                  :else true)
          (= kind 11) (not command)
          (= kind 1)
            (let [v (expose-hit c (point c event))]
              (when (!= (p/cast i64 v) 0) (unexpose! c v))
              true)
          (or (= kind 5) (= kind 6)) (do (expose-hover! c (point c event)) true)
          (or (= kind 2)
              (= kind 3)
              (= kind 4)
              (= kind 7)
              (= kind 22)
              (= kind 25)
              (= kind 26)
              (= kind 27)
              (= kind 29)
              (= kind 30)
              (= kind 31)
              (= kind 32))
            true
          :else false)))

(defn free! [(c (ptr Canvas))] (-> void)
  (do
    (for [i 0 (count c)]
      (let [v (pane c i)]
        (do
          (free-content! v false)
          (msg i64 (.view v) (sel c"removeFromSuperview") [])
          (alloc/destroy [Pane] (alloc/malloc-allocator) v))))
    (al/ArrayList::free! (mut (.panes c)))
    (release (.directory c))
    (msg i64 (.view c) (sel c"removeFromSuperview") [])
    (alloc/destroy [Canvas] (alloc/malloc-allocator) c)))

(defn snapshot [(c (ptr Canvas))] (-> (ptr i8))
  (let [dict (storage/dictionary)
        panes (storage/array)]
    (do
      (storage/put! dict c"x" (storage/number (.x (.camera c))))
      (storage/put! dict c"y" (storage/number (.y (.camera c))))
      (storage/put! dict c"zoom" (storage/number (.zoom (.camera c))))
      (for [i 0 (count c)]
        (let [v (pane c i)
              r (.bounds v)
              item (storage/dictionary)]
          (do
            (storage/put! item c"x" (storage/number (.x r)))
            (storage/put! item c"y" (storage/number (.y r)))
            (if (widget? v)
                (let [state (widget-view/state-array (.widget v))]
                  (storage/put! item
                                c"widget"
                                (widget-view/spec-string (.widget v)))
                  (when (!= (p/cast i64 state) 0)
                    (storage/put! item c"state" state)
                    0)
                  0)
                (storage/put! item c"session" (.session-id (term-of v))))
            (storage/put! item c"width" (storage/number (.w r)))
            (storage/put! item c"height" (storage/number (.h r)))
            (storage/add! panes item)
            (if (= (p/cast i64 v) (p/cast i64 (.focused c)))
                (storage/put! dict c"focused" (storage/number (p/cast f64 i)))
                0))))
      (storage/put! dict c"panes" panes)
      dict)))

(defn restorable? [(dict (ptr i8))] (-> bool)
  (let [panes (storage/get dict c"panes")
        (mut valid)
          (and (storage/kind? panes c"NSArray")
               (and (storage/numeric? dict c"zoom")
                    (and (theme/bounded? (storage/value dict c"x")
                                         0.0
                                         1000000000.0)
                         (and (theme/bounded? (storage/value dict c"y")
                                              0.0
                                              1000000000.0)
                              (theme/bounded? (storage/value dict c"zoom")
                                              0.2
                                              4.0)))))]
    (do
      (for [i 0 (storage/count panes)]
        (let [r (storage/at panes i)]
          (if (not (and (theme/bounded? (storage/value r c"x")
                                        -1000000000.0
                                        1000000000.0)
                        (and (theme/bounded? (storage/value r c"y")
                                             -1000000000.0
                                             1000000000.0)
                             (and (theme/bounded? (storage/value r c"width")
                                                  320.0
                                                  4096.0)
                                  (theme/bounded? (storage/value r c"height")
                                                  180.0
                                                  4096.0)))))
              (set! valid false)
              0)))
      (load valid))))

(defn restore! [(c (ptr Canvas)) (dict (ptr i8))] (-> bool)
  (if (not (restorable? dict))
      false
      (let [panes (storage/get dict c"panes")
            (mut ok) true]
        (do
          (set! (.camera c)
                (model/Camera
                  :x (storage/value dict c"x")
                  :y (storage/value dict c"y")
                  :zoom (storage/value dict c"zoom")))
          (for [i 0 (storage/count panes)]
            (let [r (storage/at panes i)]
              (if (not (let [; Layouts saved before drags were kept in reach
                             ; may hold panes the camera cannot pan to.
                             bounds
                               (model/reachable (rect (storage/value r c"x")
                                                      (storage/value r c"y")
                                                      (storage/value r c"width")
                                                      (storage/value r
                                                                     c"height")))
                             widget (storage/get r c"widget")]
                         (if (storage/kind? widget c"NSString")
                             (add-widget! c
                                          bounds
                                          widget
                                          (storage/get r c"state"))
                             (add-session! c
                                           bounds
                                           (let [id (storage/get r c"session")]
                                             (if (and (storage/kind? id
                                                                     c"NSString")
                                                      (sessions/valid-id? id))
                                                 id
                                                 (sessions/identifier)))))))
                  (set! ok false)
                  0)))
          (let [focused (storage/value dict c"focused")]
            (if (and (>= focused 0.0) (< focused (p/cast f64 (count c))))
                (set! (.focused c) (pane c (p/cast i64 focused)))
                0))
          (load ok)))))

(defn zoom-key! [(c (ptr Canvas)) (factor f64)] (-> void)
  (if (.zoom-enabled c)
      (let [window (msg (ptr i8) (.view c) (sel c"window") [])
            root (msg (ptr i8) window (sel c"contentView") [])
            bounds (msg Rect root (sel c"bounds") [])
            center
              (msg Point
                   (.view c)
                   (sel c"convertPoint:fromView:")
                   [Point (ptr i8)]
                   (Point :x (* (.w bounds) 0.5) :y (* (.h bounds) 0.5))
                   root)]
        (do
          (set! (.camera c)
                (model/zoom-at (.camera c)
                               (Point
                                 :x (.x center)
                                 :y (- (.height c) (.y center)))
                               factor))
          (project! c)))
      (do)))

(defn reset-zoom! [(c (ptr Canvas))] (-> void)
  (do (set! (.camera c) (model/reset-zoom (.camera c))) (project! c)))
