(module jim.main)
(import "jim.dictation" :as dictation)
(import "coil.cc" :as cc)
(import "jim.native" :use *)
(import "jim.terminal" :as terminal)
(import "jim.ghostty" :as g)
(import "jim.workspace" :as workspace)
(import "jim.canvas" :as canvas)
(import "jim.widget-view" :as widget-view)
(import "jim.widget-kit.text" :as text)
(import "jim.widget-kit.wall" :as wall)
(import "jim.storage" :as storage)
(import "jim.original" :as original)
(import "jim.sessions" :as sessions)
(import "jim.projects" :as projects)
(import "jim.sidebar" :as sidebar)
(import "coil.arraylist" :as al)
(import "coil.alloc" :as alloc)
(import "jim.actions" :as actions)
(import "jim.controls" :as controls)
(import "jim.palette" :as palette)
(import "jim.timings" :as timings)
(import "jim.animation" :as animation)
(import "jim.theme" :as theme)
(import "coil.primitive" :as p)
(import "coil.args" :as args)
(import "coil.math" :use [Float])
(import "jim.sky" :as sky)
(import "jim.runtime" :as runtime)
(import "jim.unread" :as unread)
(import "jim.pane-menu" :as pane-menu)
(import "jim.remote" :as remote)
(import "jim.remote-wire" :as wire)
(import "jim.widget-kit.json" :as kit-json)

;;; FACE holds the project in 3D: its PLATE, the solid wall of the cube that
;;; carries the background, and the canvas, whose panes float off the plate
;;; while the cube is shown.
(defstruct ProjectView
  [(id i64) (face (ptr i8)) (plate (ptr i8)) (canvas (ptr canvas/Canvas))])

(defstruct Shell
  [(app (ptr i8))
   (window (ptr i8))
   (root (ptr i8))
   (sidebar (ptr i8))
   (stage (ptr i8))
   ;; Holds the cube twice: as it is and mirrored in the floor.
   (mirror (ptr i8))
   (cube (ptr i8))
   (night sky/Sky)
   (status (ptr i8))
   (heading (ptr i8))
   (projects (al/ArrayList ProjectView))
   (model (ptr i8))
   (notes (ptr i8))
   (theme theme/Theme)
   (width f64)
   (height f64)
   (selected i64)
   (origin i64)
   (overview bool)
   (angle f64)
   (dragging bool)
   ;; The frame to come back to, held for a moment after launch.
   (window-target Rect)
   (window-pending bool)
   (window-settle-until f64)
   (drag-x f64)
   (drag-angle f64)
   ;; The cube's tilt (workspace's tilt), set by dragging up and down from
   ;; DRAG-TILT at DRAG-Y, and how fast it changes in radians per second:
   ;; measured while dragging, then sprung back level after release.
   (tilt f64)
   (tilt-speed f64)
   (drag-y f64)
   (drag-tilt f64)
   ;; The cube's spin in radians per second: measured while dragging, then
   ;; coasting down after release. DRAG-AT and SPIN-AT are when each last ran;
   ;; SPIN-AT also clocks the tilt's spring.
   (spin f64)
   (drag-at f64)
   (spin-at f64)
   ;; Where the pointer went down, so a click can be told from a drag.
   (press Point)
   ;; The overview camera's distance from the ring's axis; scrolling zooms it.
   (view-distance f64)
   ;; True while the stage covers the whole window for the cube, including
   ;; while it dives back into a project.
   (wide bool)
   ;; When the running cube transition ends, or 0 when none is running.
   (settle-at f64)
   ;; Whether every project's panes must be posed again (after a layout).
   (refit bool)
   ;; When config/theme was last changed, as of its last read.
   (stamp f64)
   (maintenance-at f64)
   (running bool)])

(defn shell [] (-> (ptr Shell))
  (p/alloc-static Shell))

(defn count [] (-> i64)
  (len (.projects (shell))))

(defn runtime [(i i64)] (-> ProjectView)
  (get (.projects (shell)) i))

(defn face [(i i64)] (-> (ptr i8))
  (let [r (runtime i)] (.face r)))

(defn project [(i i64)] (-> (ptr canvas/Canvas))
  (let [r (runtime i)] (.canvas r)))

(defn current [] (-> (ptr canvas/Canvas))
  (if (>= (.selected (shell)) 0)
      (project (.selected (shell)))
      (p/cast (ptr canvas/Canvas) 0)))

(defn record [(i i64)] (-> (ptr i8))
  (let [r (runtime i)] (projects/find (projects/list (.model (shell))) (.id r))))

(defn name [(i i64)] (-> (ptr i8))
  (if (>= i 0) (utf8 (storage/get (record i) c"name")) c"No visible project"))

(defn status! [(text (ptr i8))] (-> i64)
  (p/cast i64 (printf c"Jim: %s\n" text)))

;;; ---- the cube's ring ---------------------------------------------------------
;;; The cube is built from the projects the current profile shows, in order:
;;; each has a slot around the ring, and hidden projects have none, so the ring
;;; has no gaps.
(defn shown? [(i i64)] (-> bool)
  (not (projects/hidden? (projects/profile (.model (shell))) (.id (runtime i)))))

(defn ring-count [] (-> i64)
  (let [(mut n) 0]
    (for [i 0 (count)] (when (shown? i) (set! n (+ n 1))))
    (load n)))

;;; Project I's slot: how many shown projects come before it.
(defn ring-slot [(i i64)] (-> i64)
  (let [(mut n) 0]
    (for [k 0 i] (when (shown? k) (set! n (+ n 1))))
    (load n)))

;;; The project in SLOT, or -1 when the ring is empty.
(defn ring-project [(slot i64)] (-> i64)
  (let [(mut found) -1]
    (for [i 0 (count)]
      (when (and (shown? i) (= (ring-slot i) slot)) (set! found i)))
    (load found)))

;;; The cube's rotation that brings project I to the front.
(defn ring-angle [(i i64)] (-> f64)
  (if (< i 0) 0.0 (- 0.0 (workspace/face-angle (ring-slot i) (ring-count)))))

;;; Select the face nearest the front, which Return enters.
(defn select-nearest! [] (-> void)
  (let [s (shell)
        faces (ring-count)
        step (/ 6.283185307179586 (p/cast f64 (if (> faces 0) faces 1)))
        chosen
          (ring-project (workspace/wrap (p/cast i64
                                                (round (/ (- 0.0 (.angle s))
                                                          step)))
                                        faces))]
    (when (>= chosen 0) (set! (.selected s) chosen) 0)
    (do)))

;;; ---- the cube ---------------------------------------------------------------
;;; Jim's cube: each shown project is a face of a ring seen through
;;; workspace's camera, under a night sky with the ring reflected in the
;;; floor. Dragging spins the ring and lets it coast; scrolling moves the
;;; camera in and out; a click dives into the face under the pointer.

;;; Seconds to pull back into the cube, and to dive into a project.
(const ENTER-TIME 0.72)

(const DIVE-TIME 0.55)

;;; Radians of spin, or of tilt, per point dragged. Compiz turned the cube
;;; equally fast both ways.
(const DRAG-RATE 0.006)

;;; A released cube keeps 90% of its spin per 60 Hz frame: it falls by e
;;; every 1/FRICTION seconds, and stops below SPIN-REST radians per second.
(const SPIN-FRICTION 6.32)

(const SPIN-REST 0.01)

;;; Releasing after holding still this long, in seconds, lets go without spin.
(const SPIN-HOLD 0.08)

;;; A press and release closer than this, in points, is a click.
(const CLICK-SLOP 6.0)

;;; Panes float LIFT ×H off their face, and STEP ×H more per place in the
;;; stack (Jim's 0.5 and 0.38 units of a quarter face).
(const PANE-LIFT 0.125)

(const PANE-STEP 0.095)

;;; The reflection's opacity where it meets the cube.
(const REFLECTION 0.45)

(defn spinning? [] (-> bool)
  (let [s (shell)]
    (and (.overview s) (not (.dragging s)) (> (abs (.spin s)) SPIN-REST))))

;;; Whether a released cube is still springing back level. The spring ends
;;; exactly level.
(defn tilting? [] (-> bool)
  (let [s (shell)]
    (and (.overview s)
         (not (.dragging s))
         (or (!= (.tilt s) 0.0) (!= (.tilt-speed s) 0.0)))))

(defn coasting? [] (-> bool)
  (or (spinning?) (tilting?)))

;;; The width of each project's canvas: everything right of the sidebar in a
;;; window WIDTH wide. layout! sizes the faces with it and pose! builds the
;;; cube from it, so the two always agree.
(defn face-width [(width f64)] (-> f64)
  (- width (sidebar/width)))

(defn focal [] (-> f64)
  (* workspace/FOCAL (.height (shell))))

(defn apothem [] (-> f64)
  (workspace/face-radius (ring-count) (face-width (.width (shell)))))

;;; The overview camera's distance before any zoom.
(defn overview-distance [] (-> f64)
  (+ (apothem) (focal) (* workspace/PULLBACK (.height (shell)))))

;;; Where the camera stands now, with the ring turned by YAW and tipped by
;;; TILT, risen so it rests on the floor. Flat, the ring is always level.
(defn camera-view [(yaw f64) (tilt f64)] (-> workspace/View)
  (let [s (shell)]
    (if (.overview s)
        (workspace/View
          :shift 0.0
          :lift (* workspace/LIFT (.height s))
          :distance (.view-distance s)
          :yaw yaw
          :tilt tilt
          :rise
            (workspace/rise (ring-count)
                            (apothem)
                            (* 0.5 (face-width (.width s)))
                            (* 0.5 (.height s))
                            yaw
                            tilt)
          :focal (focal))
        ; Flat: the face exactly over the canvas, which the wide stage holds
        ; half a sidebar right of its center.
        (workspace/View
          :shift (if (.wide s) (* 0.5 (sidebar/width)) 0.0)
          :lift 0.0
          :distance (+ (apothem) (focal))
          :yaw yaw
          :tilt 0.0
          :rise 0.0
          :focal (focal)))))

;;; Height above the stage's bottom where the camera sees world point P.
(defn screen-height [(camera Transform) (p workspace/Vec3)] (-> f64)
  (+ (* 0.5 (.height (shell)))
     (.y (workspace/on-screen (workspace/apply camera p) (focal)))))

;;; Lay the night out for the camera: the floor's far edge is its horizon, and
;;; the fade over the reflection reaches up to the ring's nearest bottom edge.
(defn night! [] (-> void)
  (let [s (shell)
        h (.height s)
        still (workspace/camera-transform (camera-view 0.0 0.0))
        floor (* -0.5 h)]
    (sky/layout! (field s night)
                 (if (.wide s) (.width s) (face-width (.width s)))
                 h
                 (screen-height still
                                (workspace/Vec3
                                  :x 0.0
                                  :y floor
                                  :z (* -1.0 workspace/FLOOR-REACH h)))
                 (screen-height still
                                (workspace/Vec3
                                  :x 0.0
                                  :y floor
                                  :z
                                    (workspace/face-reach (ring-count)
                                                          (face-width (.width s))))))
    (do)))

;;; The stage's center, about which the cube is drawn.
(defn stage-center [] (-> Point)
  (let [s (shell)]
    (Point
      :x (* 0.5 (if (.wide s) (.width s) (face-width (.width s))))
      :y (* 0.5 (.height s)))))

;;; Size the stage for the cube (WIDE: the whole window, over the sidebar) or
;;; for the flat canvas. The ring stays centered in it, and camera-view's
;;; shift keeps a flat face exactly where it was, so this never moves anything
;;; on screen.
;;;
;;; The stage, the reflection, the cube and the faces are views, whose layers
;;; AppKit anchors at their corners and lays out from their frames, resetting
;;; any anchor it finds. Their anchors and positions are left to AppKit; the
;;; transforms carry the centers (workspace/about).
(defn wide! [(wide bool)] (-> void)
  (let [s (shell)
        h (.height s)
        rail (sidebar/width)
        w (if wide (.width s) (face-width (.width s)))]
    (set! (.wide s) wide)
    (frame! (.stage s) (rect (if wide 0.0 rail) 0.0 w h))
    (frame! (.mirror s) (rect 0.0 0.0 w h))
    (frame! (.cube s) (rect 0.0 0.0 w h))
    ; The eye stands where a face exactly fills the window, over the stage's
    ; center.
    (msg i64
         (layer (.stage s))
         (sel c"setSublayerTransform:")
         [Transform]
         (workspace/about (workspace/perspective (focal)) (* 0.5 w) (* 0.5 h)))
    ; The reflection is drawn only while the cube can be seen.
    (msg i64
         (layer (.mirror s))
         (sel c"setInstanceCount:")
         [i64]
         (if wide 2 1))
    (sky/show! (field s night) wide)
    ; Fades over the sidebar run with the cube's transitions; once the stage
    ; is beside it again, it is simply shown.
    (when (not wide) (sidebar/fade! true 0.0))
    (do)))

(defn pose! [(duration f64)] (-> void)
  (let [s (shell)
        h (.height s)
        faces (ring-count)
        radius (apothem)
        camera (workspace/camera-transform (camera-view (.angle s) (.tilt s)))
        ; The reflection mirrors the ring across the floor as the ring is
        ; tipped, so it starts from the level camera: yaw turns about the
        ; floor's normal and commutes with the mirror, but tilt does not.
        level (workspace/camera-transform (camera-view (.angle s) 0.0))
        ; Settled flat, the project lies exactly on the window. Its
        ; transforms are then exactly the identity, which Core Animation
        ; draws without resampling, so text stays sharp.
        flat (not (.wide s))
        identity (CATransform3DMakeTranslation 0.0 0.0 0.0)
        center (stage-center)
        ; The ring's axis is the cube layer's origin; the camera carries it
        ; to the stage's center. Each face is moved onto the axis by half its
        ; size before it is placed around the ring.
        on-stage (CATransform3DMakeTranslation (.x center) (.y center) 0.0)
        half
          (CATransform3DMakeTranslation (* -0.5 (face-width (.width s)))
                                        (* -0.5 h)
                                        0.0)]
    (transform! (layer (.cube s))
                (if flat identity (CATransform3DConcat camera on-stage))
                duration)
    (msg i64
         (layer (.mirror s))
         (sel c"setInstanceTransform:")
         [Transform]
         (workspace/about (workspace/mirror-transform level (* -0.5 h))
                          (.x center)
                          (.y center)))
    (for [i 0 (count)]
      ; Every face of the ring is drawn, turned away or not: the depth test
      ; hides what is behind, and what can be seen past it stays.
      (let [shown (and (shown? i) (or (.wide s) (= i (.selected s))))]
        (transform! (layer (face i))
                    (if (and flat (= i (.selected s)))
                        identity
                        (CATransform3DConcat half
                                             (workspace/face-placement (ring-slot i)
                                                                       faces
                                                                       radius)))
                    duration)
        (msg i64 (face i) (sel c"setHidden:") [i8] (p/cast i8 (if shown 0 1)))
        (when (!= (.visible (project i)) (or (.wide s) (= i (.selected s))))
          (canvas/visibility! (project i) (or (.wide s) (= i (.selected s))))
          0)
        ; Panes are fitted to their faces while the cube is shown. Diving, only
        ; the chosen project lies back down; the others keep the cube's
        ; layout until the dive ends and they are hidden. Only the chosen
        ; project moves with the camera, so only it animates.
        (let [fit (or (.overview s) (and (.wide s) (!= i (.selected s))))]
          (when (or (.refit s) (!= fit (.fitted (project i))))
            (canvas/cube-pose! (project i)
                               fit
                               (* PANE-LIFT h)
                               (* PANE-STEP h)
                               (if (= i (.selected s)) duration 0.0))
            0))))
    (set! (.refit s) false)
    (when (.wide s) (night!) 0)
    ; The fade is laid out for the cube at rest, level on the floor.
    (when (and (.overview s) (= (.settle-at s) 0.0))
      (sky/fade! (field s night) (= (.tilt s) 0.0))
      0)
    (if (.overview s)
        (do
          (if (palette/open?)
              (palette/focus!)
              (do
                (msg i8
                     (.window s)
                     (sel c"makeFirstResponder:")
                     [(ptr i8)]
                     (nil))
                (do)))
          (status! c"Drag to spin   ·   scroll to zoom   ·   click a face or Return to enter   ·   Esc to return"))
        (do
          (if (palette/open?)
              (palette/focus!)
              (if (>= (.selected s) 0)
                  (canvas/focus! (current) (load (field (current) focused)))
                  (do)))
          (status! c"⌘ scroll  Pan   ·   ⌘⌥ scroll / pinch  Zoom   ·   Space / middle drag  Pan   ·   ⌘⇧0  Origin")))
    (do)))

(defn visible-index [(index i64) (direction i64)] (-> i64)
  (let [(mut candidate) (workspace/wrap index (count))]
    (do
      (for [i 0 (count)]
        (let [r (runtime (load candidate))]
          (if (projects/hidden? (projects/profile (.model (shell))) (.id r))
              (set! candidate
                    (workspace/wrap (+ (load candidate) direction) (count)))
              0)))
      (load candidate))))

(defn choose! [(index i64)] (-> i64)
  (let [s (shell)
        selected (visible-index index 1)]
    (set! (.selected s) selected)
    (let [r (runtime selected)] (projects/select! (.model s) (.id r)))
    (sidebar/refresh!)
    selected))

;;; Show project INDEX at once, flat, ending any cube transition.
(defn select! [(index i64)] (-> void)
  (let [s (shell)
        selected (choose! index)]
    (set! (.angle s) (ring-angle selected))
    (set! (.spin s) 0.0)
    (set! (.tilt s) 0.0)
    (set! (.tilt-speed s) 0.0)
    (set! (.overview s) false)
    (set! (.settle-at s) 0.0)
    ;; Project navigation is an immediate swap, including during an
    ;; unfinished cube transition. Suppress implicit visibility changes too.
    (transaction! 0.0)
    (msg i64
         (class c"CATransaction")
         (sel c"setDisableActions:")
         [i8]
         (: 1 i8))
    (when (.wide s) (wide! false) 0)
    (pose! 0.0)
    (commit!)
    (do)))

;;; The angle nearest the cube's current one that faces project I, so a turn
;;; to it goes the short way round.
(defn nearest-angle [(i i64)] (-> f64)
  (let [s (shell)
        tau 6.283185307179586
        turn (- (ring-angle i) (.angle s))
        wrapped (- turn (* tau (round (/ turn tau))))]
    (+ (.angle s) wrapped)))

;;; Pull back from the current project into the cube.
(defn enter! [] (-> void)
  (let [s (shell)]
    (set! (.origin s) (.selected s))
    (set! (.spin s) 0.0)
    (set! (.tilt s) 0.0)
    (set! (.tilt-speed s) 0.0)
    (transaction! 0.0)
    (msg i64
         (class c"CATransaction")
         (sel c"setDisableActions:")
         [i8]
         (: 1 i8))
    (wide! true)
    (pose! 0.0)
    (commit!)
    (set! (.overview s) true)
    (set! (.view-distance s) (overview-distance))
    (sky/fade! (field s night) false)
    ; Set first: pose! leaves the fade hidden while a transition runs.
    (set! (.settle-at s) (+ (animation/animation-now) ENTER-TIME))
    (pose! ENTER-TIME)
    (sidebar/fade! false ENTER-TIME)
    (do)))

;;; Dive from the cube into project INDEX, turning the short way.
(defn dive! [(index i64)] (-> void)
  (let [s (shell)
        selected (choose! index)]
    (set! (.angle s) (nearest-angle selected))
    (set! (.spin s) 0.0)
    (set! (.tilt s) 0.0)
    (set! (.tilt-speed s) 0.0)
    (set! (.dragging s) false)
    (set! (.overview s) false)
    (sky/fade! (field s night) false)
    (set! (.settle-at s) (+ (animation/animation-now) DIVE-TIME))
    (pose! DIVE-TIME)
    (sidebar/fade! true DIVE-TIME)
    (do)))

;;; Finish a cube transition once its animation has run: a dive gives the
;;; window back to the sidebar; an entry shows the reflection's fade.
(defn settle! [] (-> void)
  (let [s (shell)]
    (when (and (> (.settle-at s) 0.0)
               (>= (animation/animation-now) (.settle-at s)))
      (set! (.settle-at s) 0.0)
      (if (.overview s)
          (sky/fade! (field s night) (= (.tilt s) 0.0))
          (do
            (transaction! 0.0)
            (msg i64
                 (class c"CATransaction")
                 (sel c"setDisableActions:")
                 [i8]
                 (: 1 i8))
            (wide! false)
            (pose! 0.0)
            (commit!)
            0))
      0)
    (do)))

(defn toggle! [] (-> void)
  (let [s (shell)]
    (if (.overview s) (dive! (.selected s)) (enter!))))

;;; Where point (X, Y) of a face placed by PLACE lands on screen, from the
;;; stage's center.
(defn face-corner [(camera Transform) (place Transform) (x f64) (y f64)]
  (-> Point)
  (workspace/on-screen (workspace/apply camera
                                        (workspace/apply place
                                                         (workspace/Vec3
                                                           :x x
                                                           :y y
                                                           :z 0.0)))
                       (focal)))

;;; The project whose face is under stage point PT (from the bottom left), or
;;; -1: the nearest face whose outline contains it.
(defn face-at [(pt Point)] (-> i64)
  (let [s (shell)
        faces (ring-count)
        radius (apothem)
        camera (workspace/camera-transform (camera-view (.angle s) (.tilt s)))
        half-w (* 0.5 (face-width (.width s)))
        half-h (* 0.5 (.height s))
        at (Point :x (- (.x pt) (* 0.5 (.width s))) :y (- (.y pt) half-h))
        (mut found) -1
        (mut nearest) -1000000000.0]
    (for [i 0 (count)]
      (let [place (workspace/face-placement (ring-slot i) faces radius)]
        (when (and (shown? i) (workspace/faces-eye? camera place (focal)))
          (let [depth
                  (.z (workspace/apply camera
                                       (workspace/apply place
                                                        (workspace/Vec3
                                                          :x 0.0
                                                          :y 0.0
                                                          :z 0.0))))]
            (when (and (> depth (load nearest))
                       (workspace/quad-contains? at
                                                 (face-corner camera
                                                              place
                                                              (- 0.0 half-w)
                                                              (- 0.0 half-h))
                                                 (face-corner camera
                                                              place
                                                              half-w
                                                              (- 0.0 half-h))
                                                 (face-corner camera
                                                              place
                                                              half-w
                                                              half-h)
                                                 (face-corner camera
                                                              place
                                                              (- 0.0 half-w)
                                                              half-h)))
              (set! found i)
              (set! nearest depth)
              0)))))
    (load found)))

(defn layout! [] (-> void)
  (let [s (shell)
        bounds (msg Rect (.root s) (sel c"bounds") [])
        width (.w bounds)
        height (.h bounds)
        rail (sidebar/width)
        fw (face-width width)
        fh height
        scale (msg f64 (.window s) (sel c"backingScaleFactor") [])
        cfg (.theme s)]
    (do
      (transaction! 0.0)
      (msg i64
           (class c"CATransaction")
           (sel c"setDisableActions:")
           [i8]
           (: 1 i8))
      (set! (.width s) width)
      (set! (.height s) height)
      (sidebar/layout! height)
      (frame! (.heading s) (rect (+ rail 32.0) (- height 44.0) 450.0 24.0))
      (frame! (.status s)
              (rect (+ rail 32.0) 10.0 (- width (+ rail 45.0)) 20.0))
      (for [i 0 (count)]
        (do
          (frame! (face i) (rect 0.0 0.0 fw fh))
          (frame! (.plate (runtime i)) (rect 0.0 0.0 fw fh))
          ; A face is the project's own background, solid, as in Jim.
          (background! (.plate (runtime i))
                       (.canvas-r cfg)
                       (.canvas-g cfg)
                       (.canvas-b cfg))
          (canvas/resize! (project i) fw fh scale)))
      (wide! (.wide s))
      (background! (.root s) (.canvas-r cfg) (.canvas-g cfg) (.canvas-b cfg))
      (background! (.view (sidebar/state))
                   (.rail-r cfg)
                   (.rail-g cfg)
                   (.rail-b cfg))
      (for [i 0 (count)] (canvas/apply-theme! (project i) cfg))
      (palette/layout!)
      (when (.overview s) (set! (.view-distance s) (overview-distance)) 0)
      (set! (.refit s) true)
      (pose! 0.0)
      (commit!)
      (do))))

;;; Read config/theme again and apply it. A file that is not a theme keeps the
;;; last good one, and Jim says why.
(defn theme-load! [] (-> void)
  (let [s (shell)
        (mut problem) (al/ArrayList::new [u8] (alloc/malloc-allocator))]
    (if (theme/load! "config/theme" (field s theme) (mut problem))
        (do (layout!) (status! c"Theme applied"))
        (do
          (theme/push-str! (mut problem) "; keeping the last good theme")
          (push! [u8] (mut problem) (: 0 u8))
          (printf c"Jim: config/theme: %s\n"
                  (p/cast (ptr i8) (data (slice problem))))
          0))
    (al/ArrayList::free! (mut problem))
    (do)))

;;; The session of the focused terminal, or nil if the focus isn't one.
(defn focused-session [] (-> (ptr i8))
  (if (and (>= (.selected (shell)) 0)
           (!= (p/cast i64 (.focused (current))) 0)
           (not (canvas/widget? (.focused (current)))))
      (.session-id (canvas/term-of (.focused (current))))
      (nil)))

(defn dictation-toggle! [] (-> void)
  (dictation/toggle! (.root (shell))
                     (focused-session)
                     (palette/open?)
                     (timings/now))
  (do))

;;; The surface of the session being dictated into, wherever it is now.
(defn dictation-surface [] (-> (ptr i8))
  (let [(mut found) (nil)
        id (dictation/target)]
    (when (!= (p/cast i64 id) 0)
      (for [i 0 (count)]
        (let [surface (canvas/surface-of-session (project i) id)]
          (when (!= (p/cast i64 surface) 0) (set! found surface) 0))))
    (load found)))

(defn background-maintenance! [] (-> void)
  (let [s (shell)
        bounds (msg Rect (.root s) (sel c"bounds") [])]
    (do
      (if (or (< (.width s) (.w bounds))
              (> (.width s) (.w bounds))
              (< (.height s) (.h bounds))
              (> (.height s) (.h bounds)))
          (layout!)
          (do))
      (let [manager
              (msg (ptr i8) (class c"NSFileManager") (sel c"defaultManager") [])
            attrs
              (msg (ptr i8)
                   manager
                   (sel c"attributesOfItemAtPath:error:")
                   [(ptr i8) (ptr i8)]
                   (ns c"config/theme")
                   (nil))
            date
              (msg (ptr i8)
                   attrs
                   (sel c"objectForKey:")
                   [(ptr i8)]
                   (ns c"NSFileModificationDate"))
            stamp (msg f64 date (sel c"timeIntervalSince1970") [])]
        (if (> stamp (.stamp s))
            (do (set! (.stamp s) stamp) (theme-load!))
            (do))))))

(defn save-layout! [] (-> bool)
  (do
    (for [i 0 (count)]
      (storage/put! (record i) c"layout" (canvas/snapshot (project i))))
    (let [ok (storage/write! (.model (shell)))]
      (do
        (if ok (for [i 0 (count)] (set! (.dirty (project i)) false)) 0)
        ok))))

(defn sync-selection! [] (-> void)
  (let [s (shell)]
    (do
      (set! (.selected s) -1)
      (for [i 0 (count)]
        (let [r (runtime i)]
          (if (= (.id r) (projects/active (.model s))) (set! (.selected s) i) 0)))
      (set! (.angle s) (ring-angle (.selected s)))
      (set! (.spin s) 0.0)
      (set! (.overview s) false)
      (set! (.settle-at s) 0.0)
      (when (.wide s) (wide! false) 0)
      (layout!)
      (if (save-layout!)
          (do)
          (do (status! c"Could not save project layout") (do))))))

(defn delete-project! [(wanted i64)] (-> void)
  (let [s (shell)
        (mut index) -1]
    (do
      (for [i 0 (count)]
        (let [r (runtime i)] (if (= (.id r) wanted) (set! index i) 0)))
      (if (>= (load index) 0)
          (let [index (load index)
                r (runtime index)
                deleted-name (storage/get (record index) c"name")]
            (do
              (printf c"Jim: deleting project %s and closing its terminals\n"
                      (utf8 deleted-name))
              (let [c (.canvas r)]
                (while (> (canvas/count c) 0)
                  (canvas/close! c (canvas/pane c 0))))
              (projects/delete-project! (.model s) (.id r))
              (when (unread/clear! (unread/shared) (.id r))
                (show-unread!))
              (canvas/free! (.canvas r))
              (msg i64 (.face r) (sel c"removeFromSuperview") [])
              (for [i index (- (count) 1)]
                (set! (mut (.projects s)) i (runtime (+ i 1))))
              (pop! [ProjectView] (mut (.projects s)))
              (sync-selection!)))
          (do)))))

(defn new-project! [] (-> void)
  (let [s (shell)
        record (projects/new-project! (.model s) (ns c"Project"))]
    (do
      (storage/put! record
                    c"name"
                    (indexed-string c"Project " (projects/id record) c""))
      (add-project-view! record)
      (sync-selection!))))

;;; The saved projects the import picker is offering, by id, in the picker's order.
(defn import-choices [] (-> (ptr (ptr i8)))
  (p/alloc-static (ptr i8)))

;;; Offer the projects original Jim saved that still have something to bring across.
(defn choose-original-project! [] (-> void)
  (let [s (shell)
        model (.model s)
        state (original/read-state)]
    (if (= (p/cast i64 state) 0)
        (do (status! c"No saved state from original Jim") (do))
        (let [check-alive (not (sessions/original-running?))]
          ; Imported terminals are recognized from the saved layouts.
          (save-layout!)
          (let [ids (original/choices model state check-alive)
                titles (storage/array)]
            (if (= (storage/count ids) 0)
                (do (status! c"Nothing left to import from original Jim") (do))
                (do
                  (for [i 0 (storage/count ids)]
                    (storage/add! titles
                                  (original/choice-title model
                                                         state
                                                         (projects/find (storage/get state
                                                                                     c"projects")
                                                                        (p/cast i64
                                                                                (msg f64
                                                                                     (storage/at ids
                                                                                                 i)
                                                                                     (sel c"doubleValue")
                                                                                     [])))
                                                         check-alive)))
                  (release (load (import-choices)))
                  (set! (import-choices) (msg (ptr i8) ids (sel c"retain") []))
                  (palette/pick! c"Import a project from original Jim…"
                                 titles)
                  (do))))))))

;;; Bring one saved project across and show it: it joins a project of the same name if
;;; there is one, with every terminal of it still running. Original Jim being open
;;; leaves the terminals with it. Importing the project again later brings them.
(defn import-original-project! [(picked i64)] (-> void)
  (let [s (shell)
        model (.model s)
        state (original/read-state)
        wanted
          (p/cast i64
                  (msg f64
                       (storage/at (load (import-choices)) picked)
                       (sel c"doubleValue")
                       []))
        from
          (if (= (p/cast i64 state) 0)
              (nil)
              (projects/find (storage/get state c"projects") wanted))]
    (if (= (p/cast i64 from) 0)
        (do
          (status! c"That project is no longer in original Jim's saved state")
          (do))
        (let [running (sessions/original-running?)
              existing (original/project-named model (original/name-of from))
              record
                (if (= (p/cast i64 existing) 0)
                    (let [created (original/add-project! model from)]
                      (add-project-view! created)
                      created)
                    existing)
              c (canvas-of (projects/id record))
              shift (canvas/right-edge c)
              waiting (original/pending-terminals model state from false)
              panes
                (if running
                    (storage/array)
                    (original/pending-terminals model state from true))]
          (for [i 0 (storage/count panes)]
            (let [pane (storage/at panes i)]
              (canvas/add-session! c
                                   (original/bounds pane shift)
                                   (sessions/identifier)
                                   (original/session-id pane))
              0))
          (projects/hide! model (projects/id record) false)
          (projects/select! model (projects/id record))
          (sync-selection!)
          (status! (cond (and running (> (storage/count waiting) 0))
                           c"Project imported. Quit original Jim and import it again for its terminals"
                         (= (storage/count panes) 0) c"Project imported"
                         :else
                           (utf8 (indexed-string c"Project imported with terminals: "
                                                 (storage/count panes)
                                                 c""))))
          (do)))))

(defn canvas-of [(wanted i64)] (-> (ptr canvas/Canvas))
  (let [(mut found) (project 0)]
    (for [i 0 (count)]
      (when (= (.id (runtime i)) wanted) (set! found (project i)) 0))
    (load found)))

(defn add-project-view! [(record (ptr i8))] (-> bool)
  (let [s (shell)
        f
          (layer-view (.cube s)
                      (rect 0.0 0.0 1032.0 736.0)
                      c"CATransformLayer")
        ; Before the canvas, so it lies behind the panes.
        plate (view f (rect 0.0 0.0 1032.0 736.0))
        c (canvas/create! f 1032.0 736.0 (.theme s))
        saved (storage/get record c"layout")]
    (do
      ; Behind the canvas's edge shadows (-1) in the face's 3D space.
      (msg i64 (layer plate) (sel c"setZPosition:") [f64] -2.0)
      (msg i64
           (layer plate)
           (sel c"setBorderColor:")
           [(ptr i8)]
           (msg (ptr i8) (color 1.0 1.0 1.0 0.18) (sel c"CGColor") []))
      (release (.directory c))
      (set! (.directory c)
            (msg (ptr i8) (storage/get record c"directory") (sel c"retain") []))
      (push! [ProjectView]
             (mut (.projects s))
             (ProjectView
               :id (projects/id record)
               :face f
               :plate plate
               :canvas c))
      (if (canvas/restorable? saved) (canvas/restore! c saved) true))))

;;; ---- moving panes between projects and the pane menu -----------------------------

;;; Move pane V of project FROM to project TO, by index. It is shown there when TO is.
(defn move-pane! [(from i64) (v (ptr canvas/Pane)) (to i64)] (-> void)
  (canvas/transfer! (project from) (project to) v)
  (printf c"Jim: moved a pane from %s to %s\n" (name from) (name to))
  (do))

;;; Open the pane menu if mouse EVENT is a secondary click that opens one, for the pane
;;; under it in the selected project. Whether it did.
(defn pane-menu! [(event (ptr i8))] (-> bool)
  (let [s (shell)
        c (current)
        v (canvas/menu-pane c event)]
    (if (= (p/cast i64 v) 0)
        false
        (let [(mut destinations)
                (al/ArrayList::new [pane-menu/Destination]
                                   (alloc/malloc-allocator))]
          ; The projects the profile shows, like every other switcher.
          (for [i 0 (count)]
            (when (and (!= i (.selected s)) (shown? i))
              (push! (mut destinations)
                     (pane-menu/Destination
                       :project (.id (runtime i))
                       :name (storage/get (record i) c"name")))))
          (canvas/clear-resize-cursor!)
          (pane-menu/show! event
                           (.view c)
                           (.id (runtime (.selected s)))
                           (.id v)
                           (.pinned v)
                           (slice destinations))
          (al/ArrayList::free! (mut destinations))
          true))))

;;; Carry out what was picked from the pane menu. The pane, or the project to move it
;;; to, may have gone while the menu was open; then there is nothing to do.
(defn apply-pane-menu! [(chosen pane-menu/Choice)] (-> void)
  (let [index (index-of-project (.project chosen))
        v
          (if (>= index 0)
              (canvas/pane-with-id (project index) (.pane chosen))
              (p/cast (ptr canvas/Pane) 0))
        action (.action chosen)]
    (when (!= (p/cast i64 v) 0)
      (cond (= action pane-menu/PIN) (canvas/pin! (project index) v)
            (= action pane-menu/UNPIN) (canvas/unpin! (project index) v)
            (= action pane-menu/CLOSE) (canvas/close! (project index) v)
            (= action pane-menu/MOVE)
              (let [to (index-of-project (.destination chosen))]
                (when (>= to 0) (move-pane! index v to) 0)
                (do))
            :else (do))
      0)
    (do)))

;;; Advance a coasting cube to now: its spin slows and its tilt springs back.
(defn coast! [] (-> void)
  (let [s (shell)]
    (if (coasting?)
        (let [now (animation/animation-now)
              ; A stalled frame resumes smoothly instead of jumping.
              dt (min (- now (.spin-at s)) 0.05)]
          (when (spinning?)
            (set! (.angle s) (+ (.angle s) (* (.spin s) dt)))
            (set! (.spin s) (* (.spin s) (exp (- 0.0 (* SPIN-FRICTION dt)))))
            0)
          (when (tilting?)
            (let [sprung
                    (workspace/spring-tilt (workspace/Tilt
                                             :angle (.tilt s)
                                             :speed (.tilt-speed s))
                                           dt)]
              (set! (.tilt s) (.angle sprung))
              (set! (.tilt-speed s) (.speed sprung))
              0))
          (set! (.spin-at s) now)
          (select-nearest!)
          (pose! 0.0))
        ; Not coasting. Leave the spin and tilt alone: while dragging they
        ; hold the speeds being measured for the throw.
        0)
    (do)))

;;; Show the counts wherever they appear: each project's in the sidebar, their total on
;;; the Dock icon.
(defn show-unread! [] (-> void)
  (let [total (unread/total (unread/shared))]
    (sidebar/show-counts!)
    (msg i64
         (msg (ptr i8) (.app (shell)) (sel c"dockTile") [])
         (sel c"setBadgeLabel:")
         [(ptr i8)]
         (if (> total 0) (indexed-string c"" total c"") (nil)))
    (do)))

;;; A terminal asking for attention counts against its project unless the project is
;;; already in front of the user, and bringing a project in front of them clears it.
(defn track-unread! [] (-> void)
  (let [s (shell)
        counts (unread/shared)
        active (projects/active (.model s))
        looking (!= (msg i8 (.app s) (sel c"isActive") []) (: 0 i8))
        (mut changed) false]
    (for [i 0 (count)]
      (let [id (.id (runtime i))
            bells (canvas/take-bells! (project i))]
        (when (and (> bells 0) (not (and looking (= id active))))
          (unread/add! counts id bells)
          (set! changed true))))
    (when (and looking (unread/clear! counts active))
      (set! changed true))
    (when (load changed) (show-unread!))))

(defn maintenance! [] (-> void)
  (let [s (shell)
        bounds (msg Rect (.root s) (sel c"bounds") [])
        now (animation/animation-now)]
    (do
      (hold-window-frame! now)
      (coast!)
      (settle!)
      (track-unread!)
      (if (or (< (.width s) (.w bounds))
              (> (.width s) (.w bounds))
              (< (.height s) (.h bounds))
              (> (.height s) (.h bounds)))
          (layout!)
          (do))
      (dictation/pump! (.root s) (dictation-surface) now)
      (let [reloaded (widget-view/maintain! now (> now (.maintenance-at s)))]
        (for [i 0 (count)]
          (canvas/widgets-serve! (project i))
          (canvas/settle-expose! (project i) now))
        (cond (< reloaded 0)
                (status! c"Widget edit rejected · previous version still running")
              (> reloaded 0) (status! c"Widget reloaded · state preserved")
              :else 0))
      (if (> now (.maintenance-at s))
          (do
            (set! (.maintenance-at s) (+ now 0.2))
            (background-maintenance!)
            (remember-window-frame!)
            (let [(mut dirty) false
                  (mut dragging) false]
              (do
                (for [i 0 (count)]
                  (do
                    (if (.dirty (project i)) (set! dirty true) 0)
                    (if (> (.gesture (project i)) 0) (set! dragging true) 0)))
                (if (and (load dirty) (not (load dragging)))
                    (if (not (save-layout!))
                        (status! c"Could not save canvas layout")
                        0)
                    0)))
            (if (= (msg i8 (.app s) (sel c"isActive") []) (: 0 i8))
                (for [i 0 (count)]
                  (do
                    (set! (.space-held (project i)) false)
                    (set! (.gesture (project i)) 0)))
                0)
            (let [manager
                    (msg (ptr i8)
                         (class c"NSFileManager")
                         (sel c"defaultManager")
                         [])]
              (if (!= (msg i8
                           manager
                           (sel c"fileExistsAtPath:")
                           [(ptr i8)]
                           (ns c"build/quit-request"))
                      (: 0 i8))
                  (do
                    (msg i8
                         manager
                         (sel c"removeItemAtPath:error:")
                         [(ptr i8) (ptr i8)]
                         (ns c"build/quit-request")
                         (nil))
                    (set! (.running s) false))
                  0)))
          0)
      (do))))

(defn canvas-action! [(id i64)] (-> void)
  (cond (= id 0)
          (do
            (if (.overview (shell)) (select! (.selected (shell))) (do))
            (if (not (canvas/add-visible! (current)))
                (status! c"Could not start terminal")
                0)
            (do))
        (= id 1)
          (let [focused (load (field (current) focused))]
            (if (!= (p/cast i64 focused) 0)
                (canvas/close! (current) focused)
                (do)))
        (= id 2) (canvas/home! (current))
        (= id 3) (canvas/reset-zoom! (current))
        (= id 4) (canvas/fit! (current))
        (= id 5) (canvas/zoom-key! (current) 1.1)
        (= id 6) (canvas/zoom-key! (current) (/ 1.0 1.1))
        (= id 7)
          (let [enabled (not (.zoom-enabled (current)))]
            (do
              (for [i 0 (count)]
                (do
                  (set! (.zoom-enabled (project i)) enabled)
                  (canvas/project! (project i))))
              (do)))
        (= id 8) (if (>= (.selected (shell)) 0) (toggle!) (do))
        (= id 9) (theme-load!)
        (= id 10) (timings/toggle!)
        (= id 31) (dictation-toggle!)
        (= id 29)
          (when (and (>= (.selected (shell)) 0) (not (.overview (shell))))
            (canvas/toggle-expose! (current)))
        (and (>= id 11) (< id 15))
          (do
            (projects/select! (.model (shell))
                              (projects/visible-id (.model (shell)) (- id 11)))
            (sync-selection!))
        :else (do)))

;;; ANSWER as a directory that exists, tilde expanded, or nil.
(defn existing-directory [(answer (ptr i8))] (-> (ptr i8))
  (let [path (msg (ptr i8) answer (sel c"stringByExpandingTildeInPath") [])
        manager
          (msg (ptr i8) (class c"NSFileManager") (sel c"defaultManager") [])
        directory (p/alloc-stack i8)]
    (if (and (!= (msg i8
                      manager
                      (sel c"fileExistsAtPath:isDirectory:")
                      [(ptr i8) (ptr i8)]
                      path
                      directory)
                 (: 0 i8))
             (!= (load directory) (: 0 i8)))
        path
        (nil))))

(defn project-named? [(name (ptr i8))] (-> bool)
  (let [list (projects/list (.model (shell)))
        (mut found) false]
    (for [i 0 (storage/count list)]
      (when (!= (msg i8
                     (storage/get (storage/at list i) c"name")
                     (sel c"isEqualToString:")
                     [(ptr i8)]
                     name)
                (: 0 i8))
        (set! found true)
        0))
    (load found)))

;;; NAME, or NAME with " (2)", " (3)", … if a project already has it.
(defn unused-project-name [(name (ptr i8))] (-> (ptr i8))
  (let [(mut chosen) name
        (mut n) 2]
    (while (project-named? (load chosen))
      (set! chosen
            (indexed-string (utf8 (msg (ptr i8)
                                       name
                                       (sel c"stringByAppendingString:")
                                       [(ptr i8)]
                                       (ns c" (")))
                            (load n)
                            c")"))
      (set! n (+ (load n) 1)))
    (load chosen)))

;;; The palette's "Diff: Open diff wall". The wall gets a project of its own, in
;;; the repository: the answer's repo=PATH, or the current project's directory.
;;; FALLBACK, unless nil, stands in for the current project's directory. BEHIND leaves
;;; the keyboard where it is. What the answer gets wrong is returned to ask about, or
;;; nil when it opened.
(defn open-diff-wall! [(answer (ptr i8)) (fallback (ptr i8)) (behind bool)]
  (-> (ptr i8))
  (let [s (shell)
        model (.model s)
        bytes (widget-view/string-bytes answer)
        (mut spec) (wall/parse-spec bytes)
        (mut kept) (al/ArrayList::new [u8] (alloc/malloc-allocator))
        (mut words) (al/ArrayList::new [(slice u8)] (alloc/malloc-allocator))
        (mut name) (al/ArrayList::new [u8] (alloc/malloc-allocator))
        given
          (if (> (len (.repo spec)) 0)
              (widget-view/string (slice (.repo spec)))
              (cond (!= (p/cast i64 fallback) 0) fallback
                    (>= (.selected s) 0)
                      (storage/get (record (.selected s)) c"directory")
                    :else (ns c"~")))
        directory (existing-directory given)
        (mut wrong) (nil)]
    (cond (> (len (.problem spec)) 0)
            (set! wrong (widget-view/string (slice (.problem spec))))
          (= (p/cast i64 directory) 0)
            (set! wrong (ns c"Directory does not exist; give repo=PATH"))
          :else
            (do
              (wall/words! bytes (mut words))
              (for [i 0 (len words)]
                (when (not (text/starts-with? (get words i) "repo="))
                  (when (> (len kept) 0) (text/push-str! (mut kept) " ") 0)
                  (text/push-str! (mut kept) (get words i))
                  0))
              (wall/push-name! (mut spec)
                               (widget-view/string-bytes directory)
                               (mut name))
              (let [record
                      (projects/new-project! model
                                             (unused-project-name (widget-view/string (slice name))))
                    (mut spec-text)
                      (al/ArrayList::new [u8]
                                         (alloc/malloc-allocator))]
                (storage/put! record c"directory" directory)
                (add-project-view! record)
                (text/push-str! (mut spec-text) "diffwall")
                (when (> (len kept) 0)
                  (text/push-str! (mut spec-text) " ")
                  (text/push-str! (mut spec-text) (slice kept))
                  0)
                (let [c (canvas-of (projects/id record))
                      bounds (rect wall/ORIGIN wall/ORIGIN 640.0 300.0)
                      text (widget-view/string (slice spec-text))]
                  (if behind
                      (do (canvas/add-widget-behind! c bounds text) (do))
                      (do (canvas/add-widget! c bounds text (nil)) (do))))
                (al/ArrayList::free! (mut spec-text))
                (do))))
    (al/ArrayList::free! (mut kept))
    (al/ArrayList::free! (mut words))
    (al/ArrayList::free! (mut name))
    (wall/spec-free! (mut spec))
    (load wrong)))

(defn invoke! [(id i64)] (-> void)
  (let [s (shell)
        model (.model s)]
    (cond (= id -2) (sync-selection!)
          (>= id actions/FIRST-PROJECT)
            (do
              (projects/select! model
                                (projects/id (storage/at (projects/list model)
                                                         (- id
                                                            actions/FIRST-PROJECT))))
              (sync-selection!))
          (= id 15) (new-project!)
          (= id 30) (choose-original-project!)
          (= id 16)
            (if (>= (.selected s) 0)
                (sidebar/rename! (projects/active model))
                (do))
          (= id 17)
            (if (>= (.selected s) 0)
                (do
                  (projects/hide! model (projects/active model) true)
                  (sync-selection!))
                (do))
          (= id 18)
            (if (>= (.selected s) 0)
                (palette/prompt! 18
                                 c"Project directory"
                                 (utf8 (storage/get (record (.selected s))
                                                    c"directory")))
                (do))
          (= id 19)
            (if (and (>= (.selected s) 0)
                     (!= (p/cast i64 (.focused (current))) 0)
                     (not (canvas/widget? (.focused (current)))))
                (let [pane (.focused (current))
                      term (.terminal pane)]
                  (do
                    (storage/put! (record (.selected s))
                                  c"directory"
                                  (.directory term))
                    (release (.directory (current)))
                    (set! (.directory (current))
                          (msg (ptr i8) (.directory term) (sel c"retain") []))
                    (sync-selection!)
                    (status! c"Project directory updated from focused terminal")))
                (do))
          (= id 20) (palette/prompt! 20 c"New profile name" c"")
          (= id 21)
            (palette/prompt! 21
                             c"Rename profile"
                             (utf8 (storage/get (projects/profile model)
                                                c"name")))
          (= id 22)
            (do
              (if (projects/delete-profile! model)
                  (sync-selection!)
                  (do (status! c"Keep at least one profile") (do)))
              (do))
          (= id 23)
            (do
              (set! (.show-hidden (sidebar/state))
                    (not (.show-hidden (sidebar/state))))
              (sidebar/refresh!))
          (or (= id 24) (= id 25))
            (let [profiles (projects/profiles model)
                  index
                    (msg i64
                         profiles
                         (sel c"indexOfObject:")
                         [(ptr i8)]
                         (projects/profile model))
                  next
                    (workspace/wrap (+ index (if (= id 24) -1 1))
                                    (storage/count profiles))]
              (do
                (sidebar/transition! (if (= id 24)
                                         (- 0.0 (sidebar/width))
                                         (sidebar/width)))
                (projects/switch-profile! model
                                          (projects/id (storage/at profiles
                                                                   next)))
                (sync-selection!)))
          (= id 27)
            (when (and (>= (.selected s) 0)
                       (!= (p/cast i64 (.focused (current))) 0))
              (if (canvas/reconnect! (current) (.focused (current)))
                  (do (status! c"Terminal reconnected") (do))
                  (do
                    (status! c"Cannot reconnect terminal; saved session retained")
                    (do))))
          (= id 28)
            (if (>= (.selected s) 0)
                (palette/prompt! 28
                                 c"Widget: NAME [ARGS] — e.g. diff, stage, branches, editor notes.md"
                                 c"")
                (do (status! c"Create or show a project first") (do)))
          (= id 33)
            (if (>= (.selected s) 0)
                (widget-view/choose-file-then! (.window s)
                                               (widget-view/string-bytes (.directory (current)))
                                               (p/cast (ptr i8)
                                                       (fnptr-of open-chosen-in-editor)))
                (do (status! c"Create or show a project first") (do)))
          (= id 34)
            (if (>= (.selected s) 0)
                ; A note with no file: its text is kept with the layout.
                (do (canvas/add-widget-visible! (current) (ns c"editor")) (do))
                (do (status! c"Create or show a project first") (do)))
          (= id 32)
            (palette/prompt! 32
                             c"Diff wall: working, staged, unstaged, range BASE, or pr N; per=hunk path=GLOB exclude=GLOB repo=PATH"
                             c"working")
          (= id 26)
            (let [requested (sidebar/take-delete-project!)]
              (delete-project! (if (> requested 0)
                                   requested
                                   (projects/active model))))
          (or (= id 9) (= id 10) (and (>= id 11) (< id 15))) (canvas-action! id)
          (>= (.selected s) 0) (canvas-action! id)
          :else (do (status! c"Create or show a project first") (do)))))

;;; Open PATH, an NSString, in a new editor pane on the current canvas.
(defn open-in-editor! [(path (ptr i8))] (-> void)
  (canvas/add-widget-visible! (current)
                              (msg (ptr i8)
                                   (ns c"editor ")
                                   (sel c"stringByAppendingString:")
                                   [(ptr i8)]
                                   path))
  (do))

;;; The Open sheet of Editor: Open file… was answered with PATH.
(defn open-chosen-in-editor [(path (ptr i8))] (-> void)
  (if (>= (.selected (shell)) 0)
      (open-in-editor! path)
      (do (status! c"Create or show a project first") (do))))

(export-c [open-chosen-in-editor :as "jim_open_chosen_in_editor"])

;;; Whether answering action ID needs a project to be selected.
(defn answer-needs-project? [(id i64)] (-> bool)
  (or (= id 16) (= id 18) (= id 28)))

;;; Give the actions that ask a question their answer, TEXT, which isn't empty. What's
;;; wrong with it is returned, or nil when it was taken.
(defn answer! [(id i64) (text (ptr i8))] (-> (ptr i8))
  (let [s (shell)
        model (.model s)
        (mut problem) (nil)]
    (cond (and (answer-needs-project? id) (< (.selected s) 0))
            (set! problem (ns c"Create or show a project first"))
          (= id 15)
            (do
              (add-project-view! (projects/new-project! model text))
              (do))
          (= id 16) (do (storage/put! (record (.selected s)) c"name" text) (do))
          (= id 18)
            (let [path (existing-directory text)]
              (if (!= (p/cast i64 path) 0)
                  (do
                    (storage/put! (record (.selected s)) c"directory" path)
                    (release (.directory (current)))
                    (set! (.directory (current))
                          (msg (ptr i8) path (sel c"retain") []))
                    (do))
                  (set! problem
                        (ns c"Directory does not exist; enter a directory"))))
          (= id 20) (projects/new-profile! model text)
          (= id 28)
            (do
              (canvas/add-widget-visible! (current) text)
              (do))
          (= id 32) (set! problem (open-diff-wall! text (nil) false))
          (= id 21)
            (do (storage/put! (projects/profile model) c"name" text) (do))
          :else (do))
    (sync-selection!)
    (load problem)))

(defn trimmed [(input (ptr i8))] (-> (ptr i8))
  (msg (ptr i8)
       input
       (sel c"stringByTrimmingCharactersInSet:")
       [(ptr i8)]
       (msg (ptr i8)
            (class c"NSCharacterSet")
            (sel c"whitespaceAndNewlineCharacterSet")
            [])))

(defn submit! [(id i64) (input (ptr i8))] (-> void)
  (let [text (trimmed input)]
    (if (= (msg u64 text (sel c"length") []) 0)
        (palette/prompt! id c"Please enter a nonempty value" c"")
        (let [problem (answer! id text)]
          (when (!= (p/cast i64 problem) 0)
            (palette/prompt! id (utf8 problem) (utf8 text))
            0)
          (do)))))

;;; ---- jimc -------------------------------------------------------------------------

;;; What `jimc` can ask for, one request at a time from the main loop. A command returns
;;; what's wrong as an NSString, or nil after adding its reply's members to OUT. None of
;;; them activates the app, and only those asked to switch project or focus a pane move
;;; the keyboard, so a script never pulls it out from under someone typing.
(extern getpid :cc (cc/C) [] (-> i32))

(defn remote-cell [] (-> (ptr (ptr remote/Server)))
  (p/alloc-static (ptr remote/Server)))

(defn remote-start! [] (-> void)
  (msg i8
       (msg (ptr i8) (class c"NSFileManager") (sel c"defaultManager") [])
       (sel c"createDirectoryAtPath:withIntermediateDirectories:attributes:error:")
       [(ptr i8) i8 (ptr i8) (ptr i8)]
       (msg (ptr i8)
            (ns c"~/.jim-coil")
            (sel c"stringByExpandingTildeInPath")
            [])
       (: 1 i8)
       (nil)
       (nil))
  (let [server
          (remote/listen! (utf8 (msg (ptr i8)
                                     (ns c"~/.jim-coil/control/socket")
                                     (sel c"stringByExpandingTildeInPath")
                                     [])))]
    (store! (remote-cell) server)
    (if (= (p/cast i64 server) 0)
        (do (printf c"Jim: jimc has no socket; see the session log\n") (do))
        (remote/watch! server
                       (p/cast (ptr i8) (fnptr-of widget-view/wake-main))))))

(defn remote-stop! [] (-> void)
  (when (!= (p/cast i64 (load (remote-cell))) 0)
    (remote/close! (load (remote-cell)))
    (store! (remote-cell) (p/cast (ptr remote/Server) 0))
    (do)))

(defn joined [(start (ptr i8)) (end (ptr i8))] (-> (ptr i8))
  (msg (ptr i8) (ns start) (sel c"stringByAppendingString:") [(ptr i8)] end))

(defn request-string [(r (ptr kit-json/Reply)) (key (slice u8))] (-> (ptr i8))
  (let [(mut bytes) (al/ArrayList::new [u8] (alloc/malloc-allocator))
        found
          (kit-json/string-into! r
                                 (kit-json/get r (kit-json/root r) key)
                                 (mut bytes))
        value (if found (widget-view/string (slice bytes)) (nil))]
    (al/ArrayList::free! (mut bytes))
    value))

(defn request-i64 [(r (ptr kit-json/Reply)) (key (slice u8)) (default i64)]
  (-> i64)
  (kit-json/field-i64 r (kit-json/root r) key default))

(defn request-has? [(r (ptr kit-json/Reply)) (key (slice u8))] (-> bool)
  (>= (kit-json/get r (kit-json/root r) key) 0))

(defn request-flag? [(r (ptr kit-json/Reply)) (key (slice u8))] (-> bool)
  (kit-json/field-bool r (kit-json/root r) key false))

(defn same-string? [(a (ptr i8)) (b (ptr i8))] (-> bool)
  (!= (msg i8 a (sel c"isEqualToString:") [(ptr i8)] b) (: 0 i8)))

(defn push-string-field! [(out (ptr (al/ArrayList u8)))
                          (key (slice u8))
                          (value (ptr i8))] (-> void)
  (wire/field-string! out key (widget-view/string-bytes value)))

;;; The project called WANTED, or with that id when no name matches, as an index: -1
;;; when there is none and -2 when several have the name.
(defn project-called [(wanted (ptr i8))] (-> i64)
  (let [(mut found) -1
        (mut named) 0]
    (for [i 0 (count)]
      (when (same-string? (storage/get (record i) c"name") wanted)
        (set! found i)
        (set! named (+ (load named) 1))))
    (when (= (load named) 0)
      (for [i 0 (count)]
        (when (same-string? (indexed-string c"" (.id (runtime i)) c"") wanted)
          (set! found i))))
    (if (> (load named) 1) -2 (load found))))

;;; The index of the project the request names, or else the selected one. When there is
;;; none, -1 with the reason in PROBLEM.
(defn target-project [(r (ptr kit-json/Reply)) (problem (ptr (ptr i8)))]
  (-> i64)
  (let [wanted (request-string r "project")]
    (if (= (p/cast i64 wanted) 0)
        (do
          (when (< (.selected (shell)) 0)
            (set! problem (ns c"No project is selected; pass --project")))
          (.selected (shell)))
        (let [index (project-called wanted)]
          (cond (= index -2)
                  (do
                    (set! problem
                          (joined c"Several projects are named " wanted))
                    -1)
                (= index -1)
                  (do
                    (set! problem (joined c"No project is called " wanted))
                    -1)
                :else index)))))

;;; The pane the request's "pane" names in project INDEX, or null with the reason in
;;; PROBLEM.
(defn target-pane [(r (ptr kit-json/Reply))
                   (index i64)
                   (problem (ptr (ptr i8)))] (-> (ptr canvas/Pane))
  (let [id (request-i64 r "pane" -1)
        v (canvas/pane-with-id (project index) id)]
    (when (= (p/cast i64 v) 0)
      (set! problem
            (indexed-string c"No pane "
                            id
                            c" in that project; see jimc pane list")))
    v))

(defn push-project-members! [(out (ptr (al/ArrayList u8))) (index i64)]
  (-> void)
  (let [s (shell)
        id (.id (runtime index))]
    (wire/field-i64! out "id" id)
    (push-string-field! out "name" (storage/get (record index) c"name"))
    (push-string-field! out
                        "directory"
                        (storage/get (record index) c"directory"))
    (wire/field-bool! out "active" (= index (.selected s)))
    (wire/field-bool! out
                      "hidden"
                      (projects/hidden? (projects/profile (.model s)) id))
    (wire/field-i64! out "panes" (canvas/count (project index)))))

(defn index-of-project [(id i64)] (-> i64)
  (let [(mut found) -1]
    (for [i 0 (count)]
      (when (= (.id (runtime i)) id) (set! found i)))
    (load found)))

;;; One pane's object, as a member called NAME, or an array element when that's "".
(defn push-pane! [(out (ptr (al/ArrayList u8)))
                  (name (slice u8))
                  (c (ptr canvas/Canvas))
                  (v (ptr canvas/Pane))] (-> void)
  (let [bounds (.bounds v)]
    (wire/open-object! out name)
    (wire/field-i64! out "id" (.id v))
    (wire/field-string! out "kind" (if (canvas/widget? v) "widget" "terminal"))
    (push-string-field! out
                        "title"
                        (msg (ptr i8) (.title v) (sel c"stringValue") []))
    (if (canvas/widget? v)
        (push-string-field! out "spec" (widget-view/spec-string (.widget v)))
        (let [t (canvas/term-of v)]
          (when (!= (p/cast i64 (.session-id t)) 0)
            (push-string-field! out "session" (.session-id t)))
          (push-string-field! out "directory" (.directory t))
          (wire/field-bool! out "alive" (!= (p/cast i64 (.surface t)) 0))))
    (wire/field-i64! out "x" (p/cast i64 (.x bounds)))
    (wire/field-i64! out "y" (p/cast i64 (.y bounds)))
    (wire/field-i64! out "w" (p/cast i64 (.w bounds)))
    (wire/field-i64! out "h" (p/cast i64 (.h bounds)))
    (wire/field-bool! out
                      "focused"
                      (= (p/cast i64 (.focused c)) (p/cast i64 v)))
    (wire/field-bool! out "pinned" (.pinned v))
    (wire/close-object! out)))

;;; Where the request asks a pane to go, or else where a new one of this size goes.
(defn requested-bounds [(r (ptr kit-json/Reply))
                        (c (ptr canvas/Canvas))
                        (w f64)
                        (h f64)] (-> Rect)
  (if (request-has? r "x")
      (canvas/storable (p/cast f64 (request-i64 r "x" 0))
                       (p/cast f64 (request-i64 r "y" 0))
                       (p/cast f64 (request-i64 r "w" (p/cast i64 w)))
                       (p/cast f64 (request-i64 r "h" (p/cast i64 h))))
      (canvas/next-bounds c w h)))

;;; After a project was added: show what the model now selects, without leaving the cube
;;; if that's what is on screen and the selection didn't change.
(defn selection-changed! [(switched bool)] (-> void)
  (if (and (not switched) (.overview (shell)))
      (do (layout!) (save-layout!) (do))
      (sync-selection!)))

(defn remote-status! [(out (ptr (al/ArrayList u8)))] (-> (ptr i8))
  (let [s (shell)]
    (wire/field-i64! out "pid" (p/cast i64 (getpid)))
    (wire/field-i64! out
                     "window"
                     (msg i64 (.window s) (sel c"windowNumber") []))
    (push-string-field! out
                        "app"
                        (msg (ptr i8)
                             (msg (ptr i8)
                                  (class c"NSBundle")
                                  (sel c"mainBundle")
                                  [])
                             (sel c"bundlePath")
                             []))
    (wire/field-i64! out "projects" (count))
    (when (>= (.selected s) 0)
      (wire/field-i64! out "project" (.id (runtime (.selected s)))))
    (wire/field-bool! out "overview" (.overview s))
    (nil)))

(defn remote-list-projects! [(out (ptr (al/ArrayList u8)))] (-> (ptr i8))
  (wire/open-array! out "projects")
  (for [i 0 (count)]
    (wire/open-object! out "")
    (push-project-members! out i)
    (wire/close-object! out))
  (wire/close-array! out)
  (nil))

(defn remote-new-project! [(r (ptr kit-json/Reply))
                           (out (ptr (al/ArrayList u8)))]
  (-> (ptr i8))
  (let [s (shell)
        model (.model s)
        name (request-string r "name")
        wanted-directory (request-string r "directory")
        directory
          (if (= (p/cast i64 wanted-directory) 0)
              (nil)
              (existing-directory wanted-directory))
        background (request-flag? r "background")
        before (projects/active model)]
    (cond (or (= (p/cast i64 name) 0)
              (= (msg u64 (trimmed name) (sel c"length") []) (: 0 u64)))
            (ns c"A project needs a name")
          (project-named? name) (joined c"A project is already called " name)
          (and (!= (p/cast i64 wanted-directory) 0)
               (= (p/cast i64 directory) 0))
            (joined c"No such directory: " wanted-directory)
          :else
            (let [created (projects/new-project! model name)
                  id (projects/id created)]
              (when (!= (p/cast i64 directory) 0)
                (storage/put! created c"directory" directory)
                0)
              (add-project-view! created)
              (when background (projects/select! model before))
              (selection-changed! (not background))
              (wire/open-object! out "project")
              (push-project-members! out (index-of-project id))
              (wire/close-object! out)
              (nil)))))

(defn remote-activate-project! [(r (ptr kit-json/Reply))
                                (out (ptr (al/ArrayList u8)))] (-> (ptr i8))
  (let [(mut problem) (nil)
        index (target-project r (mut problem))
        model (.model (shell))]
    (when (>= index 0)
      (let [id (.id (runtime index))]
        (when (projects/hidden? (projects/profile model) id)
          (projects/hide! model id false))
        (projects/select! model id)
        (sync-selection!)
        (wire/open-object! out "project")
        (push-project-members! out (index-of-project id))
        (wire/close-object! out)))
    (load problem)))

(defn remote-set-directory! [(r (ptr kit-json/Reply))
                             (out (ptr (al/ArrayList u8)))] (-> (ptr i8))
  (let [(mut problem) (nil)
        index (target-project r (mut problem))
        wanted (request-string r "directory")
        path (if (= (p/cast i64 wanted) 0) (nil) (existing-directory wanted))]
    (cond (< index 0) (load problem)
          (= (p/cast i64 wanted) 0) (ns c"No directory given")
          (= (p/cast i64 path) 0) (joined c"No such directory: " wanted)
          :else
            (let [c (project index)]
              (storage/put! (record index) c"directory" path)
              (release (.directory c))
              (set! (.directory c) (msg (ptr i8) path (sel c"retain") []))
              (save-layout!)
              (push-string-field! out "directory" path)
              (nil)))))

;;; Deleting ends the project's terminals, so it must be named: never "the current one".
(defn remote-delete-project! [(r (ptr kit-json/Reply))] (-> (ptr i8))
  (let [(mut problem) (nil)
        wanted (request-string r "project")
        index (target-project r (mut problem))]
    (cond (= (p/cast i64 wanted) 0) (ns c"Name the project to delete")
          (< index 0) (load problem)
          :else (do (delete-project! (.id (runtime index))) (nil)))))

(defn remote-list-panes! [(r (ptr kit-json/Reply))
                          (out (ptr (al/ArrayList u8)))] (-> (ptr i8))
  (let [(mut problem) (nil)
        index (target-project r (mut problem))]
    (when (>= index 0)
      (let [c (project index)]
        (wire/field-i64! out "project" (.id (runtime index)))
        (wire/open-array! out "panes")
        (for [i 0 (canvas/count c)]
          (push-pane! out "" c (canvas/pane c i)))
        (wire/close-array! out)))
    (load problem)))

(defn remote-focus-pane! [(r (ptr kit-json/Reply))] (-> (ptr i8))
  (let [(mut problem) (nil)
        index (target-project r (mut problem))
        v
          (if (>= index 0)
              (target-pane r index (mut problem))
              (p/cast (ptr canvas/Pane) 0))]
    (cond (= (p/cast i64 v) 0) (do)
          (.pinned v)
            (set! problem
                  (ns c"That pane is pinned to the background, which takes no keyboard; unpin it first"))
          :else
            (do
              (when (!= index (.selected (shell)))
                (projects/select! (.model (shell)) (.id (runtime index)))
                (sync-selection!))
              (canvas/reveal! (project index) v)))
    (load problem)))

(defn remote-move-pane! [(r (ptr kit-json/Reply)) (out (ptr (al/ArrayList u8)))]
  (-> (ptr i8))
  (let [(mut problem) (nil)
        index (target-project r (mut problem))
        v
          (if (>= index 0)
              (target-pane r index (mut problem))
              (p/cast (ptr canvas/Pane) 0))]
    (when (!= (p/cast i64 v) 0)
      (cond (not (and (request-has? r "x") (request-has? r "y")))
              (set! problem (ns c"Moving a pane needs x and y"))
            :else
              (let [c (project index)
                    now (.bounds v)]
                (canvas/place-pane! c
                                    v
                                    (requested-bounds r c (.w now) (.h now)))
                (push-pane! out "pane" c v))))
    (load problem)))

(defn remote-pin-pane! [(r (ptr kit-json/Reply))
                        (out (ptr (al/ArrayList u8)))
                        (pinned bool)] (-> (ptr i8))
  (let [(mut problem) (nil)
        index (target-project r (mut problem))
        v
          (if (>= index 0)
              (target-pane r index (mut problem))
              (p/cast (ptr canvas/Pane) 0))]
    (when (!= (p/cast i64 v) 0)
      (if pinned
          (canvas/pin! (project index) v)
          (canvas/unpin! (project index) v))
      (push-pane! out "pane" (project index) v))
    (load problem)))

(defn remote-move-pane-to-project! [(r (ptr kit-json/Reply))
                                    (out (ptr (al/ArrayList u8)))] (-> (ptr i8))
  (let [(mut problem) (nil)
        index (target-project r (mut problem))
        v
          (if (>= index 0)
              (target-pane r index (mut problem))
              (p/cast (ptr canvas/Pane) 0))
        wanted (request-string r "to")]
    (when (!= (p/cast i64 v) 0)
      (if (= (p/cast i64 wanted) 0)
          (set! problem (ns c"Moving a pane to a project needs \"to\""))
          (let [to (project-called wanted)]
            (cond (= to -2)
                    (set! problem
                          (joined c"Several projects are named " wanted))
                  (= to -1)
                    (set! problem (joined c"No project is called " wanted))
                  (= to index)
                    (set! problem (ns c"The pane is already in that project"))
                  :else
                    (do
                      (move-pane! index v to)
                      (wire/field-i64! out "project" (.id (runtime to)))
                      (push-pane! out "pane" (project to) v))))))
    (load problem)))

(defn remote-close-pane! [(r (ptr kit-json/Reply))] (-> (ptr i8))
  (let [(mut problem) (nil)
        index (target-project r (mut problem))
        v
          (if (>= index 0)
              (target-pane r index (mut problem))
              (p/cast (ptr canvas/Pane) 0))]
    (when (!= (p/cast i64 v) 0)
      (canvas/close! (project index) v)
      (set! (.dirty (project index)) true))
    (load problem)))

(defn remote-new-terminal! [(r (ptr kit-json/Reply))
                            (out (ptr (al/ArrayList u8)))] (-> (ptr i8))
  (let [(mut problem) (nil)
        index (target-project r (mut problem))
        wanted (request-string r "directory")
        path (if (= (p/cast i64 wanted) 0) (nil) (existing-directory wanted))]
    (cond (< index 0) (load problem)
          (and (!= (p/cast i64 wanted) 0) (= (p/cast i64 path) 0))
            (joined c"No such directory: " wanted)
          :else
            (let [c (project index)
                  v
                    (canvas/add-terminal-behind! c
                                                 (requested-bounds r
                                                                   c
                                                                   640.0
                                                                   430.0)
                                                 (if (= (p/cast i64 path) 0)
                                                     (.directory c)
                                                     path))]
              (push-pane! out "pane" c v)
              (nil)))))

;;; The terminal the request's "pane" names, or null with the reason in PROBLEM.
(defn target-terminal [(r (ptr kit-json/Reply)) (problem (ptr (ptr i8)))]
  (-> (ptr terminal/Terminal))
  (let [index (target-project r problem)
        v
          (if (>= index 0)
              (target-pane r index problem)
              (p/cast (ptr canvas/Pane) 0))]
    (cond (= (p/cast i64 v) 0) (p/cast (ptr terminal/Terminal) 0)
          (canvas/widget? v)
            (do
              (set! problem (ns c"That pane is a widget, not a terminal"))
              (p/cast (ptr terminal/Terminal) 0))
          :else (canvas/term-of v))))

(defn remote-send-text! [(r (ptr kit-json/Reply))] (-> (ptr i8))
  (let [(mut problem) (nil)
        t (target-terminal r (mut problem))
        text (request-string r "text")]
    (cond (= (p/cast i64 t) 0) (load problem)
          (= (p/cast i64 text) 0) (ns c"No text given")
          (terminal/type-text! t (utf8 text) (request-flag? r "enter")) (nil)
          :else (ns c"That terminal has no live session"))))

(defn remote-scroll-terminal! [(r (ptr kit-json/Reply))] (-> (ptr i8))
  (let [(mut problem) (nil)
        t (target-terminal r (mut problem))]
    (cond (= (p/cast i64 t) 0) (load problem)
          (not (request-has? r "lines")) (ns c"No lines given")
          (terminal/wheel! t (request-i64 r "lines" 0)) (nil)
          :else (ns c"That terminal has no live session"))))

(defn remote-read-terminal! [(r (ptr kit-json/Reply))
                             (out (ptr (al/ArrayList u8)))] (-> (ptr i8))
  (let [(mut problem) (nil)
        t (target-terminal r (mut problem))]
    (when (!= (p/cast i64 t) 0)
      (push-string-field! out "text" (terminal/visible-text t)))
    (load problem)))

(defn remote-list-widgets! [(out (ptr (al/ArrayList u8)))] (-> (ptr i8))
  (let [names
          (msg (ptr i8)
               (msg (ptr i8)
                    (msg (ptr i8)
                         (class c"NSFileManager")
                         (sel c"defaultManager")
                         [])
                    (sel c"contentsOfDirectoryAtPath:error:")
                    [(ptr i8) (ptr i8)]
                    (ns c"widgets")
                    (nil))
               (sel c"sortedArrayUsingSelector:")
               [(ptr i8)]
               (sel c"compare:"))]
    (wire/open-array! out "widgets")
    (for [i 0 (storage/count names)]
      (let [file (storage/at names i)]
        (when (!= (msg i8 file (sel c"hasSuffix:") [(ptr i8)] (ns c".coil"))
                  (: 0 i8))
          (wire/comma! out)
          (wire/push-string! out
                             (widget-view/string-bytes (msg (ptr i8)
                                                            file
                                                            (sel c"stringByDeletingPathExtension")
                                                            []))))))
    (wire/close-array! out)
    (nil)))

;;; Whether SPEC's first word is a widget Jim has, which a pane would otherwise only say
;;; once it is open.
(defn known-widget? [(spec (ptr i8))] (-> bool)
  (let [name (widget-view/spec-name (widget-view/string-bytes spec))
        path
          (joined c"widgets/"
                  (msg (ptr i8)
                       (widget-view/string name)
                       (sel c"stringByAppendingPathExtension:")
                       [(ptr i8)]
                       (ns c"coil")))]
    (and (> (len name) 0)
         (not (text/contains? name "/"))
         (!= (msg i8
                  (msg (ptr i8)
                       (class c"NSFileManager")
                       (sel c"defaultManager")
                       [])
                  (sel c"fileExistsAtPath:")
                  [(ptr i8)]
                  path)
             (: 0 i8)))))

(defn remote-open-widget! [(r (ptr kit-json/Reply))
                           (out (ptr (al/ArrayList u8)))] (-> (ptr i8))
  (let [(mut problem) (nil)
        index (target-project r (mut problem))
        spec (request-string r "spec")]
    (cond (< index 0) (load problem)
          (= (p/cast i64 spec) 0) (ns c"No widget given")
          (not (known-widget? spec))
            (joined c"No such widget; see jimc widget list: " spec)
          :else
            (let [c (project index)
                  v
                    (canvas/add-widget-behind! c
                                               (requested-bounds r
                                                                 c
                                                                 760.0
                                                                 600.0)
                                               spec)]
              (canvas/project! c)
              (push-pane! out "pane" c v)
              (nil)))))

(defn remote-diff-wall! [(r (ptr kit-json/Reply)) (out (ptr (al/ArrayList u8)))]
  (-> (ptr i8))
  (let [model (.model (shell))
        before (projects/active model)
        spec (request-string r "spec")
        background (request-flag? r "background")
        problem
          (open-diff-wall! (if (= (p/cast i64 spec) 0) (ns c"working") spec)
                           (request-string r "directory")
                           background)]
    (when (= (p/cast i64 problem) 0)
      (let [created (projects/active model)]
        (when background (projects/select! model before))
        (selection-changed! (not background))
        (wire/open-object! out "project")
        (push-project-members! out (index-of-project created))
        (wire/close-object! out)))
    problem))

(defn remote-fit-canvas! [(r (ptr kit-json/Reply))] (-> (ptr i8))
  (let [(mut problem) (nil)
        index (target-project r (mut problem))]
    (when (>= index 0) (canvas/fit! (project index)))
    (load problem)))

(defn remote-list-actions! [(out (ptr (al/ArrayList u8)))] (-> (ptr i8))
  (wire/open-array! out "actions")
  (for [i 0 (actions/count)]
    (wire/open-object! out "")
    (wire/field-i64! out "id" i)
    (push-string-field! out "title" (ns (actions/title i)))
    (let [shortcut (actions/shortcut i)]
      (when (!= (p/cast i64 shortcut) 0)
        (push-string-field! out "shortcut" (ns shortcut))))
    (wire/close-object! out))
  (wire/close-array! out)
  (nil))

;;; The action whose title is NAME, ignoring case, or -1.
(defn action-called [(name (ptr i8))] (-> i64)
  (let [(mut found) -1]
    (for [i 0 (actions/count)]
      (when (and (< (load found) 0)
                 (= (msg i64
                         (ns (actions/title i))
                         (sel c"caseInsensitiveCompare:")
                         [(ptr i8)]
                         name)
                    0))
        (set! found i)))
    (load found)))

;;; The actions that ask a question before they act, which `action run` can answer.
(defn action-answerable? [(id i64)] (-> bool)
  (or (= id 15)
      (= id 16)
      (= id 18)
      (= id 20)
      (= id 21)
      (= id 28)
      (= id 32)))

(defn remote-run-action! [(r (ptr kit-json/Reply))
                          (out (ptr (al/ArrayList u8)))] (-> (ptr i8))
  (let [name (request-string r "name")
        answer (request-string r "answer")
        id
          (if (= (p/cast i64 name) 0)
              (request-i64 r "id" -1)
              (action-called name))]
    (cond (or (< id 0) (>= id (actions/count)))
            (ns c"No such action; see jimc action list")
          (= (p/cast i64 answer) 0)
            (do
              (invoke! id)
              (wire/field-bool! out "prompted" (palette/open?))
              (nil))
          (not (action-answerable? id)) (ns c"That action takes no answer")
          (= (msg u64 (trimmed answer) (sel c"length") []) (: 0 u64))
            (ns c"The answer is empty")
          :else (answer! id (trimmed answer)))))

(defn remote-message! [(r (ptr kit-json/Reply))] (-> (ptr i8))
  (let [topic (request-string r "topic")
        body (request-string r "body")]
    (if (= (p/cast i64 topic) 0)
        (ns c"No topic given")
        (do
          (widget-view/broadcast! (p/cast (ptr widget-view/WidgetPane) 0)
                                  (widget-view/string-bytes topic)
                                  (if (= (p/cast i64 body) 0)
                                      ""
                                      (widget-view/string-bytes body)))
          (nil)))))

(defn action-is? [(action (ptr i8)) (name (ptr i8))] (-> bool)
  (same-string? action (ns name)))

(defn remote-dispatch [(r (ptr kit-json/Reply)) (out (ptr (al/ArrayList u8)))]
  (-> (ptr i8))
  (if (not (.ok r))
      (ns c"The request is not valid JSON")
      (let [action (request-string r "action")]
        (cond (= (p/cast i64 action) 0) (ns c"The request has no action")
              (action-is? action c"status") (remote-status! out)
              (action-is? action c"list_projects") (remote-list-projects! out)
              (action-is? action c"new_project") (remote-new-project! r out)
              (action-is? action c"activate_project")
                (remote-activate-project! r out)
              (action-is? action c"set_project_directory")
                (remote-set-directory! r out)
              (action-is? action c"delete_project") (remote-delete-project! r)
              (action-is? action c"list_panes") (remote-list-panes! r out)
              (action-is? action c"focus_pane") (remote-focus-pane! r)
              (action-is? action c"move_pane") (remote-move-pane! r out)
              (action-is? action c"close_pane") (remote-close-pane! r)
              (action-is? action c"pin_pane") (remote-pin-pane! r out true)
              (action-is? action c"unpin_pane") (remote-pin-pane! r out false)
              (action-is? action c"move_pane_to_project")
                (remote-move-pane-to-project! r out)
              (action-is? action c"new_terminal") (remote-new-terminal! r out)
              (action-is? action c"send_text") (remote-send-text! r)
              (action-is? action c"read_terminal") (remote-read-terminal! r out)
              (action-is? action c"scroll_terminal") (remote-scroll-terminal! r)
              (action-is? action c"list_widgets") (remote-list-widgets! out)
              (action-is? action c"open_widget") (remote-open-widget! r out)
              (action-is? action c"diff_wall") (remote-diff-wall! r out)
              (action-is? action c"fit_canvas") (remote-fit-canvas! r)
              (action-is? action c"list_actions") (remote-list-actions! out)
              (action-is? action c"run_action") (remote-run-action! r out)
              (action-is? action c"message") (remote-message! r)
              :else (joined c"Unknown action: " action)))))

(defn remote-serve! [(s (ptr remote/Server)) (c (ptr remote/Connection))]
  (-> void)
  (let [(mut r) (kit-json/parse (remote/request c))
        (mut fields) (al/ArrayList::new [u8] (alloc/malloc-allocator))
        (mut reply) (al/ArrayList::new [u8] (alloc/malloc-allocator))
        problem (remote-dispatch (mut r) (mut fields))]
    (if (= (p/cast i64 problem) 0)
        (wire/push-success! (mut reply) (slice fields))
        (wire/push-failure! (mut reply) (widget-view/string-bytes problem)))
    (remote/answer! s c (slice reply))
    (al/ArrayList::free! (mut reply))
    (al/ArrayList::free! (mut fields))
    (kit-json/free! (mut r))))

(defn remote-tick! [] (-> void)
  (let [s (load (remote-cell))]
    (when (and (!= (p/cast i64 s) 0) (remote/due? s))
      (remote/pump! s (timings/now))
      (let [(mut c) (remote/take-request! s)]
        (while (!= (p/cast i64 (load c)) 0)
          (remote-serve! s (load c))
          (set! c (remote/take-request! s)))))))

(defn handle! [(event (ptr i8))] (-> bool)
  (let [s (shell)
        kind (msg i64 event (sel c"type") [])
        flags (msg u64 event (sel c"modifierFlags") [])
        key
          (if (or (= kind 10) (= kind 11))
              (msg u16 event (sel c"keyCode") [])
              (: 0 u16))
        command (!= (& flags 1048576) (: 0 u64))]
    (do
      ;; Space belongs to the keyboard, so releases must reach every project,
      ;; including when the user switches projects or enters the cube.
      (if (and (or (= kind 10) (= kind 11)) (= key (: 49 u16)))
          (for [i 0 (count)]
            (set! (.space-held (project i)) (= kind 10)))
          0)
      (cond ; The Open sheet is AppKit's: typing a file name there is no shortcut.
            (widget-view/sheet-event? event) false
            (and (= kind 10) (= (actions/key-action key flags) 31))
              ; Ahead of the palette, which otherwise swallows it, since dictation can
              ; write there. Holding the keys down must not start and stop it repeatedly.
              (do
                (when (= (msg i8 event (sel c"isARepeat") []) (: 0 i8))
                  (invoke! 31))
                true)
            ; Escape ends dictation and nothing else, whatever has the keyboard.
            (and (= kind 10) (dictation/listening?) (= key (: 53 u16)))
              (do (dictation/stop!) true)
            (and (= kind 10)
                 (or (= key (: 36 u16)) (= key (: 76 u16)))
                 (dictation/holds-return? (.window s)))
              (do (dictation/return!) true)
            (and (= kind 10)
                 (and command
                      (and (!= (& flags 131072) (: 0 u64))
                           (= key (: 35 u16)))))
              (do
                (if (palette/open?)
                    (palette/dismiss!)
                    (do
                      (for [i 0 (count)]
                        (do
                          (set! (.space-held (project i)) false)
                          (set! (.gesture (project i)) 0)))
                      (palette/show!)))
                true)
            (palette/open?)
              (do (canvas/clear-resize-cursor!) (palette/handle! event))
            (sidebar/handle! event) (do (canvas/clear-resize-cursor!) true)
            (timings/owns-event? event) false
            (and (= kind 10) (dictation/typing-ends-it? (.window s)))
              (do (dictation/detach!) false)
            (and (= kind 5) (or (< (.selected s) 0) (.overview s)))
              (do (canvas/clear-resize-cursor!) false)
            (and (>= (.selected s) 0) (not (.overview s)) (pane-menu! event))
              true
            (and (>= (.selected s) 0)
                 (not (.overview s))
                 (canvas/handle! (current) event))
              true
            (= kind 10)
              (let [action (actions/key-action key flags)]
                (cond (and command (= key (: 12 u16)))
                        (do (set! (.running s) false) true)
                      (>= action 0) (do (invoke! action) true)
                      (widget-view/press-key! event) true
                      (.overview s)
                        (do
                          (cond (= key (: 53 u16)) (dive! (.origin s))
                                (= key (: 36 u16)) (dive! (.selected s))
                                (or (= key (: 123 u16))
                                    (= key (: 124 u16)))
                                  (do
                                    (set! (.selected s)
                                          (visible-index (+ (.selected s)
                                                            (if (= key
                                                                   (: 124 u16))
                                                                1
                                                                -1))
                                                         (if (= key
                                                                (: 124 u16))
                                                             1
                                                             -1)))
                                    (set! (.angle s)
                                          (nearest-angle (.selected s)))
                                    (set! (.spin s) 0.0)
                                    (pose! (.duration (.theme s))))
                                :else (do))
                          true)
                      :else false))
            (and (.overview s) (= kind 11)) true
            ; The cube covers the whole window and takes every pointer
            ; event while it is shown. A press in the title bar, above the
            ; content, is the window's: its buttons and its drag.
            (and (.overview s)
                 (or (= kind 1) (= kind 2) (= kind 6) (= kind 22))
                 (not (and (= kind 1)
                           (>= (.y (msg Point
                                        event
                                        (sel c"locationInWindow")
                                        []))
                               (.h (msg Rect (.root s) (sel c"frame") []))))))
              (let [pt (msg Point event (sel c"locationInWindow") [])
                    now (animation/animation-now)]
                (cond (= kind 1)
                        (do
                          ; Grabbing the cube stops any coast, and holds
                          ; its tilt where it is.
                          (set! (.dragging s) true)
                          (set! (.press s) pt)
                          (set! (.drag-x s) (.x pt))
                          (set! (.drag-angle s) (.angle s))
                          (set! (.drag-y s) (.y pt))
                          (set! (.drag-tilt s) (.tilt s))
                          (set! (.spin s) 0.0)
                          (set! (.tilt-speed s) 0.0)
                          (set! (.drag-at s) now)
                          (do))
                      (and (= kind 6) (.dragging s))
                        (let [before (.angle s)
                              tipped (.tilt s)
                              dt (- now (.drag-at s))]
                          (set! (.angle s)
                                (+ (.drag-angle s)
                                   (* (- (.x pt) (.drag-x s)) DRAG-RATE)))
                          ; Dragging down tips the cube's top toward the
                          ; viewer, as Compiz's did.
                          (set! (.tilt s)
                                (workspace/clamp-tilt (- (.drag-tilt s)
                                                         (* (- (.y pt)
                                                               (.drag-y s))
                                                            DRAG-RATE))))
                          ; Smoothed, so one jittery sample does not decide
                          ; the throw.
                          (when (> dt 0.0)
                            (set! (.spin s)
                                  (+ (* 0.6 (/ (- (.angle s) before) dt))
                                     (* 0.4 (.spin s))))
                            (set! (.tilt-speed s)
                                  (+ (* 0.6 (/ (- (.tilt s) tipped) dt))
                                     (* 0.4 (.tilt-speed s))))
                            (set! (.drag-at s) now)
                            0)
                          (pose! 0.0))
                      (and (= kind 2) (.dragging s))
                        (let [dx (- (.x pt) (.x (.press s)))
                              dy (- (.y pt) (.y (.press s)))
                              clicked
                                (< (+ (* dx dx) (* dy dy))
                                   (* CLICK-SLOP CLICK-SLOP))
                              chosen (if clicked (face-at pt) -1)]
                          (set! (.dragging s) false)
                          (if (>= chosen 0)
                              (dive! chosen)
                              (do
                                ; The cube keeps the spin and tilt it was
                                ; thrown with, unless it was held still
                                ; before release. Its tilt then springs back.
                                (when (or clicked
                                          (> (- now (.drag-at s)) SPIN-HOLD))
                                  (set! (.spin s) 0.0)
                                  (set! (.tilt-speed s) 0.0)
                                  0)
                                (set! (.spin-at s) now)
                                (select-nearest!)
                                (pose! 0.0))))
                      (= kind 22)
                        (let [precise
                                (!= (msg i8
                                         event
                                         (sel c"hasPreciseScrollingDeltas")
                                         [])
                                    (: 0 i8))
                              amount
                                (* (msg f64 event (sel c"scrollingDeltaY") [])
                                   (if precise 0.0625 1.0))
                              h (.height s)]
                          ; Scrolling moves the camera in and out, as in Jim.
                          (set! (.view-distance s)
                                (max (min (* (.view-distance s)
                                             (- 1.0 (* 0.08 amount)))
                                          (* 100.0 h))
                                     (+ (apothem) (* 0.2 h))))
                          (pose! 0.0))
                      :else (do))
                true)
            :else false))))

(defn saved-valid? [(saved (ptr i8))] (-> bool)
  (let [version (storage/value saved c"version")
        (mut ok)
          (or (= (p/cast i64 saved) 0)
              (and (= version 1.0)
                   (storage/kind? (projects/list saved) c"NSArray"))
              (and (= version 2.0) (projects/valid? saved)))]
    (do
      (for [i 0 (storage/count (projects/list saved))]
        (let [entry (storage/at (projects/list saved) i)
              layout (if (= version 1.0) entry (storage/get entry c"layout"))]
          (if (and (!= (p/cast i64 layout) 0) (not (canvas/restorable? layout)))
              (set! ok false)
              0)))
      (load ok))))

;;; Seconds after launch that the saved window frame is held.
(const WINDOW-SETTLE 3.0)

;;; Record the window's frame in the saved state when it has changed. Not while full
;;; screen or minimized: those are not the size to come back to.
(defn remember-window-frame! [] (-> void)
  (when (not (.window-pending (shell))) (record-window-frame!) 0)
  (do))

(defn record-window-frame! [] (-> i64)
  (let [s (shell)
        window (.window s)
        r (msg Rect window (sel c"frame") [])
        full-screen
          (!= (& (msg u64 window (sel c"styleMask") []) (: 16384 u64))
              (: 0 u64))
        minimized (!= (msg i8 window (sel c"isMiniaturized") []) (: 0 i8))
        stored (storage/get (.model s) c"window")
        same
          (and (storage/numeric? stored c"width")
               (= (storage/value stored c"x") (.x r))
               (= (storage/value stored c"y") (.y r))
               (= (storage/value stored c"width") (.w r))
               (= (storage/value stored c"height") (.h r)))]
    (when (not (or full-screen minimized same))
      (let [frame (storage/dictionary)]
        (storage/put! frame c"x" (storage/number (.x r)))
        (storage/put! frame c"y" (storage/number (.y r)))
        (storage/put! frame c"width" (storage/number (.w r)))
        (storage/put! frame c"height" (storage/number (.h r)))
        (storage/put! (.model s) c"window" frame)
        (when (> (count) 0) (set! (.dirty (project 0)) true) 0)
        0))
    0))

;;; Stage Manager centers a newly launched window at a size of its own, just after it
;;; appears. For a moment after launch put the saved frame back, and record nothing:
;;; that frame is not one the user chose. Pressing the mouse ends it, as they may be
;;; moving the window themselves.
(defn hold-window-frame! [(now f64)] (-> void)
  (let [s (shell)]
    (when (.window-pending s)
      (when (= (.window-settle-until s) 0.0)
        (set! (.window-settle-until s) (+ now WINDOW-SETTLE))
        0)
      (if (or (> now (.window-settle-until s))
              (!= (msg u64 (class c"NSEvent") (sel c"pressedMouseButtons") [])
                  (: 0 u64)))
          (set! (.window-pending s) false)
          (let [r (msg Rect (.window s) (sel c"frame") [])
                wanted (.window-target s)]
            (when (or (!= (.x r) (.x wanted))
                      (!= (.y r) (.y wanted))
                      (!= (.w r) (.w wanted))
                      (!= (.h r) (.h wanted)))
              (msg i64
                   (.window s)
                   (sel c"setFrame:display:")
                   [Rect i8]
                   wanted
                   (: 1 i8))
              0)
            0))
      0)
    (do)))

;;; The screen a saved frame belongs on: the one holding its center, or the main one.
(defn screen-area [(r Rect)] (-> Rect)
  (let [screens (msg (ptr i8) (class c"NSScreen") (sel c"screens") [])
        (mut found)
          (msg Rect
               (msg (ptr i8) (class c"NSScreen") (sel c"mainScreen") [])
               (sel c"visibleFrame")
               [])
        x (+ (.x r) (/ (.w r) 2.0))
        y (+ (.y r) (/ (.h r) 2.0))]
    (for [i 0 (storage/count screens)]
      (let [screen (storage/at screens i)
            f (msg Rect screen (sel c"frame") [])]
        (when (and (>= x (.x f))
                   (< x (+ (.x f) (.w f)))
                   (>= y (.y f))
                   (< y (+ (.y f) (.h f))))
          (set! found (msg Rect screen (sel c"visibleFrame") []))
          0)))
    (load found)))

;;; Reopen at the saved size, shifted fully on screen. AppKit's own frame autosave is
;;; not used: restoring a window flush with a screen edge, it clamps the window
;;; narrower and then saves that. As original Jim found, a window must be moved to
;;; fit, not shrunk, unless it is larger than the screen.
(defn restore-window-frame! [(window (ptr i8)) (saved (ptr i8))] (-> void)
  (let [stored (storage/get saved c"window")]
    (if (storage/numeric? stored c"width")
        (let [r
                (rect (storage/value stored c"x")
                      (storage/value stored c"y")
                      (max (storage/value stored c"width") 900.0)
                      (max (storage/value stored c"height") 580.0))]
          (let [fitted (fit-rect r (screen-area r))]
            (msg i64
                 window
                 (sel c"setFrame:display:")
                 [Rect i8]
                 fitted
                 (: 0 i8))
            (set! (.window-target (shell)) fitted)
            (set! (.window-pending (shell)) true)
            (do)))
        ; A frame saved by the autosave this replaced.
        (do
          (msg i8 window (sel c"setFrameUsingName:") [(ptr i8)] (ns c"Jim"))
          (do)))))

(defn setup! [] (-> bool)
  (let [s (shell)
        app
          (msg (ptr i8)
               (controls/quiet-class c"NSApplication" c"JimApplication")
               (sel c"sharedApplication")
               [])
        window
          (msg (ptr i8)
               (msg (ptr i8)
                    (controls/quiet-class c"NSWindow" c"JimWindow")
                    (sel c"alloc")
                    [])
               (sel c"initWithContentRect:styleMask:backing:defer:")
               [Rect u64 u64 i8]
               (rect 160.0 120.0 1320.0 860.0)
               15
               2
               (: 0 i8))
        root (msg (ptr i8) window (sel c"contentView") [])
        saved (storage/read)
        cls (objc_allocateClassPair (class c"NSObject") c"JimShellActions" 0)]
    (if (not (saved-valid? saved))
        (let [alert (new c"NSAlert")]
          (do
            (msg i64
                 alert
                 (sel c"setMessageText:")
                 [(ptr i8)]
                 (ns c"Saved projects could not be loaded"))
            (msg i64
                 alert
                 (sel c"setInformativeText:")
                 [(ptr i8)]
                 (ns c"The layout file is invalid. It has been left unchanged at ~/Library/Application Support/JimCoil/layout.json."))
            (msg i64 alert (sel c"runModal") [])
            (release alert)
            false))
        (do
          (set! (.app s) app)
          (set! (.window s) window)
          (set! (.root s) root)
          (set! (.theme s) (theme/defaults))
          (set! (.running s) true)
          (msg i8 app (sel c"setActivationPolicy:") [i64] 0)
          (msg i64 window (sel c"setTitle:") [(ptr i8)] (ns c"Jim · Coil"))
          (msg i64 window (sel c"setReleasedWhenClosed:") [i8] (: 0 i8))
          (msg i64 window (sel c"setMinSize:") [Size] (Size :w 900.0 :h 580.0))
          (restore-window-frame! window saved)
          (msg i64
               window
               (sel c"setAcceptsMouseMovedEvents:")
               [i8]
               (: 1 i8))
          (msg i64
               window
               (sel c"setAppearance:")
               [(ptr i8)]
               (msg (ptr i8)
                    (class c"NSAppearance")
                    (sel c"appearanceNamed:")
                    [(ptr i8)]
                    (ns c"NSAppearanceNameDarkAqua")))
          (msg i64 root (sel c"setWantsLayer:") [i8] (: 1 i8))
          (background! root 0.045 0.057 0.078)
          (set! (.model s)
                (msg (ptr i8) (projects/restore saved) (sel c"retain") []))
          (set! (.projects s)
                (al/ArrayList::new [ProjectView] (alloc/malloc-allocator)))
          (set! (actions/model) (.model s))
          (sidebar/setup! root (.model s))
          (set! (.stage s) (view root (rect 224.0 0.0 1096.0 860.0)))
          ; Back to front: the night, the cube with its reflection, and the
          ; fade over the reflection.
          (set! (.night s) (sky/create! root (.stage s)))
          (set! (.mirror s)
                (layer-view (.stage s)
                            (rect 0.0 0.0 1096.0 860.0)
                            c"CAReplicatorLayer"))
          (msg i64
               (layer (.mirror s))
               (sel c"setPreservesDepth:")
               [i8]
               (: 1 i8))
          (msg i64
               (layer (.mirror s))
               (sel c"setInstanceAlphaOffset:")
               [f32]
               (p/cast f32 (- REFLECTION 1.0)))
          (set! (.cube s)
                (layer-view (.mirror s)
                            (rect 0.0 0.0 1096.0 860.0)
                            c"CATransformLayer"))
          (sky/add-fade! (field s night) root (.stage s))
          ; The sidebar lies over the night and under the cube, so the
          ; stage can widen over it while it fades.
          (msg i64
               root
               (sel c"addSubview:positioned:relativeTo:")
               [(ptr i8) i64 (ptr i8)]
               (.view (sidebar/state))
               -1
               (.stage s))
          (msg i64
               (layer (.stage s))
               (sel c"setMasksToBounds:")
               [i8]
               (: 1 i8))
          ;; Jim Editor keeps the canvas edge clear. Operational status is
          ;; logged instead of creating a persistent hint strip in the UI.
          (set! (.status s) (nil))
          (set! (.heading s) (nil))
          (palette/setup! window)
          (timings/setup! window)
          (msg i64 app (sel c"finishLaunching") [])
          (msg i64 window (sel c"makeKeyAndOrderFront:") [(ptr i8)] (nil))
          (msg i64 app (sel c"activateIgnoringOtherApps:") [i8] (: 1 i8))
          (if (= (p/cast i64 (terminal/start!)) 0)
              false
              (let [(mut ok) true]
                (do
                  (for [i 0 (storage/count (projects/list (.model s)))]
                    (if (not (add-project-view! (storage/at (projects/list (.model s))
                                                            i)))
                        (set! ok false)
                        0))
                  (sync-selection!)
                  (load ok))))))))

(extern popen :cc (cc/C) [(ptr i8) (ptr i8)] (-> (ptr i8)))

(extern pclose :cc (cc/C) [(ptr i8)] (-> i32))

(extern fread :cc (cc/C) [(ptr u8) u64 u64 (ptr i8)] (-> u64))

;;; Apps launched from Finder or `open` inherit launchd's minimal PATH, so the
;;; tools widgets run (jimctl, gh, …) are missing. Adopt the PATH the user's
;;; login shell sets up. Terminals are unaffected: Ghostty starts login shells.
(defn adopt-login-path! [] (-> void)
  (let [pipe
          (popen c"\"${SHELL:-/bin/zsh}\" -lc 'printf %s \"$PATH\"' 2>/dev/null"
                 c"r")
        (mut buffer) (zeroed (array u8 8192))]
    (when (!= (p/cast i64 pipe) 0)
      (let [n (fread (p/cast (ptr u8) (mut buffer)) (: 1 u64) (: 8191 u64) pipe)]
        (pclose pipe)
        (when (> n (: 0 u64))
          (set! (index (p/cast (ptr u8) (mut buffer)) (p/cast i64 n))
                (: 0 u8))
          (setenv c"PATH" (p/cast (ptr i8) (mut buffer)) 1)
          0))
      0)
    (do)))

;;; A release works in its own copy of its files; a development build in this
;;; checkout, where main has already moved.
(defn prepared! [] (-> bool)
  (or (not (runtime/release?)) (runtime/enter-release!)))

(defn start! [] (-> bool)
  (setenv c"GHOSTTY_RESOURCES_DIR" c"build/ghostty/share/ghostty" 1)
  (adopt-login-path!)
  (when (not (widget-view/protect!))
    (printf c"Jim: could not install the widget crash guard.\n")
    0)
  (widget-view/prewarm!)
  (setup!))

(defn main [] (-> i64)
  (let [pool (new c"NSAutoreleasePool")]
    (do
      (let [bundle
              (msg (ptr i8)
                   (msg (ptr i8) (class c"NSBundle") (sel c"mainBundle") [])
                   (sel c"bundlePath")
                   [])]
        (if (and (not (runtime/release?))
                 (!= (msg i8 bundle (sel c"hasSuffix:") [(ptr i8)] (ns c".app"))
                     (: 0 i8)))
            (msg i8
                 (msg (ptr i8)
                      (class c"NSFileManager")
                      (sel c"defaultManager")
                      [])
                 (sel c"changeCurrentDirectoryPath:")
                 [(ptr i8)]
                 (msg (ptr i8)
                      (msg (ptr i8)
                           bundle
                           (sel c"stringByDeletingLastPathComponent")
                           [])
                      (sel c"stringByDeletingLastPathComponent")
                      []))
            (: 0 i8)))
      (cond (not (prepared!))
              (do
                (printf c"Jim: could not copy its files to ~/Library/Application Support/JimCoil/root.\n")
                1)
            (not (start!))
              (do (printf c"Jim: Ghostty initialization failed.\n") 1)
            :else
              (let [s (shell)]
                (do
                  (remote-start!)
                  (while (and (.running s)
                              (!= (msg i8 (.window s) (sel c"isVisible") [])
                                  (: 0 i8)))
                    (let [frame-pool (new c"NSAutoreleasePool")
                          event
                            (msg (ptr i8)
                                 (.app s)
                                 (sel c"nextEventMatchingMask:untilDate:inMode:dequeue:")
                                 [u64 (ptr i8) (ptr i8) i8]
                                 (p/cast u64 -1)
                                 (msg (ptr i8)
                                      (class c"NSDate")
                                      (sel c"dateWithTimeIntervalSinceNow:")
                                      [f64]
                                      (if (or (widget-view/any-animating?)
                                              (dictation/active?)
                                              (coasting?)
                                              (.window-pending s)
                                              (> (.settle-at s) 0.0))
                                          (/ 1.0 60.0)
                                          0.2))
                                 (ns c"kCFRunLoopDefaultMode")
                                 (: 1 i8))]
                      (let [input-start (timings/now)]
                        (do
                          (if (!= (p/cast i64 event) 0)
                              (if (not (handle! event))
                                  (msg i64
                                       (.app s)
                                       (sel c"sendEvent:")
                                       [(ptr i8)]
                                       event)
                                  0)
                              0)
                          (let [action (palette/take-action!)]
                            (if (>= action 0) (invoke! action) (do)))
                          (let [action (sidebar/take-action!)]
                            (if (!= action -1) (invoke! action) (do)))
                          (apply-pane-menu! (pane-menu/take!))
                          (let [dropped (terminal/take-dropped!)]
                            (when (and (!= (p/cast i64 dropped) 0)
                                       (>= (.selected s) 0)
                                       (not (.overview s)))
                              (canvas/focus-terminal! (current) dropped)
                              0))
                          (let [picked (palette/take-pick!)]
                            (when (>= picked 0)
                              (import-original-project! picked)
                              0))
                          (let [action (palette/take-submission!)]
                            (if (>= action 0)
                                (submit! action (palette/text))
                                (do)))
                          (remote-tick!)
                          (timings/record! 0
                                           (* 1000.0
                                              (- (timings/now) input-start)))
                          (let [start (timings/now)]
                            (do
                              (maintenance!)
                              (timings/record! 1
                                               (* 1000.0
                                                  (- (timings/now) start)))))
                          (let [start (timings/now)]
                            (do
                              (msg i64 (.app s) (sel c"updateWindows") [])
                              (timings/record! 2
                                               (* 1000.0
                                                  (- (timings/now) start)))))
                          (release frame-pool)))))
                  (remote-stop!)
                  (remember-window-frame!)
                  (save-layout!)
                  (palette/free!)
                  (timings/free!)
                  (sidebar/free!)
                  (for [i 0 (count)] (canvas/free! (project i)))
                  (free! (mut (.projects s)))
                  (release (.model s))
                  (terminal/stop!)
                  (msg i64 (.window s) (sel c"close") [])
                  (release (.window s))
                  (release pool)
                  0))))))
