(module jim.main)
(import "coil.cc" :as cc)
(import "jim.native" :use *)
(import "jim.terminal" :as terminal)
(import "jim.ghostty" :as g)
(import "jim.workspace" :as workspace)
(import "jim.canvas" :as canvas)
(import "jim.widget-view" :as widget-view)
(import "jim.storage" :as storage)
(import "jim.projects" :as projects)
(import "jim.sidebar" :as sidebar)
(import "coil.arraylist" :as al)
(import "coil.alloc" :as alloc)
(import "jim.actions" :as actions)
(import "jim.controls" :as controls)
(import "jim.palette" :as palette)
(import "jim.timings" :as timings)
(import "jim.animation" :as animation)
(import "jim.reload" :as reload)
(import "coil.primitive" :as p)
(import "coil.args" :as args)
(import "coil.math" :use [Float])
(import "jim.sky" :as sky)

;;; FACE holds the project in 3D: its PLATE, the solid wall of the cube that
;;; carries the background, and the canvas, whose panes float off the plate
;;; while the cube is shown.
(defstruct ProjectView
  [(id i64) (face (ptr i8)) (plate (ptr i8)) (canvas (ptr canvas/Canvas))])

(defstruct Shell
  [(app (ptr i8))
   (window (ptr i8))
   (root (ptr i8))
   (sidebar (ptr i8))
   (stage (ptr i8))
   ;; Holds the cube twice: as it is and mirrored in the floor.
   (mirror (ptr i8))
   (cube (ptr i8))
   (night sky/Sky)
   (status (ptr i8))
   (heading (ptr i8))
   (projects (al/ArrayList ProjectView))
   (model (ptr i8))
   (notes (ptr i8))
   (config reload/Config)
   (width f64)
   (height f64)
   (selected i64)
   (origin i64)
   (overview bool)
   (angle f64)
   (dragging bool)
   (drag-x f64)
   (drag-angle f64)
   ;; The cube's spin in radians per second: measured while dragging, then
   ;; coasting down after release. DRAG-AT and SPIN-AT are when each last ran.
   (spin f64)
   (drag-at f64)
   (spin-at f64)
   ;; Where the pointer went down, so a click can be told from a drag.
   (press Point)
   ;; The overview camera's distance from the ring's axis; scrolling zooms it.
   (view-distance f64)
   ;; True while the stage covers the whole window for the cube, including
   ;; while it dives back into a project.
   (wide bool)
   ;; When the running cube transition ends, or 0 when none is running.
   (settle-at f64)
   ;; Whether every project's panes must be posed again (after a layout).
   (refit bool)
   (task (ptr i8))
   (generation i64)
   (output (ptr i8))
   (stamp f64)
   (maintenance-at f64)
   (running bool)])

(defn shell [] (-> (ptr Shell))
  (p/alloc-static Shell))

(defn count [] (-> i64)
  (len (.projects (shell))))

(defn runtime [(i i64)] (-> ProjectView)
  (get (.projects (shell)) i))

(defn face [(i i64)] (-> (ptr i8))
  (let [r (runtime i)] (.face r)))

(defn project [(i i64)] (-> (ptr canvas/Canvas))
  (let [r (runtime i)] (.canvas r)))

(defn current [] (-> (ptr canvas/Canvas))
  (if (>= (.selected (shell)) 0)
      (project (.selected (shell)))
      (p/cast (ptr canvas/Canvas) 0)))

(defn record [(i i64)] (-> (ptr i8))
  (let [r (runtime i)] (projects/find (projects/list (.model (shell))) (.id r))))

(defn name [(i i64)] (-> (ptr i8))
  (if (>= i 0) (utf8 (storage/get (record i) c"name")) c"No visible project"))

(defn status! [(text (ptr i8))] (-> i64)
  (p/cast i64 (printf c"Jim: %s\n" text)))

;;; ---- the cube's ring ---------------------------------------------------------
;;; The cube is built from the projects the current profile shows, in order:
;;; each has a slot around the ring, and hidden projects have none, so the ring
;;; has no gaps.
(defn shown? [(i i64)] (-> bool)
  (not (projects/hidden? (projects/profile (.model (shell))) (.id (runtime i)))))

(defn ring-count [] (-> i64)
  (let [(mut n) 0]
    (for [i 0 (count)] (when (shown? i) (set! n (+ n 1))))
    (load n)))

;;; Project I's slot: how many shown projects come before it.
(defn ring-slot [(i i64)] (-> i64)
  (let [(mut n) 0]
    (for [k 0 i] (when (shown? k) (set! n (+ n 1))))
    (load n)))

;;; The project in SLOT, or -1 when the ring is empty.
(defn ring-project [(slot i64)] (-> i64)
  (let [(mut found) -1]
    (for [i 0 (count)]
      (when (and (shown? i) (= (ring-slot i) slot)) (set! found i)))
    (load found)))

;;; The cube's rotation that brings project I to the front.
(defn ring-angle [(i i64)] (-> f64)
  (if (< i 0) 0.0 (- 0.0 (workspace/face-angle (ring-slot i) (ring-count)))))

;;; Select the face nearest the front, which Return enters.
(defn select-nearest! [] (-> void)
  (let [s (shell)
        faces (ring-count)
        step (/ 6.283185307179586 (p/cast f64 (if (> faces 0) faces 1)))
        chosen
          (ring-project (workspace/wrap (p/cast i64
                                                (round (/ (- 0.0 (.angle s))
                                                          step)))
                                        faces))]
    (when (>= chosen 0) (set! (.selected s) chosen) 0)
    (do)))

;;; ---- the cube ---------------------------------------------------------------
;;; Jim's cube: each shown project is a face of a ring seen through
;;; workspace's camera, under a night sky with the ring reflected in the
;;; floor. Dragging spins the ring and lets it coast; scrolling moves the
;;; camera in and out; a click dives into the face under the pointer.

;;; Seconds to pull back into the cube, and to dive into a project.
(const ENTER-TIME 0.72)

(const DIVE-TIME 0.55)

;;; Radians of spin per point dragged.
(const DRAG-RATE 0.006)

;;; A released cube keeps 90% of its spin per 60 Hz frame: it falls by e
;;; every 1/FRICTION seconds, and stops below SPIN-REST radians per second.
(const SPIN-FRICTION 6.32)

(const SPIN-REST 0.01)

;;; Releasing after holding still this long, in seconds, lets go without spin.
(const SPIN-HOLD 0.08)

;;; A press and release closer than this, in points, is a click.
(const CLICK-SLOP 6.0)

;;; Panes float LIFT ×H off their face, and STEP ×H more per place in the
;;; stack (Jim's 0.5 and 0.38 units of a quarter face).
(const PANE-LIFT 0.125)

(const PANE-STEP 0.095)

;;; The reflection's opacity where it meets the cube.
(const REFLECTION 0.45)

(defn spinning? [] (-> bool)
  (let [s (shell)]
    (and (.overview s) (not (.dragging s)) (> (abs (.spin s)) SPIN-REST))))

;;; The width of each project's canvas: everything right of the sidebar in a
;;; window WIDTH wide. layout! sizes the faces with it and pose! builds the
;;; cube from it, so the two always agree.
(defn face-width [(width f64)] (-> f64)
  (- width (sidebar/width)))

(defn focal [] (-> f64)
  (* workspace/FOCAL (.height (shell))))

(defn apothem [] (-> f64)
  (workspace/face-radius (ring-count) (face-width (.width (shell)))))

;;; The overview camera's distance before any zoom.
(defn overview-distance [] (-> f64)
  (+ (apothem) (focal) (* workspace/PULLBACK (.height (shell)))))

;;; Where the camera stands now, with the ring turned by YAW.
(defn camera-view [(yaw f64)] (-> workspace/View)
  (let [s (shell)]
    (if (.overview s)
        (workspace/View
          :shift 0.0
          :lift (* workspace/LIFT (.height s))
          :distance (.view-distance s)
          :yaw yaw
          :focal (focal))
        ; Flat: the face exactly over the canvas, which the wide stage holds
        ; half a sidebar right of its center.
        (workspace/View
          :shift (if (.wide s) (* 0.5 (sidebar/width)) 0.0)
          :lift 0.0
          :distance (+ (apothem) (focal))
          :yaw yaw
          :focal (focal)))))

;;; Whether face I points toward the viewer with the ring turned by YAW.
(defn facing? [(i i64) (faces i64) (yaw f64)] (-> bool)
  (> (cos (+ yaw (workspace/face-angle (ring-slot i) faces))) 0.0))

;;; Height above the stage's bottom where the camera sees world point P.
(defn screen-height [(camera Transform) (p workspace/Vec3)] (-> f64)
  (+ (* 0.5 (.height (shell)))
     (.y (workspace/on-screen (workspace/apply camera p) (focal)))))

;;; Lay the night out for the camera: the floor's far edge is its horizon, and
;;; the fade over the reflection reaches up to the ring's nearest bottom edge.
(defn night! [] (-> void)
  (let [s (shell)
        h (.height s)
        still (workspace/camera-transform (camera-view 0.0))
        floor (* -0.5 h)]
    (sky/layout! (field s night)
                 (if (.wide s) (.width s) (face-width (.width s)))
                 h
                 (screen-height still
                                (workspace/Vec3
                                  :x 0.0
                                  :y floor
                                  :z (* -1.0 workspace/FLOOR-REACH h)))
                 (screen-height still
                                (workspace/Vec3
                                  :x 0.0
                                  :y floor
                                  :z
                                    (workspace/face-reach (ring-count)
                                                          (face-width (.width s))))))
    (do)))

;;; Make V fill a W×H stage, centered on it.
(defn fill! [(v (ptr i8)) (w f64) (h f64)] (-> void)
  (frame! v (rect 0.0 0.0 w h))
  (msg i64 (layer v) (sel c"setAnchorPoint:") [Point] (Point :x 0.5 :y 0.5))
  (msg i64
       (layer v)
       (sel c"setPosition:")
       [Point]
       (Point :x (* 0.5 w) :y (* 0.5 h)))
  (do))

;;; Size the stage for the cube (WIDE: the whole window, over the sidebar) or
;;; for the flat canvas. The ring stays centered in it, and camera-view's
;;; shift keeps a flat face exactly where it was, so this never moves anything
;;; on screen.
(defn wide! [(wide bool)] (-> void)
  (let [s (shell)
        h (.height s)
        rail (sidebar/width)
        w (if wide (.width s) (face-width (.width s)))
        center (Point :x (* 0.5 w) :y (* 0.5 h))]
    (set! (.wide s) wide)
    (frame! (.stage s) (rect (if wide 0.0 rail) 0.0 w h))
    (msg i64
         (layer (.stage s))
         (sel c"setAnchorPoint:")
         [Point]
         (Point :x 0.5 :y 0.5))
    (msg i64
         (layer (.stage s))
         (sel c"setPosition:")
         [Point]
         (Point :x (+ (if wide 0.0 rail) (* 0.5 w)) :y (* 0.5 h)))
    (fill! (.mirror s) w h)
    (fill! (.cube s) w h)
    (for [i 0 (count)]
      (msg i64 (layer (face i)) (sel c"setPosition:") [Point] center))
    ; The reflection is drawn only while the cube can be seen.
    (msg i64
         (layer (.mirror s))
         (sel c"setInstanceCount:")
         [i64]
         (if wide 2 1))
    (sky/show! (field s night) wide)
    (do)))

(defn pose! [(duration f64)] (-> void)
  (let [s (shell)
        h (.height s)
        faces (ring-count)
        radius (apothem)
        camera (workspace/camera-transform (camera-view (.angle s)))
        ; Settled flat, the project lies exactly on the window. Its
        ; transforms are then exactly the identity, which Core Animation
        ; draws without resampling, so text stays sharp.
        flat (not (.wide s))
        identity (CATransform3DMakeTranslation 0.0 0.0 0.0)]
    (transform! (layer (.cube s)) (if flat identity camera) duration)
    (msg i64
         (layer (.mirror s))
         (sel c"setInstanceTransform:")
         [Transform]
         (workspace/mirror-transform camera (* -0.5 h)))
    (for [i 0 (count)]
      ; Every face of the ring is drawn, turned away or not: the depth test
      ; hides what is behind, and what can be seen past it stays.
      (let [shown (and (shown? i) (or (.wide s) (= i (.selected s))))]
        (transform! (layer (face i))
                    (if (and flat (= i (.selected s)))
                        identity
                        (workspace/face-placement (ring-slot i) faces radius))
                    duration)
        (msg i64 (face i) (sel c"setHidden:") [i8] (p/cast i8 (if shown 0 1)))
        (when (!= (.visible (project i)) (or (.wide s) (= i (.selected s))))
          (canvas/visibility! (project i) (or (.wide s) (= i (.selected s))))
          0)
        ; Panes are fitted to their faces while the cube is shown. Diving, only
        ; the chosen project lies back down; the others keep the cube's
        ; layout until the dive ends and they are hidden. Only the chosen
        ; project moves with the camera, so only it animates.
        (let [fit (or (.overview s) (and (.wide s) (!= i (.selected s))))]
          (when (or (.refit s) (!= fit (.fitted (project i))))
            (canvas/cube-pose! (project i)
                               fit
                               (* PANE-LIFT h)
                               (* PANE-STEP h)
                               (if (= i (.selected s)) duration 0.0))
            0))))
    (set! (.refit s) false)
    (when (.wide s) (night!) 0)
    (if (.overview s)
        (do
          (if (palette/open?)
              (palette/focus!)
              (do
                (msg i8
                     (.window s)
                     (sel c"makeFirstResponder:")
                     [(ptr i8)]
                     (nil))
                (do)))
          (status! c"Drag to spin   ·   scroll to zoom   ·   click a face or Return to enter   ·   Esc to return"))
        (do
          (if (palette/open?)
              (palette/focus!)
              (if (>= (.selected s) 0)
                  (canvas/focus! (current) (load (field (current) focused)))
                  (do)))
          (status! c"⌘ scroll  Pan   ·   ⌘⌥ scroll / pinch  Zoom   ·   Space / middle drag  Pan   ·   ⌘⇧0  Origin")))
    (do)))

(defn visible-index [(index i64) (direction i64)] (-> i64)
  (let [(mut candidate) (workspace/wrap index (count))]
    (do
      (for [i 0 (count)]
        (let [r (runtime (load candidate))]
          (if (projects/hidden? (projects/profile (.model (shell))) (.id r))
              (set! candidate
                    (workspace/wrap (+ (load candidate) direction) (count)))
              0)))
      (load candidate))))

(defn choose! [(index i64)] (-> i64)
  (let [s (shell)
        selected (visible-index index 1)]
    (set! (.selected s) selected)
    (let [r (runtime selected)] (projects/select! (.model s) (.id r)))
    (sidebar/refresh!)
    selected))

;;; Show project INDEX at once, flat, ending any cube transition.
(defn select! [(index i64)] (-> void)
  (let [s (shell)
        selected (choose! index)]
    (set! (.angle s) (ring-angle selected))
    (set! (.spin s) 0.0)
    (set! (.overview s) false)
    (set! (.settle-at s) 0.0)
    ;; Project navigation is an immediate swap, including during an
    ;; unfinished cube transition. Suppress implicit visibility changes too.
    (transaction! 0.0)
    (msg i64
         (class c"CATransaction")
         (sel c"setDisableActions:")
         [i8]
         (: 1 i8))
    (when (.wide s) (wide! false) 0)
    (pose! 0.0)
    (commit!)
    (do)))

;;; The angle nearest the cube's current one that faces project I, so a turn
;;; to it goes the short way round.
(defn nearest-angle [(i i64)] (-> f64)
  (let [s (shell)
        tau 6.283185307179586
        turn (- (ring-angle i) (.angle s))
        wrapped (- turn (* tau (round (/ turn tau))))]
    (+ (.angle s) wrapped)))

;;; Pull back from the current project into the cube.
(defn enter! [] (-> void)
  (let [s (shell)]
    (set! (.origin s) (.selected s))
    (set! (.spin s) 0.0)
    (transaction! 0.0)
    (msg i64
         (class c"CATransaction")
         (sel c"setDisableActions:")
         [i8]
         (: 1 i8))
    (wide! true)
    (pose! 0.0)
    (commit!)
    (set! (.overview s) true)
    (set! (.view-distance s) (overview-distance))
    (sky/fade! (field s night) false)
    (pose! ENTER-TIME)
    (set! (.settle-at s) (+ (animation/animation-now) ENTER-TIME))
    (do)))

;;; Dive from the cube into project INDEX, turning the short way.
(defn dive! [(index i64)] (-> void)
  (let [s (shell)
        selected (choose! index)]
    (set! (.angle s) (nearest-angle selected))
    (set! (.spin s) 0.0)
    (set! (.dragging s) false)
    (set! (.overview s) false)
    (sky/fade! (field s night) false)
    (pose! DIVE-TIME)
    (set! (.settle-at s) (+ (animation/animation-now) DIVE-TIME))
    (do)))

;;; Finish a cube transition once its animation has run: a dive gives the
;;; window back to the sidebar; an entry shows the reflection's fade.
(defn settle! [] (-> void)
  (let [s (shell)]
    (when (and (> (.settle-at s) 0.0)
               (>= (animation/animation-now) (.settle-at s)))
      (set! (.settle-at s) 0.0)
      (if (.overview s)
          (sky/fade! (field s night) true)
          (do
            (transaction! 0.0)
            (msg i64
                 (class c"CATransaction")
                 (sel c"setDisableActions:")
                 [i8]
                 (: 1 i8))
            (wide! false)
            (pose! 0.0)
            (commit!)
            0))
      0)
    (do)))

(defn toggle! [] (-> void)
  (let [s (shell)]
    (if (.overview s) (dive! (.selected s)) (enter!))))

;;; Where point (X, Y) of a face placed by PLACE lands on screen, from the
;;; stage's center.
(defn face-corner [(camera Transform) (place Transform) (x f64) (y f64)]
  (-> Point)
  (workspace/on-screen (workspace/apply camera
                                        (workspace/apply place
                                                         (workspace/Vec3
                                                           :x x
                                                           :y y
                                                           :z 0.0)))
                       (focal)))

;;; The project whose face is under stage point PT (from the bottom left), or
;;; -1: the nearest face whose outline contains it.
(defn face-at [(pt Point)] (-> i64)
  (let [s (shell)
        faces (ring-count)
        radius (apothem)
        camera (workspace/camera-transform (camera-view (.angle s)))
        half-w (* 0.5 (face-width (.width s)))
        half-h (* 0.5 (.height s))
        at (Point :x (- (.x pt) (* 0.5 (.width s))) :y (- (.y pt) half-h))
        (mut found) -1
        (mut nearest) -1000000000.0]
    (for [i 0 (count)]
      (when (and (shown? i) (facing? i faces (.angle s)))
        (let [place (workspace/face-placement (ring-slot i) faces radius)
              depth
                (.z (workspace/apply camera
                                     (workspace/apply place
                                                      (workspace/Vec3
                                                        :x 0.0
                                                        :y 0.0
                                                        :z 0.0))))]
          (when (and (> depth (load nearest))
                     (workspace/quad-contains? at
                                               (face-corner camera
                                                            place
                                                            (- 0.0 half-w)
                                                            (- 0.0 half-h))
                                               (face-corner camera
                                                            place
                                                            half-w
                                                            (- 0.0 half-h))
                                               (face-corner camera
                                                            place
                                                            half-w
                                                            half-h)
                                               (face-corner camera
                                                            place
                                                            (- 0.0 half-w)
                                                            half-h)))
            (set! found i)
            (set! nearest depth)
            0))))
    (load found)))

(defn layout! [] (-> void)
  (let [s (shell)
        bounds (msg Rect (.root s) (sel c"bounds") [])
        width (.w bounds)
        height (.h bounds)
        rail (sidebar/width)
        fw (face-width width)
        fh height
        scale (msg f64 (.window s) (sel c"backingScaleFactor") [])
        cfg (.config s)]
    (do
      (transaction! 0.0)
      (msg i64
           (class c"CATransaction")
           (sel c"setDisableActions:")
           [i8]
           (: 1 i8))
      (set! (.width s) width)
      (set! (.height s) height)
      (sidebar/layout! height)
      (frame! (.heading s) (rect (+ rail 32.0) (- height 44.0) 450.0 24.0))
      (frame! (.status s)
              (rect (+ rail 32.0) 10.0 (- width (+ rail 45.0)) 20.0))
      ; The eye stands where a face exactly fills the window.
      (msg i64
           (layer (.stage s))
           (sel c"setSublayerTransform:")
           [Transform]
           (workspace/perspective (focal)))
      (for [i 0 (count)]
        (do
          (frame! (face i) (rect 0.0 0.0 fw fh))
          (msg i64
               (layer (face i))
               (sel c"setAnchorPoint:")
               [Point]
               (Point :x 0.5 :y 0.5))
          (frame! (.plate (runtime i)) (rect 0.0 0.0 fw fh))
          ; A face is the project's own background, solid, as in Jim.
          (background! (.plate (runtime i))
                       (.canvas-r cfg)
                       (.canvas-g cfg)
                       (.canvas-b cfg))
          (canvas/resize! (project i) fw fh scale)))
      (wide! (.wide s))
      (background! (.root s) (.canvas-r cfg) (.canvas-g cfg) (.canvas-b cfg))
      (background! (.view (sidebar/state))
                   (.rail-r cfg)
                   (.rail-g cfg)
                   (.rail-b cfg))
      (for [i 0 (count)] (canvas/apply-theme! (project i) cfg))
      (palette/layout!)
      (when (.overview s) (set! (.view-distance s) (overview-distance)) 0)
      (set! (.refit s) true)
      (pose! 0.0)
      (commit!)
      (do))))

(defn reload-start! [] (-> void)
  (let [s (shell)]
    (if (= (p/cast i64 (.task s)) 0)
        (let [task (new c"NSTask")
              output
                (indexed-string c"../build/config-"
                                (+ (.generation s) 1)
                                c".dylib")
              argv (msg (ptr i8) (class c"NSMutableArray") (sel c"array") [])
              error (p/alloc-stack (ptr i8))]
          (do
            (set! error (nil))
            (set! (.generation s) (+ (.generation s) 1))
            (msg i64
                 task
                 (sel c"setExecutableURL:")
                 [(ptr i8)]
                 (msg (ptr i8)
                      (class c"NSURL")
                      (sel c"fileURLWithPath:")
                      [(ptr i8)]
                      (ns c"/usr/bin/env")))
            (msg i64 argv (sel c"addObject:") [(ptr i8)] (ns c"coil"))
            (msg i64 argv (sel c"addObject:") [(ptr i8)] (ns c"build"))
            (msg i64 argv (sel c"addObject:") [(ptr i8)] (ns c"shell.coil"))
            (msg i64 argv (sel c"addObject:") [(ptr i8)] (ns c"--shared"))
            (msg i64 argv (sel c"addObject:") [(ptr i8)] (ns c"-o"))
            (msg i64 argv (sel c"addObject:") [(ptr i8)] output)
            (msg i64 task (sel c"setArguments:") [(ptr i8)] argv)
            (msg i64
                 task
                 (sel c"setCurrentDirectoryPath:")
                 [(ptr i8)]
                 (ns c"config"))
            (if (!= (msg i8
                         task
                         (sel c"launchAndReturnError:")
                         [(ptr (ptr i8))]
                         error)
                    (: 0 i8))
                (do
                  (set! (.task s) task)
                  (set! (.output s) (msg (ptr i8) output (sel c"retain") []))
                  (status! c"Compiling Coil configuration…"))
                (do
                  (release task)
                  (status! c"Could not launch Coil compiler; see launch environment.")))))
        (do))))

(defn background-maintenance! [] (-> void)
  (let [s (shell)
        bounds (msg Rect (.root s) (sel c"bounds") [])]
    (do
      (if (or (< (.width s) (.w bounds))
              (> (.width s) (.w bounds))
              (< (.height s) (.h bounds))
              (> (.height s) (.h bounds)))
          (layout!)
          (do))
      (if (and (!= (p/cast i64 (.task s)) 0)
               (= (msg i8 (.task s) (sel c"isRunning") []) (: 0 i8)))
          (do
            (if (and (= (msg i32 (.task s) (sel c"terminationStatus") [])
                        (: 0 i32))
                     (reload/load-config! (utf8 (msg (ptr i8)
                                                     (ns c"config")
                                                     (sel c"stringByAppendingPathComponent:")
                                                     [(ptr i8)]
                                                     (.output s)))
                                          (field s config)))
                (do
                  (layout!)
                  (status! c"Coil configuration reloaded · terminals preserved"))
                (status! c"Reload failed · keeping last good configuration · see compiler output"))
            (release (.task s))
            (release (.output s))
            (set! (.task s) (nil))
            (set! (.output s) (nil)))
          0)
      (let [manager
              (msg (ptr i8) (class c"NSFileManager") (sel c"defaultManager") [])
            attrs
              (msg (ptr i8)
                   manager
                   (sel c"attributesOfItemAtPath:error:")
                   [(ptr i8) (ptr i8)]
                   (ns c"config/shell.coil")
                   (nil))
            date
              (msg (ptr i8)
                   attrs
                   (sel c"objectForKey:")
                   [(ptr i8)]
                   (ns c"NSFileModificationDate"))
            stamp (msg f64 date (sel c"timeIntervalSince1970") [])]
        (if (and (> stamp (.stamp s)) (= (p/cast i64 (.task s)) 0))
            (do (set! (.stamp s) stamp) (reload-start!))
            (do))))))

(defn save-layout! [] (-> bool)
  (do
    (for [i 0 (count)]
      (storage/put! (record i) c"layout" (canvas/snapshot (project i))))
    (let [ok (storage/write! (.model (shell)))]
      (do
        (if ok (for [i 0 (count)] (set! (.dirty (project i)) false)) 0)
        ok))))

(defn sync-selection! [] (-> void)
  (let [s (shell)]
    (do
      (set! (.selected s) -1)
      (for [i 0 (count)]
        (let [r (runtime i)]
          (if (= (.id r) (projects/active (.model s))) (set! (.selected s) i) 0)))
      (set! (.angle s) (ring-angle (.selected s)))
      (set! (.spin s) 0.0)
      (set! (.overview s) false)
      (set! (.settle-at s) 0.0)
      (when (.wide s) (wide! false) 0)
      (layout!)
      (if (save-layout!)
          (do)
          (do (status! c"Could not save project layout") (do))))))

(defn delete-project! [(wanted i64)] (-> void)
  (let [s (shell)
        (mut index) -1]
    (do
      (for [i 0 (count)]
        (let [r (runtime i)] (if (= (.id r) wanted) (set! index i) 0)))
      (if (>= (load index) 0)
          (let [index (load index)
                r (runtime index)
                deleted-name (storage/get (record index) c"name")]
            (do
              (printf c"Jim: deleting project %s and closing its terminals\n"
                      (utf8 deleted-name))
              (let [c (.canvas r)]
                (while (> (canvas/count c) 0)
                  (canvas/close! c (canvas/pane c 0))))
              (projects/delete-project! (.model s) (.id r))
              (canvas/free! (.canvas r))
              (msg i64 (.face r) (sel c"removeFromSuperview") [])
              (for [i index (- (count) 1)]
                (set! (mut (.projects s)) i (runtime (+ i 1))))
              (pop! [ProjectView] (mut (.projects s)))
              (sync-selection!)))
          (do)))))

(defn new-project! [] (-> void)
  (let [s (shell)
        record (projects/new-project! (.model s) (ns c"Project"))]
    (do
      (storage/put! record
                    c"name"
                    (indexed-string c"Project " (projects/id record) c""))
      (add-project-view! record)
      (sync-selection!))))

(defn add-project-view! [(record (ptr i8))] (-> bool)
  (let [s (shell)
        f
          (layer-view (.cube s)
                      (rect 0.0 0.0 1032.0 736.0)
                      c"CATransformLayer")
        ; Before the canvas, so it lies behind the panes.
        plate (view f (rect 0.0 0.0 1032.0 736.0))
        c (canvas/create! f 1032.0 736.0 (.config s))
        saved (storage/get record c"layout")]
    (do
      ; Behind the canvas's edge shadows (-1) in the face's 3D space.
      (msg i64 (layer plate) (sel c"setZPosition:") [f64] -2.0)
      (msg i64
           (layer plate)
           (sel c"setBorderColor:")
           [(ptr i8)]
           (msg (ptr i8) (color 1.0 1.0 1.0 0.18) (sel c"CGColor") []))
      (release (.directory c))
      (set! (.directory c)
            (msg (ptr i8) (storage/get record c"directory") (sel c"retain") []))
      (push! [ProjectView]
             (mut (.projects s))
             (ProjectView
               :id (projects/id record)
               :face f
               :plate plate
               :canvas c))
      (if (canvas/restorable? saved) (canvas/restore! c saved) true))))

;;; Advance a coasting cube to now.
(defn coast! [] (-> void)
  (let [s (shell)]
    (if (spinning?)
        (let [now (animation/animation-now)
              ; A stalled frame resumes smoothly instead of jumping.
              dt (min (- now (.spin-at s)) 0.05)]
          (set! (.angle s) (+ (.angle s) (* (.spin s) dt)))
          (set! (.spin s) (* (.spin s) (exp (- 0.0 (* SPIN-FRICTION dt)))))
          (set! (.spin-at s) now)
          (select-nearest!)
          (pose! 0.0))
        ; Not coasting. Leave the spin alone: while dragging it holds the
        ; speed being measured for the throw.
        0)
    (do)))

(defn maintenance! [] (-> void)
  (let [s (shell)
        bounds (msg Rect (.root s) (sel c"bounds") [])
        now (animation/animation-now)]
    (do
      (coast!)
      (settle!)
      (if (or (< (.width s) (.w bounds))
              (> (.width s) (.w bounds))
              (< (.height s) (.h bounds))
              (> (.height s) (.h bounds)))
          (layout!)
          (do))
      (let [reloaded (widget-view/maintain! now (> now (.maintenance-at s)))]
        (for [i 0 (count)]
          (canvas/widgets-serve! (project i))
          (canvas/settle-expose! (project i) now))
        (cond (< reloaded 0)
                (status! c"Widget edit rejected · previous version still running")
              (> reloaded 0) (status! c"Widget reloaded · state preserved")
              :else 0))
      (if (> now (.maintenance-at s))
          (do
            (set! (.maintenance-at s) (+ now 0.2))
            (background-maintenance!)
            (let [(mut dirty) false
                  (mut dragging) false]
              (do
                (for [i 0 (count)]
                  (do
                    (if (.dirty (project i)) (set! dirty true) 0)
                    (if (> (.gesture (project i)) 0) (set! dragging true) 0)))
                (if (and (load dirty) (not (load dragging)))
                    (if (not (save-layout!))
                        (status! c"Could not save canvas layout")
                        0)
                    0)))
            (if (= (msg i8 (.app s) (sel c"isActive") []) (: 0 i8))
                (for [i 0 (count)]
                  (do
                    (set! (.space-held (project i)) false)
                    (set! (.gesture (project i)) 0)))
                0)
            (let [manager
                    (msg (ptr i8)
                         (class c"NSFileManager")
                         (sel c"defaultManager")
                         [])]
              (if (!= (msg i8
                           manager
                           (sel c"fileExistsAtPath:")
                           [(ptr i8)]
                           (ns c"build/quit-request"))
                      (: 0 i8))
                  (do
                    (msg i8
                         manager
                         (sel c"removeItemAtPath:error:")
                         [(ptr i8) (ptr i8)]
                         (ns c"build/quit-request")
                         (nil))
                    (set! (.running s) false))
                  0)))
          0)
      (do))))

(defn canvas-action! [(id i64)] (-> void)
  (cond (= id 0)
          (do
            (if (.overview (shell)) (select! (.selected (shell))) (do))
            (if (not (canvas/add-visible! (current)))
                (status! c"Could not start terminal")
                0)
            (do))
        (= id 1)
          (let [focused (load (field (current) focused))]
            (if (!= (p/cast i64 focused) 0)
                (canvas/close! (current) focused)
                (do)))
        (= id 2) (canvas/home! (current))
        (= id 3) (canvas/reset-zoom! (current))
        (= id 4) (canvas/fit! (current))
        (= id 5) (canvas/zoom-key! (current) 1.1)
        (= id 6) (canvas/zoom-key! (current) (/ 1.0 1.1))
        (= id 7)
          (let [enabled (not (.zoom-enabled (current)))]
            (do
              (for [i 0 (count)]
                (do
                  (set! (.zoom-enabled (project i)) enabled)
                  (canvas/project! (project i))))
              (do)))
        (= id 8) (if (>= (.selected (shell)) 0) (toggle!) (do))
        (= id 9) (reload-start!)
        (= id 10) (timings/toggle!)
        (= id 29)
          (when (and (>= (.selected (shell)) 0) (not (.overview (shell))))
            (canvas/toggle-expose! (current)))
        (and (>= id 11) (< id 15))
          (do
            (projects/select! (.model (shell))
                              (projects/visible-id (.model (shell)) (- id 11)))
            (sync-selection!))
        :else (do)))

(defn invoke! [(id i64)] (-> void)
  (let [s (shell)
        model (.model s)]
    (cond (= id -2) (sync-selection!)
          (>= id actions/FIRST-PROJECT)
            (do
              (projects/select! model
                                (projects/id (storage/at (projects/list model)
                                                         (- id
                                                            actions/FIRST-PROJECT))))
              (sync-selection!))
          (= id 15) (new-project!)
          (= id 16)
            (if (>= (.selected s) 0)
                (sidebar/rename! (projects/active model))
                (do))
          (= id 17)
            (if (>= (.selected s) 0)
                (do
                  (projects/hide! model (projects/active model) true)
                  (sync-selection!))
                (do))
          (= id 18)
            (if (>= (.selected s) 0)
                (palette/prompt! 18
                                 c"Project directory"
                                 (utf8 (storage/get (record (.selected s))
                                                    c"directory")))
                (do))
          (= id 19)
            (if (and (>= (.selected s) 0)
                     (!= (p/cast i64 (.focused (current))) 0)
                     (not (canvas/widget? (.focused (current)))))
                (let [pane (.focused (current))
                      term (.terminal pane)]
                  (do
                    (storage/put! (record (.selected s))
                                  c"directory"
                                  (.directory term))
                    (release (.directory (current)))
                    (set! (.directory (current))
                          (msg (ptr i8) (.directory term) (sel c"retain") []))
                    (sync-selection!)
                    (status! c"Project directory updated from focused terminal")))
                (do))
          (= id 20) (palette/prompt! 20 c"New profile name" c"")
          (= id 21)
            (palette/prompt! 21
                             c"Rename profile"
                             (utf8 (storage/get (projects/profile model)
                                                c"name")))
          (= id 22)
            (do
              (if (projects/delete-profile! model)
                  (sync-selection!)
                  (do (status! c"Keep at least one profile") (do)))
              (do))
          (= id 23)
            (do
              (set! (.show-hidden (sidebar/state))
                    (not (.show-hidden (sidebar/state))))
              (sidebar/refresh!))
          (or (= id 24) (= id 25))
            (let [profiles (projects/profiles model)
                  index
                    (msg i64
                         profiles
                         (sel c"indexOfObject:")
                         [(ptr i8)]
                         (projects/profile model))
                  next
                    (workspace/wrap (+ index (if (= id 24) -1 1))
                                    (storage/count profiles))]
              (do
                (sidebar/transition! (if (= id 24)
                                         (- 0.0 (sidebar/width))
                                         (sidebar/width)))
                (projects/switch-profile! model
                                          (projects/id (storage/at profiles
                                                                   next)))
                (sync-selection!)))
          (= id 27)
            (when (and (>= (.selected s) 0)
                       (!= (p/cast i64 (.focused (current))) 0))
              (if (canvas/reconnect! (current) (.focused (current)))
                  (do (status! c"Terminal reconnected") (do))
                  (do
                    (status! c"Cannot reconnect terminal; saved session retained")
                    (do))))
          (= id 28)
            (if (>= (.selected s) 0)
                (palette/prompt! 28
                                 c"Widget: NAME [ARGS] — e.g. diff, stage, branches, markdown README.md"
                                 c"")
                (do (status! c"Create or show a project first") (do)))
          (= id 26)
            (let [requested (sidebar/take-delete-project!)]
              (delete-project! (if (> requested 0)
                                   requested
                                   (projects/active model))))
          (or (= id 9) (= id 10) (and (>= id 11) (< id 15))) (canvas-action! id)
          (>= (.selected s) 0) (canvas-action! id)
          :else (do (status! c"Create or show a project first") (do)))))

(defn submit! [(id i64) (input (ptr i8))] (-> void)
  (let [s (shell)
        model (.model s)
        text
          (msg (ptr i8)
               input
               (sel c"stringByTrimmingCharactersInSet:")
               [(ptr i8)]
               (msg (ptr i8)
                    (class c"NSCharacterSet")
                    (sel c"whitespaceAndNewlineCharacterSet")
                    []))
        (mut invalid-directory) false]
    (if (= (msg u64 text (sel c"length") []) 0)
        (palette/prompt! id c"Please enter a nonempty value" c"")
        (do
          (cond (= id 15)
                  (do
                    (add-project-view! (projects/new-project! model text))
                    (do))
                (= id 16)
                  (do (storage/put! (record (.selected s)) c"name" text) (do))
                (= id 18)
                  (let [path
                          (msg (ptr i8)
                               text
                               (sel c"stringByExpandingTildeInPath")
                               [])
                        manager
                          (msg (ptr i8)
                               (class c"NSFileManager")
                               (sel c"defaultManager")
                               [])
                        directory (p/alloc-stack i8)]
                    (if (and (!= (msg i8
                                      manager
                                      (sel c"fileExistsAtPath:isDirectory:")
                                      [(ptr i8) (ptr i8)]
                                      path
                                      directory)
                                 (: 0 i8))
                             (!= (load directory) (: 0 i8)))
                        (do
                          (storage/put! (record (.selected s))
                                        c"directory"
                                        path)
                          (release (.directory (current)))
                          (set! (.directory (current))
                                (msg (ptr i8) path (sel c"retain") []))
                          (do))
                        (do (set! invalid-directory true) (do))))
                (= id 20) (projects/new-profile! model text)
                (= id 28)
                  (do
                    (canvas/add-widget-visible! (current) text)
                    (do))
                (= id 21)
                  (do (storage/put! (projects/profile model) c"name" text) (do))
                :else (do))
          (sync-selection!)
          (when (load invalid-directory)
            (palette/prompt! 18
                             c"Directory does not exist; enter a directory"
                             (utf8 text)))))))

(defn handle! [(event (ptr i8))] (-> bool)
  (let [s (shell)
        kind (msg i64 event (sel c"type") [])
        flags (msg u64 event (sel c"modifierFlags") [])
        key
          (if (or (= kind 10) (= kind 11))
              (msg u16 event (sel c"keyCode") [])
              (: 0 u16))
        command (!= (& flags 1048576) (: 0 u64))]
    (do
      ;; Space belongs to the keyboard, so releases must reach every project,
      ;; including when the user switches projects or enters the cube.
      (if (and (or (= kind 10) (= kind 11)) (= key (: 49 u16)))
          (for [i 0 (count)]
            (set! (.space-held (project i)) (= kind 10)))
          0)
      (cond (and (= kind 10)
                 (and command
                      (and (!= (& flags 131072) (: 0 u64))
                           (= key (: 35 u16)))))
              (do
                (if (palette/open?)
                    (palette/dismiss!)
                    (do
                      (for [i 0 (count)]
                        (do
                          (set! (.space-held (project i)) false)
                          (set! (.gesture (project i)) 0)))
                      (palette/show!)))
                true)
            (palette/open?) (palette/handle! event)
            (sidebar/handle! event) true
            (timings/owns-event? event) false
            (and (>= (.selected s) 0)
                 (not (.overview s))
                 (canvas/handle! (current) event))
              true
            (= kind 10)
              (let [action (actions/key-action key flags)]
                (cond (and command (= key (: 12 u16)))
                        (do (set! (.running s) false) true)
                      (>= action 0) (do (invoke! action) true)
                      (.overview s)
                        (do
                          (cond (= key (: 53 u16)) (dive! (.origin s))
                                (= key (: 36 u16)) (dive! (.selected s))
                                (or (= key (: 123 u16))
                                    (= key (: 124 u16)))
                                  (do
                                    (set! (.selected s)
                                          (visible-index (+ (.selected s)
                                                            (if (= key
                                                                   (: 124 u16))
                                                                1
                                                                -1))
                                                         (if (= key
                                                                (: 124 u16))
                                                             1
                                                             -1)))
                                    (set! (.angle s)
                                          (nearest-angle (.selected s)))
                                    (set! (.spin s) 0.0)
                                    (pose! (.duration (.config s))))
                                :else (do))
                          true)
                      :else false))
            (and (.overview s) (= kind 11)) true
            ; The cube covers the whole window and takes every pointer
            ; event while it is shown.
            (and (.overview s)
                 (or (= kind 1) (= kind 2) (= kind 6) (= kind 22)))
              (let [pt (msg Point event (sel c"locationInWindow") [])
                    now (animation/animation-now)]
                (cond (= kind 1)
                        (do
                          ; Grabbing the cube stops any coast.
                          (set! (.dragging s) true)
                          (set! (.press s) pt)
                          (set! (.drag-x s) (.x pt))
                          (set! (.drag-angle s) (.angle s))
                          (set! (.spin s) 0.0)
                          (set! (.drag-at s) now)
                          (do))
                      (and (= kind 6) (.dragging s))
                        (let [before (.angle s)
                              dt (- now (.drag-at s))]
                          (set! (.angle s)
                                (+ (.drag-angle s)
                                   (* (- (.x pt) (.drag-x s)) DRAG-RATE)))
                          ; Smoothed, so one jittery sample does not decide
                          ; the throw.
                          (when (> dt 0.0)
                            (set! (.spin s)
                                  (+ (* 0.6 (/ (- (.angle s) before) dt))
                                     (* 0.4 (.spin s))))
                            (set! (.drag-at s) now)
                            0)
                          (pose! 0.0))
                      (and (= kind 2) (.dragging s))
                        (let [dx (- (.x pt) (.x (.press s)))
                              dy (- (.y pt) (.y (.press s)))
                              clicked
                                (< (+ (* dx dx) (* dy dy))
                                   (* CLICK-SLOP CLICK-SLOP))
                              chosen (if clicked (face-at pt) -1)]
                          (set! (.dragging s) false)
                          (if (>= chosen 0)
                              (dive! chosen)
                              (do
                                ; The cube keeps the spin it was thrown with,
                                ; unless it was held still before release.
                                (when (or clicked
                                          (> (- now (.drag-at s)) SPIN-HOLD))
                                  (set! (.spin s) 0.0)
                                  0)
                                (set! (.spin-at s) now)
                                (select-nearest!)
                                (pose! 0.0))))
                      (= kind 22)
                        (let [precise
                                (!= (msg i8
                                         event
                                         (sel c"hasPreciseScrollingDeltas")
                                         [])
                                    (: 0 i8))
                              amount
                                (* (msg f64 event (sel c"scrollingDeltaY") [])
                                   (if precise 0.0625 1.0))
                              h (.height s)]
                          ; Scrolling moves the camera in and out, as in Jim.
                          (set! (.view-distance s)
                                (max (min (* (.view-distance s)
                                             (- 1.0 (* 0.08 amount)))
                                          (* 100.0 h))
                                     (+ (apothem) (* 0.2 h))))
                          (pose! 0.0))
                      :else (do))
                true)
            :else false))))

(defn saved-valid? [(saved (ptr i8))] (-> bool)
  (let [version (storage/value saved c"version")
        (mut ok)
          (or (= (p/cast i64 saved) 0)
              (and (= version 1.0)
                   (storage/kind? (projects/list saved) c"NSArray"))
              (and (= version 2.0) (projects/valid? saved)))]
    (do
      (for [i 0 (storage/count (projects/list saved))]
        (let [entry (storage/at (projects/list saved) i)
              layout (if (= version 1.0) entry (storage/get entry c"layout"))]
          (if (and (!= (p/cast i64 layout) 0) (not (canvas/restorable? layout)))
              (set! ok false)
              0)))
      (load ok))))

(defn setup! [] (-> bool)
  (let [s (shell)
        app
          (msg (ptr i8)
               (controls/quiet-class c"NSApplication" c"JimApplication")
               (sel c"sharedApplication")
               [])
        window
          (msg (ptr i8)
               (msg (ptr i8)
                    (controls/quiet-class c"NSWindow" c"JimWindow")
                    (sel c"alloc")
                    [])
               (sel c"initWithContentRect:styleMask:backing:defer:")
               [Rect u64 u64 i8]
               (rect 160.0 120.0 1320.0 860.0)
               15
               2
               (: 0 i8))
        root (msg (ptr i8) window (sel c"contentView") [])
        saved (storage/read)
        cls (objc_allocateClassPair (class c"NSObject") c"JimShellActions" 0)]
    (if (not (saved-valid? saved))
        (let [alert (new c"NSAlert")]
          (do
            (msg i64
                 alert
                 (sel c"setMessageText:")
                 [(ptr i8)]
                 (ns c"Saved projects could not be loaded"))
            (msg i64
                 alert
                 (sel c"setInformativeText:")
                 [(ptr i8)]
                 (ns c"The layout file is invalid. It has been left unchanged at ~/Library/Application Support/JimCoil/layout.json."))
            (msg i64 alert (sel c"runModal") [])
            (release alert)
            false))
        (do
          (set! (.app s) app)
          (set! (.window s) window)
          (set! (.root s) root)
          (set! (.config s) (reload/defaults))
          (set! (.running s) true)
          (msg i8 app (sel c"setActivationPolicy:") [i64] 0)
          (msg i64 window (sel c"setTitle:") [(ptr i8)] (ns c"Jim · Coil"))
          (msg i64 window (sel c"setReleasedWhenClosed:") [i8] (: 0 i8))
          (msg i64 window (sel c"setMinSize:") [Size] (Size :w 900.0 :h 580.0))
          (msg i64
               window
               (sel c"setAcceptsMouseMovedEvents:")
               [i8]
               (: 1 i8))
          (msg i64
               window
               (sel c"setAppearance:")
               [(ptr i8)]
               (msg (ptr i8)
                    (class c"NSAppearance")
                    (sel c"appearanceNamed:")
                    [(ptr i8)]
                    (ns c"NSAppearanceNameDarkAqua")))
          (msg i64 root (sel c"setWantsLayer:") [i8] (: 1 i8))
          (background! root 0.045 0.057 0.078)
          (set! (.model s)
                (msg (ptr i8) (projects/restore saved) (sel c"retain") []))
          (set! (.projects s)
                (al/ArrayList::new [ProjectView] (alloc/malloc-allocator)))
          (set! (actions/model) (.model s))
          (sidebar/setup! root (.model s))
          (set! (.stage s) (view root (rect 224.0 0.0 1096.0 860.0)))
          ; Back to front: the night, the cube with its reflection, and the
          ; fade over the reflection.
          (set! (.night s) (sky/create! root (.stage s)))
          (set! (.mirror s)
                (layer-view (.stage s)
                            (rect 0.0 0.0 1096.0 860.0)
                            c"CAReplicatorLayer"))
          (msg i64
               (layer (.mirror s))
               (sel c"setPreservesDepth:")
               [i8]
               (: 1 i8))
          (msg i64
               (layer (.mirror s))
               (sel c"setInstanceAlphaOffset:")
               [f32]
               (p/cast f32 (- REFLECTION 1.0)))
          (set! (.cube s)
                (layer-view (.mirror s)
                            (rect 0.0 0.0 1096.0 860.0)
                            c"CATransformLayer"))
          (sky/add-fade! (field s night) root (.stage s))
          (msg i64
               (layer (.stage s))
               (sel c"setMasksToBounds:")
               [i8]
               (: 1 i8))
          ;; Jim Editor keeps the canvas edge clear. Operational status is
          ;; logged instead of creating a persistent hint strip in the UI.
          (set! (.status s) (nil))
          (set! (.heading s) (nil))
          (palette/setup! window)
          (timings/setup! window)
          (msg i64 app (sel c"finishLaunching") [])
          (msg i64 window (sel c"makeKeyAndOrderFront:") [(ptr i8)] (nil))
          (msg i64 app (sel c"activateIgnoringOtherApps:") [i8] (: 1 i8))
          (if (= (p/cast i64 (terminal/start!)) 0)
              false
              (let [(mut ok) true]
                (do
                  (for [i 0 (storage/count (projects/list (.model s)))]
                    (if (not (add-project-view! (storage/at (projects/list (.model s))
                                                            i)))
                        (set! ok false)
                        0))
                  (sync-selection!)
                  (load ok))))))))

(extern popen :cc (cc/C) [(ptr i8) (ptr i8)] (-> (ptr i8)))

(extern pclose :cc (cc/C) [(ptr i8)] (-> i32))

(extern fread :cc (cc/C) [(ptr u8) u64 u64 (ptr i8)] (-> u64))

;;; Apps launched from Finder or `open` inherit launchd's minimal PATH, so the
;;; tools widgets run (jimctl, gh, …) are missing. Adopt the PATH the user's
;;; login shell sets up. Terminals are unaffected: Ghostty starts login shells.
(defn adopt-login-path! [] (-> void)
  (let [pipe
          (popen c"\"${SHELL:-/bin/zsh}\" -lc 'printf %s \"$PATH\"' 2>/dev/null"
                 c"r")
        (mut buffer) (zeroed (array u8 8192))]
    (when (!= (p/cast i64 pipe) 0)
      (let [n (fread (p/cast (ptr u8) (mut buffer)) (: 1 u64) (: 8191 u64) pipe)]
        (pclose pipe)
        (when (> n (: 0 u64))
          (set! (index (p/cast (ptr u8) (mut buffer)) (p/cast i64 n))
                (: 0 u8))
          (setenv c"PATH" (p/cast (ptr i8) (mut buffer)) 1)
          0))
      0)
    (do)))

(defn main [] (-> i64)
  (let [pool (new c"NSAutoreleasePool")]
    (do
      (let [bundle
              (msg (ptr i8)
                   (msg (ptr i8) (class c"NSBundle") (sel c"mainBundle") [])
                   (sel c"bundlePath")
                   [])]
        (if (!= (msg i8 bundle (sel c"hasSuffix:") [(ptr i8)] (ns c".app"))
                (: 0 i8))
            (msg i8
                 (msg (ptr i8)
                      (class c"NSFileManager")
                      (sel c"defaultManager")
                      [])
                 (sel c"changeCurrentDirectoryPath:")
                 [(ptr i8)]
                 (msg (ptr i8)
                      (msg (ptr i8)
                           bundle
                           (sel c"stringByDeletingLastPathComponent")
                           [])
                      (sel c"stringByDeletingLastPathComponent")
                      []))
            (: 0 i8)))
      (setenv c"GHOSTTY_RESOURCES_DIR" c"build/ghostty/share/ghostty" 1)
      (adopt-login-path!)
      (widget-view/prewarm!)
      (if (not (setup!))
          (do (printf c"Jim: Ghostty initialization failed.\n") 1)
          (let [s (shell)]
            (do
              (while (and (.running s)
                          (!= (msg i8 (.window s) (sel c"isVisible") [])
                              (: 0 i8)))
                (let [frame-pool (new c"NSAutoreleasePool")
                      event
                        (msg (ptr i8)
                             (.app s)
                             (sel c"nextEventMatchingMask:untilDate:inMode:dequeue:")
                             [u64 (ptr i8) (ptr i8) i8]
                             (p/cast u64 -1)
                             (msg (ptr i8)
                                  (class c"NSDate")
                                  (sel c"dateWithTimeIntervalSinceNow:")
                                  [f64]
                                  (if (or (widget-view/any-animating?)
                                          (spinning?)
                                          (> (.settle-at s) 0.0))
                                      (/ 1.0 60.0)
                                      0.2))
                             (ns c"kCFRunLoopDefaultMode")
                             (: 1 i8))]
                  (let [input-start (timings/now)]
                    (do
                      (if (!= (p/cast i64 event) 0)
                          (if (not (handle! event))
                              (msg i64
                                   (.app s)
                                   (sel c"sendEvent:")
                                   [(ptr i8)]
                                   event)
                              0)
                          0)
                      (let [action (palette/take-action!)]
                        (if (>= action 0) (invoke! action) (do)))
                      (let [action (sidebar/take-action!)]
                        (if (!= action -1) (invoke! action) (do)))
                      (let [action (palette/take-submission!)]
                        (if (>= action 0) (submit! action (palette/text)) (do)))
                      (timings/record! 0
                                       (* 1000.0 (- (timings/now) input-start)))
                      (let [start (timings/now)]
                        (do
                          (maintenance!)
                          (timings/record! 1 (* 1000.0 (- (timings/now) start)))))
                      (let [start (timings/now)]
                        (do
                          (msg i64 (.app s) (sel c"updateWindows") [])
                          (timings/record! 2 (* 1000.0 (- (timings/now) start)))))
                      (release frame-pool)))))
              (if (!= (p/cast i64 (.task s)) 0)
                  (do
                    (msg i64 (.task s) (sel c"terminate") [])
                    (msg i64 (.task s) (sel c"waitUntilExit") [])
                    (release (.task s))
                    (release (.output s)))
                  0)
              (save-layout!)
              (palette/free!)
              (timings/free!)
              (sidebar/free!)
              (for [i 0 (count)] (canvas/free! (project i)))
              (free! (mut (.projects s)))
              (release (.model s))
              (terminal/stop!)
              (msg i64 (.window s) (sel c"close") [])
              (release (.window s))
              (release pool)
              0))))))
