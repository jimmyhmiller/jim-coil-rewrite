(module jim.guard)
(import "coil.cc" :as cc)
(import "coil.primitive" :as p)
(import "coil.slice" :use *)
(import "coil.atomic" :as atomic)
(import "coil.thread" :as thread)
(import "coil.os" :as os)

;;; Calls into widget code that come back to Jim when the widget crashes, instead
;;; of ending the process.
;;;
;;; A guarded call saves where it started with sigsetjmp. A fault, a trap, or an
;;; abort (a failed check, assertion or panic aborts) in the code it runs jumps back
;;; there with siglongjmp, and the call reports the signal. So does a call on the
;;; main thread that runs longer than the hang limit: a watchdog thread interrupts
;;; it. Whatever the widget was doing is abandoned, and Jim never calls that widget
;;; again.
;;;
;;; Two cases are left alone, because jumping out would abandon a lock the rest of
;;; the process needs:
;;;   - a fault inside the allocator, which holds its zone lock while it works;
;;;   - the watchdog's interrupt landing anywhere but widget code. Widget code is
;;;     JIT compiled, so it lies outside every loaded image, while the system
;;;     libraries and Jim itself lie inside one. The watchdog asks again until the
;;;     interrupt lands in widget code.
;;; A crash that isn't recovered writes the widget's name to the marker file before
;;; the process ends, so the next launch doesn't start that widget by itself.
;;;
;;; Coil can't mark a function as returning twice, so `enter` makes the sigsetjmp
;;; call in LLVM IR, whose `returns_twice` tells the optimizer.

;;; ---- Darwin ABI, read with clang's sizeof/offsetof ------------------------------
(const SIGACTION-SIZE 16)

(const SA-FLAGS-OFFSET 12)

(const SA-SIGINFO 64)

(const SA-ONSTACK 1)

(const SS-DISABLE 4)

(const SIGINFO-CODE-OFFSET 8)

(const UCONTEXT-MCONTEXT-OFFSET 48)

;;; __ss at 16 in the 64-bit machine context, and its __pc at 256.
(const MCONTEXT-PC-OFFSET 272)

(const JMP-BUF-SIZE 196)

(const NSIG 32)

(const SIGTRAP 5)

(const SIGABRT 6)

(const SIGSYS 12)

(const SIGUSR2 31)

;;; The signal a call stopped for running too long reports.
(const HANG SIGUSR2)

(const LC-SEGMENT-64 25)

(const MH-MAGIC-64 4277009103)

;;; O_WRONLY | O_CREAT | O_TRUNC
(const MARKER-FLAGS 1537)

;;; CLOCK_UPTIME_RAW
(const UPTIME-CLOCK 8)

(extern sigaction :cc (cc/C) [i32 (ptr i8) (ptr i8)] (-> i32))

(extern sigaltstack :cc (cc/C) [(ptr i8) (ptr i8)] (-> i32))

(extern sigsetjmp :cc (cc/C) [(ptr u8) i32] (-> i32))

(extern siglongjmp :cc (cc/C) [(ptr u8) i32] (-> void))

(extern raise :cc (cc/C) [i32] (-> i32))

(extern pthread_self :cc (cc/C) [] (-> (ptr i8)))

(defn self-thread [] (-> i64)
  (p/cast i64 (pthread_self)))

(extern pthread_kill :cc (cc/C) [(ptr i8) i32] (-> i32))

(extern usleep :cc (cc/C) [u32] (-> i32))

(extern clock_gettime_nsec_np :cc (cc/C) [u32] (-> u64))

(extern malloc :cc (cc/C) [isize] (-> (ptr i8)))

(extern write :cc (cc/C) [i32 (ptr i8) isize] (-> isize))

(extern close :cc (cc/C) [i32] (-> i32))

(extern _dyld_register_func_for_add_image :cc (cc/C) [(ptr i8)] (-> void))

(extern _dyld_image_count :cc (cc/C) [] (-> u32))

(extern _dyld_get_image_header :cc (cc/C) [u32] (-> (ptr u8)))

(extern _dyld_get_image_vmaddr_slide :cc (cc/C) [u32] (-> i64))

;;; ---- state -------------------------------------------------------------------

;;; One guarded call: its jump target, the call it is nested in, and the widget
;;; it runs for.
(defstruct Guard
  [(env (array u8 256))
   (outer (ptr Guard))
   (name (ptr u8))
   (name-len i64)
   ;; On the main thread: this call's watchdog id.
   (id i64)])

;;; A thread that has made guarded calls: its innermost call, and whether it has
;;; a stack for signal handlers, which a stack overflow needs.
(defstruct Slot [(thread i64) (guard (ptr Guard)) (alt-stack bool)])

(const MAX-THREADS 64)

(defstruct Range [(start i64) (end i64)])

(const MAX-IMAGES 8192)

(const MARKER-MAX 1024)

(const ALT-STACK-SIZE 262144)

(defstruct State
  [(installed bool)
   (main i64)
   ;; The main thread's innermost guarded call, for the watchdog: its id (0 when
   ;; none runs) and when it started, in nanoseconds of uptime.
   (main-call i64)
   (main-start i64)
   (next-call i64)
   ;; The call the watchdog has asked to stop.
   (stop-call i64)
   (hang-limit-ns i64)
   (slots (array Slot 64))
   (images (array Range 8192))
   (image-count i64)
   ;; Images that are widgets built ahead of time: widget code, though loaded.
   (widget-images (array Range 256))
   (widget-image-count i64)
   (allocator Range)
   (marker (array u8 1024))
   (previous (array u8 512))])

(defn state [] (-> (ptr State))
  (p/alloc-static State))

(defn now-ns [] (-> i64)
  (p/cast i64 (clock_gettime_nsec_np (p/cast u32 UPTIME-CLOCK))))

;;; This thread's slot, or nil when it has none. Safe in a signal handler.
(defn find-slot [] (-> (ptr Slot))
  (let [st (state)
        me (self-thread)
        (mut found) (p/cast (ptr Slot) 0)]
    (for [i 0 MAX-THREADS]
      (let [s (index (p/cast (ptr Slot) (field st slots)) i)]
        (when (and (= (p/cast i64 (load found)) 0)
                   (= (atomic/read (field s thread)) me))
          (set! found s)
          0)))
    (load found)))

;;; This thread's slot, claiming a free one the first time.
(defn own-slot! [] (-> (ptr Slot))
  (let [existing (find-slot)]
    (if (!= (p/cast i64 existing) 0)
        existing
        (let [st (state)
              me (self-thread)
              (mut claimed) (p/cast (ptr Slot) 0)]
          (for [i 0 MAX-THREADS]
            (let [s (index (p/cast (ptr Slot) (field st slots)) i)]
              (when (and (= (p/cast i64 (load claimed)) 0)
                         (= (atomic/cas (field s thread) 0 me) 0))
                (set! claimed s)
                0)))
          (when (= (p/cast i64 (load claimed)) 0)
            (panic "jim.guard: more than {} threads ran widget code"
                   MAX-THREADS))
          (load claimed)))))

(defn ensure-alt-stack! [(s (ptr Slot))] (-> void)
  (when (not (.alt-stack s))
    (let [(mut existing) (zeroed (array u8 24))]
      (if (and (= (sigaltstack (p/cast (ptr i8) 0)
                               (p/cast (ptr i8) (mut existing)))
                  (: 0 i32))
               (= (& (load (p/cast (ptr i32)
                                   (index (p/cast (ptr u8) (mut existing)) 16)))
                     (: 4 i32))
                  (: 0 i32)))
          (set! (.alt-stack s) true)
          ; Kept for the thread's life: a signal may need it at any moment.
          (let [memory (malloc (p/cast isize ALT-STACK-SIZE))
                (mut config) (zeroed (array u8 24))
                c (p/cast (ptr u8) (mut config))]
            (when (!= (p/cast i64 memory) 0)
              (set! (p/cast (ptr (ptr i8)) c) memory)
              (set! (p/cast (ptr i64) (index c 8)) ALT-STACK-SIZE)
              (when (= (sigaltstack (p/cast (ptr i8) c) (p/cast (ptr i8) 0))
                       (: 0 i32))
                (set! (.alt-stack s) true)
                0)
              0)
            0)))
    0)
  (do))

;;; ---- loaded images -------------------------------------------------------------
(defn read-u32 [(at (ptr u8))] (-> i64)
  (p/cast i64 (load (p/cast (ptr u32) at))))

(defn read-u64 [(at (ptr u8))] (-> i64)
  (p/cast i64 (load (p/cast (ptr u64) at))))

;;; Where the __TEXT segment of the image with HEADER lies once slid by SLIDE.
(defn text-range [(header (ptr u8)) (slide i64)] (-> Range)
  (let [(mut r) (Range :start 0 :end 0)]
    (when (= (read-u32 header) MH-MAGIC-64)
      (let [count (read-u32 (index header 16))
            (mut at) (index header 32)]
        (for [i 0 count]
          (let [command (load at)]
            (when (and (= (read-u32 command) LC-SEGMENT-64)
                       (= (load (index command 8)) (: 95 u8))
                       (= (load (index command 9)) (: 95 u8))
                       (= (load (index command 10)) (: 84 u8))
                       (= (load (index command 11)) (: 69 u8))
                       (= (load (index command 12)) (: 88 u8))
                       (= (load (index command 13)) (: 84 u8))
                       (= (load (index command 14)) (: 0 u8)))
              (let [start (+ (read-u64 (index command 24)) slide)]
                (set! r
                      (Range
                        :start start
                        :end (+ start (read-u64 (index command 32))))))
              0)
            (set! at (index command (read-u32 (index command 4)))))))
      0)
    (load r)))

;;; dyld calls this once for each image already loaded and for each one loaded
;;; later, one at a time.
(defn image-added [(header (ptr u8)) (slide i64)] (-> void)
  (let [st (state)
        n (atomic/read (field st image-count))]
    (when (< n MAX-IMAGES)
      (set! (index (p/cast (ptr Range) (field st images)) n)
            (text-range header slide))
      (atomic/store (field st image-count) (+ n 1))
      0)
    (do)))

(export-c [image-added :as "jim_guard_image_added"])

(defn in-ranges? [(ranges (ptr Range)) (n i64) (pc i64)] (-> bool)
  (let [(mut found) false]
    (for [i 0 n]
      (let [r (load (index ranges i))]
        (when (and (>= pc (.start r)) (< pc (.end r))) (set! found true) 0)))
    (load found)))

;;; Whether PC is in a loaded image other than a widget's.
(defn in-image? [(pc i64)] (-> bool)
  (let [st (state)]
    (and (in-ranges? (p/cast (ptr Range) (field st images))
                     (atomic/read (field st image-count))
                     pc)
         (not (in-ranges? (p/cast (ptr Range) (field st widget-images))
                          (atomic/read (field st widget-image-count))
                          pc)))))

;;; The loaded image holding ADDRESS is a widget built ahead of time, so the
;;; watchdog may stop its code like JIT-compiled widget code. False when no image
;;; holds it.
(defn widget-image! [(address i64)] (-> bool)
  (let [st (state)
        (mut found) false]
    (for [i 0 (p/cast i64 (_dyld_image_count))]
      (let [r
              (text-range (_dyld_get_image_header (p/cast u32 i))
                          (_dyld_get_image_vmaddr_slide (p/cast u32 i)))
            n (atomic/read (field st widget-image-count))]
        (when (and (not (load found))
                   (not (in-ranges? (p/cast (ptr Range)
                                            (field st widget-images))
                                    n
                                    address))
                   (>= address (.start r))
                   (< address (.end r))
                   (< n 256))
          (set! (index (p/cast (ptr Range) (field st widget-images)) n) r)
          (atomic/store (field st widget-image-count) (+ n 1))
          (set! found true)
          0)))
    (load found)))

(defn pc-of [(context (ptr u8))] (-> i64)
  (if (= (p/cast i64 context) 0)
      0
      (let [machine
              (load (p/cast (ptr (ptr u8))
                            (index context UCONTEXT-MCONTEXT-OFFSET)))]
        (if (= (p/cast i64 machine) 0)
            0
            (read-u64 (index machine MCONTEXT-PC-OFFSET))))))

;;; ---- the handlers ------------------------------------------------------------
(defn write-marker! [(g (ptr Guard))] (-> void)
  (let [st (state)
        path (p/cast (ptr u8) (field st marker))]
    (when (and (!= (p/cast i64 g) 0) (!= (load path) (: 0 u8)))
      (let [fd
              (os/open (p/cast (ptr i8) path)
                       (p/cast i32 MARKER-FLAGS)
                       (: 384 i32))]
        (when (>= fd (: 0 i32))
          (write fd
                 (p/cast (ptr i8) (.name g))
                 (p/cast isize (if (< (.name-len g) 256) (.name-len g) 256)))
          (write fd c"\n" (p/cast isize 1))
          (close fd)
          0)
        0)
      0)
    (do)))

(defn previous-of [(sig i32)] (-> (ptr u8))
  (index (p/cast (ptr u8) (field (state) previous))
         (* (p/cast i64 sig) SIGACTION-SIZE)))

;;; Hand a signal no guard takes to whoever had it before Jim: a handler of its
;;; own, or the default, which ends the process.
(defn pass-on [(sig i32) (info (ptr u8)) (context (ptr u8))] (-> void)
  (let [prev (previous-of sig)
        handler (load (p/cast (ptr (ptr i8)) prev))
        flags (load (p/cast (ptr i32) (index prev SA-FLAGS-OFFSET)))
        address (p/cast i64 handler)]
    (cond (and (!= (& flags (p/cast i32 SA-SIGINFO)) (: 0 i32)) (!= address 0))
            (call-ptr (p/cast (fnptr (cc/C) [i32 (ptr u8) (ptr u8)] void)
                              handler)
                      sig
                      info
                      context)
          (and (= (& flags (p/cast i32 SA-SIGINFO)) (: 0 i32)) (> address 1))
            (call-ptr (p/cast (fnptr (cc/C) [i32] void) handler) sig)
          :else
            (do
              ; Restore the default. A fault then happens again as the instruction
              ; is retried; a signal something sent is raised again.
              (let [(mut default) (zeroed (array u8 16))]
                (sigaction sig
                           (p/cast (ptr i8) (mut default))
                           (p/cast (ptr i8) 0)))
              (when (or (= (p/cast i64 info) 0)
                        (<= (load (p/cast (ptr i32)
                                          (index info SIGINFO-CODE-OFFSET)))
                            (: 0 i32))
                        (= (p/cast i64 sig) SIGABRT))
                (raise sig)
                0)
              (do)))))

(defn on-fatal [(sig i32) (info (ptr u8)) (context (ptr u8))] (-> void)
  (let [s (find-slot)
        g (if (= (p/cast i64 s) 0) (p/cast (ptr Guard) 0) (.guard s))
        pc (pc-of context)
        a (.allocator (state))
        in-allocator (and (>= pc (.start a)) (< pc (.end a)))]
    (if (and (!= (p/cast i64 g) 0) (not in-allocator))
        (siglongjmp (p/cast (ptr u8) (field g env)) sig)
        (do (write-marker! g) (pass-on sig info context)))
    (do)))

(export-c [on-fatal :as "jim_guard_on_fatal"])

(defn on-hang [(sig i32) (info (ptr u8)) (context (ptr u8))] (-> void)
  (let [st (state)
        s (find-slot)
        g (if (= (p/cast i64 s) 0) (p/cast (ptr Guard) 0) (.guard s))]
    (when (and (= (self-thread) (.main st))
               (!= (p/cast i64 g) 0)
               (!= (.id g) 0)
               (= (.id g) (atomic/read (field st stop-call)))
               ; Outside widget code a lock may be held: the watchdog asks again.
               (not (in-image? (pc-of context))))
      (siglongjmp (p/cast (ptr u8) (field g env)) (p/cast i32 HANG))
      0)
    (do)))

(export-c [on-hang :as "jim_guard_on_hang"])

(defn watchdog [(arg (ptr i8))] (-> (ptr i8))
  (let [st (state)]
    (loop (usleep (: 50000 u32))
      (let [id (atomic/read (field st main-call))
            start (atomic/read (field st main-start))
            limit (atomic/read (field st hang-limit-ns))]
        (when (and (!= id 0)
                   (= id (atomic/read (field st main-call)))
                   (> limit 0)
                   (> (- (now-ns) start) limit))
          (atomic/store (field st stop-call) id)
          (pthread_kill (p/cast (ptr i8) (.main st)) (p/cast i32 SIGUSR2))
          0)))
    (p/cast (ptr i8) 0)))

(defn watchdog-thread [] (-> (ptr thread/Thread))
  (p/alloc-static thread/Thread))

(defn handle! [(sig i64) (handler (ptr i8))] (-> bool)
  (let [(mut sa) (zeroed (array u8 16))
        a (p/cast (ptr u8) (mut sa))]
    (set! (p/cast (ptr (ptr i8)) a) handler)
    (set! (p/cast (ptr i32) (index a SA-FLAGS-OFFSET))
          (p/cast i32 (+ SA-SIGINFO SA-ONSTACK)))
    (= (sigaction (p/cast i32 sig)
                  (p/cast (ptr i8) a)
                  (p/cast (ptr i8) (previous-of (p/cast i32 sig))))
       (: 0 i32))))

;;; ---- installing and calling ---------------------------------------------------

;;; For tests, which make widgets hang on purpose.
(defn set-hang-limit! [(milliseconds i64)] (-> void)
  (atomic/store (field (state) hang-limit-ns) (* milliseconds 1000000)))

;;; Install the handlers and start the watchdog, on the main thread, before any
;;; widget runs. MARKER is where a crash that can't be recovered names its widget;
;;; HANG-MS is how long a guarded call on the main thread may run (0 for ever).
(defn install! [(marker (slice u8)) (hang-ms i64)] (-> bool)
  (let [st (state)]
    (if (.installed st)
        true
        (do
          (set! (.installed st) true)
          (set! (.main st) (self-thread))
          (set! (.next-call st) 1)
          (let [n (if (< (len marker) MARKER-MAX) (len marker) (- MARKER-MAX 1))]
            (for [i 0 n]
              (set! (index (p/cast (ptr u8) (field st marker)) i)
                    (get marker i)))
            (set! (index (p/cast (ptr u8) (field st marker)) n) (: 0 u8)))
          (set-hang-limit! hang-ms)
          (_dyld_register_func_for_add_image (p/cast (ptr i8)
                                                     (fnptr-of image-added)))
          ; The allocator is the image whose code holds malloc.
          (let [at (p/cast i64 (p/cast (ptr i8) (fnptr-of malloc)))]
            (for [i 0 (p/cast i64 (_dyld_image_count))]
              (let [r
                      (text-range (_dyld_get_image_header (p/cast u32 i))
                                  (_dyld_get_image_vmaddr_slide (p/cast u32 i)))]
                (when (and (>= at (.start r)) (< at (.end r)))
                  (set! (.allocator st) r)
                  0))))
          (ensure-alt-stack! (own-slot!))
          (let [fatal (p/cast (ptr i8) (fnptr-of on-fatal))
                ok
                  (and (handle! 11 fatal)
                       (handle! 10 fatal)
                       (handle! 4 fatal)
                       (handle! SIGTRAP fatal)
                       (handle! 8 fatal)
                       (handle! SIGABRT fatal)
                       (handle! SIGSYS fatal)
                       (handle! SIGUSR2 (p/cast (ptr i8) (fnptr-of on-hang))))]
            (thread/Thread::spawn-configured (watchdog-thread)
                                             (fnptr-of watchdog)
                                             (p/cast (ptr i8) 0)
                                             (thread/ThreadConfig::new 262144 0))
            ok)))))

;;; Call F(ARG), C functions, with G as the jump target, made current in CELL
;;; once it exists. 0 when F returns, or the signal a jump back passed.
(defn enter [(env (ptr u8))
             (f (ptr i8))
             (arg (ptr i8))
             (g (ptr Guard))
             (cell (ptr (ptr Guard)))] (-> i32)
  (p/llvm-ir i32
             [env f arg (p/cast (ptr i8) (fnptr-of sigsetjmp)) g cell]
             "%r = call i32 $3(ptr $0, i32 1) returns_twice
%again = icmp ne i32 %r, 0
br i1 %again, label %jumped, label %first
first:
store volatile ptr $4, ptr $5
call void $1(ptr $2)
ret i32 0
jumped:
ret i32 %r"))

;;; Run F, a C function taking one pointer, with ARG, on behalf of the widget NAME.
;;; 0 when F returned; otherwise the signal that stopped it, and F's work is
;;; abandoned wherever it was.
(defn call! [(f (ptr i8)) (arg (ptr i8)) (name (slice u8))] (-> i64)
  (let [st (state)
        s (own-slot!)
        on-main (and (.installed st) (= (self-thread) (.main st)))
        outer-id (if on-main (atomic/read (field st main-call)) 0)
        (mut g)
          (Guard
            :env (zeroed (array u8 256))
            :outer (.guard s)
            :name (data name)
            :name-len (len name)
            :id 0)]
    (ensure-alt-stack! s)
    (when on-main
      (set! (.id g) (.next-call st))
      (set! (.next-call st) (+ (.next-call st) 1))
      (atomic/store (field st main-call) 0)
      (atomic/store (field st main-start) (now-ns))
      (atomic/store (field st main-call) (.id g))
      0)
    (let [result
            (enter (p/cast (ptr u8) (field (mut g) env))
                   f
                   arg
                   (mut g)
                   (p/cast (ptr (ptr Guard)) (field s guard)))]
      (set! (.guard s) (.outer g))
      (when on-main
        ; An outer call starts its time again: it was not the one running.
        (atomic/store (field st main-call) 0)
        (atomic/store (field st main-start) (now-ns))
        (atomic/store (field st main-call) outer-id)
        0)
      (p/cast i64 result))))

;;; What stopped a call, for people.
(defn describe [(sig i64)] (-> (slice u8))
  (cond (= sig 11) "it crashed: a bad memory access (SIGSEGV)"
        (= sig 10) "it crashed: a bad memory access (SIGBUS)"
        (= sig SIGABRT) "it failed a check or assertion, or panicked (SIGABRT)"
        (= sig SIGTRAP) "it hit a trap (SIGTRAP)"
        (= sig 4) "it ran an illegal instruction (SIGILL)"
        (= sig 8) "it failed arithmetic (SIGFPE)"
        (= sig SIGSYS) "it made a bad system call (SIGSYS)"
        (= sig HANG) "it ran too long without returning"
        :else "it crashed"))
