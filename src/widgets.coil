(module jim.widgets)
(import "coil.cc" :as cc)
(import "coil.primitive" :as p)
(import "coil.alloc" :as alloc)
(import "coil.arraylist" :use *)
(import "coil.slice" :use *)
(import "coil.fs" :as fs)
(import "coil.jit" :as jit)
(import "coil.thread" :as thread)
(import "coil.sync" :as sync)
(import "jim.widget-api" :as api)
(import "jim.services" :as services)
(import "jim.runtime" :as runtime)
(import "jim.guard" :as guard)

;;; Hot-reloaded Coil widgets.
;;;
;;; A widget is `widgets/NAME.coil`, declaring `(module widgets.NAME)`, a type
;;; implementing api/Widget, and `boot`. Every pane running a source shares its
;;; compiled code, so a JIT session (hundreds of megabytes) is paid per source,
;;; not per pane, and a save compiles once however many panes show it. A new pane
;;; of a source that is already compiled boots at once.
;;;
;;; A Source compiles into a Generation it is not running: its idle one, or a new one,
;;; while the live panes keep running. Compiling never happens on the main thread.
;;; One worker thread makes every coil.jit call (sessions, compiles, symbol lookup,
;;; resets), one job at a time in submission order. When a compile succeeds the
;;; main thread picks up the result on its next pass (`service-poll!`) and, for
;;; each pane, saves the live widget's state and boots the new generation by
;;; calling its boot shim directly, which takes microseconds. Only then is the old
;;; widget destroyed, with its own code. A Generation is reset, which unmaps its code,
;;; once nothing uses it. Any failure resets the candidate alone and keeps the
;;; live widgets. A pane whose state the new generation refuses stays on the old
;;; generation, which stays mapped until that pane moves on.
;;;
;;; Compiled code is shared, so a widget's module-level mutable state is shared by
;;; its panes. Keep per-pane state in the widget's own struct.
;;;
;;; Jim calls widgets only through the api/Widget vtable, from the main thread,
;;; between events, so no widget code is running when a generation retires.
;;;
;;; Every call into widget code is guarded (jim.guard). A widget that crashes, fails
;;; a check, panics or runs too long stops there and Jim carries on: the pane says
;;; what happened, and Jim never calls that widget again, not even to free it, since
;;; its memory may be broken. Restart boots it again from its last saved state, and
;;; saving its file boots the new code. A crash is saved with the layout, so the
;;; next launch doesn't run it again by itself either.
(extern getenv :cc (cc/C) [(ptr i8)] (-> (ptr i8)))

(extern access :cc (cc/C) [(ptr i8) i32] (-> i32))

(extern strlen :cc (cc/C) [(ptr i8)] (-> u64))

(extern usleep :cc (cc/C) [u32] (-> i32))

;;; Macro: the bytes of file PATH (relative to the build directory) as a
;;; string literal. An unreadable file fails the build at PATH.
(defn embed-file [(path Code)] (-> Code)
  (try (let [text
               (try-or! (fs/read-file (alloc/malloc-allocator)
                                      (p/code-str path))
                        (do
                          (p/report path
                                    "cannot read this file when building Jim")
                          `""))]
         `~text)))

;;; The API source this program was compiled from. Every widget session compiles
;;; this exact text, so Jim's and the widget's copies of api types agree.
(defn api-source [] (-> (slice u8))
  (embed-file "src/widget_api.coil"))

(defn path-join [(dir (slice u8)) (name (slice u8))] (-> (slice u8))
  (let [a (alloc/malloc-allocator)
        (mut out) (ArrayList::new [u8] a)]
    (extend! (mut out) (data dir) (len dir))
    (push! (mut out) (: 47 u8))
    (extend! (mut out) (data name) (len name))
    (push! (mut out) (: 0 u8))
    (into-slice (mut out))))

;;; The `coil` executable that built Jim, found on the build's PATH. The JIT
;;; loads its matching standard library from this toolchain. Jim is usually
;;; launched from Finder or `open`, where PATH does not include it.
(defn find-toolchain [] (-> (slice u8))
  (let [path-var (getenv c"PATH")]
    (if (= (p/cast i64 path-var) 0)
        ""
        (let [entries
                (slice::new (p/cast (ptr u8) path-var)
                            (p/cast i64 (strlen path-var)))
              (mut start) 0
              (mut found) ""]
          (for [i 0 (+ (len entries) 1)]
            (when (and (= (len (load found)) 0)
                       (or (= i (len entries))
                           (= (get entries i) (: 58 u8))))
              (when (> i (load start))
                (let [candidate
                        (path-join (subslice entries (load start) i) "coil")]
                  (if (= (access (p/cast (ptr i8) (data candidate))
                                 (: 1 i32))
                         (: 0 i32))
                      ; Drop the NUL terminator from the returned path.
                      (set! found (subslice candidate 0 (- (len candidate) 1)))
                      0)))
              (set! start (+ i 1))))
          (load found)))))

;;; Macro: the absolute path of the `coil` that is building Jim.
(defn build-toolchain [(anchor Code)] (-> Code)
  (let [found (find-toolchain)]
    (if (= (len found) 0)
        (do (p/report anchor "coil must be on PATH when building Jim") `"")
        `~found)))

(defn toolchain [] (-> (slice u8))
  (build-toolchain toolchain))

;;; The toolchain widgets compile with: a release's own, otherwise the one that
;;; built Jim.
(defn session-toolchain [] (-> (slice u8))
  (let [bundled (runtime/toolchain)]
    (if (= (p/cast i64 bundled) 0)
        (toolchain)
        (slice::new (p/cast (ptr u8) bundled) (p/cast i64 (strlen bundled))))))

(defstruct Stat
  [(head (array u8 48)) (mtime-sec i64) (mtime-nsec i64) (tail (array u8 80))])

(extern stat :cc (cc/C) [(ptr i8) (ptr Stat)] (-> i32))

;;; One compiled generation of a Source: a JIT session and the code in it.
(defstruct Generation
  ;; Owned by the compile worker: the main thread never touches these.
  [(session jit/JitSession)
   (started bool)
   ;; A generation lease token held while this generation may run, so a reset of
   ;; live code fails instead of unmapping it.
   (lease i64)
   (leased bool)
   ;; Owned by the main thread.
   (shim (ptr i8))
   ;; The source's modification time this generation was compiled from.
   (stamp i64)
   ;; Widgets running this generation, retiring ones included, plus one while it
   ;; is its Source's current generation.
   (users i64)
   (source (ptr Source))])

;;; A widget source file and the compiled generations of it, shared by every pane
;;; showing it. Owned by the main thread.
(defstruct Source
  [(path (ArrayList u8))
   ;; Panes showing this source that are not closing.
   (runtimes (ArrayList (ptr Runtime)))
   ;; Runtimes not yet freed, closing ones included.
   (holders i64)
   ;; Jobs submitted for this source's generations and not yet finished.
   (pending i64)
   (current (ptr Generation))
   (idle (ArrayList (ptr Generation)))
   (compiling bool)
   (again bool)
   (stamp i64)
   ;; Its last pane closed: it is out of the registry and goes when it is quiet.
   (detached bool)])

(defstruct Runtime
  [(name (ArrayList u8))
   (source (ptr Source))
   (code (ptr Generation))
   (widget (dyn api/Widget))
   (ui api/Ui)
   (diagnostic (ArrayList u8))
   (requests api/Requests)
   (directory (ArrayList u8))
   (args (ArrayList u8))
   (restored (ptr api/Snapshot))
   ;; The live generation's services (its api/Host).
   (services (ptr services/Services))
   ;; Replaced generations waiting for their tasks to finish before their code
   ;; can be destroyed and unmapped.
   (retiring (ArrayList Retiree))
   (released bool)
   (closing bool)
   (update i64)
   ;; The widget stopped (see jim.guard), and the generation's stamp it stopped in.
   (crashed bool)
   (crash-stamp i64)
   ;; The state of the last save that worked, for Restart.
   (last-saved (ptr api/Snapshot))])

(defstruct Retiree
  [(widget (dyn api/Widget))
   (present bool)
   (code (ptr Generation))
   (services (ptr services/Services))])

(defn valid-name? [(name (slice u8))] (-> bool)
  (let [(mut ok) (> (len name) 0)]
    (for [i 0 (len name)]
      (let [c (p/cast i64 (get name i))]
        (when (not (or (and (>= c 97) (<= c 122))
                       (and (>= c 48) (<= c 57))
                       (= c 45)
                       (= c 95)))
          (set! ok false))))
    (load ok)))

(defn push-str! [(l (ptr (ArrayList u8))) (s (slice u8))] (-> void)
  (extend! (mut l) (data s) (len s))
  (do))

(defn set-str! [(l (ptr (ArrayList u8))) (s (slice u8))] (-> void)
  (clear! (mut l))
  (push-str! l s))

(defn say! [(r (ptr Runtime)) (message (slice u8))] (-> void)
  (set-str! (field r diagnostic) message))

;;; ---- the compile service ---------------------------------------------------
(const JOB-COMPILE 1)

(const JOB-RESET 2)

;;; Free a generation's session and the generation.
(const JOB-FREE-CODE 3)

;;; Nothing for the worker to do: it only orders a closing runtime's memory after
;;; every job submitted before it.
(const JOB-RELEASE 4)

(defstruct Job
  [(kind i64)
   (code (ptr Generation))
   (runtime (ptr Runtime))
   (text (ArrayList u8))])

(defstruct Done
  [(kind i64)
   (code (ptr Generation))
   (runtime (ptr Runtime))
   (ok bool)
   (shim (ptr i8))
   (message (ArrayList u8))])

(defstruct Service
  [(lock sync/Mutex)
   (wake sync/Condition)
   (jobs (ArrayList Job))
   (done (ArrayList Done))
   (worker thread/Thread)
   (started bool)
   (outstanding i64)
   (notify (ptr i8))])

(defn service-cell [] (-> (ptr Service))
  (p/alloc-static Service))

(defn lock! [(s (ptr Service))] (-> void)
  (try (let [_ (try-or! (sync/Mutex::lock! (field s lock)) 0)] 0))
  (do))

(defn unlock! [(s (ptr Service))] (-> void)
  (try (let [_ (try-or! (sync/Mutex::unlock! (field s lock)) 0)] 0))
  (do))

;;; ---- the compiler's own malloc zone -------------------------------------------------
(extern malloc_create_zone :cc (cc/C) [u64 u32] (-> (ptr i8)))

(extern malloc_zone_malloc :cc (cc/C) [(ptr i8) u64] (-> (ptr i8)))

(extern malloc_zone_memalign :cc (cc/C) [(ptr i8) u64 u64] (-> (ptr i8)))

(extern malloc_zone_realloc :cc (cc/C) [(ptr i8) (ptr i8) u64] (-> (ptr i8)))

(extern malloc_zone_free :cc (cc/C) [(ptr i8) (ptr i8)] (-> void))

;;; Compiling allocates and frees hundreds of megabytes. In the default malloc
;;; zone that contends with the main thread's own allocations for the zone's
;;; lock, stalling it for milliseconds; a private zone keeps them apart.
(defstruct CompilerZone [(zone (ptr i8))])

(defn some-or-none [(q (ptr i8))] (-> (Option (ptr i8)))
  (if (= (p/cast i64 q) 0) (None) (Some q)))

(impl alloc/Allocator CompilerZone
  (allocate [(self (ptr CompilerZone)) (request (ref alloc/AllocRequest))]
    (-> (Option (ptr i8)))
    (let [bytes (p/cast u64 (.bytes request))
          align (.align request)]
      (some-or-none (if (<= align 16)
                        (malloc_zone_malloc (.zone self) bytes)
                        (malloc_zone_memalign (.zone self)
                                              (p/cast u64 align)
                                              bytes)))))
  ; A shrink succeeds in place; growth needs remap.
  (resize [(self (ptr CompilerZone))
           (memory (ptr i8))
           (old (ref alloc/AllocRequest))
           (new (ref alloc/AllocRequest))]
    (-> bool)
    (<= (.bytes new) (.bytes old)))
  (remap [(self (ptr CompilerZone))
          (memory (ptr i8))
          (old (ref alloc/AllocRequest))
          (new (ref alloc/AllocRequest))]
    (-> (Option (ptr i8)))
    (if (> (.align new) 16)
        (None)
        (some-or-none (malloc_zone_realloc (.zone self)
                                           memory
                                           (p/cast u64
                                                   (.bytes new))))))
  (deallocate [(self (ptr CompilerZone))
               (memory (ptr i8))
               (request (ref alloc/AllocRequest))]
    (-> i64)
    (malloc_zone_free (.zone self) memory)
    0))

(defn compiler-allocator [] (-> (dyn alloc/Allocator))
  (let [z (p/alloc-static CompilerZone)]
    (when (= (p/cast i64 (.zone z)) 0)
      (set! (.zone z) (malloc_create_zone (: 0 u64) (: 0 u32)))
      0)
    (p/make-dyn alloc/Allocator z)))

;;; A new session, publishing through the native backend (tpde): Jim is built
;;; with `jit = "tpde"`, so its JIT links no LLVM. A save shows in about half a
;;; second.
;;; A new session reads Jim's Coil.toml (from the working directory, the project
;;; root) so widget imports such as jim.widget-api resolve from its source roots.
(defn acquire [] (-> jit/JitSession)
  (let [(mut session)
          (jit/jit-session-new-with-toolchain (compiler-allocator)
                                              (session-toolchain))
        loaded (jit/jit-session-load-project! (mut session))]
    (when (!= loaded 0)
      (println "widgets: the JIT session could not load Coil.toml ({}); project imports will not resolve"
               loaded)
      0)
    (load session)))

;;; C's session, started on first use. Worker only.
(defn session [(c (ptr Generation))] (-> (ptr jit/JitSession))
  (when (not (.started c))
    (set! (.session c) (acquire))
    (set! (.started c) true)
    0)
  (field c session))

;;; Imports resolve from disk, never from earlier submissions. So after the
;;; widget compiles, this shim joins its module under private aliases and is
;;; exported under a C name, which is coil.jit's documented lookup contract
;;; (lookup is per session, so every widget can use the same name). Jim calls it
;;; with two addresses, independent of how the widget spelled its imports.
(defn shim-source [] (-> (slice u8))
  (embed-file "src/widget_shim.txt"))

;;; Compiled into a session before the widget, coil.safety checks every widget
;;; operation after it (Zig's safe build modes, see `coil guide debugging`) and
;;; makes the widget's heap Coil's debug allocator. A failed check aborts, which
;;; jim.guard turns into the widget stopping.
(defn safety-prelude [] (-> (slice u8))
  "(import \"coil.safety\")")

;;; Widgets compile against src/widget_api.coil on disk. Jim's own copy is the
;;; text it was built from; if they differ, the layouts may too, so refuse.
(defn api-current? [(out (ptr (ArrayList u8)))] (-> bool)
  (try (let [text
               (try-or! (fs/read-file (alloc/malloc-allocator)
                                      "src/widget_api.coil")
                        (do
                          (set-str! out "Cannot read src/widget_api.coil")
                          false))]
         (let [same (= text (api-source))]
           (alloc/free [u8] (alloc/malloc-allocator) text)
           (when (not same)
             (set-str! out
                       "src/widget_api.coil changed since Jim was built; rebuild Jim to load widgets against it.")
             0)
           same))))

(defn compile-into! [(s (ptr jit/JitSession))
                     (source (slice u8))
                     (out (ptr (ArrayList u8)))] (-> bool)
  (if (= (jit/jit-compile! s source) 0)
      true
      (do (set-str! out (jit/jit-diagnostic s)) false)))

;;; Worker: compile JOB's source and shim, and find the shim.
(defn run-compile [(job (ptr Job))] (-> Done)
  (let [c (.code job)
        s (session c)
        (mut message) (ArrayList::new [u8] (alloc/malloc-allocator))
        (mut shim-name) (ArrayList::new [u8] (alloc/malloc-allocator))
        ; Panics and diagnostics then name the widget's file instead of <jit>.
        _ (jit/jit-session-set-source-name! s (source-path (.source c)))
        compiled
          (and (api-current? (mut message))
               ; Checked, so a bad index, a null pointer or a double free
               ; stops the widget where it happens instead of breaking memory.
               (compile-into! s (safety-prelude) (mut message))
               (compile-into! s (slice (.text job)) (mut message))
               (compile-into! s (shim-source) (mut message)))]
    (push-str! (mut shim-name) "jim_shim_boot")
    (let [shim
            (if compiled
                (jit/jit-symbol-address s (slice shim-name))
                (p/cast (ptr i8) 0))
          ok (and compiled (!= (p/cast i64 shim) 0))]
      (when (and compiled (not ok))
        (set-str! (mut message)
                  "the widget compiled but its boot shim was not found")
        0)
      (if ok
          (let [token (jit/jit-generation-retain-current! s)]
            (set! (.lease c) token)
            (set! (.leased c) (!= token -1))
            0)
          (do (jit/jit-reset! s) 0))
      (ArrayList::free! (mut shim-name))
      (Done
        :kind JOB-COMPILE
        :code c
        :runtime (.runtime job)
        :ok ok
        :shim shim
        :message (load message)))))

(defn release-lease! [(c (ptr Generation))] (-> void)
  (when (.leased c)
    (jit/jit-generation-release-token! (field c session) (.lease c))
    (set! (.leased c) false)
    0)
  (do))

(defn run-job [(job (ptr Job))] (-> Done)
  (if (= (.kind job) JOB-COMPILE)
      (run-compile job)
      (let [c (.code job)]
        (cond (= (.kind job) JOB-RESET)
                (when (.started c)
                  (release-lease! c)
                  (jit/jit-reset! (field c session))
                  0)
              (= (.kind job) JOB-FREE-CODE)
                (when (.started c)
                  (release-lease! c)
                  (jit/jit-session-free! (field c session))
                  (set! (.started c) false)
                  0)
              :else 0)
        (Done
          :kind (.kind job)
          :code c
          :runtime (.runtime job)
          :ok true
          :shim (p/cast (ptr i8) 0)
          :message (ArrayList::new [u8] (alloc/malloc-allocator))))))

(extern pthread_set_qos_class_self_np :cc (cc/C) [u32 i32] (-> i32))

;;; QOS_CLASS_USER_INITIATED
(const QOS-USER-INITIATED 25)

(defn worker [(arg (ptr i8))] (-> (ptr i8))
  (let [s (p/cast (ptr Service) arg)]
    ; Below the main thread, which runs user-interactive: never compete with it.
    (pthread_set_qos_class_self_np (p/cast u32 QOS-USER-INITIATED)
                                   (: 0 i32))
    (loop (lock! s)
      (while (= (len (.jobs s)) 0)
        (try (let [_
                     (try-or! (wait! (field s wake)
                                     (field s lock))
                              0)]
               0)))
      (let [(mut job) (get (.jobs s) 0)]
        ; Jobs run in submission order, so a session's reset precedes its next compile.
        (for [i 1 (len (.jobs s))]
          (set! (elem (field s jobs) (- i 1)) (get (.jobs s) i)))
        (set! (.len (field s jobs)) (- (len (.jobs s)) 1))
        (unlock! s)
        (let [d (run-job (mut job))]
          (ArrayList::free! (mut (.text job)))
          (lock! s)
          (push! (mut (.done s)) d)
          (unlock! s)
          (when (!= (p/cast i64 (.notify s)) 0)
            (call-ptr (p/cast (fnptr (cc/C) [] void) (.notify s)))
            0))))
    (p/cast (ptr i8) 0)))

;;; The service, starting its worker on first use (from the main thread).
(defn service [] (-> (ptr Service))
  (let [s (service-cell)]
    (when (not (.started s))
      (sync/Mutex::init (field s lock))
      (sync/Condition::init (field s wake))
      (set! (.jobs s) (ArrayList::new [Job] (alloc/malloc-allocator)))
      (set! (.done s) (ArrayList::new [Done] (alloc/malloc-allocator)))
      (set! (.started s) true)
      ; The compiler recurses deeply; give it room.
      (thread/Thread::spawn-configured (field s worker)
                                       (fnptr-of worker)
                                       (p/cast (ptr i8) s)
                                       (thread/ThreadConfig::new (* 512 1048576)
                                                                 65536))
      0)
    s))

;;; Called on the worker after each job, e.g. to wake the main run loop.
(defn set-notifier! [(f (ptr i8))] (-> void)
  (set! (.notify (service)) f)
  (do))

(defn submit! [(kind i64)
               (c (ptr Generation))
               (r (ptr Runtime))
               (text (slice u8))] (-> void)
  (let [s (service)
        (mut owned) (ArrayList::new [u8] (alloc/malloc-allocator))]
    (push-str! (mut owned) text)
    (when (!= (p/cast i64 c) 0)
      (set! (.pending (.source c)) (+ (.pending (.source c)) 1))
      0)
    (lock! s)
    (push! (mut (.jobs s))
           (Job
             :kind kind
             :code c
             :runtime r
             :text (load owned)))
    (set! (.outstanding s) (+ (.outstanding s) 1))
    (try (let [_ (try-or! (notify-one! (field s wake)) 0)] 0))
    (unlock! s)
    (do)))

;;; ---- runtimes ----------------------------------------------------------------

;;; The sources with open panes.
(defn sources [] (-> (ptr (ArrayList (ptr Source))))
  (let [cell (p/alloc-static (ArrayList (ptr Source)))]
    (when (= (p/cast i64 (.data cell)) 0)
      (set! cell (ArrayList::new [(ptr Source)] (alloc/malloc-allocator)))
      0)
    cell))

;;; The Source of file PATH (NUL-terminated), created on first use.
(defn source-of [(path (slice u8))] (-> (ptr Source))
  (let [all (sources)
        (mut found) (p/cast (ptr Source) 0)]
    (for [i 0 (len (load all))]
      (when (= (slice (.path (get (load all) i))) path)
        (set! found (get (load all) i))
        0))
    (when (= (p/cast i64 (load found)) 0)
      (let [a (alloc/malloc-allocator)
            src (alloc/box! a Source (zeroed Source))]
        (set! (.path src) (ArrayList::new [u8] a))
        (push-str! (field src path) path)
        (set! (.runtimes src) (ArrayList::new [(ptr Runtime)] a))
        (set! (.idle src) (ArrayList::new [(ptr Generation)] a))
        (push! (mut all) src)
        (set! found src)
        0))
    (load found)))

;;; A runtime for DIR/NAME.coil. Nothing loads until reload!. Every boot sees
;;; PROJECT (the project directory) and ARGS (the text after the widget name).
(defn create-in [(dir (slice u8))
                 (name (slice u8))
                 (project (slice u8))
                 (args (slice u8))] (-> (ptr Runtime))
  (let [a (alloc/malloc-allocator)
        r (alloc/box! a Runtime (zeroed Runtime))
        (mut path) (ArrayList::new [u8] a)]
    (set! (.name r) (ArrayList::new [u8] a))
    (push-str! (field r name) name)
    ; NUL-terminated: the path is also handed to stat.
    (push-str! (mut path) dir)
    (push-str! (mut path) "/")
    (push-str! (mut path) name)
    (push-str! (mut path) ".coil")
    (push! (mut path) (: 0 u8))
    (let [src (source-of (slice path))]
      (set! (.source r) src)
      (push! (mut (.runtimes src)) r)
      (set! (.holders src) (+ (.holders src) 1))
      0)
    (ArrayList::free! (mut path))
    (set! (.ui r) (api/ui-new a))
    (set! (.diagnostic r) (ArrayList::new [u8] a))
    (set! (.requests r) (api/requests-new a))
    (set! (.directory r) (ArrayList::new [u8] a))
    (push-str! (field r directory) project)
    (set! (.args r) (ArrayList::new [u8] a))
    (push-str! (field r args) args)
    (set! (.restored r) (p/cast (ptr api/Snapshot) 0))
    (set! (.last-saved r) (p/cast (ptr api/Snapshot) 0))
    (set! (.retiring r) (ArrayList::new [Retiree] a))
    (protect! "")
    r))

;;; A runtime for widgets/NAME.coil, relative to Jim's working directory.
(defn create [(name (slice u8)) (project (slice u8)) (args (slice u8))]
  (-> (ptr Runtime))
  (create-in "widgets" name project args))

;;; State saved by an earlier run of Jim, used for the first boot only.
(defn restore-state! [(r (ptr Runtime)) (state api/Snapshot)] (-> void)
  (let [saved (alloc/box! (alloc/malloc-allocator) api/Snapshot state)
        crash (api/find saved "jim.crashed")]
    (set! (.restored r) saved)
    (replace-last-saved! r saved)
    (cond (!= crash api/NONE)
            (do
              ; Stopped last run, and stays stopped until restarted or edited.
              (set! (.crashed r) true)
              (set! (.crash-stamp r) (api/get-i64 saved "jim.crash-stamp" -1))
              (say! r (api/get-text saved "jim.crashed" ""))
              0)
          (held? (slice (.name r)))
            (do
              (set! (.crashed r) true)
              (set! (.crash-stamp r) (source-stamp (.source r)))
              (say! r
                    "Jim quit unexpectedly while this widget was running, so it hasn't been started again. Restart runs it from its last saved state; saving its file runs the new code.")
              0)
          :else 0))
  (do))

(defn source-path [(src (ptr Source))] (-> (slice u8))
  (subslice (slice (.path src)) 0 (- (len (.path src)) 1)))

(defn live? [(r (ptr Runtime))] (-> bool)
  (!= (p/cast i64 (.code r)) 0))

;;; True while the first generation is still compiling.
(defn loading? [(r (ptr Runtime))] (-> bool)
  (and (.compiling (.source r)) (not (live? r))))

;;; Modification time of the source in nanoseconds, or -1 when missing.
(defn source-stamp [(src (ptr Source))] (-> i64)
  (let [(mut st) (zeroed Stat)]
    (if (= (stat (p/cast (ptr i8) (data (slice (.path src)))) (mut st))
           (: 0 i32))
        (+ (* (.mtime-sec st) 1000000000) (.mtime-nsec st))
        -1)))

(defn changed? [(r (ptr Runtime))] (-> bool)
  (let [src (.source r)
        stamp (source-stamp src)]
    (and (>= stamp 0) (!= stamp (.stamp src)))))

;;; ---- compiled generations ----------------------------------------------------

;;; C is unused now and reset: keep one for the next compile, free the rest.
(defn code-idle! [(c (ptr Generation))] (-> void)
  (let [src (.source c)]
    (if (or (.detached src) (> (len (.idle src)) 0))
        (submit! JOB-FREE-CODE c (p/cast (ptr Runtime) 0) "")
        (do (push! (mut (.idle src)) c) (do)))))

(defn code-release! [(c (ptr Generation))] (-> void)
  (set! (.users c) (- (.users c) 1))
  (when (= (.users c) 0)
    (submit! JOB-RESET c (p/cast (ptr Runtime) 0) "")
    0)
  (do))

;;; Once a detached source is quiet, give back everything it holds and then
;;; itself, which the jobs this submits come back through.
(defn source-settle! [(src (ptr Source))] (-> void)
  (when (and (.detached src) (= (.holders src) 0) (not (.compiling src)))
    (let [c (.current src)]
      (when (!= (p/cast i64 c) 0)
        (set! (.current src) (p/cast (ptr Generation) 0))
        (code-release! c)
        0))
    (for [i 0 (len (.idle src))]
      (submit! JOB-FREE-CODE (get (.idle src) i) (p/cast (ptr Runtime) 0) ""))
    (clear! (mut (.idle src)))
    (when (= (.pending src) 0)
      (ArrayList::free! (mut (.path src)))
      (ArrayList::free! (mut (.runtimes src)))
      (ArrayList::free! (mut (.idle src)))
      (alloc/destroy [Source] (alloc/malloc-allocator) src)
      0)
    0)
  (do))

;;; R no longer shows its source; with no panes left the source is detached, so
;;; the next pane of this widget starts from a fresh compile.
(defn source-leave! [(src (ptr Source)) (r (ptr Runtime))] (-> void)
  (let [(mut k) 0]
    (for [i 0 (len (.runtimes src))]
      (let [other (get (.runtimes src) i)]
        (when (!= (p/cast i64 other) (p/cast i64 r))
          (set! (elem (field src runtimes) (load k)) other)
          (set! k (+ (load k) 1))
          0)))
    (set! (.len (field src runtimes)) (load k)))
  (when (= (len (.runtimes src)) 0)
    (set! (.detached src) true)
    (let [all (sources)
          (mut k) 0]
      (for [i 0 (len (load all))]
        (let [other (get (load all) i)]
          (when (!= (p/cast i64 other) (p/cast i64 src))
            (set! (elem all (load k)) other)
            (set! k (+ (load k) 1))
            0)))
      (set! (.len all) (load k)))
    0)
  (do))

;;; ---- retiring generations ----------------------------------------------------
(defn retiring-runtimes [] (-> (ptr (ArrayList (ptr Runtime))))
  (let [cell (p/alloc-static (ArrayList (ptr Runtime)))]
    (when (= (p/cast i64 (.data cell)) 0)
      (set! cell (ArrayList::new [(ptr Runtime)] (alloc/malloc-allocator)))
      0)
    cell))

;;; Destroy retired generations whose tasks have finished and drop their claim on
;;; their code; release a closing runtime once nothing is left.
(defn drain-retiring! [(r (ptr Runtime))] (-> void)
  (let [(mut k) 0]
    (for [i 0 (len (.retiring r))]
      (let [e (get (.retiring r) i)]
        (if (services/busy? (.services e))
            (do
              (set! (elem (field r retiring) (load k)) e)
              (set! k (+ (load k) 1))
              0)
            (do
              (when (.present e)
                (let [(mut call) (call-of CALL-DESTROY (.widget e))]
                  ; A crash while freeing leaves the memory; there is nothing else to do.
                  (guarded r (mut call)))
                0)
              (services/free! (.services e))
              (code-release! (.code e))
              0))))
    (set! (.len (field r retiring)) (load k)))
  (when (and (.closing r) (= (len (.retiring r)) 0) (not (.released r)))
    (set! (.released r) true)
    (submit! JOB-RELEASE (p/cast (ptr Generation) 0) r "")
    0)
  (do))

(defn retire! [(r (ptr Runtime))
               (widget (dyn api/Widget))
               (present bool)
               (c (ptr Generation))
               (s (ptr services/Services))] (-> void)
  (push! (mut (.retiring r))
         (Retiree
           :widget widget
           :present present
           :code c
           :services s))
  (let [all (retiring-runtimes)
        (mut listed) false]
    (for [i 0 (len (load all))]
      (when (= (p/cast i64 (get (load all) i)) (p/cast i64 r))
        (set! listed true)
        0))
    (when (not (load listed)) (push! (mut all) r) 0))
  (drain-retiring! r))

;;; Tell every pane of SRC why its source did not load.
(defn say-all! [(src (ptr Source)) (message (slice u8))] (-> void)
  (for [i 0 (len (.runtimes src))]
    (let [r (get (.runtimes src) i)]
      (say! r message)
      (set! (.update r) -1)))
  (do))

;;; Start compiling SRC's file; returns at once. A save arriving while a compile
;;; runs is compiled after it, once.
;;; ---- widgets built ahead of time -------------------------------------------
;;;
;;; Compiling a widget takes the JIT most of a second, so scripts/widget_cache.py
;;; builds each one ahead of time, checked with coil.safety, into
;;; build/widget-cache/NAME.dylib. Beside it, NAME.key hashes what it was built
;;; from: the shim, the widget's source, widget_api.coil and every widget-kit file.
;;; When the sources on disk still hash to that key the library is loaded, in a few
;;; milliseconds and on the main thread, so a pane never waits behind a compile; a
;;; widget edited since takes the JIT as before. A library stays loaded once loaded.
(const CACHE-DIR "build/widget-cache")

(extern dlopen :cc (cc/C) [(ptr i8) i32] (-> (ptr i8)))

(extern dlsym :cc (cc/C) [(ptr i8) (ptr i8)] (-> (ptr i8)))

;;; RTLD_NOW | RTLD_LOCAL: each widget library keeps its own copy of the library code.
(const DLOPEN-FLAGS 6)

;;; FNV-1a, 64-bit, as scripts/widget_cache.py computes it.
(defn hash-bytes [(h i64) (bytes (slice u8))] (-> i64)
  (let [(mut x) h]
    (for [i 0 (len bytes)]
      (set! x (p/imul (^ (load x) (p/cast i64 (get bytes i))) 1099511628211)))
    (load x)))

;;; One input: its label, a zero byte, its bytes, a zero byte.
(defn hash-part [(h i64) (label (slice u8)) (bytes (slice u8))] (-> i64)
  (let [zero (: [0] (slice u8))]
    (hash-bytes (hash-bytes (hash-bytes (hash-bytes h label) zero) bytes) zero)))

(defn sort-names! [(names (ptr (ArrayList (slice u8))))] (-> void)
  (for [i 1 (len (load names))]
    (let [(mut k) i]
      (while (and (> (load k) 0)
                  (bytes-less? (get (load names) (load k))
                               (get (load names) (- (load k) 1))))
        (let [t (get (load names) (load k))]
          (set! (elem names (load k)) (get (load names) (- (load k) 1)))
          (set! (elem names (- (load k) 1)) t))
        (set! k (- (load k) 1)))))
  (do))

(defn bytes-less? [(a (slice u8)) (b (slice u8))] (-> bool)
  (let [n (if (< (len a) (len b)) (len a) (len b))
        (mut at) 0]
    (while (and (< (load at) n) (= (get a (load at)) (get b (load at))))
      (set! at (+ (load at) 1)))
    (if (= (load at) n)
        (< (len a) (len b))
        (< (p/cast i64 (get a (load at))) (p/cast i64 (get b (load at)))))))

;;; The key of a widget whose source is TEXT, as 16 hex digits into OUT, or false
;;; when a widget-kit file can't be read.
(defn cache-key! [(text (slice u8)) (out (ptr (ArrayList u8)))] (-> bool)
  (let [a (alloc/malloc-allocator)
        (mut h) -3750763034362895579
        (mut ok) true]
    (set! h (hash-part (load h) "src/widget_shim.txt" (shim-source)))
    (set! h (hash-part (load h) "widget" text))
    (set! h (hash-part (load h) "src/widget_api.coil" (api-source)))
    (match (fs/Directory::list a "src/widget_kit")
      (Ok [listed]
          (let [(mut names) listed]
            (sort-names! (mut names))
            (for [i 0 (len names)]
              (let [name (get names i)]
                (when (and (>= (len name) 5)
                           (= (subslice name (- (len name) 5) (len name))
                              ".coil"))
                  (let [(mut path) (ArrayList::new [u8] a)]
                    (push-str! (mut path) "src/widget_kit/")
                    (push-str! (mut path) name)
                    (match (fs/read-file a (slice path))
                      (Ok [bytes]
                          (set! h (hash-part (load h) (slice path) bytes))
                          (alloc/free [u8] a bytes)
                          0)
                      (Err [_] (set! ok false) 0))
                    (ArrayList::free! (mut path)))
                  0)))
            (fs/Directory::free-list a (mut names))
            0))
      (Err [_] (set! ok false) 0))
    (clear! (mut out))
    (let [digits "0123456789abcdef"]
      (for [k 0 16]
        (push! (mut out)
               (get digits (& (>> (load h) (p/cast i64 (* (- 15 k) 4))) 15)))))
    (load ok)))

;;; The widget's name: its source's file name without ".coil".
(defn source-name [(src (ptr Source))] (-> (slice u8))
  (let [path (source-path src)
        (mut start) 0]
    (for [i 0 (len path)]
      (when (= (get path i) (: 47 u8)) (set! start (+ i 1)) 0))
    (subslice path (load start) (- (len path) 5))))

(defn cache-path! [(out (ptr (ArrayList u8)))
                   (name (slice u8))
                   (suffix (slice u8))]
  (-> void)
  (clear! (mut out))
  (push-str! out CACHE-DIR)
  (push-str! out "/")
  (push-str! out name)
  (push-str! out suffix)
  (push! (mut out) (: 0 u8))
  (do))

;;; The boot shim of SRC's library built from TEXT, loaded, or nil when there is no
;;; library built from exactly these sources.
(defn load-precompiled [(src (ptr Source)) (text (slice u8))] (-> (ptr i8))
  (let [a (alloc/malloc-allocator)
        (mut key) (ArrayList::new [u8] a)
        (mut path) (ArrayList::new [u8] a)
        (mut problem) (ArrayList::new [u8] a)
        name (source-name src)
        (mut shim) (p/cast (ptr i8) 0)]
    (when (and (api-current? (mut problem)) (cache-key! text (mut key)))
      (cache-path! (mut path) name ".key")
      (match (fs/read-file a (subslice (slice path) 0 (- (len path) 1)))
        (Ok [stored]
            (when (= (runtime-trim stored) (slice key))
              (cache-path! (mut path) name ".dylib")
              (let [handle
                      (dlopen (p/cast (ptr i8) (data (slice path)))
                              (p/cast i32 DLOPEN-FLAGS))]
                (when (!= (p/cast i64 handle) 0)
                  (set! shim (dlsym handle c"jim_shim_boot"))
                  (when (!= (p/cast i64 (load shim)) 0)
                    (guard/widget-image! (p/cast i64 (load shim)))
                    0)
                  0))
              0)
            (alloc/free [u8] a stored)
            0)
        (Err [_] 0))
      0)
    (ArrayList::free! (mut key))
    (ArrayList::free! (mut path))
    (ArrayList::free! (mut problem))
    (load shim)))

(defn runtime-trim [(s (slice u8))] (-> (slice u8))
  (let [(mut n) (len s)]
    (while (and (> (load n) 0)
                (let [c (get s (- (load n) 1))]
                  (or (= c (: 10 u8)) (= c (: 13 u8)) (= c (: 32 u8)))))
      (set! n (- (load n) 1)))
    (subslice s 0 (load n))))

;;; Set when tests want every widget from the JIT.
(defn cache-off [] (-> (ptr bool))
  (p/alloc-static bool))

(defn set-cache! [(on bool)] (-> void)
  (set! (cache-off) (not on))
  (do))

;;; Main thread: give SRC's panes the library built from TEXT, at STAMP, when there
;;; is one, as a finished compile would. False when there isn't.
(defn use-precompiled! [(src (ptr Source)) (text (slice u8)) (stamp i64)]
  (-> bool)
  (let [shim
          (if (load (cache-off))
              (p/cast (ptr i8) 0)
              (load-precompiled src text))]
    (if (= (p/cast i64 shim) 0)
        false
        (let [c
                (if (> (len (.idle src)) 0)
                    (pop-idle! src)
                    (let [fresh
                            (alloc/box! (alloc/malloc-allocator)
                                        Generation
                                        (zeroed Generation))]
                      (set! (.source fresh) src)
                      fresh))
              (mut d)
                (Done
                  :kind JOB-COMPILE
                  :code c
                  :runtime (p/cast (ptr Runtime) 0)
                  :ok true
                  :shim shim
                  :message (ArrayList::new [u8] (alloc/malloc-allocator)))]
          (set! (.stamp c) stamp)
          (set! (.compiling src) true)
          (compile-finished! (mut d))
          (ArrayList::free! (mut (.message d)))
          true))))

(defn compile! [(src (ptr Source))] (-> void)
  (let [stamp (source-stamp src)]
    (if (.compiling src)
        (when (!= stamp (.stamp src))
          (set! (.stamp src) stamp)
          (set! (.again src) true)
          0)
        (do
          (set! (.stamp src) stamp)
          (try (let [text
                       (try-or! (fs/read-file (alloc/malloc-allocator)
                                              (source-path src))
                                (let [(mut message)
                                        (ArrayList::new [u8]
                                                        (alloc/malloc-allocator))]
                                  (push-str! (mut message) "Cannot read ")
                                  (push-str! (mut message) (source-path src))
                                  (say-all! src (slice message))
                                  (ArrayList::free! (mut message))
                                  (do)))]
                 (if (use-precompiled! src text stamp)
                     (do (alloc/free [u8] (alloc/malloc-allocator) text) (do))
                     (let [spare (> (len (.idle src)) 0)
                           c
                             (if spare
                                 (pop-idle! src)
                                 (let [fresh
                                         (alloc/box! (alloc/malloc-allocator)
                                                     Generation
                                                     (zeroed Generation))]
                                   (set! (.source fresh) src)
                                   fresh))]
                       (set! (.compiling src) true)
                       (set! (.stamp c) stamp)
                       (submit! JOB-COMPILE c (p/cast (ptr Runtime) 0) text)
                       (alloc/free [u8] (alloc/malloc-allocator) text)
                       (do)))))))
    (do)))

(defn pop-idle! [(src (ptr Source))] (-> (ptr Generation))
  (let [last (- (len (.idle src)) 1)
        c (get (.idle src) last)]
    (set! (.len (field src idle)) last)
    c))

;;; Bring R up to date; returns at once. A new pane joins the generation already
;;; compiled from the file on disk. Anything else asks for a compile, whose result
;;; arrives through service-poll! and take-update!.
(defn reload! [(r (ptr Runtime))] (-> void)
  (let [src (.source r)]
    (cond (.closing r) (do)
          (not (valid-name? (slice (.name r))))
            (say! r "Widget names may use only a-z, 0-9, - and _.")
          (and (not (live? r))
               (not (.compiling src))
               (!= (p/cast i64 (.current src)) 0)
               (= (source-stamp src) (.stamp src)))
            (do
              (set! (.update r) (if (boot! r (.current src)) 1 -1))
              (do))
          :else (compile! src))))

(defn copy-entries! [(from (ptr api/Snapshot)) (to (ptr api/Snapshot))]
  (-> void)
  (for [k 0 (len (.entries from))]
    (let [e (get (.entries from) k)]
      (api/put-entry! to
                      (api/snapshot-slice from (.key-at e) (.key-len e))
                      (.value e)
                      (api/snapshot-slice from (.text-at e) (.text-len e))))))

;;; Main thread: boot generation C from the live widget's state (or the state
;;; restored from disk), then retire the old generation. A widget that stopped stays
;;; stopped for C when C is the code it stopped in.
(defn boot! [(r (ptr Runtime)) (c (ptr Generation))] (-> bool)
  (if (and (.crashed r) (= (.stamp c) (.crash-stamp r)))
      false
      (boot-anew! r c)))

(defn boot-anew! [(r (ptr Runtime)) (c (ptr Generation))] (-> bool)
  (let [a (alloc/malloc-allocator)
        saved (alloc/box! a api/Snapshot (api/snapshot-new a))
        out (alloc/box! a (dyn api/Widget) (zeroed (dyn api/Widget)))
        fresh (services/services-new (slice (.name r)))
        (mut saving) (call-of CALL-SAVE (.widget r))
        saved-sig
          (cond (live? r)
                  (do (set! (.snapshot saving) saved) (guarded r (mut saving)))
                (!= (p/cast i64 (.restored r)) 0)
                  (do (copy-entries! (.restored r) saved) 0)
                (!= (p/cast i64 (.last-saved r)) 0)
                  (do (copy-entries! (.last-saved r) saved) 0)
                :else 0)]
    (when (!= saved-sig 0) (crashed! r saved-sig "saving its state") 0)
    (set! (.host saved) (services/host fresh))
    ; Later entries win, so Jim's context overrides anything saved under it.
    (api/put-text! saved "jim.dir" (slice (.directory r)))
    (api/put-text! saved "jim.args" (slice (.args r)))
    (set! (.users c) (+ (.users c) 1))
    ; A live widget whose state cannot be saved keeps running; the candidate
    ; never boots. Nor does it boot from a save that crashed partway.
    (let [boot-sig
            (if (and (= saved-sig 0) (= (len (api/problem saved)) 0))
                (let [(mut booting)
                        (call-of CALL-BOOT (zeroed (dyn api/Widget)))]
                  (set! (.shim booting) (.shim c))
                  (set! (.snapshot booting) saved)
                  (set! (.out booting) (p/cast i64 out))
                  (guarded r (mut booting)))
                0)
          stored
            (and (= boot-sig 0)
                 (!= (p/cast i64 (load (p/cast (ptr (ptr i8)) out))) 0))
          refused (> (len (api/problem saved)) 0)
          ok (and stored (not refused))]
      (when (and stored refused)
        ; Boot refused and stored a widget anyway; free it with its own code.
        (let [(mut freeing) (call-of CALL-DESTROY (load out))]
          (guarded r (mut freeing)))
        0)
      (if ok
          (do
            (let [had (live? r)
                  old-widget (.widget r)
                  old-code (.code r)
                  old-services (.services r)]
              ; Switch to the new generation before retiring the old one.
              (set! (.widget r) (load out))
              (set! (.code r) c)
              (set! (.services r) fresh)
              (set! (.crashed r) false)
              (when had (retire! r old-widget true old-code old-services) 0))
            (clear! (mut (.diagnostic r)))
            (when (!= (p/cast i64 (.restored r)) 0)
              (api/snapshot-free! (.restored r))
              (alloc/destroy [api/Snapshot] a (.restored r))
              (set! (.restored r) (p/cast (ptr api/Snapshot) 0))
              0)
            0)
          (do
            (cond (!= boot-sig 0)
                    (do
                      (say-crash! r boot-sig "starting")
                      ; With nothing else running, the pane is stopped until
                      ; restarted or edited; a live old version keeps running.
                      (when (not (live? r))
                        (set! (.crashed r) true)
                        (set! (.crash-stamp r) (.stamp c))
                        0)
                      0)
                  (!= saved-sig 0) 0
                  :else
                    (do
                      (say! r
                            (if refused
                                (api/problem saved)
                                "boot did not store a widget"))
                      0))
            ; Boot may have started tasks; the code is released once they end.
            (retire! r (zeroed (dyn api/Widget)) false c fresh)
            0))
      (alloc/destroy [(dyn api/Widget)] a out)
      (api/snapshot-free! saved)
      (alloc/destroy [api/Snapshot] a saved)
      ok)))

(defn final-free! [(r (ptr Runtime))] (-> void)
  (let [a (alloc/malloc-allocator)
        src (.source r)]
    (api/ui-free! (field r ui))
    (api/requests-free! (field r requests))
    (when (!= (p/cast i64 (.restored r)) 0)
      (api/snapshot-free! (.restored r))
      (alloc/destroy [api/Snapshot] a (.restored r))
      0)
    (when (!= (p/cast i64 (.last-saved r)) 0)
      (api/snapshot-free! (.last-saved r))
      (alloc/destroy [api/Snapshot] a (.last-saved r))
      0)
    (ArrayList::free! (mut (.directory r)))
    (ArrayList::free! (mut (.args r)))
    (ArrayList::free! (mut (.diagnostic r)))
    (ArrayList::free! (mut (.name r)))
    (ArrayList::free! (mut (.retiring r)))
    (alloc/destroy [Runtime] a r)
    (set! (.holders src) (- (.holders src) 1))
    (source-settle! src)
    (do)))

;;; A compile finished: every pane moves to the new generation, or, if it failed,
;;; keeps what it runs and hears why.
(defn compile-finished! [(d (ptr Done))] (-> void)
  (let [c (.code d)
        src (.source c)]
    (set! (.compiling src) false)
    (cond (not (.ok d))
            (do (say-all! src (slice (.message d))) (code-idle! c) (do))
          (.detached src)
            (do (submit! JOB-RESET c (p/cast (ptr Runtime) 0) "") (do))
          :else
            (let [old (.current src)]
              (set! (.shim c) (.shim d))
              (set! (.users c) 1)
              (set! (.current src) c)
              (for [i 0 (len (.runtimes src))]
                (let [r (get (.runtimes src) i)]
                  (set! (.update r) (if (boot! r c) 1 -1))
                  (do)))
              (when (!= (p/cast i64 old) 0) (code-release! old) 0)
              (do)))
    (when (and (.again src) (not (.detached src)))
      (set! (.again src) false)
      (compile! src)
      0)
    (do)))

(defn finish! [(d (ptr Done))] (-> void)
  (let [c (.code d)
        src (if (= (p/cast i64 c) 0) (p/cast (ptr Source) 0) (.source c))]
    (when (!= (p/cast i64 src) 0)
      (set! (.pending src) (- (.pending src) 1))
      0)
    (cond (= (.kind d) JOB-RELEASE) (final-free! (.runtime d))
          (= (.kind d) JOB-RESET) (code-idle! c)
          (= (.kind d) JOB-FREE-CODE)
            (do (alloc/destroy [Generation] (alloc/malloc-allocator) c) (do))
          :else (compile-finished! d))
    (ArrayList::free! (mut (.message d)))
    (when (!= (p/cast i64 src) 0) (source-settle! src) 0)
    (do)))

;;; Main thread: apply every finished job. Cheap when nothing finished.
(defn service-poll! [] (-> void)
  (let [s (service-cell)]
    (when (.started s)
      (lock! s)
      (let [(mut finished) (ArrayList::new [Done] (alloc/malloc-allocator))]
        (for [i 0 (len (.done s))] (push! (mut finished) (get (.done s) i)))
        (clear! (mut (.done s)))
        (set! (.outstanding s) (- (.outstanding s) (len finished)))
        (unlock! s)
        (for [i 0 (len finished)] (finish! (elem (mut finished) i)))
        (ArrayList::free! (mut finished)))
      0)
    ; Retire generations whose tasks have finished.
    (let [all (retiring-runtimes)
          (mut k) 0]
      (for [i 0 (len (load all))]
        (let [r (get (load all) i)]
          (drain-retiring! r)
          (when (> (len (.retiring r)) 0)
            (set! (elem all (load k)) r)
            (set! k (+ (load k) 1))
            0)))
      (set! (.len all) (load k)))
    (do)))

;;; What happened since the last call: 1 a new generation went live, -1 an edit
;;; was rejected, 0 nothing.
(defn take-update! [(r (ptr Runtime))] (-> i64)
  (let [u (.update r)]
    (set! (.update r) 0)
    u))

;;; Wait, polling, until R has no compile in flight. For tests and tools; Jim
;;; itself never blocks on the compiler.
(defn settle! [(r (ptr Runtime))] (-> bool)
  (while (.compiling (.source r))
    (usleep (: 2000 u32))
    (service-poll!))
  (live? r))

;;; ---- guarded calls into widget code ------------------------------------------

;;; How long one call into a widget on the main thread may run before it is stopped.
(const HANG-LIMIT-MS 2000)

;;; Guard every widget call made from now on. MARKER is where a crash that can't be
;;; recovered names its widget; Jim reads it on the next launch (held-crashed!).
(defn protect! [(marker (slice u8))] (-> bool)
  (guard/install! marker HANG-LIMIT-MS))

;;; For tests, which make widgets hang on purpose.
(defn set-hang-limit! [(milliseconds i64)] (-> void)
  (guard/set-hang-limit! milliseconds))

(const CALL-RENDER 1)

(const CALL-EVENT 2)

(const CALL-SAVE 3)

(const CALL-ANIMATING 4)

(const CALL-DESTROY 5)

(const CALL-BOOT 6)

;;; One call into a widget's code, what it needs, and what it answered.
(defstruct Call
  [(kind i64)
   (widget (dyn api/Widget))
   (ui (ptr api/Ui))
   (event (ptr api/Event))
   (snapshot (ptr api/Snapshot))
   (shim (ptr i8))
   (out i64)
   (answer bool)])

(defn call-of [(kind i64) (widget (dyn api/Widget))] (-> Call)
  (Call
    :kind kind
    :widget widget
    :ui (p/cast (ptr api/Ui) 0)
    :event (p/cast (ptr api/Event) 0)
    :snapshot (p/cast (ptr api/Snapshot) 0)
    :shim (p/cast (ptr i8) 0)
    :out 0
    :answer false))

(defn run-call [(arg (ptr i8))] (-> void)
  (let [c (p/cast (ptr Call) arg)
        k (.kind c)]
    (cond (= k CALL-RENDER) (do (api/render (.widget c) (.ui c)) 0)
          (= k CALL-EVENT) (do (api/event (.widget c) (.event c)) 0)
          (= k CALL-SAVE) (do (api/save (.widget c) (.snapshot c)) 0)
          (= k CALL-ANIMATING)
            (do (set! (.answer c) (api/animating? (.widget c))) 0)
          (= k CALL-DESTROY) (do (api/destroy! (.widget c)) 0)
          (= k CALL-BOOT)
            (do
              (call-ptr (p/cast (fnptr (cc/C) [i64 i64] void) (.shim c))
                        (p/cast i64 (.snapshot c))
                        (.out c))
              0)
          :else 0)
    (do)))

(export-c [run-call :as "jim_widget_run_call"])

;;; Make CALL into R's widget code: 0 when it returned, otherwise the signal that
;;; stopped it.
(defn guarded [(r (ptr Runtime)) (call (ptr Call))] (-> i64)
  (protect! "")
  (guard/call! (p/cast (ptr i8) (fnptr-of run-call))
               (p/cast (ptr i8) call)
               (slice (.name r))))

;;; Say why R's widget stopped while DOING.
(defn say-crash! [(r (ptr Runtime)) (sig i64) (doing (slice u8))] (-> void)
  (set-str! (field r diagnostic) "This widget stopped while ")
  (push-str! (field r diagnostic) doing)
  (push-str! (field r diagnostic) ": ")
  (push-str! (field r diagnostic) (guard/describe sig))
  (push-str! (field r diagnostic) ".")
  ; coil.panic keeps a panic's message and place to itself; its report is in Jim's log.
  (when (= sig 6)
    (push-str! (field r diagnostic)
               " A panic's message and place are in Jim's log.")
    0)
  (push-str! (field r diagnostic)
             " Jim stopped running it. Restart runs it again from its last saved state; saving its file runs the new code.")
  (do))

;;; R's live widget stopped while DOING: never call into it again, not even to
;;; free it, since its memory may be broken. Its tasks still finish before its
;;; code goes.
(defn crashed! [(r (ptr Runtime)) (sig i64) (doing (slice u8))] (-> void)
  (say-crash! r sig doing)
  (set! (.crashed r) true)
  (when (live? r)
    (let [c (.code r)]
      (set! (.crash-stamp r) (.stamp c))
      (set! (.code r) (p/cast (ptr Generation) 0))
      (retire! r (.widget r) false c (.services r)))
    0)
  (do))

;;; A task the live widget started crashed on a worker thread.
(defn check-tasks! [(r (ptr Runtime))] (-> void)
  (when (live? r)
    (let [sig (services/crashed (.services r))]
      (when (!= sig 0) (crashed! r sig "running a background task") 0))
    0)
  (do))

;;; Whether R is stopped: a crash, here or on an earlier run.
(defn crashed? [(r (ptr Runtime))] (-> bool)
  (.crashed r))

(defn replace-last-saved! [(r (ptr Runtime)) (from (ptr api/Snapshot))]
  (-> void)
  (let [a (alloc/malloc-allocator)]
    (when (= (p/cast i64 (.last-saved r)) 0)
      (set! (.last-saved r) (alloc/box! a api/Snapshot (api/snapshot-new a)))
      0)
    (clear! (mut (.bytes (.last-saved r))))
    (clear! (mut (.entries (.last-saved r))))
    (copy-entries! from (.last-saved r))
    (do)))

;;; Run R's widget again after a crash, from the state its last good save made.
(defn restart! [(r (ptr Runtime))] (-> void)
  (when (and (.crashed r) (not (live? r)) (not (.closing r)))
    (set! (.crashed r) false)
    (clear! (mut (.diagnostic r)))
    (when (and (= (p/cast i64 (.restored r)) 0)
               (!= (p/cast i64 (.last-saved r)) 0))
      (let [a (alloc/malloc-allocator)
            copy (alloc/box! a api/Snapshot (api/snapshot-new a))]
        (copy-entries! (.last-saved r) copy)
        (set! (.restored r) copy))
      0)
    (reload! r)
    0)
  (do))

;;; Names of widgets a crash that couldn't be recovered stopped in the last run.
(defn held-names [] (-> (ptr (ArrayList u8)))
  (let [cell (p/alloc-static (ArrayList u8))]
    (when (= (p/cast i64 (.data cell)) 0)
      (set! cell (ArrayList::new [u8] (alloc/malloc-allocator)))
      0)
    cell))

;;; NAMES, one per line, crashed Jim last time (the guard's marker): panes of them
;;; restored from the last run stay stopped until restarted.
(defn held-crashed! [(names (slice u8))] (-> void)
  (set-str! (held-names) names)
  (do))

(defn held? [(name (slice u8))] (-> bool)
  (let [all (slice (load (held-names)))
        (mut start) 0
        (mut found) false]
    (for [i 0 (+ (len all) 1)]
      (when (or (= i (len all)) (= (get all i) (: 10 u8)))
        (when (= (subslice all (load start) i) name) (set! found true) 0)
        (set! start (+ i 1))
        0))
    (load found)))

;;; ---- rendering and events --------------------------------------------------
(defn fault-text [(code i64)] (-> (slice u8))
  (cond (= code api/FAULT-END-WITHOUT-CONTAINER)
          "end! without an open vstack!/hstack!"
        (= code api/FAULT-APPEND-WITHOUT-TEXT) "append! must follow text!"
        (= code api/FAULT-UNCLOSED-CONTAINER)
          "render returned with an unclosed vstack!/hstack!"
        (= code api/FAULT-SECOND-ROOT)
          "render produced more than one root element"
        (= code api/FAULT-STYLE-WITHOUT-ELEMENT)
          "a style setter ran before any element existed"
        (= code api/FAULT-CHILD-OF-LEAF)
          "an element was added outside every container; open vstack! first"
        (= code api/FAULT-BAD-KEY) "key! takes one lowercase letter or digit"
        :else "unknown widget API fault"))

;;; Render the live widget into the runtime's Ui. False when there is nothing
;;; to show or the widget misused the API (the diagnostic says how).
(defn render! [(r (ptr Runtime)) (width f64) (height f64) (scroll-y f64)]
  (-> bool)
  (api/ui-clear! (field r ui) width height scroll-y)
  (check-tasks! r)
  (if (not (live? r))
      false
      (let [(mut call) (call-of CALL-RENDER (.widget r))
            _ (do (set! (.ui call) (field r ui)) 0)
            sig (guarded r (mut call))]
        (if (!= sig 0)
            (do
              ; Half a frame is no frame.
              (api/ui-clear! (field r ui) width height scroll-y)
              (crashed! r sig "drawing")
              false)
            (do
              (when (> (len (.open (.ui r))) 0)
                (api/fault! (field r ui) api/FAULT-UNCLOSED-CONTAINER)
                0)
              (if (= (.fault (.ui r)) 0)
                  true
                  (do (say! r (fault-text (.fault (.ui r)))) false)))))))

(defn deliver! [(r (ptr Runtime))
                (kind i64)
                (id (slice u8))
                (text (slice u8))
                (checked bool)
                (dt f64)] (-> void)
  (check-tasks! r)
  (when (live? r)
    (let [(mut e)
            (api/Event
              :kind kind
              :id id
              :text text
              :checked checked
              :dt dt
              :requests (field r requests))
          (mut call) (call-of CALL-EVENT (.widget r))]
      (set! (.event call) (p/cast (ptr api/Event) (mut e)))
      (let [sig (guarded r (mut call))]
        (when (!= sig 0)
          (crashed! r
                    sig
                    (if (= kind api/TICK) "animating" "handling an event"))
          0)))
    0)
  (do))

;;; Whether node INDEX of the last render reacts to clicks.
(defn active? [(r (ptr Runtime)) (index i64)] (-> bool)
  (let [n (api/node (field r ui) index)
        kind (.kind n)]
    (or (= kind api/BUTTON)
        (= kind api/TOGGLE)
        (and (api/container? kind) (> (.id-len n) 0)))))

;;; Activate node INDEX of the last render: a button or clickable container
;;; click, or a toggle flip. The id is copied first: the Ui is rebuilt by the
;;; next render.
(defn activate! [(r (ptr Runtime)) (index i64)] (-> bool)
  (if (not (active? r index))
      false
      (let [ui (field r ui)
            n (api/node ui index)
            (mut id) (ArrayList::new [u8] (alloc/malloc-allocator))]
        (push-str! (mut id) (api/node-id ui n))
        (if (= (.kind n) api/TOGGLE)
            (deliver! r
                      api/TOGGLE-EVENT
                      (slice id)
                      ""
                      (not (.checked n))
                      0.0)
            (deliver! r api/CLICK (slice id) "" false 0.0))
        (ArrayList::free! (mut id))
        true)))

;;; Deliver a CLICK with ID, for a shortcut! of the last render.
(defn click! [(r (ptr Runtime)) (id (slice u8))] (-> void)
  (let [(mut owned) (ArrayList::new [u8] (alloc/malloc-allocator))]
    ; Copied: the Ui holding ID is rebuilt by the next render.
    (push-str! (mut owned) id)
    (deliver! r api/CLICK (slice owned) "" false 0.0)
    (ArrayList::free! (mut owned))
    (do)))

;;; Deliver an edit (SUBMIT false) or Return (SUBMIT true) in text field ID.
(defn input! [(r (ptr Runtime)) (id (slice u8)) (text (slice u8)) (submit bool)]
  (-> void)
  (deliver! r (if submit api/INPUT-SUBMIT api/INPUT-CHANGE) id text false 0.0))

(defn message! [(r (ptr Runtime)) (topic (slice u8)) (payload (slice u8))]
  (-> void)
  (deliver! r api/MESSAGE topic payload false 0.0))

(defn files-changed! [(r (ptr Runtime)) (watched (slice u8)) (paths (slice u8))]
  (-> void)
  (deliver! r api/FILES-CHANGED watched paths false 0.0))

;;; A sheet was answered: ID is "open" or "save", PATH the file.
(defn file-chosen! [(r (ptr Runtime)) (id (slice u8)) (path (slice u8))]
  (-> void)
  (deliver! r api/FILE-CHOSEN id path false 0.0))

(defn animating? [(r (ptr Runtime))] (-> bool)
  (if (not (live? r))
      false
      (let [(mut call) (call-of CALL-ANIMATING (.widget r))
            sig (guarded r (mut call))]
        (if (= sig 0)
            (.answer call)
            (do (crashed! r sig "checking whether it animates") false)))))

(defn tick! [(r (ptr Runtime)) (dt f64)] (-> void)
  (deliver! r api/TICK "" "" false dt))

;;; The widget's state, for saving with Jim's layout: the live widget's, or,
;;; before any generation has booted (say its source does not compile), the
;;; state restored from the last run, so quitting then does not lose it. A
;;; stopped widget keeps the state of its last good save, and says it stopped.
(defn save-state! [(r (ptr Runtime)) (out (ptr api/Snapshot))] (-> bool)
  (check-tasks! r)
  (let [sig
          (if (live? r)
              (let [(mut call) (call-of CALL-SAVE (.widget r))]
                (set! (.snapshot call) out)
                (guarded r (mut call)))
              0)]
    (cond (and (live? r) (= sig 0))
            (if (= (len (api/problem out)) 0)
                (do (replace-last-saved! r out) true)
                (do (say! r (api/problem out)) false))
          (!= sig 0)
            (do
              (crashed! r sig "saving its state")
              (clear! (mut (.bytes out)))
              (clear! (mut (.entries out)))
              (clear! (mut (.problem out)))
              (save-stopped! r out))
          (.crashed r) (save-stopped! r out)
          (!= (p/cast i64 (.restored r)) 0)
            (do (copy-entries! (.restored r) out) true)
          :else false)))

(defn save-stopped! [(r (ptr Runtime)) (out (ptr api/Snapshot))] (-> bool)
  (when (!= (p/cast i64 (.last-saved r)) 0)
    (copy-entries! (.last-saved r) out)
    0)
  (api/put-text! out "jim.crashed" (slice (.diagnostic r)))
  (api/put-i64! out "jim.crash-stamp" (.crash-stamp r))
  true)

;;; The last render, for tools and tests.
(defn ui-of [(r (ptr Runtime))] (-> (ptr api/Ui))
  (field r ui))

;;; Requests the widget made during the events delivered since the last clear.
(defn requests [(r (ptr Runtime))] (-> (ptr api/Requests))
  (field r requests))

(defn diagnostic [(r (ptr Runtime))] (-> (slice u8))
  (slice (.diagnostic r)))

;;; Destroy the live widget now; the runtime's memory goes once its retiring
;;; generations have finished (via service-poll!), and its source's code once no
;;; pane uses it.
(defn free! [(r (ptr Runtime))] (-> void)
  (set! (.closing r) true)
  (source-leave! (.source r) r)
  (if (live? r)
      (let [c (.code r)]
        (set! (.code r) (p/cast (ptr Generation) 0))
        (retire! r (.widget r) true c (.services r)))
      (drain-retiring! r)))
