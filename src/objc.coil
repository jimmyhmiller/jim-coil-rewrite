(module jim.objc)
(import "coil.cc" :as cc)
(import "coil.primitive" :as primitive)

(export class sel msg objc_getClass sel_registerName objc_msgSend)

(extern objc_getClass :cc (cc/C) [(ptr i8)] (-> (ptr i8)))

(extern sel_registerName :cc (cc/C) [(ptr i8)] (-> (ptr i8)))

(extern objc_msgSend :cc (cc/C) [(ptr i8) (ptr i8)] (-> (ptr i8)))

(defn class [(name (ptr i8))] (-> (ptr i8))
  (objc_getClass name))

(defn sel [(name (ptr i8))] (-> (ptr i8))
  (sel_registerName name))

;;; Send an Objective-C message with an exact C ABI signature. This is the only
;;; bridge used by the framework: AppKit, QuartzCore, and Metal are called
;;; directly from Coil, with no wrapper C or Objective-C source.
(defn msg [(ret Code) (recv Code) (selector Code) (argtypes Code) & (args Code)]
  (-> Code)
  `(primitive/call-ptr (primitive/cast (fnptr (cc/C)
                                              [(ptr i8) (ptr i8) ~@argtypes]
                                              ~ret)
                                       (primitive/fnptr-of objc_msgSend))
                       ~recv
                       ~selector
                       ~@args))
