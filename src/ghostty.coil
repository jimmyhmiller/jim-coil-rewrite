(module jim.ghostty)
(import "coil.cc" :as cc)
(import "coil.primitive" :as p)

;;; Audited subset of vendor/ghostty.h. Compile-time assertions below check this boundary.
(defstruct SurfaceConfig
  [(platform-tag i32)
   (view (ptr i8))
   (userdata (ptr i8))
   (scale f64)
   (font-size f32)
   (cwd (ptr i8))
   (command (ptr i8))
   (env (ptr i8))
   (env-count u64)
   (input (ptr i8))
   (wait bool)
   (context i32)])

(defstruct Key
  [(action i32)
   (mods i32)
   (consumed i32)
   (keycode u32)
   (text (ptr i8))
   (unshifted u32)
   (composing bool)])

(defstruct Target [(tag i32) (surface (ptr i8))])

(defstruct Action [(tag i32) (data (array u64 3))])

(defstruct Runtime
  [(userdata (ptr i8))
   (selection bool)
   (wakeup (ptr i8))
   (action (ptr i8))
   (read (ptr i8))
   (confirm (ptr i8))
   (write (ptr i8))
   (close (ptr i8))])

(static-assert (= (p/sizeof SurfaceConfig) 88)
               "Ghostty surface config ABI size")

(static-assert (= (p/alignof SurfaceConfig) 8)
               "Ghostty surface config ABI alignment")

(static-assert (= (p/offsetof SurfaceConfig platform-tag) 0)
               "Ghostty platform tag offset")

(static-assert (= (p/offsetof SurfaceConfig view) 8)
               "Ghostty platform payload offset")

(static-assert (= (p/offsetof SurfaceConfig userdata) 16)
               "Ghostty userdata offset")

(static-assert (= (p/offsetof SurfaceConfig scale) 24) "Ghostty scale offset")

(static-assert (= (p/offsetof SurfaceConfig cwd) 40) "Ghostty cwd offset")

(static-assert (= (p/offsetof SurfaceConfig context) 84)
               "Ghostty context offset")

(static-assert (= (p/sizeof Key) 32) "Ghostty key ABI size")

(static-assert (= (p/offsetof Key text) 16) "Ghostty key text offset")

(static-assert (= (p/offsetof Key composing) 28) "Ghostty key composing offset")

(static-assert (= (p/sizeof Runtime) 64) "Ghostty runtime ABI size")

(static-assert (= (p/offsetof Runtime wakeup) 16)
               "Ghostty wakeup callback offset")

(static-assert (= (p/sizeof Target) 16) "Ghostty target ABI size")

(static-assert (= (p/sizeof Action) 32) "Ghostty action ABI size")

(static-assert (= (p/alignof Action) 8) "Ghostty action ABI alignment")

(defstruct ClipboardContent [(mime (ptr i8)) (data (ptr i8))])

(extern ghostty_init :cc (cc/C) [u64 (ptr (ptr i8))] (-> i32))

(extern ghostty_config_new :cc (cc/C) [] (-> (ptr i8)))

(extern ghostty_config_free :cc (cc/C) [(ptr i8)] (-> void))

(extern ghostty_config_load_file :cc (cc/C) [(ptr i8) (ptr i8)] (-> void))

(extern ghostty_config_finalize :cc (cc/C) [(ptr i8)] (-> void))

(extern ghostty_app_new :cc (cc/C) [(ptr Runtime) (ptr i8)] (-> (ptr i8)))

(extern ghostty_app_free :cc (cc/C) [(ptr i8)] (-> void))

(extern ghostty_app_tick :cc (cc/C) [(ptr i8)] (-> void))

(extern ghostty_app_set_focus :cc (cc/C) [(ptr i8) bool] (-> void))

(extern ghostty_surface_config_new :cc (cc/C) [] (-> SurfaceConfig))

(extern ghostty_surface_new
        :cc
        (cc/C)
        [(ptr i8) (ptr SurfaceConfig)]
        (-> (ptr i8)))

(extern ghostty_surface_free :cc (cc/C) [(ptr i8)] (-> void))

(extern ghostty_surface_set_size :cc (cc/C) [(ptr i8) u32 u32] (-> void))

(extern ghostty_surface_set_content_scale
        :cc
        (cc/C)
        [(ptr i8) f64 f64]
        (-> void))

(extern ghostty_surface_set_focus :cc (cc/C) [(ptr i8) bool] (-> void))

(extern ghostty_surface_set_occlusion :cc (cc/C) [(ptr i8) bool] (-> void))

(extern ghostty_surface_key :cc (cc/C) [(ptr i8) Key] (-> bool))

(extern ghostty_surface_text :cc (cc/C) [(ptr i8) (ptr i8) u64] (-> void))

(extern ghostty_surface_preedit :cc (cc/C) [(ptr i8) (ptr i8) u64] (-> void))

(extern ghostty_surface_mouse_pos :cc (cc/C) [(ptr i8) f64 f64 i32] (-> void))

(extern ghostty_surface_mouse_button
        :cc
        (cc/C)
        [(ptr i8) i32 i32 i32]
        (-> bool))

(extern ghostty_surface_mouse_scroll
        :cc
        (cc/C)
        [(ptr i8) f64 f64 i32]
        (-> void))

(extern ghostty_surface_ime_point
        :cc
        (cc/C)
        [(ptr i8) (ptr f64) (ptr f64) (ptr f64) (ptr f64)]
        (-> void))

(extern ghostty_surface_binding_action
        :cc
        (cc/C)
        [(ptr i8) (ptr i8) u64]
        (-> bool))

(extern ghostty_surface_complete_clipboard_request
        :cc
        (cc/C)
        [(ptr i8) (ptr i8) (ptr i8) bool]
        (-> void))

(extern ghostty_surface_process_exited :cc (cc/C) [(ptr i8)] (-> bool))

(extern ghostty_surface_userdata :cc (cc/C) [(ptr i8)] (-> (ptr i8)))

(extern ghostty_surface_new_session
        :cc
        (cc/C)
        [(ptr i8) (ptr SurfaceConfig) i32]
        (-> (ptr i8)))

(defstruct TextPoint [(tag i32) (coord i32) (x u32) (y u32)])

(defstruct TextSelection [(top TextPoint) (bottom TextPoint) (rectangle bool)])

(defstruct Text
  [(x f64) (y f64) (offset u32) (length u32) (text (ptr i8)) (size u64)])

(extern ghostty_surface_read_text
        :cc
        (cc/C)
        [(ptr i8) TextSelection (ptr Text)]
        (-> bool))

(extern ghostty_surface_free_text :cc (cc/C) [(ptr i8) (ptr Text)] (-> void))
