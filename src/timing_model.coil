(module jim.timing-model)
(import "coil.primitive" :as p)

(defstruct Sample
  [(interval f64)
   (budget f64)
   (input f64)
   (maintenance f64)
   (windows f64)
   (ghostty f64)
   (overlay f64)])

(defstruct History [(samples (array Sample 120)) (count i64) (next i64)])

(defstruct Summary
  [(hz f64)
   (mean f64)
   (p95 f64)
   (maximum f64)
   (late i64)
   (input f64)
   (maintenance f64)
   (windows f64)
   (ghostty f64)
   (overlay f64)])

(defn push! [(h (ptr History)) (s Sample)] (-> void)
  (do
    (set! (index (field h samples) (.next h)) s)
    (set! (.next h) (% (+ (.next h) 1) 120))
    (if (< (.count h) 120) (set! (.count h) (+ (.count h) 1)) 0)
    (do)))

(defn summarize [(h (ptr History))] (-> Summary)
  (let [sorted (p/alloc-stack (array f64 120))
        (mut sum) 0.0
        (mut late) 0
        (mut input) 0.0
        (mut maintenance) 0.0
        (mut windows) 0.0
        (mut ghostty) 0.0
        (mut overlay) 0.0]
    (do
      (for [i 0 (.count h)]
        (let [s (load (index (field h samples) i))
              (mut at) i]
          (do
            (set! sum (+ (load sum) (.interval s)))
            (if (> (.interval s) (* 1.5 (.budget s)))
                (set! late (+ (load late) 1))
                0)
            (set! input (+ (load input) (.input s)))
            (set! maintenance (+ (load maintenance) (.maintenance s)))
            (set! windows (+ (load windows) (.windows s)))
            (set! ghostty (+ (load ghostty) (.ghostty s)))
            (set! overlay (+ (load overlay) (.overlay s)))
            (while (and (> (load at) 0)
                        (> (load (index sorted (- (load at) 1)))
                           (.interval s)))
              (do
                (set! (index sorted (load at))
                      (load (index sorted (- (load at) 1))))
                (set! at (- (load at) 1))))
            (set! (index sorted (load at)) (.interval s)))))
      (let [n (p/cast f64 (if (> (.count h) 0) (.count h) 1))]
        (Summary
          :hz (if (> (load sum) 0.0) (/ (* n 1000.0) (load sum)) 0.0)
          :mean (/ (load sum) n)
          :p95
            (if (> (.count h) 0)
                (load (index sorted (- (/ (+ (* (.count h) 95) 99) 100) 1)))
                0.0)
          :maximum
            (if (> (.count h) 0) (load (index sorted (- (.count h) 1))) 0.0)
          :late (load late)
          :input (/ (load input) n)
          :maintenance (/ (load maintenance) n)
          :windows (/ (load windows) n)
          :ghostty (/ (load ghostty) n)
          :overlay (/ (load overlay) n))))))
