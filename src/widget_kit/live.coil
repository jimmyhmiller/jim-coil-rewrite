(module jim.widget-kit.live)
(import "coil.primitive" :as p)
(import "coil.alloc" :as alloc)
(import "coil.arraylist" :use *)
(import "coil.slice" :use *)
(import "coil.os" :as os)
(import "coil.time" :as time)
(import "jim.widget-kit.text" :as text)

;;; Keeping a widget current with the world outside it. A widget watches paths
;;; (api/watch!) and listens for other widgets' messages; each notice marks a
;;; Refresher. `due?` then says when to actually refresh: never while a refresh
;;; is still running, and at most every MIN-GAP milliseconds, so a build that
;;; touches hundreds of files costs one refresh, not hundreds.
(const MIN-GAP 500)

(defstruct Refresher [(pending bool) (last i64)])

(defn refresher [] (-> Refresher)
  (Refresher :pending false :last 0))

(defn now-ms [] (-> i64)
  (try (let [v (try-or! (time/monotonic-now-ms) 0)] v)))

;;; Something changed; refresh when allowed.
(defn note! [(r (ptr Refresher))] (-> void)
  (set! (.pending r) true)
  (do))

;;; True when a noted change should be refreshed now, given whether a refresh
;;; is still RUNNING. Clears the note.
(defn due? [(r (ptr Refresher)) (running bool)] (-> bool)
  (let [now (now-ms)]
    (if (and (.pending r) (not running) (>= (- now (.last r)) MIN-GAP))
        (do (set! (.pending r) false) (set! (.last r) now) true)
        false)))

;;; A refresh started for another reason (a button, a boot); pending notes are
;;; covered by it.
(defn started! [(r (ptr Refresher))] (-> void)
  (set! (.pending r) false)
  (set! (.last r) (now-ms))
  (do))

(defn waiting? [(r (ptr Refresher))] (-> bool)
  (.pending r))

;;; $HOME/REST into OUT.
(defn home-path! [(rest (slice u8)) (out (ptr (ArrayList u8)))] (-> void)
  (let [home (os/getenv c"HOME")]
    (when (!= (p/cast i64 home) 0)
      (let [c (p/cast (ptr u8) home)
            (mut n) 0]
        (while (!= (load (index c (load n))) (: 0 u8))
          (set! n (+ (load n) 1)))
        (text/push-str! out (slice::new c (load n))))
      0)
    (text/push-str! out rest)))

;;; True when any line of PATHS (one per line) starts with PREFIX.
(defn any-under? [(paths (slice u8)) (prefix (slice u8))] (-> bool)
  (let [(mut spans) (ArrayList::new [text/Span] (alloc/malloc-allocator))
        (mut found) false]
    (text/lines! paths (mut spans))
    (for [i 0 (len spans)]
      (when (text/starts-with? (text/span-text paths (get spans i)) prefix)
        (set! found true)
        0))
    (free! (mut spans))
    (load found)))
