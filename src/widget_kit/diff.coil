(module jim.widget-kit.diff)
(import "coil.primitive" :as p)
(import "coil.alloc" :as alloc)
(import "coil.arraylist" :use *)
(import "coil.slice" :use *)
(import "jim.widget-kit.text" :as text)
(import "jim.widget-kit.highlight" :as hl)

;;; A parsed diff: files, their hunks, and display lines with syntax runs. All
;;; text lives in one owned buffer; everything else is index ranges into it, so
;;; a whole diff is freed (or cleared for a refresh) at once.
(const HUNK 0)

(const CONTEXT 1)

(const ADD 2)

(const DEL 3)

(defstruct Line
  [(tag i64)
   (old i64)
   (new i64)
   (at i64)
   (len i64)
   (runs-at i64)
   (runs-len i64)])

(defstruct Hunk [(at i64) (len i64) (line i64)])

(defstruct File
  [(old-at i64)
   (old-len i64)
   (new-at i64)
   (new-len i64)
   (change-at i64)
   (change-len i64)
   (lines-at i64)
   (lines-len i64)
   (hunks-at i64)
   (hunks-len i64)
   (adds i64)
   (dels i64)
   (binary bool)])

(defstruct Model
  [(text (ArrayList u8))
   (lines (ArrayList Line))
   (hunks (ArrayList Hunk))
   (files (ArrayList File))
   (runs (ArrayList hl/Run))
   (old-no i64)
   (new-no i64)])

(defn model-new [] (-> Model)
  (let [a (alloc/malloc-allocator)]
    (Model
      :text (ArrayList::new [u8] a)
      :lines (ArrayList::new [Line] a)
      :hunks (ArrayList::new [Hunk] a)
      :files (ArrayList::new [File] a)
      :runs (ArrayList::new [hl/Run] a)
      :old-no 0
      :new-no 0)))

(defn clear! [(m (ptr Model))] (-> void)
  (ArrayList::clear! (mut (.text m)))
  (ArrayList::clear! (mut (.lines m)))
  (ArrayList::clear! (mut (.hunks m)))
  (ArrayList::clear! (mut (.files m)))
  (ArrayList::clear! (mut (.runs m)))
  (do))

(defn free! [(m (ptr Model))] (-> void)
  (ArrayList::free! (mut (.text m)))
  (ArrayList::free! (mut (.lines m)))
  (ArrayList::free! (mut (.hunks m)))
  (ArrayList::free! (mut (.files m)))
  (ArrayList::free! (mut (.runs m)))
  (do))

(defn keep! [(m (ptr Model)) (s (slice u8))] (-> i64)
  (let [at (len (.text m))]
    (text/push-str! (field m text) s)
    at))

(defn text-at [(m (ptr Model)) (at i64) (n i64)] (-> (slice u8))
  (subslice (slice (.text m)) at (+ at n)))

(defn file-count [(m (ptr Model))] (-> i64)
  (len (.files m)))

(defn file [(m (ptr Model)) (i i64)] (-> (ptr File))
  (elem (field m files) i))

(defn line [(m (ptr Model)) (i i64)] (-> (ptr Line))
  (elem (field m lines) i))

(defn hunk [(m (ptr Model)) (i i64)] (-> (ptr Hunk))
  (elem (field m hunks) i))

(defn line-text [(m (ptr Model)) (l (ptr Line))] (-> (slice u8))
  (text-at m (.at l) (.len l)))

(defn hunk-header [(m (ptr Model)) (h (ptr Hunk))] (-> (slice u8))
  (text-at m (.at h) (.len h)))

(defn run [(m (ptr Model)) (i i64)] (-> hl/Run)
  (get (.runs m) i))

(defn old-path [(m (ptr Model)) (f (ptr File))] (-> (slice u8))
  (text-at m (.old-at f) (.old-len f)))

(defn new-path [(m (ptr Model)) (f (ptr File))] (-> (slice u8))
  (text-at m (.new-at f) (.new-len f)))

(defn change [(m (ptr Model)) (f (ptr File))] (-> (slice u8))
  (text-at m (.change-at f) (.change-len f)))

;;; The path to show: the new side unless the file was deleted.
(defn path [(m (ptr Model)) (f (ptr File))] (-> (slice u8))
  (if (and (> (.new-len f) 0)
           (not (text/ends-with? (new-path m f) "/dev/null")))
      (new-path m f)
      (old-path m f)))

(defstruct Pair [(a i64) (b i64)])

;;; Added and deleted line counts over every file.
(defn totals [(m (ptr Model))] (-> Pair)
  (let [(mut adds) 0
        (mut dels) 0]
    (for [i 0 (file-count m)]
      (let [f (file m i)]
        (set! adds (+ (load adds) (.adds f)))
        (set! dels (+ (load dels) (.dels f)))))
    (Pair :a (load adds) :b (load dels))))

;;; ---- building ----------------------------------------------------------------
(defn begin-file! [(m (ptr Model))
                   (old (slice u8))
                   (new (slice u8))
                   (change (slice u8))
                   (binary bool)] (-> void)
  (let [old-at (keep! m old)
        new-at (keep! m new)
        change-at (keep! m change)]
    (push! (mut (.files m))
           (File
             :old-at old-at
             :old-len (len old)
             :new-at new-at
             :new-len (len new)
             :change-at change-at
             :change-len (len change)
             :lines-at (len (.lines m))
             :lines-len 0
             :hunks-at (len (.hunks m))
             :hunks-len 0
             :adds 0
             :dels 0
             :binary binary))
    (do)))

(defn current [(m (ptr Model))] (-> (ptr File))
  (file m (- (file-count m) 1)))

(defn add-hunk! [(m (ptr Model))
                 (header (slice u8))
                 (old-start i64)
                 (new-start i64)] (-> void)
  (let [f (current m)
        at (keep! m header)]
    (push! (mut (.hunks m))
           (Hunk
             :at at
             :len (len header)
             :line (len (.lines m))))
    (push! (mut (.lines m))
           (Line
             :tag HUNK
             :old 0
             :new 0
             :at at
             :len (len header)
             :runs-at 0
             :runs-len 0))
    (set! (.hunks-len f) (+ (.hunks-len f) 1))
    (set! (.lines-len f) (+ (.lines-len f) 1))
    (set! (.old-no m) old-start)
    (set! (.new-no m) new-start)
    (do)))

;;; A line of the current hunk. OLD and NEW are its line numbers (0 when the
;;; side has none).
(defn add-line! [(m (ptr Model))
                 (tag i64)
                 (old i64)
                 (new i64)
                 (body (slice u8))] (-> void)
  (let [f (current m)
        at (keep! m body)]
    (push! (mut (.lines m))
           (Line
             :tag tag
             :old old
             :new new
             :at at
             :len (len body)
             :runs-at 0
             :runs-len 0))
    (set! (.lines-len f) (+ (.lines-len f) 1))
    (cond (= tag ADD) (set! (.adds f) (+ (.adds f) 1))
          (= tag DEL) (set! (.dels f) (+ (.dels f) 1))
          :else 0)
    (do)))

;;; Record counts reported by the source (e.g. jimctl) instead of counting.
(defn set-counts! [(m (ptr Model)) (adds i64) (dels i64)] (-> void)
  (let [f (current m)]
    (set! (.adds f) adds)
    (set! (.dels f) dels)
    (do)))

;;; ---- unified diffs ---------------------------------------------------------
(defn strip-prefix [(p (slice u8))] (-> (slice u8))
  (let [t (text/trim p)
        ; Drop a trailing tab-separated timestamp (diff -u).
        tab (text/index-of t "\t")
        u (if (>= tab 0) (subslice t 0 tab) t)]
    (if (or (text/starts-with? u "a/") (text/starts-with? u "b/"))
        (text/from u 2)
        u)))

(defn first-number [(s (slice u8))] (-> i64)
  (let [(mut v) 0
        (mut i) 0]
    (while (and (< (load i) (len s)) (hl/digit? (p/cast i64 (get s (load i)))))
      (set! v (+ (* (load v) 10) (- (p/cast i64 (get s (load i))) 48)))
      (set! i (+ (load i) 1)))
    (load v)))

;;; "@@ -o,c +n,c @@ …" start lines, old then new.
(defn hunk-starts [(header (slice u8))] (-> Pair)
  (let [minus (text/index-of header "-")
        plus (text/index-of header "+")]
    (Pair
      :a (if (>= minus 0) (first-number (text/from header (+ minus 1))) 1)
      :b (if (>= plus 0) (first-number (text/from header (+ plus 1))) 1))))

;;; Parse RAW, the output of `git diff`, `gh pr diff`, `diff -u` …, into M.
(defn parse-unified! [(m (ptr Model)) (raw (slice u8))] (-> void)
  (let [(mut spans) (ArrayList::new [text/Span] (alloc/malloc-allocator))
        (mut have) false
        (mut in-hunk) false
        (mut i) 0]
    (text/lines! raw (mut spans))
    (while (< (load i) (len spans))
      (let [l (text/span-text raw (get spans (load i)))
            next
              (if (< (+ (load i) 1) (len spans))
                  (text/span-text raw (get spans (+ (load i) 1)))
                  "")]
        (cond (text/starts-with? l "diff --git")
                (do
                  ; Paths come from the ---/+++ lines; binary and pure-rename
                  ; diffs have none, so take them from the header meanwhile.
                  (let [rest (text/from l 11)
                        b (text/index-of rest " b/")]
                    (begin-file! m
                                 (strip-prefix (if (>= b 0)
                                                   (subslice rest 0 b)
                                                   rest))
                                 (strip-prefix (if (>= b 0)
                                                   (text/from rest (+ b 1))
                                                   rest))
                                 "modified"
                                 false))
                  (set! have true)
                  (set! in-hunk false)
                  (set! i (+ (load i) 1)))
              (and (text/starts-with? l "--- ") (text/starts-with? next "+++ "))
                (do
                  (if (and (load have) (= (.lines-len (current m)) 0))
                      ; Replace the header's guess with the real paths.
                      (let [f (current m)
                            old-at (keep! m (strip-prefix (text/from l 4)))
                            new-at (keep! m (strip-prefix (text/from next 4)))]
                        (set! (.old-at f) old-at)
                        (set! (.old-len f) (len (strip-prefix (text/from l 4))))
                        (set! (.new-at f) new-at)
                        (set! (.new-len f)
                              (len (strip-prefix (text/from next 4))))
                        0)
                      (do
                        (begin-file! m
                                     (strip-prefix (text/from l 4))
                                     (strip-prefix (text/from next 4))
                                     "modified"
                                     false)
                        (set! have true)
                        0))
                  (set! in-hunk false)
                  (set! i (+ (load i) 2)))
              (text/starts-with? l "@@")
                (do
                  (when (not (load have))
                    (begin-file! m "" "" "modified" false)
                    (set! have true)
                    0)
                  (let [starts (hunk-starts l)]
                    (add-hunk! m l (.a starts) (.b starts)))
                  (set! in-hunk true)
                  (set! i (+ (load i) 1)))
              (and (load in-hunk) (load have))
                (let [c0 (if (> (len l) 0) (p/cast i64 (get l 0)) 32)
                      body (text/from l 1)]
                  (cond (= c0 92) 0
                        (= c0 43)
                          (do
                            (add-line! m ADD 0 (.new-no m) body)
                            (set! (.new-no m) (+ (.new-no m) 1))
                            0)
                        (= c0 45)
                          (do
                            (add-line! m DEL (.old-no m) 0 body)
                            (set! (.old-no m) (+ (.old-no m) 1))
                            0)
                        :else
                          (do
                            (add-line! m CONTEXT (.old-no m) (.new-no m) body)
                            (set! (.old-no m) (+ (.old-no m) 1))
                            (set! (.new-no m) (+ (.new-no m) 1))
                            0))
                  (set! i (+ (load i) 1)))
              :else
                (do
                  (when (and (load have) (text/starts-with? l "Binary files"))
                    (set! (.binary (current m)) true)
                    0)
                  (when (and (load have) (text/starts-with? l "new file"))
                    (let [f (current m)]
                      (set! (.change-at f) (keep! m "added"))
                      (set! (.change-len f) 5))
                    0)
                  (when (and (load have) (text/starts-with? l "deleted file"))
                    (let [f (current m)]
                      (set! (.change-at f) (keep! m "deleted"))
                      (set! (.change-len f) 7))
                    0)
                  (when (and (load have) (text/starts-with? l "rename from"))
                    (let [f (current m)]
                      (set! (.change-at f) (keep! m "renamed"))
                      (set! (.change-len f) 7))
                    0)
                  (set! i (+ (load i) 1))))))
    (ArrayList::free! (mut spans))
    (do)))

;;; ---- highlighting ------------------------------------------------------------

;;; Syntax runs for every line of file I. Old and new sides are lexed as two
;;; sequences, so a block comment opened on one side continues on that side.
(defn highlight-file! [(m (ptr Model)) (i i64)] (-> void)
  (let [f (file m i)
        (mut old-lx) (hl/lexer (path m f))
        (mut new-lx) (hl/lexer (path m f))]
    (for [k (.lines-at f) (+ (.lines-at f) (.lines-len f))]
      (let [l (line m k)
            tag (.tag l)]
        (when (!= tag HUNK)
          (let [start (len (.runs m))]
            (if (= tag DEL)
                (hl/line! (mut old-lx) (line-text m l) (.at l) (field m runs))
                (hl/line! (mut new-lx) (line-text m l) (.at l) (field m runs)))
            ; Context lines advance the old side's comment state too.
            (when (= tag CONTEXT)
              (let [(mut scratch)
                      (ArrayList::new [hl/Run] (alloc/malloc-allocator))]
                (hl/line! (mut old-lx) (line-text m l) 0 (mut scratch))
                (ArrayList::free! (mut scratch)))
              0)
            (set! (.runs-at l) start)
            (set! (.runs-len l) (- (len (.runs m)) start)))
          0)))
    (do)))

(defn highlight-all! [(m (ptr Model))] (-> void)
  (for [i 0 (file-count m)] (highlight-file! m i))
  (do))
