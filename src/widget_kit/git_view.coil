(module jim.widget-kit.git-view)
(import "coil.primitive" :as p)
(import "coil.alloc" :as alloc)
(import "coil.arraylist" :use *)
(import "coil.slice" :use *)
(import "jim.widget-api" :as api)
(import "jim.widget-kit.text" :as text)
(import "jim.widget-kit.highlight" :as hl)
(import "jim.widget-kit.diff" :as diff)

;;; Colors and diff row primitives shared by the git widgets (the Coil
;;; counterpart of original Jim's git.ft), so diff and stage render lines the
;;; same way.
(const INK 0xe6e9f0)

(const MUTED 0x9098a4)

(const ACCENT 0x8fe3b0)

(const PANEL 0x12151b)

(const CARD 0x161a21)

(const WARN 0xe0b066)

(const ERR 0xe08a8a)

(const ADDED 0x5fcf8a)

(const REMOVED 0xe08a8a)

;;; Every diff row is this tall, so widgets can virtualize by arithmetic.
(const ROW-H 20.0)

(defn tint [(tag i64)] (-> i64)
  (cond (= tag diff/ADD) 0x12301d
        (= tag diff/DEL) 0x341a1d
        :else api/NONE))

(defn sign-color [(tag i64)] (-> i64)
  (cond (= tag diff/ADD) ADDED
        (= tag diff/DEL) REMOVED
        :else MUTED))

(defn sign-text [(tag i64)] (-> (slice u8))
  (cond (= tag diff/ADD) "+"
        (= tag diff/DEL) "-"
        :else " "))

(defn mono-text! [(ui (ptr api/Ui)) (value (slice u8)) (size f64) (color i64)] (-> void)
  (api/text! ui value size color false)
  (api/mono! ui))

;;; "  12   13": old and new line numbers, blank where a side has none.
(defn gutter! [(ui (ptr api/Ui)) (l (ptr diff/Line))] (-> void)
  (let [(mut out) (al-new [u8] (alloc/malloc-allocator))]
    (if (> (.old l) 0)
        (text/push-padded! (mut out) (.old l) 4)
        (text/push-str! (mut out) "    "))
    (text/push-str! (mut out) " ")
    (if (> (.new l) 0)
        (text/push-padded! (mut out) (.new l) 4)
        (text/push-str! (mut out) "    "))
    (mono-text! ui (al-slice out) 11.0 MUTED)
    (al-free! (mut out))
    (do)))

;;; The line's code as syntax-colored runs.
(defn code! [(ui (ptr api/Ui)) (m (ptr diff/Model)) (l (ptr diff/Line))] (-> void)
  (api/hstack! ui 0.0 0.0)
  (if (= (.runs-len l) 0)
      (mono-text! ui (if (> (.len l) 0) (diff/line-text m l) " ") 12.5 INK)
      (do
        (for [k (.runs-at l) (+ (.runs-at l) (.runs-len l))]
          (let [r (diff/run m k)]
            (mono-text! ui
                        (diff/text-at m (.at r) (.len r))
                        12.5
                        (hl/color (.kind r)))))
        (do)))
  (api/end! ui))

;;; One diff line: gutter, sign and code on the line's add/delete tint. With a
;;; non-empty ID the row is clickable.
(defn line-row! [(ui (ptr api/Ui))
                 (m (ptr diff/Model))
                 (l (ptr diff/Line))
                 (id (slice u8))
                 (focused bool)] (-> void)
  (api/hstack! ui 8.0 0.0)
  (api/align! ui api/START)
  (api/height! ui ROW-H)
  (api/pad! ui 1.0 6.0 1.0 6.0)
  (api/clip! ui)
  (api/bg! ui (if focused 0x2b3a52 (tint (.tag l))))
  (when (> (len id) 0) (api/clickable! ui id false) 0)
  (gutter! ui l)
  (mono-text! ui (sign-text (.tag l)) 12.5 (sign-color (.tag l)))
  (code! ui m l)
  (api/end! ui))

(defn hunk-row! [(ui (ptr api/Ui)) (header (slice u8))] (-> void)
  (api/hstack! ui 0.0 0.0)
  (api/height! ui ROW-H)
  (api/pad! ui 2.0 6.0 2.0 6.0)
  (api/clip! ui)
  (api/bg! ui PANEL)
  (mono-text! ui header 11.0 ACCENT)
  (api/end! ui))

;;; One side of a split row: LINE, or blank when INDEX is NONE.
(defn side-cell! [(ui (ptr api/Ui)) (m (ptr diff/Model)) (index i64)] (-> void)
  (api/hstack! ui 8.0 0.0)
  (api/align! ui api/START)
  (api/grow! ui 1.0)
  (api/height! ui ROW-H)
  (api/pad! ui 1.0 6.0 1.0 6.0)
  (api/clip! ui)
  (when (!= index api/NONE)
    (let [l (diff/line m index)]
      (api/bg! ui (tint (.tag l)))
      (mono-text! ui (sign-text (.tag l)) 12.5 (sign-color (.tag l)))
      (code! ui m l))
    0)
  (api/end! ui))

;;; "+12 −3" in add/delete colors.
(defn stat! [(ui (ptr api/Ui)) (adds i64) (dels i64) (size f64)] (-> void)
  (mono-text! ui "+" size ADDED)
  (api/append-i64! ui adds)
  (mono-text! ui "−" size REMOVED)
  (api/append-i64! ui dels))
