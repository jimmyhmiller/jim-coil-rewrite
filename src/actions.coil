(module jim.actions)
(import "jim.native" :use *)
(import "coil.primitive" :as p)
(import "jim.projects" :as projects)
(import "jim.storage" :as storage)

(defn model [] (-> (ptr (ptr i8)))
  (p/alloc-static (ptr i8)))

;;; Stable action IDs are shared by shortcuts and the searchable registry.
;;; Fixed actions come first; one action per project follows.
(const FIRST-PROJECT 30)

(defn count [] (-> i64)
  (+ FIRST-PROJECT (storage/count (projects/list (load (model))))))

(defn title [(id i64)] (-> (ptr i8))
  (cond (= id 0) c"Terminal: New terminal"
        (= id 1) c"Terminal: Close focused terminal"
        (= id 2) c"Canvas: Reset pan and zoom"
        (= id 3) c"Canvas: Reset zoom"
        (= id 4) c"Canvas: Fit all panes"
        (= id 5) c"Canvas: Zoom in"
        (= id 6) c"Canvas: Zoom out"
        (= id 7) c"Canvas: Toggle zoom"
        (= id 8) c"Workspace: Show or hide cube"
        (= id 9) c"Theme: Reload Coil configuration"
        (= id 10) c"Developer: Toggle frame timings"
        (= id 11) c"Project: First visible project"
        (= id 12) c"Project: Second visible project"
        (= id 13) c"Project: Third visible project"
        (= id 14) c"Project: Fourth visible project"
        (= id 15) c"Project: New project"
        (= id 16) c"Project: Rename current project"
        (= id 17) c"Project: Hide current project"
        (= id 18) c"Project: Set directory"
        (= id 19) c"Project: Set directory from focused terminal"
        (= id 20) c"Profile: New profile"
        (= id 21) c"Profile: Rename current profile"
        (= id 22) c"Profile: Delete current profile"
        (= id 23) c"Project: Show or hide hidden projects"
        (= id 24) c"Profile: Previous profile"
        (= id 25) c"Profile: Next profile"
        (= id 26) c"Project: Delete current project"
        (= id 27) c"Terminal: Reconnect focused terminal"
        (= id 28) c"Widget: Open widget"
        (= id 29) c"View: Toggle Exposé"
        :else
          (utf8 (msg (ptr i8)
                     (ns c"Project: ")
                     (sel c"stringByAppendingString:")
                     [(ptr i8)]
                     (storage/get (storage/at (projects/list (load (model)))
                                              (- id FIRST-PROJECT))
                                  c"name")))))

(defn shortcut [(id i64)] (-> (ptr i8))
  (cond (= id 0) c"⌘T"
        (= id 1) c"⌘W"
        (= id 2) c"⌘⇧0"
        (= id 3) c"⌘0"
        (= id 5) c"⌘="
        (= id 6) c"⌘−"
        (= id 7) c"⌘⇧Z"
        (= id 8) c"⌘⇧\\"
        (= id 9) c"⌘R"
        (= id 11) c"⌘1"
        (= id 12) c"⌘2"
        (= id 13) c"⌘3"
        (= id 14) c"⌘4"
        (= id 29) c"⌘⇧E"
        :else c""))

(defn keywords [(id i64)] (-> (ptr i8))
  (cond (= id 0) c" shell ghostty pane"
        (= id 2) c" home origin"
        (= id 8) c" compiz overview workspaces"
        (= id 10) c" fps performance profiler latency frame time"
        (= id 19) c" cwd pwd working current default new terminal"
        (= id 28) c" coil hot reload funct pane new"
        (= id 29)
          c" expose overview windows spread grid mission control tile arrange"
        :else c""))

;;; Original Jim's subsequence score: consecutive and word-start bonuses.
;;; NSString lowercasing keeps native search input, including Unicode, intact.
(defn score [(query (ptr i8)) (text (ptr i8))] (-> i64)
  (let [q (msg (ptr i8) query (sel c"lowercaseString") [])
        h (msg (ptr i8) text (sel c"lowercaseString") [])
        qn (msg u64 q (sel c"length") [])
        hn (msg u64 h (sel c"length") [])
        (mut hi) (: 0 u64)
        (mut result) 0
        (mut consecutive) 0
        (mut valid) true]
    (do
      (for [qi 0 (p/cast i64 qn)]
        (let [ch (msg u16 q (sel c"characterAtIndex:") [u64] (p/cast u64 qi))
              (mut found) false]
          (do
            (while (and (< (load hi) hn) (not (load found)))
              (let [at (load hi)
                    hc (msg u16 h (sel c"characterAtIndex:") [u64] at)
                    prev
                      (if (> at (: 0 u64))
                          (msg u16
                               h
                               (sel c"characterAtIndex:")
                               [u64]
                               (- at (: 1 u64)))
                          (: 32 u16))]
                (do
                  (set! hi (+ at (: 1 u64)))
                  (if (= ch hc)
                      (do
                        (set! result (+ (load result) (+ 1 (load consecutive))))
                        (if (or (= at (: 0 u64))
                                (= prev (: 32 u16))
                                (= prev (: 95 u16))
                                (= prev (: 46 u16))
                                (= prev (: 47 u16))
                                (= prev (: 45 u16)))
                            (set! result (+ (load result) 4))
                            0)
                        (set! consecutive (+ (load consecutive) 1))
                        (set! found true))
                      (set! consecutive 0)))))
            (if (not (load found)) (set! valid false) 0))))
      (if (load valid) (load result) -1))))

(defn match-score [(query (ptr i8)) (id i64)] (-> i64)
  (let [hay
          (msg (ptr i8)
               (ns (title id))
               (sel c"stringByAppendingString:")
               [(ptr i8)]
               (ns (keywords id)))
        base
          (if (and (>= id FIRST-PROJECT)
                   (projects/hidden? (projects/profile (load (model)))
                                     (projects/id (storage/at (projects/list (load (model)))
                                                              (- id
                                                                 FIRST-PROJECT)))))
              -1
              (score query hay))
        exact
          (msg Range hay (sel c"rangeOfString:options:") [(ptr i8) u64] query 1)]
    (if (and (>= base 0)
             (and (> (msg u64 query (sel c"length") []) (: 0 u64))
                  (> (.length exact) (: 0 u64))))
        (+ base 32)
        base)))

(defn key-action [(key u16) (flags u64)] (-> i64)
  (let [command (!= (& flags 1048576) (: 0 u64))
        shift (!= (& flags 131072) (: 0 u64))]
    (if command
        (cond (or (= key (: 17 u16)) (= key (: 45 u16))) 0
              (= key (: 13 u16)) 1
              (= key (: 29 u16)) (if shift 2 3)
              (= key (: 24 u16)) 5
              (= key (: 27 u16)) 6
              (and shift (= key (: 6 u16))) 7
              (and shift (= key (: 42 u16))) 8
              (and shift (= key (: 14 u16))) 29
              (= key (: 15 u16)) 9
              (and (>= key (: 18 u16)) (<= key (: 21 u16)))
                (+ 11 (- (p/cast i64 key) 18))
              :else -1)
        -1)))
