(module jim.session.transport)
(import "coil.cc" :as cc)
(import "coil.os" :as os)
(import "coil.primitive" :as p)

(const MAGIC 1246317873)

(const MAX-PAYLOAD 65536)

(const JIM-ATTACH 1)

(const JIM-INPUT 2)

(const JIM-RESIZE 3)

(const JIM-KILL 4)

(const JIM-COLORS 5)

(const JIM-OUTPUT 16)

(const JIM-READY 17)

(const JIM-EXITED 18)

(const JIM-ERROR 19)

(const JIM-DIRECTORY 20)

(const AF-UNIX 1)

(const SOCK-STREAM 1)

(const SOL-SOCKET 65535)

(const SO-NOSIGPIPE 4130)

(const F-SETFD 2)

(const FD-CLOEXEC 1)

(const SHUT-RDWR 2)

(const EINTR 4)

(const ENOENT 2)

(const EIO 5)

(const EACCES 13)

(const EMSGSIZE 40)

(const EPROTO 100)

(const ECONNREFUSED 61)

(const POSIX-SPAWN-CLOEXEC-DEFAULT 16384)

;;; Darwin's sockaddr_un begins with one-byte length and family fields.
(defstruct SockaddrUn [(length u8) (family u8) (path (array i8 104))])

(static-assert (= (sizeof SockaddrUn) 106) "Darwin sockaddr_un ABI size")

(static-assert (= (offsetof SockaddrUn path) 2)
               "Darwin sockaddr_un path offset")

(extern socket :cc (cc/C) [i32 i32 i32] (-> i32))

(extern connect :cc (cc/C) [i32 (ptr i8) u32] (-> i32))

(extern setsockopt :cc (cc/C) [i32 i32 i32 (ptr i8) u32] (-> i32))

(extern getpeereid :cc (cc/C) [i32 (ptr u32) (ptr u32)] (-> i32))

(extern getuid :cc (cc/C) [] (-> u32))

(extern send :cc (cc/C) [i32 (ptr i8) isize i32] (-> isize))

(extern recv :cc (cc/C) [i32 (ptr i8) isize i32] (-> isize))

(extern shutdown :cc (cc/C) [i32 i32] (-> i32))

(extern close :cc (cc/C) [i32] (-> i32))

(extern fcntl :cc (cc/C) [i32 i32 ...] (-> i32))

(extern strlen :cc (cc/C) [(ptr i8)] (-> isize))

(extern memcpy :cc (cc/C) [(ptr i8) (ptr i8) isize] (-> (ptr i8)))

(extern nanosleep :cc (cc/C) [(ptr i8) (ptr i8)] (-> i32))

(extern waitpid :cc (cc/C) [i32 (ptr i32) i32] (-> i32))

(extern posix_spawn
        :cc
        (cc/C)
        [(ptr i32) (ptr i8) (ptr i8) (ptr i8) (ptr (ptr i8)) (ptr (ptr i8))]
        (-> i32))

(extern posix_spawnattr_init :cc (cc/C) [(ptr (ptr i8))] (-> i32))

(extern posix_spawnattr_destroy :cc (cc/C) [(ptr (ptr i8))] (-> i32))

(extern posix_spawnattr_setflags :cc (cc/C) [(ptr (ptr i8)) i16] (-> i32))

(extern posix_spawn_file_actions_init :cc (cc/C) [(ptr (ptr i8))] (-> i32))

(extern posix_spawn_file_actions_destroy :cc (cc/C) [(ptr (ptr i8))] (-> i32))

(extern posix_spawn_file_actions_addopen
        :cc
        (cc/C)
        [(ptr (ptr i8)) i32 (ptr i8) i32 u16]
        (-> i32))

(extern posix_spawn_file_actions_adddup2
        :cc
        (cc/C)
        [(ptr (ptr i8)) i32 i32]
        (-> i32))

(extern _NSGetEnviron :cc (cc/C) [] (-> (ptr (ptr (ptr i8)))))

(extern __error :cc (cc/C) [] (-> (ptr i32)))

(defn set-errno! [(value i32)] (-> i64)
  (set! (index (__error) 0) value)
  0)

(defn byte-at [(base (ptr i8)) (offset i64)] (-> u8)
  (p/cast u8 (load (index base offset))))

(defn put-byte! [(base (ptr i8)) (offset i64) (value u8)] (-> i64)
  (set! (index base offset) (p/cast i8 value))
  0)

(defn put-u32-be! [(base (ptr i8)) (offset i64) (value u32)] (-> i64)
  (put-byte! base offset (p/cast u8 (>> value (: 24 u32))))
  (put-byte! base (+ offset 1) (p/cast u8 (>> value (: 16 u32))))
  (put-byte! base (+ offset 2) (p/cast u8 (>> value (: 8 u32))))
  (put-byte! base (+ offset 3) (p/cast u8 value))
  0)

(defn u32-be [(base (ptr i8)) (offset i64)] (-> u32)
  (| (<< (p/cast u32 (byte-at base offset)) (: 24 u32))
     (<< (p/cast u32 (byte-at base (+ offset 1))) (: 16 u32))
     (<< (p/cast u32 (byte-at base (+ offset 2))) (: 8 u32))
     (p/cast u32 (byte-at base (+ offset 3)))))

(defn transfer [(fd i32) (data (ptr i8)) (length i64) (sending bool)] (-> i32)
  (let [(mut at) 0]
    (block
      :done
        (loop (if (>= (load at) length)
                  (break (: 0 i32))
                  (let [n
                          (if sending
                              (send fd
                                    (index data (load at))
                                    (p/cast isize (- length (load at)))
                                    0)
                              (recv fd
                                    (index data (load at))
                                    (p/cast isize (- length (load at)))
                                    0))]
                    (if (and (< n 0) (= (os/errno) EINTR))
                        0
                        (if (<= n 0)
                            (return-from :done (: -1 i32))
                            (set! at (+ (load at) (p/cast i64 n)))))))
          (: 0 i32)))))

(defn session-send [(fd i32) (kind u32) (bytes (ptr i8)) (length i64)] (-> i32)
  (if (> length MAX-PAYLOAD)
      (do (set-errno! EMSGSIZE) (: -1 i32))
      (let [(mut header) (zeroed (array i8 12))
            out (p/cast (ptr i8) (mut header))]
        (put-u32-be! out 0 (p/cast u32 MAGIC))
        (put-u32-be! out 4 kind)
        (put-u32-be! out 8 (p/cast u32 length))
        (if (< (transfer fd out 12 true) 0)
            (: -1 i32)
            (transfer fd bytes length true)))))

(defn session-receive [(fd i32)
                       (kind (ptr u32))
                       (bytes (ptr i8))
                       (capacity i64)] (-> i32)
  (let [(mut header) (zeroed (array i8 12))
        input (p/cast (ptr i8) (mut header))]
    (if (< (transfer fd input 12 false) 0)
        (: -1 i32)
        (let [length (p/cast i64 (u32-be input 8))]
          (if (or (!= (u32-be input 0) (p/cast u32 MAGIC))
                  (> length capacity)
                  (> length MAX-PAYLOAD))
              (do (set-errno! EPROTO) (: -1 i32))
              (do
                (set! (index kind 0) (u32-be input 4))
                (if (< (transfer fd bytes length false) 0)
                    (: -1 i32)
                    (p/cast i32 length))))))))

;;; ---- event log ------------------------------------------------------------------
;;; One line per lifecycle event, in events.log beside the session sockets. A terminal
;;; service has no stdout, so without this a failure leaves no trace of its cause.
;;; A full disk can lose a line, so a failure's reason also goes to the client's pane.

(extern snprintf :cc (cc/C) [(ptr i8) u64 (ptr i8) ...] (-> i32))

(extern gettimeofday :cc (cc/C) [(ptr i8) (ptr i8)] (-> i32))

(extern localtime_r :cc (cc/C) [(ptr i64) (ptr i8)] (-> (ptr i8)))

(extern strftime :cc (cc/C) [(ptr i8) u64 (ptr i8) (ptr i8)] (-> u64))

(extern getpid :cc (cc/C) [] (-> i32))

(extern open :cc (cc/C) [(ptr i8) i32 ...] (-> i32))

(extern write :cc (cc/C) [i32 (ptr i8) isize] (-> isize))

(extern rename :cc (cc/C) [(ptr i8) (ptr i8)] (-> i32))

(extern lseek :cc (cc/C) [i32 i64 i32] (-> i64))

(extern strrchr :cc (cc/C) [(ptr i8) i32] (-> (ptr i8)))

(extern strerror :cc (cc/C) [i32] (-> (ptr i8)))

(extern proc_name :cc (cc/C) [i32 (ptr i8) u32] (-> i32))

(extern getsockopt :cc (cc/C) [i32 i32 i32 (ptr i8) (ptr u32)] (-> i32))

(extern poll :cc (cc/C) [(ptr i8) u64 i32] (-> i32))

(const O-WRONLY-APPEND-CREAT-CLOEXEC 16777737)

(const SEEK-END 2)

(const LOG-ROTATE-BYTES 16777216)

(const SOL-LOCAL 0)

(const LOCAL-PEERPID 2)

(const POLLIN-EVENT 1)

;;; The open log's descriptor plus one, so that zero means not open.
(defn log-fd-cell [] (-> (ptr i32))
  (p/alloc-static i32))

(defn log-tag-cell [] (-> (ptr (array i8 40)))
  (p/alloc-static (array i8 40)))

(defn log-tag [] (-> (ptr i8))
  (p/cast (ptr i8) (log-tag-cell)))

;;; Open events.log in the directory holding SOCKET, naming this process's lines TAG.
(defn log-open! [(socket (ptr i8)) (tag (ptr i8))] (-> i64)
  (when (= (load (log-fd-cell)) (: 0 i32))
    (snprintf (log-tag) (: 40 u64) c"%s" tag)
    (let [(mut path) (zeroed (array i8 1200))
          (mut old) (zeroed (array i8 1200))
          out (p/cast (ptr i8) (mut path))
          aged (p/cast (ptr i8) (mut old))]
      (snprintf out (: 1200 u64) c"%s" socket)
      (let [slash (strrchr out (: 47 i32))]
        (when (!= (p/cast i64 slash) 0)
          (set! (index slash 1) (: 0 i8))
          (snprintf aged (: 1200 u64) c"%sevents.log" out)
          (snprintf out (: 1200 u64) c"%s.1" aged)
          (let [fd (open aged O-WRONLY-APPEND-CREAT-CLOEXEC (: 384 i32))]
            (when (>= fd (: 0 i32))
              (if (>= (lseek fd 0 SEEK-END) LOG-ROTATE-BYTES)
                  (do
                    (close fd)
                    (rename aged out)
                    (let [fresh
                            (open aged
                                  O-WRONLY-APPEND-CREAT-CLOEXEC
                                  (: 384 i32))]
                      (set! (log-fd-cell) (+ fresh (: 1 i32)))
                      0))
                  (do (set! (log-fd-cell) (+ fd (: 1 i32))) 0))
              0)
            0)
          0)
        0)
      0)
    0)
  0)

;;; Record MESSAGE. Leaves errno as it found it, so callers may still read it.
(defn log-line! [(message (ptr i8))] (-> i64)
  (let [saved (os/errno)
        (mut clock) (zeroed (array i64 2))
        (mut tm) (zeroed (array i8 64))
        (mut stamp) (zeroed (array i8 48))
        (mut line) (zeroed (array i8 2200))
        stamp-out (p/cast (ptr i8) (mut stamp))
        line-out (p/cast (ptr i8) (mut line))]
    (gettimeofday (p/cast (ptr i8) (mut clock)) (p/cast (ptr i8) 0))
    (localtime_r (p/cast (ptr i64) (mut clock)) (p/cast (ptr i8) (mut tm)))
    (strftime stamp-out
              (: 48 u64)
              c"%Y-%m-%dT%H:%M:%S%z"
              (p/cast (ptr i8) (mut tm)))
    (let [written
            (snprintf line-out
                      (: 2200 u64)
                      c"%s us=%06lld pid=%d %s %s\n"
                      stamp-out
                      (p/cast i64
                              (load (index (p/cast (ptr i64) (mut clock)) 1)))
                      (getpid)
                      (log-tag)
                      message)
          length (if (> written (: 2199 i32)) (: 2199 i32) written)
          fd (- (load (log-fd-cell)) (: 1 i32))]
      (when (>= fd (: 0 i32))
        (write fd line-out (p/cast isize length))
        0)
      (set-errno! (p/cast i32 saved))
      0)))

;;; Record FORMAT with up to four arguments. Pointers go in cast to i64.
(defn log! [(format (ptr i8)) (a i64) (b i64) (c i64) (d i64)] (-> i64)
  (let [saved (os/errno)
        (mut message) (zeroed (array i8 2000))
        out (p/cast (ptr i8) (mut message))]
    (snprintf out (: 2000 u64) format a b c d)
    (set-errno! (p/cast i32 saved))
    (log-line! out)))

(defn peer-pid [(fd i32)] (-> i32)
  (let [(mut pid) (zeroed i32)
        (mut length) (: 4 u32)]
    (if (< (getsockopt fd
                       SOL-LOCAL
                       LOCAL-PEERPID
                       (p/cast (ptr i8) (mut pid))
                       (mut length))
           (: 0 i32))
        (: -1 i32)
        (load pid))))

;;; Record EVENT and who is on the other end of FD: what kicks a client, or kills a
;;; session, is the first thing to want to know.
(defn log-peer! [(event (ptr i8)) (fd i32)] (-> i64)
  (let [pid (peer-pid fd)
        (mut name) (zeroed (array i8 64))
        out (p/cast (ptr i8) (mut name))]
    (when (> pid (: 0 i32)) (proc_name pid out (: 64 u32)) 0)
    (log! c"%s peer_pid=%lld peer=%s"
          (p/cast i64 event)
          (p/cast i64 pid)
          (p/cast i64 out)
          0)))

;;; For the client's reader, in Ghostty's IO code: what ended this connection.
(defn session-log-client [(fd i32) (event (ptr i8)) (detail (ptr i8))] (-> void)
  (let [code (os/errno)]
    (log! c"client fd=%lld %s detail=%s errno=%lld"
          (p/cast i64 fd)
          (p/cast i64 event)
          (p/cast i64 (if (= (p/cast i64 detail) 0) c"-" detail))
          (p/cast i64 code))
    (do)))

;;; Whether FD has something to read within MILLISECONDS.
(defn session-readable [(fd i32) (milliseconds i32)] (-> i32)
  (let [(mut entry) (zeroed (array i16 4))
        bytes (p/cast (ptr i8) (mut entry))]
    (set! (index (p/cast (ptr i32) bytes) 0) fd)
    (set! (index (p/cast (ptr i16) bytes) 2) (: 1 i16))
    (poll bytes (: 1 u64) milliseconds)))

(defn session-connect [(path (ptr i8))] (-> i32)
  (let [address (p/alloc-stack SockaddrUn)
        path-length (p/cast i64 (strlen path))]
    (if (>= path-length 104)
        (do (set-errno! 63) (: -1 i32))
        (do
          (set! address (zeroed SockaddrUn))
          (set! (.length address) (: 106 u8))
          (set! (.family address) (p/cast u8 AF-UNIX))
          (memcpy (p/cast (ptr i8) (index (field address path) 0))
                  path
                  (p/cast isize (+ path-length 1)))
          (let [fd (socket AF-UNIX SOCK-STREAM 0)]
            (if (< fd 0)
                fd
                (let [(mut yes) (: 1 i32)]
                  (fcntl fd F-SETFD FD-CLOEXEC)
                  (setsockopt fd
                              SOL-SOCKET
                              SO-NOSIGPIPE
                              (p/cast (ptr i8) (mut yes))
                              (: 4 u32))
                  (if (< (connect fd (p/cast (ptr i8) address) (: 106 u32))
                         0)
                      (do (close fd) (: -1 i32))
                      (let [(mut uid) (zeroed u32)
                            (mut gid) (zeroed u32)]
                        (if (or (< (getpeereid fd (mut uid) (mut gid)) 0)
                                (!= uid (getuid)))
                            (do (close fd) (set-errno! EACCES) (: -1 i32))
                            fd))))))))))

;;; Attach with no size. The client reports its real one after replay. Services older
;;; than this applied the attach size to the terminal, but ignore a size of zero, so
;;; shells they already run are not resized by a reattach either.
(defn attach [(fd i32)] (-> i32)
  (let [(mut size) (: (zeroed (array i8 8)) (array i8 8))
        bytes (p/cast (ptr i8) (mut size))]
    (if (< (session-send fd (p/cast u32 JIM-ATTACH) bytes 8) 0)
        (do (close fd) (: -1 i32))
        fd)))

(defstruct Timespec [(seconds i64) (nanoseconds i64)])

;;; The launcher's exit status when the original Jim daemon it was asked to adopt
;;; is gone. Reported as ENOENT, distinct from a service that failed to start.
(const EXIT-UPSTREAM-GONE 3)

;;; ---- starting a service through launchd ------------------------------------------
;;; Force quitting an app, from the Dock, Cmd-Opt-Esc or the low-memory dialog, sends
;;; SIGTERM to every process in its coalition. A child stays in its parent's coalition
;;; however it detaches, and setsid, a double fork or disclaiming responsibility do not
;;; change that. launchd gives what it starts a coalition of its own, so a service starts
;;; as a launchd job. The job lasts only until the service is running, since the service
;;; then belongs to no one but itself.
;;;
;;; launchd carries neither the caller's environment nor the launcher's exit status. So
;;; the job is `jim-session --launched REQUEST`: REQUEST holds the service's arguments and
;;; environment, and it leaves the launcher's wait status in REQUEST.status.

(extern read :cc (cc/C) [i32 (ptr i8) isize] (-> isize))

(extern unlink :cc (cc/C) [(ptr i8)] (-> i32))

(const O-RDONLY-CLOEXEC 16777216)

;;; O_WRONLY | O_CREAT | O_TRUNC | O_CLOEXEC
(const O-REPLACE-CLOEXEC 16778753)

(const O-WRONLY-NOCTTY 131073)

(const ENAMETOOLONG 63)

;;; How long launchd has to run the launcher, in tries 10 ms apart.
(const LAUNCH-ATTEMPTS 500)

;;; The jetsam coalition of this process: the unit a force quit ends. Logged by a service,
;;; since it is what proves a service is out of the app's reach. 20 is
;;; PROC_PIDCOALITIONINFO, which fills two ids, resource and then jetsam.
(extern proc_pidinfo :cc (cc/C) [i32 i32 u64 (ptr i8) i32] (-> i32))

(extern getpid :cc (cc/C) [] (-> i32))

(defn coalition-of [(pid i32)] (-> i64)
  (let [(mut ids) (zeroed (array u64 8))
        got
          (proc_pidinfo pid
                        (: 20 i32)
                        (: 0 u64)
                        (p/cast (ptr i8) (mut ids))
                        (: 64 i32))]
    (if (>= got (: 16 i32)) (p/cast i64 (load (index (mut ids) 1))) -1)))

(defn own-coalition [] (-> i64)
  (coalition-of (getpid)))

(defn rename-file [(from (ptr i8)) (to (ptr i8))] (-> i32)
  (rename from to))

(defn write-all! [(fd i32) (bytes (ptr i8)) (length i64)] (-> bool)
  (let [(mut done) 0
        (mut ok) true]
    (while (and (load ok) (< (load done) length))
      (let [wrote
              (write fd
                     (index bytes (load done))
                     (p/cast isize (- length (load done))))]
        (if (> wrote (: 0 isize))
            (set! done (+ (load done) (p/cast i64 wrote)))
            (when (or (= wrote (: 0 isize)) (!= (os/errno) EINTR))
              (set! ok false)))))
    (load ok)))

;;; S and the NUL that ends it.
(defn write-string! [(fd i32) (s (ptr i8))] (-> bool)
  (write-all! fd s (+ (p/cast i64 (strlen s)) 1)))

;;; REQUEST: each argument, an empty string, then each environment entry.
(defn write-request! [(request (ptr i8)) (argv (ptr (ptr i8)))] (-> bool)
  (let [fd (open request O-REPLACE-CLOEXEC (: 384 i32))]
    (if (< fd (: 0 i32))
        false
        (let [environment (load (_NSGetEnviron))
              (mut ok) true
              (mut i) 0]
          (while (and (load ok)
                      (!= (p/cast i64 (load (index argv (load i)))) 0))
            (set! ok (write-string! fd (load (index argv (load i)))))
            (set! i (+ (load i) 1)))
          (when (load ok) (set! ok (write-string! fd c"")))
          (set! i 0)
          (while (and (load ok)
                      (!= (p/cast i64 (load (index environment (load i)))) 0))
            (set! ok (write-string! fd (load (index environment (load i)))))
            (set! i (+ (load i) 1)))
          (close fd)
          (load ok)))))

;;; S as XML text. A control character has no XML spelling, so it fails.
(defn write-xml! [(fd i32) (s (ptr i8))] (-> bool)
  (let [(mut ok) true
        (mut i) 0
        length (p/cast i64 (strlen s))]
    (while (and (load ok) (< (load i) length))
      (let [c (byte-at s (load i))]
        (cond (< c (: 32 u8)) (set! ok false)
              (= c (: 38 u8)) (set! ok (write-all! fd c"&amp;" 5))
              (= c (: 60 u8)) (set! ok (write-all! fd c"&lt;" 4))
              (= c (: 62 u8)) (set! ok (write-all! fd c"&gt;" 4))
              :else (set! ok (write-all! fd (index s (load i)) 1))))
      (set! i (+ (load i) 1)))
    (load ok)))

(defn write-text! [(fd i32) (s (ptr i8))] (-> bool)
  (write-all! fd s (p/cast i64 (strlen s))))

;;; AbandonProcessGroup, or launchd would end what the launcher leaves behind. The
;;; service sets up its own session, but nothing depends on the order that happens in.
(defn write-plist! [(plist (ptr i8))
                    (label (ptr i8))
                    (executable (ptr i8))
                    (request (ptr i8))] (-> bool)
  (let [fd (open plist O-REPLACE-CLOEXEC (: 384 i32))]
    (if (< fd (: 0 i32))
        false
        (let [ok
                (and (write-text! fd
                                  c"<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<plist version=\"1.0\"><dict>\n<key>Label</key><string>")
                     (write-xml! fd label)
                     (write-text! fd
                                  c"</string>\n<key>ProgramArguments</key><array><string>")
                     (write-xml! fd executable)
                     (write-text! fd
                                  c"</string><string>--launched</string><string>")
                     (write-xml! fd request)
                     (write-text! fd
                                  c"</string></array>\n<key>RunAtLoad</key><true/>\n<key>KeepAlive</key><false/>\n<key>AbandonProcessGroup</key><true/>\n<key>ProcessType</key><string>Interactive</string>\n<key>LimitLoadToSessionType</key><string>Aqua</string>\n</dict></plist>\n"))]
          (close fd)
          ok))))

;;; Run launchctl VERB FIRST [SECOND]: its wait status, or -1 with errno set. What it
;;; prints about a failure goes to the event log.
(defn launchctl! [(verb (ptr i8)) (first (ptr i8)) (second (ptr i8))] (-> i32)
  (let [(mut attributes) (: (p/cast (ptr i8) 0) (ptr i8))
        (mut actions) (: (p/cast (ptr i8) 0) (ptr i8))
        (mut pid) (zeroed i32)
        (mut status) (zeroed i32)
        argv (p/alloc-stack (array (ptr i8) 5))
        log-fd (- (load (log-fd-cell)) (: 1 i32))]
    (set! (index argv 0) c"/bin/launchctl")
    (set! (index argv 1) verb)
    (set! (index argv 2) first)
    (set! (index argv 3) second)
    (set! (index argv 4) (p/cast (ptr i8) 0))
    (if (or (!= (posix_spawnattr_init (mut attributes)) (: 0 i32))
            (!= (posix_spawn_file_actions_init (mut actions)) (: 0 i32)))
        (: -1 i32)
        (do
          (posix_spawnattr_setflags (mut attributes)
                                    (p/cast i16 POSIX-SPAWN-CLOEXEC-DEFAULT))
          (posix_spawn_file_actions_addopen (mut actions)
                                            (: 0 i32)
                                            c"/dev/null"
                                            (: 0 i32)
                                            (: 0 u16))
          (posix_spawn_file_actions_addopen (mut actions)
                                            (: 1 i32)
                                            c"/dev/null"
                                            O-WRONLY-NOCTTY
                                            (: 0 u16))
          (if (> log-fd (: 2 i32))
              (posix_spawn_file_actions_adddup2 (mut actions) log-fd (: 2 i32))
              (posix_spawn_file_actions_addopen (mut actions)
                                                (: 2 i32)
                                                c"/dev/null"
                                                O-WRONLY-NOCTTY
                                                (: 0 u16)))
          (let [spawn-error
                  (posix_spawn (mut pid)
                               c"/bin/launchctl"
                               (p/cast (ptr i8) (mut actions))
                               (p/cast (ptr i8) (mut attributes))
                               (p/cast (ptr (ptr i8)) argv)
                               (load (_NSGetEnviron)))]
            (posix_spawn_file_actions_destroy (mut actions))
            (posix_spawnattr_destroy (mut attributes))
            (if (!= spawn-error (: 0 i32))
                (do (set-errno! spawn-error) (: -1 i32))
                (do
                  (while (and (< (waitpid pid (mut status) 0) (: 0 i32))
                              (= (os/errno) EINTR))
                    0)
                  (load status))))))))

;;; The launcher's wait status once it has reported one, or -1.
(defn launcher-status [(path (ptr i8))] (-> i32)
  (let [fd (open path O-RDONLY-CLOEXEC)]
    (if (< fd (: 0 i32))
        (: -1 i32)
        (let [(mut status) (zeroed i32)
              got (read fd (p/cast (ptr i8) (mut status)) (: 4 isize))]
          (close fd)
          (if (= got (: 4 isize)) (load status) (: -1 i32))))))

;;; Run the launcher as a launchd job and wait for it: its wait status, or -1 with errno
;;; set. No path falls back to spawning it directly, which would quietly put the terminal
;;; back where a force quit ends it.
(defn launch! [(executable (ptr i8))
               (path (ptr i8))
               (cwd (ptr i8))
               (resources (ptr i8))
               (upstream (ptr i8))] (-> i32)
  (if (>= (p/cast i64 (strlen path)) 1000)
      (do (set-errno! ENAMETOOLONG) (: -1 i32))
      (let [(mut request-bytes) (zeroed (array i8 1200))
            (mut plist-bytes) (zeroed (array i8 1200))
            (mut status-bytes) (zeroed (array i8 1200))
            (mut label-bytes) (zeroed (array i8 1200))
            (mut domain-bytes) (zeroed (array i8 64))
            (mut service-bytes) (zeroed (array i8 1400))
            request (p/cast (ptr i8) (mut request-bytes))
            plist (p/cast (ptr i8) (mut plist-bytes))
            status-path (p/cast (ptr i8) (mut status-bytes))
            label (p/cast (ptr i8) (mut label-bytes))
            domain (p/cast (ptr i8) (mut domain-bytes))
            service (p/cast (ptr i8) (mut service-bytes))
            slash (strrchr path (: 47 i32))
            name (if (= (p/cast i64 slash) 0) path (index slash 1))
            argv (p/alloc-stack (array (ptr i8) 7))
            adopting (!= (p/cast i64 upstream) 0)
            first (if adopting 3 1)]
        (snprintf request (: 1200 u64) c"%s.launch" path)
        (snprintf plist (: 1200 u64) c"%s.plist" path)
        (snprintf status-path (: 1200 u64) c"%s.launch.status" path)
        (snprintf label (: 1200 u64) c"dev.jim.coil.session.%s" name)
        (snprintf domain (: 64 u64) c"gui/%u" (getuid))
        (snprintf service (: 1400 u64) c"%s/%s" domain label)
        (set! (index argv 0) executable)
        (when adopting
          (set! (index argv 1) c"--adopt")
          (set! (index argv 2) upstream))
        (set! (index argv first) path)
        (set! (index argv (+ first 1)) cwd)
        (set! (index argv (+ first 2)) resources)
        (set! (index argv (+ first 3)) (p/cast (ptr i8) 0))
        (unlink status-path)
        (let [result
                (if (not (and (write-request! request
                                              (p/cast (ptr (ptr i8)) argv))
                              (write-plist! plist label executable request)))
                    (do
                      (log! c"launch-failed step=write errno=%lld"
                            (p/cast i64 (os/errno))
                            0
                            0
                            0)
                      (set-errno! EIO)
                      (: -1 i32))
                    (let [(mut loaded) (launchctl! c"bootstrap" domain plist)]
                      ; A job an interrupted launch left behind holds the label.
                      (when (!= (load loaded) (: 0 i32))
                        (launchctl! c"bootout" service (p/cast (ptr i8) 0))
                        (set! loaded (launchctl! c"bootstrap" domain plist)))
                      (if (!= (load loaded) (: 0 i32))
                          (do
                            (log! c"launch-failed step=bootstrap status=%lld errno=%lld"
                                  (p/cast i64 (load loaded))
                                  (p/cast i64 (os/errno))
                                  0
                                  0)
                            (set-errno! EIO)
                            (: -1 i32))
                          (let [(mut attempts) 0
                                (mut status) (launcher-status status-path)
                                (mut delay)
                                  (: (Timespec :seconds 0 :nanoseconds 10000000)
                                     Timespec)]
                            (while (and (< (load status) (: 0 i32))
                                        (< (load attempts) LAUNCH-ATTEMPTS))
                              (nanosleep (p/cast (ptr i8) (mut delay))
                                         (p/cast (ptr i8) 0))
                              (set! status (launcher-status status-path))
                              (set! attempts (+ (load attempts) 1)))
                            (launchctl! c"bootout" service (p/cast (ptr i8) 0))
                            (when (< (load status) (: 0 i32))
                              (log! c"launch-failed step=wait attempts=%lld"
                                    (load attempts)
                                    0
                                    0
                                    0)
                              (set-errno! EIO))
                            (load status)))))
              saved (os/errno)]
          (unlink plist)
          (unlink request)
          (unlink status-path)
          (set-errno! (p/cast i32 saved))
          result))))

(defn session-open [(executable (ptr i8))
                    (path (ptr i8))
                    (cwd (ptr i8))
                    (resources (ptr i8))] (-> i32)
  (start-session executable path cwd resources (p/cast (ptr i8) 0)))

;;; Like session-open, but the service fronts the original Jim daemon listening
;;; at UPSTREAM instead of starting a shell.
(defn session-adopt [(executable (ptr i8))
                     (path (ptr i8))
                     (cwd (ptr i8))
                     (resources (ptr i8))
                     (upstream (ptr i8))] (-> i32)
  (start-session executable path cwd resources upstream))

(defn start-session [(executable (ptr i8))
                     (path (ptr i8))
                     (cwd (ptr i8))
                     (resources (ptr i8))
                     (upstream (ptr i8))] (-> i32)
  (let [existing (session-connect path)]
    (if (>= existing 0)
        (attach existing)
        (if (and (!= (os/errno) ENOENT) (!= (os/errno) ECONNREFUSED))
            (: -1 i32)
            (let [adopting (!= (p/cast i64 upstream) 0)
                  status (launch! executable path cwd resources upstream)]
              (cond (< status (: 0 i32)) (: -1 i32)
                    (and adopting
                         (= status (p/cast i32 (<< EXIT-UPSTREAM-GONE 8))))
                      (do (set-errno! ENOENT) (: -1 i32))
                    :else
                      (let [(mut attempts) 0
                            (mut delay)
                              (: (Timespec :seconds 0 :nanoseconds 10000000)
                                 Timespec)]
                        (block :connected
                          (loop (if (>= (load attempts) 200)
                                    (break (: 0 i32))
                                    (let [fd (session-connect path)]
                                      (if (>= fd 0)
                                          (return-from :connected (attach fd))
                                          (do
                                            (nanosleep (p/cast (ptr i8)
                                                               (mut delay))
                                                       (p/cast (ptr i8) 0))
                                            (set! attempts
                                                  (+ (load attempts) 1)))))))
                          ; Not ENOENT, which means the daemon is gone.
                          (set-errno! EIO)
                          (: -1 i32)))))))))

(defn session-kill [(path (ptr i8))] (-> i32)
  (let [fd (session-connect path)]
    (if (< fd 0)
        (if (= (os/errno) ENOENT) (: 0 i32) (: -1 i32))
        (let [result
                (session-send fd (p/cast u32 JIM-KILL) (p/cast (ptr i8) 0) 0)]
          ; Stay connected until the service has read this, or it can't tell who sent
          ; it. A stuck service never will, so this only waits so long.
          (session-readable fd (: 1000 i32))
          (close fd)
          result))))

;;; Whether anything answers at PATH. Only for services that tolerate a connection
;;; that sends nothing: an original Jim daemon would drop its attached client.
(defn session-running? [(path (ptr i8))] (-> bool)
  (let [fd (session-connect path)]
    (if (>= fd 0) (do (close fd) true) false)))

;;; Attach to the service at PATH if one is running, without starting one.
(defn session-attach [(path (ptr i8))] (-> i32)
  (let [fd (session-connect path)]
    (if (>= fd 0) (attach fd) fd)))

;;; The original daemon's Kill message: a big-endian length and bincode variant 4.
(defn original-kill [(path (ptr i8))] (-> i32)
  (let [fd (session-connect path)]
    (if (< fd 0)
        (if (or (= (os/errno) ENOENT) (= (os/errno) ECONNREFUSED))
            (: 0 i32)
            (: -1 i32))
        (let [(mut frame) (: (zeroed (array i8 5)) (array i8 5))
              bytes (p/cast (ptr i8) (mut frame))]
          (put-byte! bytes 3 (: 1 u8))
          (put-byte! bytes 4 (: 4 u8))
          (let [result (transfer fd bytes 5 true)]
            (close fd)
            result)))))

(defn session-shutdown [(fd i32)] (-> void)
  (shutdown fd SHUT-RDWR))

(defn session-close [(fd i32)] (-> void)
  (close fd))

(export-c [session-send :as "jim_session_send"]
          [session-receive :as "jim_session_receive"]
          [session-open :as "jim_session_open"]
          [session-kill :as "jim_session_kill"]
          [session-shutdown :as "jim_session_shutdown"]
          [session-close :as "jim_session_close"]
          [session-log-client :as "jim_session_log_client"]
          [session-readable :as "jim_session_readable"])
