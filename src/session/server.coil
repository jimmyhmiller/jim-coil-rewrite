(import "coil.cc" :as cc)
(import "jim.session.transport" :as transport)
(import "coil.alloc" :as alloc)
(import "coil.os" :as os)
(import "coil.primitive" :as p)
(import "coil.math" :use [min])

(const FRAME-CAPACITY 65548)

(const INPUT-CAPACITY 4194304)

(const PATH-CAPACITY 1024)

(const AF-UNIX 1)

(const SOCK-STREAM 1)

(const SOL-SOCKET 65535)

(const SO-RCVTIMEO 4102)

(const SO-NOSIGPIPE 4130)

(const F-GETFL 3)

(const F-SETFL 4)

(const F-SETFD 2)

(const F-DUPFD-CLOEXEC 67)

(const FD-CLOEXEC 1)

(const O-RDWR 2)

(const O-NONBLOCK 4)

(const O-CREAT 512)

(const O-NOFOLLOW 256)

(const LOCK-EX 2)

(const LOCK-NB 4)

(const POLLIN 1)

(const POLLOUT 4)

(const POLLERR 8)

(const POLLHUP 16)

(const EINTR 4)

(const EAGAIN 35)

(const ECHILD 10)

(const EIO 5)

(const SIGHUP 1)

(const SIGKILL 9)

(const SIGPIPE 13)

(const WNOHANG 1)

(const TIOCSWINSZ 2148037735)

(const PROC-PIDVNODEPATHINFO 9)

;;; GHOSTTY_TERMINAL_OPT_SCROLLBACK_MAX_LINES: how many lines of history a
;;; session's terminal keeps.
(const SCROLLBACK-MAX-LINES 28)

;;; GHOSTTY_TERMINAL_DATA_KITTY_KEYBOARD_FLAGS and GHOSTTY_TERMINAL_DATA_MODE.
(const DATA-KITTY-FLAGS 8)

(const DATA-MODE 37)

;;; ---- bounded history ------------------------------------------------------------
;;; A session keeps the newest 64 MiB of its output, as original Jim's daemons do.
;;; Older frames leave the front of the journal in steps, so a busy terminal does
;;; not hand memory back for every read.
(const HISTORY-LIMIT 67108864)

(const TRIM-STEP 1048576)

;;; A client this far behind has stopped reading. It loses its connection rather
;;; than holding the journal's memory.
(const STALLED-CLIENT-LIMIT 268435456)

;;; The journal is a ring in memory, so a full disk can't touch a terminal. This much
;;; address space is reserved, and only what holds history is ever resident: the
;;; stalled limit, the newest history, and more than one loop can append.
(const JOURNAL-CAPACITY 335544320)

(const PROT-READ-WRITE 3)

(const MAP-PRIVATE-ANON 4098)

(const MAP-FIXED-PRIVATE-ANON 4114)

;;; ---- original Jim's daemon ------------------------------------------------------
;;; Frames are a big-endian u32 length and a bincode message with standard config:
;;; variable-length integers and enum variants numbered from zero.
(const UPSTREAM-RX-CAPACITY 131072)

(const UPSTREAM-INPUT-CHUNK 65000)

(const MESSAGE-ATTACH 0)

(const MESSAGE-INPUT 1)

(const MESSAGE-RESIZE 2)

(const MESSAGE-KILL 4)

(const MESSAGE-ATTACHED 0)

(const MESSAGE-OUTPUT 1)

(const MESSAGE-REPLAY-START 2)

(const MESSAGE-REPLAY-END 3)

(const MESSAGE-CHILD-EXITED 4)

;;; How far adoption has come. Clients wait until the daemon's history is journaled
;;; so that all of it reaches them as replay rather than as live output.
(const PHASE-CONNECTING 0)

(const PHASE-ATTACHED 1)

(const PHASE-REPLAYING 2)

(const PHASE-LIVE 3)

;;; Poll ticks of silence from the daemon before adoption gives up.
(const UPSTREAM-PATIENCE 25)

(const NO-EXIT -1)

(const SOL-LOCAL 0)

(const LOCAL-PEERPID 2)

(const SO-SNDTIMEO 4101)

(const O-NOCTTY 131072)

(const S-IFCHR 8192)

(const PROC-PIDTBSDINFO 3)

(const BSDINFO-SIZE 136)

(const BSDINFO-TDEV 108)

(const BSDINFO-TPGID 112)

(const TIOCGWINSZ 1074295912)

(defstruct SockaddrUn [(length u8) (family u8) (path (array i8 104))])

(defstruct PollFd [(fd i32) (events i16) (revents i16)])

(defstruct Timeval [(seconds i64) (microseconds i32) (padding i32)])

(defstruct Timespec [(seconds i64) (nanoseconds i64)])

(defstruct Winsize [(rows u16) (cols u16) (width u16) (height u16)])

(defstruct ModeQuery [(mode u16) (value bool)])

(defstruct Passwd
  [(name (ptr i8))
   (password (ptr i8))
   (uid u32)
   (gid u32)
   (change i64)
   (class (ptr i8))
   (gecos (ptr i8))
   (directory (ptr i8))
   (shell (ptr i8))
   (expire i64)])

(defstruct GhosttyColor [(r u8) (g u8) (b u8)])

(defstruct GhosttyPrimary
  [(conformance u16) (features (array u16 64)) (count u64)])

(defstruct GhosttySecondary
  [(device-type u16) (firmware-version u16) (rom-cartridge u16)])

(defstruct GhosttyTertiary [(unit-id u32)])

(defstruct GhosttyAttributes
  [(primary GhosttyPrimary)
   (secondary GhosttySecondary)
   (tertiary GhosttyTertiary)])

;;; Darwin's struct sigaction.
(defstruct Sigaction [(handler (ptr i8)) (mask u32) (flags i32)])

(static-assert (= (sizeof Sigaction) 16) "Darwin sigaction ABI size")

(defstruct Session
  [(pty i32)
   (client i32)
   (journal (ptr i8))
   (child i32)
   (end i64)
   (cursor i64)
   (replay-end i64)
   (tx (array i8 65548))
   (rx (array i8 65548))
   (input (array i8 4194304))
   (tx-len i64)
   (tx-at i64)
   (rx-len i64)
   (input-len i64)
   (input-at i64)
   (ready bool)
   (exited bool)
   (failed bool)
   (stopping bool)
   (terminal (ptr i8))
   (color-scheme i32)
   (cwd (array i8 1024))
   (start i64)
   (punched i64)
   (base-size (array i8 8))
   (base-directory (array i8 3136))
   (base-directory-length i64)
   (base-owed i64)
   (modes-owed bool)
   (initial-cols u16)
   (initial-rows u16)
   (upstream bool)
   (phase i64)
   (patience i64)
   (upstream-exit i64)
   (upstream-rx (array i8 131072))
   (upstream-rx-len i64)
   (upstream-tx (array i8 65600))
   (upstream-tx-len i64)
   (upstream-tx-at i64)
   (size-owed bool)
   (owed-cols u16)
   (owed-rows u16)])

(static-assert (= (sizeof SockaddrUn) 106) "Darwin sockaddr_un ABI size")

(static-assert (= (sizeof PollFd) 8) "Darwin pollfd ABI size")

(static-assert (= (sizeof Winsize) 8) "Darwin winsize ABI size")

(static-assert (= (sizeof GhosttyColor) 3) "Ghostty RGB ABI size")

(static-assert (= (sizeof ModeQuery) 4) "GhosttyTerminalModeConfig ABI size")

