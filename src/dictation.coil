(module jim.dictation)
(import "coil.cc" :as cc)
(import "coil.primitive" :as p)
(import "jim.native" :use *)
(import "jim.ghostty" :as g)
(import "jim.dictation-core" :as core)
(import "jim.session.transport" :as transport)

;;; Hands-free dictation, as in original Jim. ⌘⇧T starts it and Escape or ⌘⇧T stops it.
;;; Words appear in what has the keyboard while you speak, and settle as the engine gets
;;; more context. Return ends it, and is passed on once the last words have landed. The
;;; target is chosen when dictation starts.
;;;
;;; Anything else that takes text here is AppKit's: the palette, a project being renamed,
;;; a widget's input or text area. Each write checks the text it is replacing is still
;;; what it wrote, and stops writing if it isn't, so an edit is never overwritten. It also
;;; stops if the target loses the keyboard, as there's a shared field editor to mistake.
;;;
;;; A terminal is a byte stream and a paste can't be unsent, so a revision is DEL × n
;;; then the new text, which only means "delete what we wrote" to a line editor. It is
;;; sent only while the child passes `ghostty_surface_revisable`. A child that fails
;;; never gets a preview: its transcript stays on the pill and lands as one paste at the
;;; end. Typing during dictation ends it, since DELs would then delete what was typed.

(extern pthread_create
        :cc
        (cc/C)
        [(ptr u64) (ptr i8) (ptr i8) (ptr i8)]
        (-> i32))

(extern pthread_detach :cc (cc/C) [u64] (-> i32))

(extern pthread_mutex_init :cc (cc/C) [(ptr i8) (ptr i8)] (-> i32))

(extern pthread_mutex_lock :cc (cc/C) [(ptr i8)] (-> i32))

(extern pthread_mutex_unlock :cc (cc/C) [(ptr i8)] (-> i32))

(extern usleep :cc (cc/C) [u32] (-> i32))

(extern free :cc (cc/C) [(ptr i8)] (-> void))

(extern strlen :cc (cc/C) [(ptr i8)] (-> u64))

(extern strdup :cc (cc/C) [(ptr i8)] (-> (ptr i8)))

(extern malloc :cc (cc/C) [u64] (-> (ptr i8)))

(extern snprintf :cc (cc/C) [(ptr i8) u64 (ptr i8) ...] (-> i32))

(extern memcpy :cc (cc/C) [(ptr i8) (ptr i8) u64] (-> (ptr i8)))

(defstruct AudioFormat
  [(sample-rate f64)
   (format-id u32)
   (flags u32)
   (bytes-per-packet u32)
   (frames-per-packet u32)
   (bytes-per-frame u32)
   (channels u32)
   (bits u32)
   (reserved u32)])

(static-assert (= (sizeof AudioFormat) 40)
               "AudioStreamBasicDescription ABI size")

(extern AudioQueueNewInput
        :cc
        (cc/C)
        [(ptr AudioFormat)
         (ptr i8)
         (ptr i8)
         (ptr i8)
         (ptr i8)
         u32
         (ptr (ptr i8))]
        (-> i32))

(extern AudioQueueAllocateBuffer
        :cc
        (cc/C)
        [(ptr i8) u32 (ptr (ptr i8))]
        (-> i32))

(extern AudioQueueEnqueueBuffer
        :cc
        (cc/C)
        [(ptr i8) (ptr i8) u32 (ptr i8)]
        (-> i32))

(extern AudioQueueStart :cc (cc/C) [(ptr i8) (ptr i8)] (-> i32))

(extern AudioQueueStop :cc (cc/C) [(ptr i8) u8] (-> i32))

(extern AudioQueueDispose :cc (cc/C) [(ptr i8) u8] (-> i32))

(const LINEAR-PCM 1819304813)

;;; kAudioFormatFlagIsFloat | kAudioFormatFlagIsPacked
(const FLOAT-PACKED 9)

;;; 50 ms of 32-bit samples, which is also how often the meter moves.
(const BUFFER-BYTES 3200)

;;; AudioQueueBuffer: mAudioData at 8, mAudioDataByteSize at 16.
(const BUFFER-DATA-OFFSET 8)

(const BUFFER-SIZE-OFFSET 16)

(const ERROR-SECONDS 5.0)

;;; Which way a long line on the pill loses its overflow. A transcript's end is the part
;;; to see, and a message's start.
(const CUT-HEAD 3)

(const CUT-TAIL 4)

(const PILL-WIDTH 420.0)

(const PILL-HEIGHT 30.0)

;;; The pill while it has a meter under its text.
(const PILL-METER-HEIGHT 42.0)

(const METER-WIDTH 392.0)

(const METER-HEIGHT 4.0)

(const PILL-TOP 64.0)

(const IDLE 0)

(const LISTENING 1)

(const FINISHING 2)

;;; ---- shared with the audio and worker threads, under the mutex ---------------------

(defstruct Shared
  [(mutex (array i8 64))
   (pending core/Samples)
   (stop bool)
   (done bool)
   (failed bool)
   (text (ptr i8))
   (fresh bool)
   (capturing bool)
   (level f32)
   (install-done bool)
   (install-ok bool)])

(defn shared [] (-> (ptr Shared))
  (p/alloc-static Shared))

(defn lock! [] (-> i64)
  (pthread_mutex_lock (p/cast (ptr i8) (field (shared) mutex)))
  0)

(defn unlock! [] (-> i64)
  (pthread_mutex_unlock (p/cast (ptr i8) (field (shared) mutex)))
  0)

;;; The audio queue's thread. Under the mutex, because the worker drains PENDING.
(defn on-audio [(user (ptr i8))
                (queue (ptr i8))
                (buffer (ptr i8))
                (time (ptr i8))
                (packets u32)
                (description (ptr i8))] (-> void)
  (let [data (load (p/cast (ptr (ptr f32)) (index buffer BUFFER-DATA-OFFSET)))
        bytes (load (p/cast (ptr u32) (index buffer BUFFER-SIZE-OFFSET)))
        s (shared)]
    (lock!)
    (core/samples-push! (field s pending)
                        data
                        (/ (p/cast i64 bytes) 4))
    (set! (.level s) (core/level-of data (/ (p/cast i64 bytes) 4)))
    (let [capturing (.capturing s)]
      (unlock!)
      (when capturing
        (AudioQueueEnqueueBuffer queue buffer (: 0 u32) (p/cast (ptr i8) 0))
        0))
    (do)))

(export-c [on-audio :as "jim_dictation_on_audio"])

;;; Publish TEXT, which the main thread then owns, in place of any it hasn't taken.
(defn publish! [(text (ptr i8))] (-> i64)
  (let [s (shared)]
    (lock!)
    (when (!= (p/cast i64 (.text s)) 0) (free (.text s)) (do))
    (set! (.text s) text)
    (set! (.fresh s) true)
    (unlock!)
    0))

(defn finish-worker! [(failed bool)] (-> i64)
  (let [s (shared)]
    (lock!)
    (set! (.failed s) failed)
    (set! (.done s) true)
    (unlock!)
    0))

;;; Move what's been captured into the session. Whether to stop comes back with it, read
;;; under the same lock, so a stop means all the captured audio has been taken.
(defn drain! [(session (ptr core/Session))] (-> bool)
  (let [s (shared)
        pending (field s pending)]
    (lock!)
    (let [stop (.stop s)
          taken (load pending)]
      (set! pending (zeroed core/Samples))
      (unlock!)
      (when (> (.len taken) 0)
        (core/session-push! session (.data taken) (.len taken))
        0)
      (free (p/cast (ptr i8) (.data taken)))
      stop)))

(defn worker-main [(argument (ptr i8))] (-> (ptr i8))
  (let [(mut session) (zeroed core/Session)
        state (p/cast (ptr core/Session) (mut session))]
    (core/session-init! state)
    (block
      :done
        (loop (if (drain! state)
                  (let [ok (core/session-finish! state)]
                    (when ok (publish! (core/session-text state)) 0)
                    (finish-worker! (not ok))
                    (return-from :done 0))
                  (let [step (core/session-step! state)]
                    (cond (< step 0)
                            (do (finish-worker! true) (return-from :done 0))
                          (> step 0) (publish! (core/session-text state))
                          :else 0)
                    (usleep (: 30000 u32))))))
    (core/session-free! state)
    (p/cast (ptr i8) 0)))

(export-c [worker-main :as "jim_dictation_worker"])

;;; The install's own thread. It reports on the pill when it's done.
(defn installer-main [(argument (ptr i8))] (-> (ptr i8))
  (let [ok (core/install-phonon!)
        s (shared)]
    (lock!)
    (set! (.install-ok s) ok)
    (set! (.install-done s) true)
    (unlock!)
    (p/cast (ptr i8) 0)))

(export-c [installer-main :as "jim_dictation_installer"])

;;; ---- the main thread -----------------------------------------------------------------

(defstruct State
  [(phase i64)
   (target (ptr i8))
   (editor (ptr i8))
   (client (ptr i8))
   (at u64)
   (replay-return bool)
   (submit bool)
   (installing bool)
   (detached bool)
   (inserted (ptr i8))
   (preview (ptr i8))
   (in-place bool)
   (queue (ptr i8))
   (pill (ptr i8))
   (label (ptr i8))
   (meter (ptr i8))
   (fill (ptr i8))
   (message-until f64)
   (mutex-ready bool)])

(defn state [] (-> (ptr State))
  (p/alloc-static State))

(defn listening? [] (-> bool)
  (= (.phase (state)) LISTENING))

(defn active? [] (-> bool)
  (!= (.phase (state)) IDLE))

;;; The session being dictated into, so the caller can find its surface again: a pane
;;; can reconnect or close while dictation runs.
(defn target [] (-> (ptr i8))
  (.target (state)))

(defn replace-string! [(cell (ptr (ptr i8))) (value (ptr i8))] (-> i64)
  (when (!= (p/cast i64 (load cell)) 0) (free (load cell)) (do))
  (set! cell value)
  0)

;;; ---- the pill -------------------------------------------------------------------------

(defn ensure-pill! [(root (ptr i8))] (-> i64)
  (let [s (state)]
    (when (= (p/cast i64 (.pill s)) 0)
      (let [pill (view root (rect 0.0 0.0 PILL-WIDTH PILL-HEIGHT))]
        (msg i64 (layer pill) (sel c"setCornerRadius:") [f64] 15.0)
        (msg i64 (layer pill) (sel c"setBorderWidth:") [f64] 1.0)
        (msg i64
             (layer pill)
             (sel c"setBorderColor:")
             [(ptr i8)]
             (msg (ptr i8) (color 0.25 0.33 0.42 1.0) (sel c"CGColor") []))
        (msg i64
             (layer pill)
             (sel c"setBackgroundColor:")
             [(ptr i8)]
             (msg (ptr i8) (color 0.08 0.10 0.13 0.96) (sel c"CGColor") []))
        (set! (.pill s) pill)
        (set! (.label s)
              (label pill
                     c""
                     (rect 14.0 6.0 (- PILL-WIDTH 28.0) 18.0)
                     12.0
                     false))
        (set! (.meter s)
              (view pill (rect 14.0 8.0 METER-WIDTH METER-HEIGHT)))
        (msg i64 (layer (.meter s)) (sel c"setCornerRadius:") [f64] 2.0)
        (background! (.meter s) 0.17 0.21 0.27)
        (set! (.fill s) (view (.meter s) (rect 0.0 0.0 2.0 METER-HEIGHT)))
        (msg i64 (layer (.fill s)) (sel c"setCornerRadius:") [f64] 2.0)
        (background! (.fill s) 0.45 0.72 1.0)
        (msg i64 pill (sel c"setHidden:") [i8] (: 1 i8))
        0))
    0))

;;; Show LEVEL, from 0 to 1, on the meter.
(defn meter! [(level f32)] (-> i64)
  (let [s (state)
        width (* (p/cast f64 level) METER-WIDTH)]
    (when (!= (p/cast i64 (.fill s)) 0)
      (frame! (.fill s)
              (rect 0.0 0.0 (if (< width 2.0) 2.0 width) METER-HEIGHT))
      0)
    0))

(defn pill-text! [(root (ptr i8)) (text (ptr i8)) (cut i64) (metered bool)]
  (-> i64)
  (let [s (state)
        bounds (msg Rect root (sel c"bounds") [])
        flipped (!= (msg i8 root (sel c"isFlipped") []) (: 0 i8))
        height (if metered PILL-METER-HEIGHT PILL-HEIGHT)]
    (ensure-pill! root)
    (frame! (.pill s)
            (rect (/ (- (.w bounds) PILL-WIDTH) 2.0)
                  (if flipped PILL-TOP (- (.h bounds) (+ PILL-TOP height)))
                  PILL-WIDTH
                  height))
    (frame! (.label s)
            (rect 14.0 (- height 24.0) (- PILL-WIDTH 28.0) 18.0))
    (msg i64
         (.meter s)
         (sel c"setHidden:")
         [i8]
         (if metered (: 0 i8) (: 1 i8)))
    (msg i64 (.label s) (sel c"setLineBreakMode:") [u64] (p/cast u64 cut))
    (msg i64 (.label s) (sel c"setStringValue:") [(ptr i8)] (ns text))
    (msg i64
         root
         (sel c"addSubview:positioned:relativeTo:")
         [(ptr i8) i64 (ptr i8)]
         (.pill s)
         1
         (nil))
    (msg i64 (.pill s) (sel c"setHidden:") [i8] (: 0 i8))
    0))

(defn pill-hide! [] (-> i64)
  (let [pill (.pill (state))]
    (when (!= (p/cast i64 pill) 0)
      (msg i64 pill (sel c"setHidden:") [i8] (: 1 i8))
      0)
    0))

(defn listening-text! [(root (ptr i8))] (-> i64)
  (let [s (state)
        (mut line) (zeroed (array i8 300))
        out (p/cast (ptr i8) (mut line))
        preview (.preview s)]
    (snprintf out
              (: 300 u64)
              (cond (= (.phase s) FINISHING) c"Finishing… %s"
                    (.detached s) c"Stopped writing · %s"
                    :else c"● Listening · Esc to stop  %s")
              (if (= (p/cast i64 preview) 0)
                  c""
                  (index preview (core/tail-start preview 56))))
    (pill-text! root out CUT-HEAD (= (.phase s) LISTENING))
    0))

;;; ---- writing to AppKit's text ----------------------------------------------------------

;;; What in WINDOW has the keyboard and takes text, or nil. A text field's is the shared
;;; field editor, as AppKit edits every field through one.
(defn focused-text [(window (ptr i8))] (-> (ptr i8))
  (let [responder
          (if (= (p/cast i64 window) 0)
              (nil)
              (msg (ptr i8) window (sel c"firstResponder") []))]
    (if (and (!= (p/cast i64 responder) 0)
             (!= (msg i8
                      responder
                      (sel c"isKindOfClass:")
                      [(ptr i8)]
                      (class c"NSTextView"))
                 (: 0 i8))
             (!= (msg i8 responder (sel c"isEditable") []) (: 0 i8)))
        responder
        (nil))))

;;; What EDITOR is editing: the field, for a field editor, otherwise itself.
(defn client-of [(editor (ptr i8))] (-> (ptr i8))
  (if (!= (msg i8 editor (sel c"isFieldEditor") []) (: 0 i8))
      (msg (ptr i8) editor (sel c"delegate") [])
      editor))

;;; Whether the target still has the keyboard. The field editor moving on to another
;;; field looks like nothing happened, unless what it's editing is checked too.
(defn editing-target? [] (-> bool)
  (let [s (state)
        editor (.editor s)
        window (msg (ptr i8) editor (sel c"window") [])]
    (and (= (p/cast i64 (focused-text window)) (p/cast i64 editor))
         (= (p/cast i64 (client-of editor)) (p/cast i64 (.client s))))))

;;; Replace the characters at AT in EDITOR, if they are still PREVIOUS, with TEXT. True
;;; if they were. Going through the text input system tells whoever is listening, so the
;;; palette filters and a widget hears the change, and leaves the caret after the text.
(defn revise-text! [(editor (ptr i8))
                    (at u64)
                    (previous (ptr i8))
                    (text (ptr i8))] (-> bool)
  (let [before (ns previous)
        length (msg u64 before (sel c"length") [])
        whole (msg (ptr i8) editor (sel c"string") [])
        span (Range :location at :length length)]
    (if (or (> (+ at length) (msg u64 whole (sel c"length") []))
            (= (msg i8
                    (msg (ptr i8)
                         whole
                         (sel c"substringWithRange:")
                         [Range]
                         span)
                    (sel c"isEqualToString:")
                    [(ptr i8)]
                    before)
               (: 0 i8)))
        false
        (do
          (msg i64
               editor
               (sel c"insertText:replacementRange:")
               [(ptr i8) Range]
               (ns text)
               span)
          true))))

(defn stop-writing! [(reason (ptr i8))] (-> i64)
  (set! (.detached (state)) true)
  (transport/log! c"dictation stopped-writing reason=%s"
                  (p/cast i64 reason)
                  0
                  0
                  0)
  0)

(defn write-editor! [(flat (ptr i8))] (-> i64)
  (let [s (state)]
    (cond (.detached s) 0
          (= (strlen flat) (: 0 u64)) 0
          (not (editing-target?)) (stop-writing! c"target-lost-the-keyboard")
          (revise-text! (.editor s) (.at s) (.inserted s) flat)
            (replace-string! (field s inserted) (strdup flat))
          :else (stop-writing! c"target-was-edited"))
    0))

;;; ---- writing to the terminal -------------------------------------------------------

(defn send-deletes! [(surface (ptr i8)) (count i64)] (-> i64)
  (when (> count 0)
    (let [size (+ 6 (* 4 count))
          action (malloc (p/cast u64 (+ size 1)))]
      (memcpy action c"text:" (: 5 u64))
      (for [i 0 count]
        (memcpy (index action (+ 5 (* i 4))) c"\\x7f" (: 4 u64)))
      (set! (index action (+ 5 (* count 4))) (: 0 i8))
      (g/ghostty_surface_binding_action surface
                                        action
                                        (p/cast u64 (+ 5 (* count 4))))
      (free action)
      0))
  0)

;;; Make the text at the prompt read TEXT, retyping only what differs from what's there.
(defn write-text! [(surface (ptr i8)) (text (ptr i8)) (final bool)] (-> i64)
  (let [s (state)
        flat (core/flatten-text text)
        inserted (.inserted s)
        had-text (!= (p/cast i64 inserted) 0)]
    (replace-string! (field s preview) (core/flatten-text flat))
    (let [revisable
            (and (!= (p/cast i64 surface) 0)
                 (g/ghostty_surface_revisable surface))]
      (cond (.detached s) 0
            (!= (p/cast i64 (.editor s)) 0) (write-editor! flat)
            (= (p/cast i64 surface) 0)
              (do
                (set! (.detached s) true)
                (transport/log! c"dictation target-gone" 0 0 0 0)
                0)
            (and had-text (not revisable))
              (do
                (set! (.detached s) true)
                (transport/log! c"dictation target-started-full-screen-program"
                                0
                                0
                                0
                                0)
                0)
            (and (not final) (not revisable)) 0
            :else
              (let [shared-bytes
                      (if had-text (core/common-prefix inserted flat) 0)
                    deletes
                      (if had-text
                          (core/char-count (index inserted shared-bytes))
                          0)
                    rest (index flat shared-bytes)
                    rest-size (strlen rest)]
                (send-deletes! surface deletes)
                (when (> rest-size (: 0 u64))
                  (g/ghostty_surface_text surface rest rest-size)
                  0)
                (replace-string! (field s inserted) (core/flatten-text flat))
                0)))
    (free flat)
    0))

;;; ---- starting and stopping ---------------------------------------------------------

(defn microphone-denied? [] (-> bool)
  (let [status
          (msg i64
               (class c"AVCaptureDevice")
               (sel c"authorizationStatusForMediaType:")
               [(ptr i8)]
               (ns c"soun"))]
    (or (= status 1) (= status 2))))

(defn start-capture! [] (-> bool)
  (let [s (state)
        (mut format)
          (: (AudioFormat
               :sample-rate 16000.0
               :format-id (p/cast u32 LINEAR-PCM)
               :flags (p/cast u32 FLOAT-PACKED)
               :bytes-per-packet (: 4 u32)
               :frames-per-packet (: 1 u32)
               :bytes-per-frame (: 4 u32)
               :channels (: 1 u32)
               :bits (: 32 u32)
               :reserved (: 0 u32))
             AudioFormat)
        (mut queue) (zeroed (ptr i8))]
    (if (!= (AudioQueueNewInput (mut format)
                                (p/cast (ptr i8) (fnptr-of on-audio))
                                (p/cast (ptr i8) 0)
                                (p/cast (ptr i8) 0)
                                (p/cast (ptr i8) 0)
                                (: 0 u32)
                                (mut queue))
            (: 0 i32))
        false
        (do
          (set! (.capturing (shared)) true)
          (for [i 0 4]
            (let [(mut buffer) (zeroed (ptr i8))]
              (AudioQueueAllocateBuffer (load queue)
                                        (p/cast u32 BUFFER-BYTES)
                                        (mut buffer))
              (AudioQueueEnqueueBuffer (load queue)
                                       (load buffer)
                                       (: 0 u32)
                                       (p/cast (ptr i8) 0))))
          (if (!= (AudioQueueStart (load queue) (p/cast (ptr i8) 0)) (: 0 i32))
              (do
                (set! (.capturing (shared)) false)
                (AudioQueueDispose (load queue) (: 1 u8))
                false)
              (do (set! (.queue s) (load queue)) true))))))

(defn stop-capture! [] (-> i64)
  (let [s (state)]
    (when (!= (p/cast i64 (.queue s)) 0)
      ; Synchronous, so the last callbacks' audio is in before the worker's final drain.
      (AudioQueueStop (.queue s) (: 1 u8))
      (lock!)
      (set! (.capturing (shared)) false)
      (unlock!)
      (AudioQueueDispose (.queue s) (: 1 u8))
      (set! (.queue s) (p/cast (ptr i8) 0))
      0)
    0))

(defn show-message! [(root (ptr i8)) (text (ptr i8)) (now f64)] (-> i64)
  (pill-text! root text CUT-TAIL false)
  (set! (.message-until (state)) (+ now ERROR-SECONDS))
  (transport/log! c"dictation message=%s" (p/cast i64 text) 0 0 0)
  0)

;;; Install Phonon in the background, and say so. It takes minutes, so nothing waits on
;;; it: the pill says when to try again.
(defn begin-install! [(root (ptr i8)) (now f64)] (-> i64)
  (let [s (state)
        (mut thread) (zeroed u64)]
    (when (not (.installing s))
      (lock!)
      (set! (.install-done (shared)) false)
      (unlock!)
      (if (= (pthread_create (mut thread)
                             (p/cast (ptr i8) 0)
                             (p/cast (ptr i8) (fnptr-of installer-main))
                             (p/cast (ptr i8) 0))
             (: 0 i32))
          (do
            (pthread_detach (load thread))
            (set! (.installing s) true)
            (transport/log! c"dictation install-started" 0 0 0 0)
            0)
          (core/set-error! c"Couldn't start the Phonon install.")))
    (show-message! root
                   (if (.installing s)
                       c"Installing Phonon (first use, a minute or two). Try again when it says it's ready."
                       (core/last-error))
                   now)))

;;; Point the session at EDITOR, which has the keyboard. Text goes where the caret is, and
;;; replaces a selection as typing would, so what's selected is what's to be replaced.
(defn target-text! [(editor (ptr i8)) (replay-return bool)] (-> i64)
  (let [s (state)
        selection (msg Range editor (sel c"selectedRange") [])]
    (set! (.editor s) (msg (ptr i8) editor (sel c"retain") []))
    (set! (.client s) (msg (ptr i8) (client-of editor) (sel c"retain") []))
    (set! (.at s) (.location selection))
    (set! (.replay-return s) replay-return)
    (replace-string! (field s inserted)
                     (strdup (utf8 (msg (ptr i8)
                                        (msg (ptr i8) editor (sel c"string") [])
                                        (sel c"substringWithRange:")
                                        [Range]
                                        selection))))
    0))

;;; Dictate into what has the keyboard in ROOT's window until told to stop: its text if
;;; any, otherwise session ID. Return is passed on at the end unless IN-PALETTE, where it
;;; would run whichever action the words happened to leave selected.
(defn start! [(root (ptr i8)) (id (ptr i8)) (in-palette bool) (now f64)]
  (-> i64)
  (let [s (state)
        t (shared)
        editor (focused-text (msg (ptr i8) root (sel c"window") []))]
    (when (not (.mutex-ready s))
      (pthread_mutex_init (p/cast (ptr i8) (field t mutex)) (p/cast (ptr i8) 0))
      (set! (.mutex-ready s) true)
      0)
    (cond (and (= (p/cast i64 editor) 0) (= (p/cast i64 id) 0))
            (show-message! root c"Nothing focused to dictate into." now)
          (microphone-denied?)
            (show-message! root
                           c"Microphone access is off for Jim Coil. See System Settings → Privacy."
                           now)
          (not (core/installed?)) (begin-install! root now)
          :else
            (do
              (set! (.stop t) false)
              (set! (.done t) false)
              (set! (.failed t) false)
              (set! (.fresh t) false)
              (if (not (start-capture!))
                  (show-message! root c"Couldn't open the microphone." now)
                  (let [(mut thread) (zeroed u64)
                        failed
                          (pthread_create (mut thread)
                                          (p/cast (ptr i8) 0)
                                          (p/cast (ptr i8)
                                                  (fnptr-of worker-main))
                                          (p/cast (ptr i8) 0))]
                    (if (!= failed (: 0 i32))
                        (do
                          (stop-capture!)
                          (show-message! root c"Couldn't start dictation." now))
                        (do
                          (pthread_detach (load thread))
                          (set! (.phase s) LISTENING)
                          (set! (.detached s) false)
                          (set! (.submit s) false)
                          (set! (.message-until s) 0.0)
                          (replace-string! (field s inserted)
                                           (p/cast (ptr i8) 0))
                          (replace-string! (field s preview)
                                           (p/cast (ptr i8) 0))
                          (if (!= (p/cast i64 editor) 0)
                              (do
                                (target-text! editor (not in-palette))
                                (transport/log! c"dictation start text" 0 0 0 0))
                              (do
                                (set! (.target s)
                                      (msg (ptr i8) id (sel c"retain") []))
                                (transport/log! c"dictation start id=%s"
                                                (p/cast i64 (utf8 id))
                                                0
                                                0
                                                0)))
                          (meter! (: 0.0 f32))
                          (listening-text! root)
                          0))))))
    0))

;;; Stop listening. The last words still decode, and land when the worker finishes.
(defn stop! [] (-> i64)
  (let [s (state)]
    (when (listening?)
      (set! (.phase s) FINISHING)
      (stop-capture!)
      (lock!)
      (set! (.stop (shared)) true)
      (unlock!)
      0)
    0))

;;; Whether keys pressed now go to the target, rather than to the palette or a field the
;;; person has since moved to.
(defn keyboard-on-target? [(window (ptr i8))] (-> bool)
  (let [editor (.editor (state))
        text (focused-text window)]
    (= (p/cast i64 text) (p/cast i64 editor))))

;;; Whether a key pressed now would type over a terminal's transcript. A text target
;;; doesn't need this, as its writes check what they replace.
(defn typing-ends-it? [(window (ptr i8))] (-> bool)
  (and (active?)
       (= (p/cast i64 (.editor (state))) 0)
       (keyboard-on-target? window)))

;;; The user typed. DEL would now delete what they typed, so leave the text as it is.
(defn detach! [] (-> i64)
  (when (active?)
    (set! (.detached (state)) true)
    (stop!)
    (transport/log! c"dictation typing-ended-it" 0 0 0 0)
    0)
  0)

;;; Whether Return should wait for the transcript. It's what ends a dictation into
;;; something that submits, and the target would otherwise submit without the last words.
(defn holds-return? [(window (ptr i8))] (-> bool)
  (and (active?) (not (.detached (state))) (keyboard-on-target? window)))

(defn return! [] (-> i64)
  (set! (.submit (state)) true)
  (stop!))

;;; Return, now the transcript is in. To the target, wherever the keyboard has gone since.
(defn replay-return! [(surface (ptr i8))] (-> i64)
  (let [s (state)]
    (cond (!= (p/cast i64 (.editor s)) 0)
            (when (and (.replay-return s) (editing-target?))
              (msg i64
                   (.editor s)
                   (sel c"doCommandBySelector:")
                   [(ptr i8)]
                   (sel c"insertNewline:"))
              0)
          (!= (p/cast i64 surface) 0)
            (do
              (g/ghostty_surface_binding_action surface
                                                c"text:\\x0d"
                                                (: 9 u64))
              0)
          :else 0)
    0))

(defn toggle! [(root (ptr i8)) (id (ptr i8)) (in-palette bool) (now f64)]
  (-> i64)
  (cond (listening?) (stop!)
        (active?) 0
        :else (start! root id in-palette now)))

(defn end-session! [] (-> i64)
  (let [s (state)]
    (set! (.phase s) IDLE)
    (release (.target s))
    (set! (.target s) (p/cast (ptr i8) 0))
    (release (.editor s))
    (set! (.editor s) (p/cast (ptr i8) 0))
    (release (.client s))
    (set! (.client s) (p/cast (ptr i8) 0))
    (replace-string! (field s inserted) (p/cast (ptr i8) 0))
    (replace-string! (field s preview) (p/cast (ptr i8) 0))
    0))

;;; Run from the app's main loop. SURFACE is the target session's, or nil if it's gone.
(defn pump! [(root (ptr i8)) (surface (ptr i8)) (now f64)] (-> i64)
  (let [s (state)
        t (shared)]
    (when (and (= (.phase s) IDLE)
               (> (.message-until s) 0.0)
               (> now (.message-until s)))
      (set! (.message-until s) 0.0)
      (pill-hide!)
      0)
    (when (.installing s)
      (lock!)
      (let [done (.install-done t)
            ok (.install-ok t)]
        (unlock!)
        (when done
          (set! (.installing s) false)
          (transport/log! c"dictation install-finished ok=%lld"
                          (if ok 1 0)
                          0
                          0
                          0)
          ; A dictation can't be running, as none starts until this reports.
          (show-message! root
                         (if ok
                             c"✓ Phonon is installed and ready."
                             (core/last-error))
                         now)
          0)))
    (when (active?)
      (lock!)
      (let [text (if (.fresh t) (.text t) (p/cast (ptr i8) 0))
            done (.done t)
            failed (.failed t)
            level (.level t)]
        (when (.fresh t)
          (set! (.text t) (p/cast (ptr i8) 0))
          (set! (.fresh t) false)
          0)
        (unlock!)
        (meter! level)
        (when (!= (p/cast i64 text) 0)
          (write-text! surface text done)
          (free text)
          (listening-text! root)
          0)
        (when done
          (let [nothing
                  (or (= (p/cast i64 (.preview s)) 0)
                      (= (strlen (.preview s)) (: 0 u64)))]
            (stop-capture!)
            (transport/log! c"dictation end failed=%lld detached=%lld nothing=%lld"
                            (if failed 1 0)
                            (if (.detached s) 1 0)
                            (if nothing 1 0)
                            0)
            (when (and (.submit s) (not failed) (not (.detached s)))
              (replay-return! surface)
              0)
            (cond failed (show-message! root (core/last-error) now)
                  nothing (show-message! root c"Heard nothing." now)
                  (and (= (p/cast i64 surface) 0)
                       (= (p/cast i64 (.editor s)) 0))
                    (show-message! root c"That terminal is gone." now)
                  :else (pill-hide!))
            (end-session!)
            0))
        0))
    0))
