(module jim.terminal)
(import "coil.cc" :as cc)
(import "jim.timings" :as timings)
(import "jim.native" :use *)
(import "jim.ghostty" :as g)
(import "jim.sessions" :as sessions)
(import "jim.image-original" :as original)
(import "coil.primitive" :as p)
(import "coil.alloc" :as alloc)
(import "coil.arraylist" :as al)

(defstruct Terminal
  [(view (ptr i8))
   (surface (ptr i8))
   (directory (ptr i8))
   (session-id (ptr i8))
   (original i64)
   (marked (ptr i8))
   (accum (ptr i8))
   (selection Range)
   (in-key bool)
   (closed bool)
   (picked g/ImageBox)
   (outline (ptr i8))
   (pick-timer (ptr i8))
   (preview-directory (ptr i8))
   (preview-url (ptr i8))
   (space-taken bool)])

(defn association-key [] (-> (ptr i8))
  (p/alloc-static i8))

(defn terminal [(view (ptr i8))] (-> (ptr Terminal))
  (p/cast (ptr Terminal) (objc_getAssociatedObject view (association-key))))

(defn app-cell [] (-> (ptr (ptr i8)))
  (p/alloc-static (ptr i8)))

(defn dispatcher-cell [] (-> (ptr (ptr i8)))
  (p/alloc-static (ptr i8)))

(defn mods [(event (ptr i8))] (-> i32)
  (let [m (msg u64 event (sel c"modifierFlags") [])]
    (p/cast i32
            (| (>> (& m 131072) 17)
               (>> (& m 262144) 17)
               (>> (& m 524288) 17)
               (>> (& m 1048576) 17)
               (>> (& m 65536) 12)))))

(defn string-value [(value (ptr i8))] (-> (ptr i8))
  (if (!= (msg i8
               value
               (sel c"isKindOfClass:")
               [(ptr i8)]
               (class c"NSAttributedString"))
          (: 0 i8))
      (msg (ptr i8) value (sel c"string") [])
      value))

(defn accepts [(self (ptr i8)) (cmd (ptr i8))] (-> i8)
  (: 1 i8))

(defn has-marked [(self (ptr i8)) (cmd (ptr i8))] (-> i8)
  (p/cast i8
          (if (> (msg u64 (.marked (terminal self)) (sel c"length") []) 0) 1 0)))

(defn marked-range [(self (ptr i8)) (cmd (ptr i8))] (-> Range)
  (let [n (msg u64 (.marked (terminal self)) (sel c"length") [])]
    (Range
      :location (if (> n 0) (: 0 u64) (: 9223372036854775807 u64))
      :length n)))

(defn selected-range [(self (ptr i8)) (cmd (ptr i8))] (-> Range)
  (.selection (terminal self)))

(defn unmark [(self (ptr i8)) (cmd (ptr i8))] (-> void)
  (do
    (msg i64 (.marked (terminal self)) (sel c"setString:") [(ptr i8)] (ns c""))
    (g/ghostty_surface_preedit (.surface (terminal self)) (nil) 0)))

(defn insert [(self (ptr i8))
              (cmd (ptr i8))
              (value (ptr i8))
              (replacement Range)] (-> void)
  (let [t (terminal self)
        s (string-value value)]
    (do
      (unmark self cmd)
      (if (.in-key t)
          (msg i64 (.accum t) (sel c"appendString:") [(ptr i8)] s)
          (let [bytes (utf8 s)]
            (g/ghostty_surface_text (.surface t) bytes (strlen bytes)))))))

(defn set-marked [(self (ptr i8))
                  (cmd (ptr i8))
                  (value (ptr i8))
                  (selected Range)
                  (replacement Range)] (-> void)
  (let [t (terminal self)
        s (string-value value)
        bytes (utf8 s)]
    (do
      (msg i64 (.marked t) (sel c"setString:") [(ptr i8)] s)
      (set! (.selection t) selected)
      (g/ghostty_surface_preedit (.surface t) bytes (strlen bytes)))))

(defn attributes [(self (ptr i8)) (cmd (ptr i8))] (-> (ptr i8))
  (msg (ptr i8) (class c"NSArray") (sel c"array") []))

(defn substring [(self (ptr i8))
                 (cmd (ptr i8))
                 (range Range)
                 (actual (ptr Range))] (-> (ptr i8))
  (let [s (.marked (terminal self))
        n (msg u64 s (sel c"length") [])]
    (if (and (<= (.location range) n)
             (<= (.length range) (- n (.location range))))
        (do
          (if (!= (p/cast i64 actual) 0) (set! actual range) 0)
          (msg (ptr i8)
               (msg (ptr i8)
                    (msg (ptr i8)
                         (class c"NSAttributedString")
                         (sel c"alloc")
                         [])
                    (sel c"initWithString:")
                    [(ptr i8)]
                    (msg (ptr i8) s (sel c"substringWithRange:") [Range] range))
               (sel c"autorelease")
               []))
        (nil))))

(defn character-index [(self (ptr i8)) (cmd (ptr i8)) (point Point)] (-> u64)
  0)

(defn first-rect [(self (ptr i8))
                  (cmd (ptr i8))
                  (range Range)
                  (actual (ptr Range))] (-> Rect)
  (let [(mut x) 0.0
        (mut y) 0.0
        (mut w) 0.0
        (mut h) 0.0
        bounds (msg Rect self (sel c"bounds") [])]
    (do
      (g/ghostty_surface_ime_point (.surface (terminal self)) x y w h)
      (if (!= (p/cast i64 actual) 0) (set! actual range) 0)
      (msg Rect
           (msg (ptr i8) self (sel c"window") [])
           (sel c"convertRectToScreen:")
           [Rect]
           (msg Rect
                self
                (sel c"convertRect:toView:")
                [Rect (ptr i8)]
                (rect (load x)
                      (- (.h bounds) (+ (load y) (load h)))
                      (load w)
                      (load h))
                (nil))))))

(defn command [(self (ptr i8)) (cmd (ptr i8)) (selector (ptr i8))] (-> void)
  (do))

(defn key-event [(self (ptr i8)) (event (ptr i8)) (action i32)] (-> void)
  (let [t (terminal self)
        before (!= (has-marked self (nil)) (: 0 i8))
        raw (msg (ptr i8) event (sel c"charactersIgnoringModifiers") [])
        (mut key) (zeroed g/Key)]
    (do
      (set! (.action key) action)
      (set! (.mods key) (mods event))
      (set! (.keycode key) (p/cast u32 (msg u16 event (sel c"keyCode") [])))
      (if (> (msg u64 raw (sel c"length") []) 0)
          (set! (.unshifted key)
                (p/cast u32 (msg u16 raw (sel c"characterAtIndex:") [u64] 0)))
          0)
      (if (!= action (: 0 i32))
          (do
            (msg i64 (.accum t) (sel c"setString:") [(ptr i8)] (ns c""))
            (set! (.in-key t) true)
            (msg i64
                 self
                 (sel c"interpretKeyEvents:")
                 [(ptr i8)]
                 (msg (ptr i8)
                      (class c"NSArray")
                      (sel c"arrayWithObject:")
                      [(ptr i8)]
                      event))
            (set! (.in-key t) false)
            (if (> (msg u64 (.accum t) (sel c"length") []) 0)
                (do
                  (set! (.text key) (utf8 (.accum t)))
                  ; A committed IME string has no physical modifier semantics.
                  (if before
                      (do
                        (set! (.mods key) 0)
                        (set! (.keycode key) 0)
                        (set! (.unshifted key) 0))
                      0))
                (set! (.composing key)
                      (or before (!= (has-marked self (nil)) (: 0 i8))))))
          0)
      (g/ghostty_surface_key (.surface t) (load key)))))

;;; ---- image preview --------------------------------------------------------------
;;; As in Finder: click an image to pick it, then Space shows it in Quick Look. Space
;;; alone cannot mean preview, or hovering over an image would eat what is being typed.

(const SPACE-KEYCODE (: 49 u16))

(const KEY-DOWN-EVENT (: 10 u64))

(const PNG-FILE-TYPE (: 4 u64))

(const ALPHA-NONPREMULTIPLIED (: 2 u64))

(const PICK-CHECK-SECONDS 0.1)

(defn nil? [(object (ptr i8))] (-> bool)
  (= (p/cast i64 object) 0))

(defn picked? [(t (ptr Terminal))] (-> bool)
  (not (nil? (.outline t))))

(defn plain-space? [(event (ptr i8))] (-> bool)
  (and (= (msg u16 event (sel c"keyCode") []) SPACE-KEYCODE)
       (= (& (mods event) (: 15 i32)) (: 0 i32))))

(defn repeat? [(event (ptr i8))] (-> bool)
  (!= (msg i8 event (sel c"isARepeat") []) (: 0 i8)))

;;; PNG bytes of W by H pixels of straight RGBA.
(defn png-of [(w i64) (h i64) (data (ptr i8))] (-> (ptr i8))
  (let [(mut planes) data
        rep
          (msg (ptr i8)
               (msg (ptr i8) (class c"NSBitmapImageRep") (sel c"alloc") [])
               (sel c"initWithBitmapDataPlanes:pixelsWide:pixelsHigh:bitsPerSample:samplesPerPixel:hasAlpha:isPlanar:colorSpaceName:bitmapFormat:bytesPerRow:bitsPerPixel:")
               [(ptr (ptr i8)) i64 i64 i64 i64 i8 i8 (ptr i8) u64 i64 i64]
               (mut planes)
               w
               h
               8
               4
               (: 1 i8)
               (: 0 i8)
               (ns c"NSDeviceRGBColorSpace")
               ALPHA-NONPREMULTIPLIED
               (* w 4)
               32)]
    (if (nil? rep)
        (nil)
        (let [png
                (msg (ptr i8)
                     rep
                     (sel c"representationUsingType:properties:")
                     [u64 (ptr i8)]
                     PNG-FILE-TYPE
                     (msg (ptr i8)
                          (class c"NSDictionary")
                          (sel c"dictionary")
                          []))]
          (release rep)
          png))))

(defn place-outline! [(t (ptr Terminal))] (-> void)
  (let [box (.picked t)
        bounds (msg Rect (.view t) (sel c"bounds") [])]
    (msg i64 (class c"CATransaction") (sel c"begin") [])
    (msg i64 (class c"CATransaction") (sel c"setDisableActions:") [i8] (: 1 i8))
    (msg i64
         (.outline t)
         (sel c"setFrame:")
         [Rect]
         (rect (.x box)
               (- (.h bounds) (+ (.y box) (.h box)))
               (.w box)
               (.h box)))
    (msg i64 (class c"CATransaction") (sel c"commit") [])
    (do)))

(defn unpick! [(t (ptr Terminal))] (-> void)
  (when (picked? t)
    (msg i64 (.pick-timer t) (sel c"invalidate") [])
    (set! (.pick-timer t) (nil))
    (msg i64 (.outline t) (sel c"removeFromSuperlayer") [])
    (release (.outline t))
    (set! (.outline t) (nil))
    (do)))

(defn pick! [(t (ptr Terminal)) (box g/ImageBox)] (-> void)
  (do
    (set! (.picked t) box)
    (when (not (picked? t))
      (let [outline (new c"CALayer")]
        (msg i64 outline (sel c"setBorderWidth:") [f64] 2.0)
        (msg i64 outline (sel c"setCornerRadius:") [f64] 2.0)
        (msg i64
             outline
             (sel c"setBorderColor:")
             [(ptr i8)]
             (msg (ptr i8) (color 0.447 0.78 0.925 1.0) (sel c"CGColor") []))
        (msg i64 (layer (.view t)) (sel c"addSublayer:") [(ptr i8)] outline)
        (set! (.outline t) outline)
        (set! (.pick-timer t)
              (msg (ptr i8)
                   (class c"NSTimer")
                   (sel c"scheduledTimerWithTimeInterval:target:selector:userInfo:repeats:")
                   [f64 (ptr i8) (ptr i8) (ptr i8) i8]
                   PICK-CHECK-SECONDS
                   (.view t)
                   (sel c"checkPick:")
                   (nil)
                   (: 1 i8)))))
    (place-outline! t)))

;;; Output and scrolling move what is on screen. The outline follows the image, and a
;;; picked image no longer showing is no longer picked, so Space types again.
(defn check-pick [(self (ptr i8)) (cmd (ptr i8)) (timer (ptr i8))] (-> void)
  (let [t (terminal self)
        (mut box) (zeroed g/ImageBox)]
    (cond (not (nil? (.preview-url t))) (do)
          (and (g/ghostty_surface_image_box (.surface t)
                                            (.id (.picked t))
                                            (mut box))
               (= (.transmission (load box)) (.transmission (.picked t))))
            (do (set! (.picked t) (load box)) (place-outline! t))
          :else (unpick! t))))

(defn pick-under-mouse! [(t (ptr Terminal))] (-> void)
  (let [(mut box) (zeroed g/ImageBox)]
    (if (g/ghostty_surface_image_at_mouse (.surface t) (mut box))
        (pick! t (load box))
        (unpick! t))))

(defn preview-panel [] (-> (ptr i8))
  (msg (ptr i8) (class c"QLPreviewPanel") (sel c"sharedPreviewPanel") []))

;;; How far from a picked image to look for where its full-size file was printed.
(const ROWS-BEFORE-IMAGE (: 60 u32))

(const ROWS-AFTER-IMAGE (: 10 u32))

(defn set-preview-file! [(t (ptr Terminal)) (path (ptr i8))] (-> void)
  (set! (.preview-url t)
        (msg (ptr i8)
             (msg (ptr i8)
                  (class c"NSURL")
                  (sel c"fileURLWithPath:")
                  [(ptr i8)]
                  path)
             (sel c"retain")
             [])))

;;; The full-size file of the thumbnail in PIXELS, from the text around it, or nil.
(defn picked-original [(t (ptr Terminal)) (pixels g/ImagePixels)] (-> (ptr i8))
  (let [(mut box) (.picked t)
        (mut around) (zeroed g/Text)]
    (if (g/ghostty_surface_text_around_image (.surface t)
                                             (mut box)
                                             ROWS-BEFORE-IMAGE
                                             ROWS-AFTER-IMAGE
                                             (mut around))
        (let [found
                (original/find (.text around)
                               (p/cast i64 (.w pixels))
                               (p/cast i64 (.h pixels))
                               (.data pixels))]
          (g/ghostty_surface_free_text (.surface t) (mut around))
          found)
        (nil))))

;;; Save PIXELS where Quick Look can read them. False if they could not be.
(defn write-preview-copy! [(t (ptr Terminal)) (pixels g/ImagePixels)] (-> bool)
  (let [files (msg (ptr i8) (class c"NSFileManager") (sel c"defaultManager") [])
        directory
          (append (NSTemporaryDirectory)
                  (append (ns c"jim-preview-") (sessions/identifier)))
        path (append directory (ns c"/image.png"))
        png
          (png-of (p/cast i64 (.w pixels))
                  (p/cast i64 (.h pixels))
                  (.data pixels))
        written
          (and (not (nil? png))
               (!= (msg i8
                        files
                        (sel c"createDirectoryAtPath:withIntermediateDirectories:attributes:error:")
                        [(ptr i8) i8 (ptr i8) (ptr i8)]
                        directory
                        (: 1 i8)
                        (nil)
                        (nil))
                   (: 0 i8))
               (!= (msg i8
                        png
                        (sel c"writeToFile:atomically:")
                        [(ptr i8) i8]
                        path
                        (: 1 i8))
                   (: 0 i8)))]
    (when written
      (set! (.preview-directory t) (msg (ptr i8) directory (sel c"retain") []))
      (set-preview-file! t path))
    written))

;;; Choose what Quick Look shows: the picked image's full-size file if the text around
;;; it names one, else a copy of what the terminal has. False if neither can be shown.
(defn prepare-preview! [(t (ptr Terminal))] (-> bool)
  (let [(mut pixels) (zeroed g/ImagePixels)
        box (.picked t)]
    (if (g/ghostty_surface_image_pixels (.surface t)
                                        (.id box)
                                        (.transmission box)
                                        (mut pixels))
        (let [held (load pixels)
              original (picked-original t held)
              ready
                (if (nil? original)
                    (write-preview-copy! t held)
                    (do (set-preview-file! t original) true))]
          (g/ghostty_surface_image_pixels_free (.surface t) (mut pixels))
          ready)
        false)))

;;; Stop previewing, deleting the copy if it was one. An original stays where it is.
(defn remove-preview! [(t (ptr Terminal))] (-> void)
  (when (not (nil? (.preview-url t)))
    (when (not (nil? (.preview-directory t)))
      (msg i8
           (msg (ptr i8) (class c"NSFileManager") (sel c"defaultManager") [])
           (sel c"removeItemAtPath:error:")
           [(ptr i8) (ptr i8)]
           (.preview-directory t)
           (nil))
      (release (.preview-directory t))
      (set! (.preview-directory t) (nil)))
    (release (.preview-url t))
    (set! (.preview-url t) (nil))
    (do)))

;;; Quick Look finds who controls its panel by walking the responder chain of the key
;;; window, so the panel asks the terminal view showing the preview.
(defn accepts-preview [(self (ptr i8)) (cmd (ptr i8)) (panel (ptr i8))] (-> i8)
  (let [t (terminal self)]
    (p/cast i8
            (if (and (!= (p/cast i64 t) 0) (not (nil? (.preview-url t)))) 1 0))))

(defn begin-preview [(self (ptr i8)) (cmd (ptr i8)) (panel (ptr i8))] (-> void)
  (do
    (msg i64 panel (sel c"setDataSource:") [(ptr i8)] self)
    (msg i64 panel (sel c"setDelegate:") [(ptr i8)] self)
    (do)))

(defn end-preview [(self (ptr i8)) (cmd (ptr i8)) (panel (ptr i8))] (-> void)
  (do
    (msg i64 panel (sel c"setDataSource:") [(ptr i8)] (nil))
    (msg i64 panel (sel c"setDelegate:") [(ptr i8)] (nil))
    (remove-preview! (terminal self))))

(defn preview-count [(self (ptr i8)) (cmd (ptr i8)) (panel (ptr i8))] (-> i64)
  1)

(defn preview-item [(self (ptr i8))
                    (cmd (ptr i8))
                    (panel (ptr i8))
                    (index i64)] (-> (ptr i8))
  (.preview-url (terminal self)))

;;; Space closes the preview it opened. Its key-up and any repeats land back here.
(defn preview-event [(self (ptr i8))
                     (cmd (ptr i8))
                     (panel (ptr i8))
                     (event (ptr i8))] (-> i8)
  (if (and (= (msg u64 event (sel c"type") []) KEY-DOWN-EVENT)
           (plain-space? event))
      (do
        (set! (.space-taken (terminal self)) true)
        (msg i64 panel (sel c"orderOut:") [(ptr i8)] (nil))
        (: 1 i8))
      (: 0 i8)))

;;; Where the preview zooms from and back to: the image in the terminal.
(defn preview-source [(self (ptr i8))
                      (cmd (ptr i8))
                      (panel (ptr i8))
                      (item (ptr i8))] (-> Rect)
  (let [t (terminal self)
        box (.picked t)
        bounds (msg Rect self (sel c"bounds") [])]
    (msg Rect
         (msg (ptr i8) self (sel c"window") [])
         (sel c"convertRectToScreen:")
         [Rect]
         (msg Rect
              self
              (sel c"convertRect:toView:")
              [Rect (ptr i8)]
              (rect (.x box)
                    (- (.h bounds) (+ (.y box) (.h box)))
                    (.w box)
                    (.h box))
              (nil)))))

;;; Show the picked image. False if it is gone, so the key should type as usual.
(defn show-preview! [(t (ptr Terminal))] (-> bool)
  (if (prepare-preview! t)
      (let [panel (preview-panel)]
        (msg i64 panel (sel c"makeKeyAndOrderFront:") [(ptr i8)] (nil))
        (msg i64 panel (sel c"reloadData") [])
        true)
      false))

(defn close-preview! [(t (ptr Terminal))] (-> void)
  (when (not (nil? (.preview-url t)))
    (msg i64 (preview-panel) (sel c"orderOut:") [(ptr i8)] (nil))
    (remove-preview! t)))

;;; Whether this key is Space opening the preview of a picked image. Any other key
;;; means typing has resumed, so it drops the pick and goes to the terminal.
(defn key-opens-preview? [(t (ptr Terminal)) (event (ptr i8))] (-> bool)
  (cond (not (picked? t)) false
        (and (plain-space? event) (show-preview! t)) true
        :else (do (unpick! t) false)))

(defn key-down [(self (ptr i8)) (cmd (ptr i8)) (event (ptr i8))] (-> void)
  (let [t (terminal self)]
    (if (and (.space-taken t) (repeat? event) (plain-space? event))
        (do)
        (do
          (set! (.space-taken t) false)
          (if (key-opens-preview? t event)
              (set! (.space-taken t) true)
              (key-event self event (if (repeat? event) 2 1)))))))

(defn key-up [(self (ptr i8)) (cmd (ptr i8)) (event (ptr i8))] (-> void)
  (let [t (terminal self)]
    (if (and (.space-taken t)
             (= (msg u16 event (sel c"keyCode") []) SPACE-KEYCODE))
        (set! (.space-taken t) false)
        (key-event self event 0))))

(defn mouse-position! [(self (ptr i8)) (event (ptr i8))] (-> void)
  (let [pt
          (msg Point
               self
               (sel c"convertPoint:fromView:")
               [Point (ptr i8)]
               (msg Point event (sel c"locationInWindow") [])
               (nil))
        bounds (msg Rect self (sel c"bounds") [])]
    (g/ghostty_surface_mouse_pos (.surface (terminal self))
                                 (.x pt)
                                 (- (.h bounds) (.y pt))
                                 (mods event))))

(defn mouse-down [(self (ptr i8)) (cmd (ptr i8)) (event (ptr i8))] (-> void)
  (do
    (msg i8
         (msg (ptr i8) self (sel c"window") [])
         (sel c"makeFirstResponder:")
         [(ptr i8)]
         self)
    (mouse-position! self event)
    (when (= (msg i64 event (sel c"buttonNumber") []) 0)
      (pick-under-mouse! (terminal self)))
    (g/ghostty_surface_mouse_button (.surface (terminal self))
                                    1
                                    (p/cast i32
                                            (+ 1
                                               (msg i64
                                                    event
                                                    (sel c"buttonNumber")
                                                    [])))
                                    (mods event))))

(defn mouse-up [(self (ptr i8)) (cmd (ptr i8)) (event (ptr i8))] (-> void)
  (do
    (mouse-position! self event)
    (g/ghostty_surface_mouse_button (.surface (terminal self))
                                    0
                                    (p/cast i32
                                            (+ 1
                                               (msg i64
                                                    event
                                                    (sel c"buttonNumber")
                                                    [])))
                                    (mods event))))

(defn mouse-move [(self (ptr i8)) (cmd (ptr i8)) (event (ptr i8))] (-> void)
  (mouse-position! self event))

(defn scroll [(self (ptr i8)) (cmd (ptr i8)) (event (ptr i8))] (-> void)
  (do
    (mouse-position! self event)
    (g/ghostty_surface_mouse_scroll (.surface (terminal self))
                                    (msg f64 event (sel c"scrollingDeltaX") [])
                                    (msg f64 event (sel c"scrollingDeltaY") [])
                                    (if (!= (msg i8
                                                 event
                                                 (sel c"hasPreciseScrollingDeltas")
                                                 [])
                                            (: 0 i8))
                                        1
                                        0))))

(defn focus-in [(self (ptr i8)) (cmd (ptr i8))] (-> i8)
  (do
    (g/ghostty_surface_set_focus (.surface (terminal self)) true)
    (: 1 i8)))

(defn focus-out [(self (ptr i8)) (cmd (ptr i8))] (-> i8)
  (do
    (unpick! (terminal self))
    (g/ghostty_surface_set_focus (.surface (terminal self)) false)
    (: 1 i8)))

(defn copy [(self (ptr i8)) (cmd (ptr i8)) (sender (ptr i8))] (-> void)
  (g/ghostty_surface_binding_action (.surface (terminal self))
                                    c"copy_to_clipboard"
                                    17))

;;; ---- drag and drop --------------------------------------------------------------
;;; What is dropped arrives as the text a shell needs, as Ghostty's own app does it:
;;; files as escaped paths, so an agent or command in the terminal can open them.

(extern NSTemporaryDirectory :cc (cc/C) [] (-> (ptr i8)))

;;; The view dropped onto since last asked, so the canvas can focus its pane.
(defn dropped-cell [] (-> (ptr (ptr i8)))
  (p/alloc-static (ptr i8)))

(defn take-dropped! [] (-> (ptr i8))
  (let [view (load (dropped-cell))]
    (set! (dropped-cell) (nil))
    view))

(defn replace-all [(s (ptr i8)) (from (ptr i8)) (to (ptr i8))] (-> (ptr i8))
  (msg (ptr i8)
       s
       (sel c"stringByReplacingOccurrencesOfString:withString:")
       [(ptr i8) (ptr i8)]
       from
       to))

(defn append [(a (ptr i8)) (b (ptr i8))] (-> (ptr i8))
  (msg (ptr i8) a (sel c"stringByAppendingString:") [(ptr i8)] b))

;;; PATH, safe to type at a shell prompt.
(defn shell-escaped [(path (ptr i8))] (-> (ptr i8))
  (let [specials
          [c"\\"
           c" "
           c"("
           c")"
           c"["
           c"]"
           c"{"
           c"}"
           c"<"
           c">"
           c"\""
           c"'"
           c"`"
           c"!"
           c"#"
           c"$"
           c"&"
           c";"
           c"|"
           c"*"
           c"?"
           c"\t"]
        (mut out) path]
    (for [i 0 22]
      (let [special (ns (get specials i))]
        (set! out (replace-all (load out) special (append (ns c"\\") special)))))
    (load out)))

(defn dropped-files [(board (ptr i8))] (-> (ptr i8))
  (let [classes
          (msg (ptr i8)
               (class c"NSArray")
               (sel c"arrayWithObject:")
               [(ptr i8)]
               (class c"NSURL"))
        options
          (msg (ptr i8)
               (class c"NSDictionary")
               (sel c"dictionaryWithObject:forKey:")
               [(ptr i8) (ptr i8)]
               (msg (ptr i8)
                    (class c"NSNumber")
                    (sel c"numberWithBool:")
                    [i8]
                    (: 1 i8))
               (ns c"NSPasteboardURLReadingFileURLsOnlyKey"))
        urls
          (msg (ptr i8)
               board
               (sel c"readObjectsForClasses:options:")
               [(ptr i8) (ptr i8)]
               classes
               options)
        (mut text) (ns c"")]
    (for [i 0 (msg i64 urls (sel c"count") [])]
      (set! text
            (append (load text)
                    (append (shell-escaped (msg (ptr i8)
                                                (msg (ptr i8)
                                                     urls
                                                     (sel c"objectAtIndex:")
                                                     [i64]
                                                     i)
                                                (sel c"path")
                                                []))
                            (ns c" ")))))
    (load text)))

;;; Image data with no file behind it, as from a browser, saved where a path can reach
;;; it. Nil if BOARD holds no image, or it could not be saved.
(defn dropped-image [(board (ptr i8))] (-> (ptr i8))
  (let [png
          (msg (ptr i8)
               board
               (sel c"dataForType:")
               [(ptr i8)]
               (ns c"public.png"))
        tiff
          (if (= (p/cast i64 png) 0)
              (msg (ptr i8)
                   board
                   (sel c"dataForType:")
                   [(ptr i8)]
                   (ns c"public.tiff"))
              (nil))
        data
          (if (= (p/cast i64 tiff) 0)
              png
              (msg (ptr i8)
                   (msg (ptr i8)
                        (class c"NSBitmapImageRep")
                        (sel c"imageRepWithData:")
                        [(ptr i8)]
                        tiff)
                   (sel c"representationUsingType:properties:")
                   [u64 (ptr i8)]
                   (: 4 u64)
                   (msg (ptr i8) (class c"NSDictionary") (sel c"dictionary") [])))
        path
          (append (NSTemporaryDirectory)
                  (append (append (ns c"jim-drop-") (sessions/identifier))
                          (ns c".png")))]
    (if (and (!= (p/cast i64 data) 0)
             (!= (msg i8
                      data
                      (sel c"writeToFile:atomically:")
                      [(ptr i8) i8]
                      path
                      (: 1 i8))
                 (: 0 i8)))
        (append (shell-escaped path) (ns c" "))
        (nil))))

;;; The text a drop of BOARD types: files, else an image, else plain text. Nil if none.
(defn dropped-text [(board (ptr i8))] (-> (ptr i8))
  (let [files (dropped-files board)]
    (if (> (msg u64 files (sel c"length") []) (: 0 u64))
        files
        (let [image (dropped-image board)]
          (if (!= (p/cast i64 image) 0)
              image
              (msg (ptr i8)
                   board
                   (sel c"stringForType:")
                   [(ptr i8)]
                   (ns c"public.utf8-plain-text")))))))

(defn dragging-entered [(self (ptr i8)) (cmd (ptr i8)) (info (ptr i8))] (-> u64)
  (: 1 u64))

(defn perform-drag [(self (ptr i8)) (cmd (ptr i8)) (info (ptr i8))] (-> i8)
  (let [t (terminal self)
        text (dropped-text (msg (ptr i8) info (sel c"draggingPasteboard") []))]
    (if (or (= (p/cast i64 (.surface t)) 0) (= (p/cast i64 text) 0))
        (: 0 i8)
        (let [bytes (utf8 text)]
          (g/ghostty_surface_text (.surface t) bytes (strlen bytes))
          (set! (dropped-cell) self)
          ; The next thing wanted is usually Return in this terminal.
          (msg i64
               (msg (ptr i8)
                    (class c"NSApplication")
                    (sel c"sharedApplication")
                    [])
               (sel c"activateIgnoringOtherApps:")
               [i8]
               (: 1 i8))
          (: 1 i8)))))

(defn register-drops! [(view (ptr i8))] (-> void)
  (let [types (new c"NSMutableArray")]
    (for [i 0 4]
      (msg i64
           types
           (sel c"addObject:")
           [(ptr i8)]
           (ns (cond (= i 0) c"public.file-url"
                     (= i 1) c"public.png"
                     (= i 2) c"public.tiff"
                     :else c"public.utf8-plain-text"))))
    (msg i64 view (sel c"registerForDraggedTypes:") [(ptr i8)] types)
    (release types)
    (do)))

(defn paste [(self (ptr i8)) (cmd (ptr i8)) (sender (ptr i8))] (-> void)
  (g/ghostty_surface_binding_action (.surface (terminal self))
                                    c"paste_from_clipboard"
                                    20))

(defn select-all [(self (ptr i8)) (cmd (ptr i8)) (sender (ptr i8))] (-> void)
  (g/ghostty_surface_binding_action (.surface (terminal self)) c"select_all" 10))

(defn accessibility-role [(self (ptr i8)) (cmd (ptr i8))] (-> (ptr i8))
  (ns c"AXTextArea"))

(defn accessibility-value [(self (ptr i8)) (cmd (ptr i8))] (-> (ptr i8))
  (let [t (terminal self)
        (mut text) (zeroed g/Text)
        selection
          (g/TextSelection
            :top
              (g/TextPoint
                :tag 1
                :coord 1
                :x 0
                :y 0)
            :bottom
              (g/TextPoint
                :tag 1
                :coord 2
                :x 0
                :y 0)
            :rectangle false)]
    (if (and (!= (p/cast i64 t) 0)
             (!= (p/cast i64 (.surface t)) 0)
             (g/ghostty_surface_read_text (.surface t) selection (mut text)))
        (let [value (ns (.text text))]
          (do (g/ghostty_surface_free_text (.surface t) (mut text)) value))
        (ns c""))))

(defn view-class [] (-> (ptr i8))
  (let [existing (class c"JimTerminalView")]
    (if (!= (p/cast i64 existing) 0)
        existing
        (let [cls
                (objc_allocateClassPair (class c"NSView") c"JimTerminalView" 0)]
          (do
            (class_addProtocol cls (objc_getProtocol c"NSTextInputClient"))
            (method! cls
                     c"isAccessibilityElement"
                     (p/cast (ptr i8) (fnptr-of accepts))
                     c"c@:")
            (method! cls
                     c"accessibilityRole"
                     (p/cast (ptr i8) (fnptr-of accessibility-role))
                     c"@@:")
            (method! cls
                     c"accessibilityValue"
                     (p/cast (ptr i8) (fnptr-of accessibility-value))
                     c"@@:")
            (method! cls
                     c"acceptsFirstResponder"
                     (p/cast (ptr i8) (fnptr-of accepts))
                     c"c@:")
            (method! cls
                     c"becomeFirstResponder"
                     (p/cast (ptr i8) (fnptr-of focus-in))
                     c"c@:")
            (method! cls
                     c"resignFirstResponder"
                     (p/cast (ptr i8) (fnptr-of focus-out))
                     c"c@:")
            (method! cls
                     c"hasMarkedText"
                     (p/cast (ptr i8) (fnptr-of has-marked))
                     c"c@:")
            (method! cls
                     c"markedRange"
                     (p/cast (ptr i8) (fnptr-of marked-range))
                     c"{_NSRange=QQ}@:")
            (method! cls
                     c"selectedRange"
                     (p/cast (ptr i8) (fnptr-of selected-range))
                     c"{_NSRange=QQ}@:")
            (method! cls
                     c"unmarkText"
                     (p/cast (ptr i8) (fnptr-of unmark))
                     c"v@:")
            (method! cls
                     c"insertText:replacementRange:"
                     (p/cast (ptr i8) (fnptr-of insert))
                     c"v@:@{_NSRange=QQ}")
            (method! cls
                     c"setMarkedText:selectedRange:replacementRange:"
                     (p/cast (ptr i8) (fnptr-of set-marked))
                     c"v@:@{_NSRange=QQ}{_NSRange=QQ}")
            (method! cls
                     c"validAttributesForMarkedText"
                     (p/cast (ptr i8) (fnptr-of attributes))
                     c"@@:")
            (method! cls
                     c"attributedSubstringForProposedRange:actualRange:"
                     (p/cast (ptr i8) (fnptr-of substring))
                     c"@@:{_NSRange=QQ}^{_NSRange=QQ}")
            (method! cls
                     c"characterIndexForPoint:"
                     (p/cast (ptr i8) (fnptr-of character-index))
                     c"Q@:{CGPoint=dd}")
            (method! cls
                     c"firstRectForCharacterRange:actualRange:"
                     (p/cast (ptr i8) (fnptr-of first-rect))
                     c"{CGRect={CGPoint=dd}{CGSize=dd}}@:{_NSRange=QQ}^{_NSRange=QQ}")
            (method! cls
                     c"doCommandBySelector:"
                     (p/cast (ptr i8) (fnptr-of command))
                     c"v@::")
            (method! cls
                     c"keyDown:"
                     (p/cast (ptr i8) (fnptr-of key-down))
                     c"v@:@")
            (method! cls
                     c"keyUp:"
                     (p/cast (ptr i8) (fnptr-of key-up))
                     c"v@:@")
            (method! cls
                     c"mouseDown:"
                     (p/cast (ptr i8) (fnptr-of mouse-down))
                     c"v@:@")
            (method! cls
                     c"rightMouseDown:"
                     (p/cast (ptr i8) (fnptr-of mouse-down))
                     c"v@:@")
            (method! cls
                     c"otherMouseDown:"
                     (p/cast (ptr i8) (fnptr-of mouse-down))
                     c"v@:@")
            (method! cls
                     c"mouseUp:"
                     (p/cast (ptr i8) (fnptr-of mouse-up))
                     c"v@:@")
            (method! cls
                     c"rightMouseUp:"
                     (p/cast (ptr i8) (fnptr-of mouse-up))
                     c"v@:@")
            (method! cls
                     c"otherMouseUp:"
                     (p/cast (ptr i8) (fnptr-of mouse-up))
                     c"v@:@")
            (method! cls
                     c"mouseDragged:"
                     (p/cast (ptr i8) (fnptr-of mouse-move))
                     c"v@:@")
            (method! cls
                     c"rightMouseDragged:"
                     (p/cast (ptr i8) (fnptr-of mouse-move))
                     c"v@:@")
            (method! cls
                     c"otherMouseDragged:"
                     (p/cast (ptr i8) (fnptr-of mouse-move))
                     c"v@:@")
            (method! cls
                     c"mouseMoved:"
                     (p/cast (ptr i8) (fnptr-of mouse-move))
                     c"v@:@")
            (method! cls
                     c"scrollWheel:"
                     (p/cast (ptr i8) (fnptr-of scroll))
                     c"v@:@")
            (method! cls
                     c"draggingEntered:"
                     (p/cast (ptr i8) (fnptr-of dragging-entered))
                     c"Q@:@")
            (method! cls
                     c"performDragOperation:"
                     (p/cast (ptr i8) (fnptr-of perform-drag))
                     c"c@:@")
            (method! cls
                     c"checkPick:"
                     (p/cast (ptr i8) (fnptr-of check-pick))
                     c"v@:@")
            (method! cls
                     c"acceptsPreviewPanelControl:"
                     (p/cast (ptr i8) (fnptr-of accepts-preview))
                     c"c@:@")
            (method! cls
                     c"beginPreviewPanelControl:"
                     (p/cast (ptr i8) (fnptr-of begin-preview))
                     c"v@:@")
            (method! cls
                     c"endPreviewPanelControl:"
                     (p/cast (ptr i8) (fnptr-of end-preview))
                     c"v@:@")
            (method! cls
                     c"numberOfPreviewItemsInPreviewPanel:"
                     (p/cast (ptr i8) (fnptr-of preview-count))
                     c"q@:@")
            (method! cls
                     c"previewPanel:previewItemAtIndex:"
                     (p/cast (ptr i8) (fnptr-of preview-item))
                     c"@@:@q")
            (method! cls
                     c"previewPanel:handleEvent:"
                     (p/cast (ptr i8) (fnptr-of preview-event))
                     c"c@:@@")
            (method! cls
                     c"previewPanel:sourceFrameOnScreenForPreviewItem:"
                     (p/cast (ptr i8) (fnptr-of preview-source))
                     c"{CGRect={CGPoint=dd}{CGSize=dd}}@:@@")
            (method! cls c"copy:" (p/cast (ptr i8) (fnptr-of copy)) c"v@:@")
            (method! cls c"paste:" (p/cast (ptr i8) (fnptr-of paste)) c"v@:@")
            (method! cls
                     c"selectAll:"
                     (p/cast (ptr i8) (fnptr-of select-all))
                     c"v@:@")
            (objc_registerClassPair cls)
            cls)))))

(defn tick [(self (ptr i8)) (cmd (ptr i8)) (unused (ptr i8))] (-> void)
  (let [start (timings/now)]
    (do
      (if (!= (p/cast i64 (load (app-cell))) 0)
          (g/ghostty_app_tick (load (app-cell)))
          (do))
      (timings/record! 3 (* 1000.0 (- (timings/now) start))))))

(defn wakeup [(userdata (ptr i8))] (-> void)
  (let [pool (new c"NSAutoreleasePool")]
    (do
      (msg i64
           (load (dispatcher-cell))
           (sel c"performSelectorOnMainThread:withObject:waitUntilDone:")
           [(ptr i8) (ptr i8) i8]
           (sel c"tick:")
           (nil)
           (: 0 i8))
      (release pool))))

(defn action [(app (ptr i8)) (target g/Target) (value g/Action)] (-> bool)
  (if (and (= (.tag target) g/TARGET-SURFACE) (= (.tag value) g/ACTION-PWD))
      (let [t
              (p/cast (ptr Terminal)
                      (g/ghostty_surface_userdata (.surface target)))
            path (p/cast (ptr i8) (load (index (field value data) 0)))]
        (if (and (!= (p/cast i64 t) 0) (!= (p/cast i64 path) 0))
            (do
              (release (.directory t))
              (set! (.directory t) (msg (ptr i8) (ns path) (sel c"retain") []))
              true)
            false))
      false))

;;; The general pasteboard's type for MIME, or nil when macOS knows none.
(defn pasteboard-type [(mime (ptr i8))] (-> (ptr i8))
  (if (= (strcmp mime c"text/plain") (: 0 i32))
      (ns c"public.utf8-plain-text")
      (let [type
              (msg (ptr i8)
                   (class c"UTType")
                   (sel c"typeWithMIMEType:")
                   [(ptr i8)]
                   (ns mime))]
        (if (= (p/cast i64 type) 0)
            (nil)
            (msg (ptr i8) type (sel c"identifier") [])))))

;;; The MIME type of pasteboard TYPE as a C string, or null when it has none.
;;; Plain text in any encoding is text/plain, the name Ghostty asks for.
(defn mime-of [(type (ptr i8))] (-> (ptr i8))
  (let [ut
          (msg (ptr i8)
               (class c"UTType")
               (sel c"typeWithIdentifier:")
               [(ptr i8)]
               type)
        plain
          (msg (ptr i8)
               (class c"UTType")
               (sel c"typeWithIdentifier:")
               [(ptr i8)]
               (ns c"public.plain-text"))]
    (cond (= (p/cast i64 ut) 0) (p/cast (ptr i8) 0)
          (!= (msg i8 ut (sel c"conformsToType:") [(ptr i8)] plain) (: 0 i8))
            c"text/plain"
          :else
            (let [mime (msg (ptr i8) ut (sel c"preferredMIMEType") [])]
              (if (= (p/cast i64 mime) 0) (p/cast (ptr i8) 0) (utf8 mime))))))

;;; Whether NAMES, COUNT C strings, include NAME.
(defn listed? [(names (ptr (ptr i8))) (count i64) (name (ptr i8))] (-> bool)
  (let [(mut found) false]
    (for [i 0 count]
      (when (= (strcmp (load (index names i)) name) (: 0 i32))
        (set! found true)))
    (load found)))

;;; Serve a terminal's clipboard read from the general pasteboard: each MIME
;;; type it asks for that the pasteboard holds, and, when it asks for the
;;; list, every MIME type the pasteboard could serve. Jim has only the
;;; standard clipboard.
(defn read-clipboard [(userdata (ptr i8))
                      (kind i32)
                      (request (ptr i8))
                      (mimes (ptr (ptr i8)))
                      (count u64)
                      (list bool)] (-> i32)
  (if (!= kind g/CLIPBOARD-STANDARD)
      g/CLIPBOARD-READ-UNSUPPORTED
      (let [t (p/cast (ptr Terminal) userdata)
            pb
              (msg (ptr i8)
                   (class c"NSPasteboard")
                   (sel c"generalPasteboard")
                   [])
            (mut contents)
              (al/ArrayList::new [g/ClipboardContent] (alloc/malloc-allocator))
            (mut available)
              (al/ArrayList::new [(ptr i8)] (alloc/malloc-allocator))]
        (for [i 0 (p/cast i64 count)]
          (let [mime (load (index mimes i))
                type (pasteboard-type mime)]
            (when (and (!= (p/cast i64 type) 0) (not (listed? mimes i mime)))
              (let [data
                      (msg (ptr i8)
                           pb
                           (sel c"dataForType:")
                           [(ptr i8)]
                           type)]
                (when (!= (p/cast i64 data) 0)
                  (push! (mut contents)
                         (g/ClipboardContent
                           :mime mime
                           :data (msg (ptr i8) data (sel c"bytes") [])
                           :len (msg u64 data (sel c"length") []))))))))
        (when list
          (let [types (msg (ptr i8) pb (sel c"types") [])]
            (for [i 0 (p/cast i64 (msg u64 types (sel c"count") []))]
              (let [mime
                      (mime-of (msg (ptr i8)
                                    types
                                    (sel c"objectAtIndex:")
                                    [u64]
                                    (p/cast u64 i)))]
                (when (and (!= (p/cast i64 mime) 0)
                           (not (listed? (.data available) (len available) mime)))
                  (push! (mut available) mime))))))
        (let [result
                (if (and (= (len contents) 0) (not list))
                    g/CLIPBOARD-READ-UNAVAILABLE
                    (let [(mut complete)
                            (g/ClipboardComplete
                              :contents (.data contents)
                              :count (p/cast u64 (len contents))
                              :available (.data available)
                              :available-count (p/cast u64 (len available))
                              :confirmed false
                              :remember false)]
                      (g/ghostty_surface_complete_clipboard_request (.surface t)
                                                                    (mut complete)
                                                                    request)
                      g/CLIPBOARD-READ-STARTED))]
          (al/ArrayList::free! (mut contents))
          (al/ArrayList::free! (mut available))
          result))))

;;; Ghostty asks before a read or write its policy holds back. Jim has no
;;; prompt: a paste the user asked for is confirmed as it stands, and anything
;;; else is refused. config/ghostty denies terminal reads outright.
(defn confirm-clipboard [(userdata (ptr i8))
                         (confirm (ptr g/ClipboardConfirm))
                         (request (ptr i8))
                         (kind i32)] (-> void)
  (let [surface (.surface (p/cast (ptr Terminal) userdata))]
    (if (= kind g/CLIPBOARD-REQUEST-PASTE)
        (let [(mut complete)
                (g/ClipboardComplete
                  :contents (.contents confirm)
                  :count (.count confirm)
                  :available (.available confirm)
                  :available-count (.available-count confirm)
                  :confirmed true
                  :remember false)]
          (g/ghostty_surface_complete_clipboard_request surface
                                                        (mut complete)
                                                        request))
        (g/ghostty_surface_deny_clipboard_request surface request))))

;;; Put a terminal's clipboard write on the general pasteboard, each
;;; representation under its pasteboard type. A write that needs confirmation
;;; is dropped, since Jim has no prompt to ask with; config/ghostty allows
;;; terminal writes, so none should need one.
(defn write-clipboard [(userdata (ptr i8))
                       (kind i32)
                       (contents (ptr g/ClipboardContent))
                       (count u64)
                       (confirm bool)] (-> void)
  (when (and (= kind g/CLIPBOARD-STANDARD) (not confirm) (> count (: 0 u64)))
    (let [pb
            (msg (ptr i8) (class c"NSPasteboard") (sel c"generalPasteboard") [])]
      (msg i64 pb (sel c"clearContents") [])
      (for [i 0 (p/cast i64 count)]
        (let [c (index contents i)
              type (pasteboard-type (.mime c))]
          (when (!= (p/cast i64 type) 0)
            (msg i8
                 pb
                 (sel c"setData:forType:")
                 [(ptr i8) (ptr i8)]
                 (msg (ptr i8)
                      (class c"NSData")
                      (sel c"dataWithBytes:length:")
                      [(ptr i8) u64]
                      (.data c)
                      (.len c))
                 type)))))))

(defn close-surface [(userdata (ptr i8)) (alive bool)] (-> void)
  (set! (.closed (p/cast (ptr Terminal) userdata)) true))

(defn start! [] (-> (ptr i8))
  (if (!= (g/ghostty_init 0 (p/cast (ptr (ptr i8)) 0)) (: 0 i32))
      (nil)
      (let [cls
              (objc_allocateClassPair (class c"NSObject")
                                      c"JimGhosttyDispatcher"
                                      0)
            config (g/ghostty_config_new)
            (mut runtime) (zeroed g/Runtime)]
        (do
          (method! cls c"tick:" (p/cast (ptr i8) (fnptr-of tick)) c"v@:@")
          (objc_registerClassPair cls)
          (set! (dispatcher-cell) (new c"JimGhosttyDispatcher"))
          (g/ghostty_config_load_file config c"config/ghostty")
          (g/ghostty_config_finalize config)
          (set! (.wakeup runtime) (p/cast (ptr i8) (fnptr-of wakeup)))
          (set! (.action runtime) (p/cast (ptr i8) (fnptr-of action)))
          (set! (.read runtime) (p/cast (ptr i8) (fnptr-of read-clipboard)))
          (set! (.confirm runtime)
                (p/cast (ptr i8) (fnptr-of confirm-clipboard)))
          (set! (.write runtime) (p/cast (ptr i8) (fnptr-of write-clipboard)))
          (set! (.close runtime) (p/cast (ptr i8) (fnptr-of close-surface)))
          (set! (app-cell) (g/ghostty_app_new runtime config))
          (g/ghostty_config_free config)
          (load (app-cell))))))

(defn create! [(parent (ptr i8))
               (bounds Rect)
               (cwd (ptr i8))
               (session-id (ptr i8))
               (original i64)] (-> (ptr Terminal))
  (let [v
          (msg (ptr i8)
               (msg (ptr i8) (view-class) (sel c"alloc") [])
               (sel c"initWithFrame:")
               [Rect]
               bounds)
        t (alloc/box! (alloc/malloc-allocator) Terminal (zeroed Terminal))
        (mut config) (g/ghostty_surface_config_new)
        scale
          (msg f64
               (msg (ptr i8) parent (sel c"window") [])
               (sel c"backingScaleFactor")
               [])]
    (do
      (set! (.view t) v)
      (set! (.session-id t) (msg (ptr i8) session-id (sel c"retain") []))
      (set! (.original t) original)
      (set! (.directory t) (msg (ptr i8) (ns cwd) (sel c"retain") []))
      (set! (.marked t) (new c"NSMutableString"))
      (set! (.accum t) (new c"NSMutableString"))
      (objc_setAssociatedObject v (association-key) (p/cast (ptr i8) t) 0)
      (msg i64 parent (sel c"addSubview:") [(ptr i8)] v)
      (register-drops! v)
      (set! (.platform-tag config) 1)
      (set! (.view config) v)
      (set! (.userdata config) (p/cast (ptr i8) t))
      (set! (.scale config) scale)
      (set! (.cwd config) cwd)
      (let [fd (sessions/open! session-id cwd (field t original))]
        (if (>= fd (: 0 i32))
            (set! (.surface t)
                  (g/ghostty_surface_new_session (load (app-cell))
                                                 config
                                                 fd
                                                 (p/cast u32
                                                         (* (.w bounds) scale))
                                                 (p/cast u32
                                                         (* (.h bounds) scale))))
            0))
      (if (!= (p/cast i64 (.surface t)) 0)
          (g/ghostty_surface_set_size (.surface t)
                                      (p/cast u32 (* (.w bounds) scale))
                                      (p/cast u32 (* (.h bounds) scale)))
          (do
            (objc_setAssociatedObject v (association-key) (nil) 0)
            (msg i64 v (sel c"removeFromSuperview") [])
            (release v)
            (set! (.view t) (nil))
            (do)))
      t)))

(defn resize! [(t (ptr Terminal)) (bounds Rect) (scale f64)] (-> void)
  (when (!= (p/cast i64 (.surface t)) 0)
    (frame! (.view t) bounds)
    (g/ghostty_surface_set_content_scale (.surface t) scale scale)
    (g/ghostty_surface_set_size (.surface t)
                                (p/cast u32 (* (.w bounds) scale))
                                (p/cast u32 (* (.h bounds) scale)))))

(defn free! [(t (ptr Terminal))] (-> void)
  (do
    (unpick! t)
    (close-preview! t)
    (if (!= (p/cast i64 (.surface t)) 0)
        (g/ghostty_surface_free (.surface t))
        (do))
    (objc_setAssociatedObject (.view t) (association-key) (nil) 0)
    (msg i64 (.view t) (sel c"removeFromSuperview") [])
    (release (.view t))
    (release (.directory t))
    (release (.session-id t))
    (release (.marked t))
    (release (.accum t))
    (alloc/destroy [Terminal] (alloc/malloc-allocator) t)))

(defn stop! [] (-> void)
  (do
    (g/ghostty_app_free (load (app-cell)))
    (set! (app-cell) (nil))
    (release (load (dispatcher-cell)))))

(export-c [action :as "jim_terminal_action"]
          [insert :as "jim_terminal_insert"]
          [set-marked :as "jim_terminal_set_marked"]
          [substring :as "jim_terminal_substring"]
          [character-index :as "jim_terminal_character_index"]
          [first-rect :as "jim_terminal_first_rect"]
          [marked-range :as "jim_terminal_marked_range"]
          [selected-range :as "jim_terminal_selected_range"]
          [preview-source :as "jim_terminal_preview_source"])
