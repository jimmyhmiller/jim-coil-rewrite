(module jim.remote)
(import "coil.cc" :as cc)
(import "coil.os" :as os)
(import "coil.primitive" :as p)
(import "coil.alloc" :as alloc)
(import "coil.arraylist" :use *)
(import "coil.slice" :use *)
(import "jim.native" :use [ns])
(import "jim.session.transport" :as transport)
(import "jim.remote-wire" :as wire)

;;; The socket `jimc` talks to. It belongs to the main thread: nothing here blocks and
;;; every read, write and command happens in the app's loop, between events, so a
;;; command can touch AppKit and can never land in the middle of something else. The
;;; run loop only says when a socket is ready, by waking that loop.

(const O-NONBLOCK (: 4 i32))

(const F-GETFL 3)

(const F-SETFL 4)

(const EAGAIN 35)

(const EEXIST 17)

(const READ-CALLBACK (: 1 u64))

(const WRITE-CALLBACK (: 2 u64))

;;; A client has this long to send its request, and this long to take its reply.
(const REQUEST-SECONDS 5.0)

(const REPLY-SECONDS 30.0)

;;; Clients past this many wait in the listen backlog, or are refused once that fills.
(const MAX-CONNECTIONS 32)

(const READING 0)

;;; A whole request is here, waiting for take-request!.
(const READY 1)

;;; Taken, and being answered by the caller.
(const SERVING 2)

(const WRITING 3)

(const CLOSED 4)

(extern bind :cc (cc/C) [i32 (ptr i8) u32] (-> i32))

(extern listen :cc (cc/C) [i32 i32] (-> i32))

(extern accept :cc (cc/C) [i32 (ptr i8) (ptr u32)] (-> i32))

(extern unlink :cc (cc/C) [(ptr i8)] (-> i32))

(extern mkdir :cc (cc/C) [(ptr i8) u16] (-> i32))

(extern lstat :cc (cc/C) [(ptr i8) (ptr i8)] (-> i32))

(extern getuid :cc (cc/C) [] (-> u32))

(extern strlen :cc (cc/C) [(ptr i8)] (-> u64))

(extern memcpy :cc (cc/C) [(ptr i8) (ptr i8) u64] (-> (ptr i8)))

(extern CFFileDescriptorCreate
        :cc
        (cc/C)
        [(ptr i8) i32 i8 (ptr i8) (ptr i8)]
        (-> (ptr i8)))

(extern CFFileDescriptorEnableCallBacks :cc (cc/C) [(ptr i8) u64] (-> void))

(extern CFFileDescriptorCreateRunLoopSource
        :cc
        (cc/C)
        [(ptr i8) (ptr i8) i64]
        (-> (ptr i8)))

(extern CFFileDescriptorInvalidate :cc (cc/C) [(ptr i8)] (-> void))

(extern CFRunLoopGetMain :cc (cc/C) [] (-> (ptr i8)))

(extern CFRunLoopAddSource :cc (cc/C) [(ptr i8) (ptr i8) (ptr i8)] (-> void))

(extern CFRunLoopSourceInvalidate :cc (cc/C) [(ptr i8)] (-> void))

(extern CFRelease :cc (cc/C) [(ptr i8)] (-> void))

(defstruct CFContext
  [(version i64)
   (info (ptr i8))
   (retain (ptr i8))
   (release (ptr i8))
   (description (ptr i8))])

;;; A socket's place on the run loop. Both are null until the server is watched.
(defstruct Watch [(descriptor (ptr i8)) (source (ptr i8))])

(defstruct Connection
  [(fd i32)
   (watch Watch)
   (input (ArrayList u8))
   (output (ArrayList u8))
   (sent i64)
   (opened f64)
   (state i64)])

(defstruct Server
  [(listener i32)
   (path (ArrayList u8))
   (watch Watch)
   (connections (ArrayList (ptr Connection)))
   ;; Set when the run loop says a socket is ready; cleared by pump!.
   (ready bool)
   (watching bool)
   ;; A C function that wakes the app's loop, or null.
   (wake (ptr i8))])

(defn nil? [(pointer (ptr i8))] (-> bool)
  (= (p/cast i64 pointer) 0))

;;; ---- the socket's directory ----------------------------------------------------

(defn path-bytes [(path (ptr i8))] (-> (slice u8))
  (slice::new (p/cast (ptr u8) path) (p/cast i64 (strlen path))))

;;; The directory holding PATH, as a NUL-terminated copy to free.
(defn parent-of [(path (ptr i8))] (-> (ArrayList u8))
  (let [bytes (path-bytes path)
        (mut slash) 0
        (mut out) (ArrayList::new [u8] (alloc/malloc-allocator))]
    (for [i 0 (len bytes)]
      (when (= (get bytes i) (: 47 u8)) (set! slash i)))
    (wire/push-str! (mut out) (subslice bytes 0 (load slash)))
    (push! (mut out) (: 0 u8))
    out))

;;; The socket's directory, made if missing, must be this user's alone. The peer-UID
;;; check on each connection is the second line of defense, not the first.
(defn private-parent? [(path (ptr i8))] (-> bool)
  (let [(mut parent) (parent-of path)
        directory (p/cast (ptr i8) (data (slice parent)))
        (mut status) (zeroed (array i8 144))
        made (mkdir directory (: 448 u16))
        usable
          (and (or (= made (: 0 i32)) (= (os/errno) EEXIST))
               (>= (lstat directory (p/cast (ptr i8) (mut status))) (: 0 i32)))
        bytes (p/cast (ptr i8) (mut status))
        mode (load (p/cast (ptr u16) (index bytes 4)))
        owner (load (p/cast (ptr u32) (index bytes 16)))]
    (ArrayList::free! (mut parent))
    (and usable
         (= (& mode (: 61440 u16)) (: 16384 u16))
         (= owner (getuid))
         (= (& mode (: 63 u16)) (: 0 u16)))))

(defn socket-file? [(path (ptr i8))] (-> bool)
  (let [(mut status) (zeroed (array i8 144))]
    (and (>= (lstat path (p/cast (ptr i8) (mut status))) (: 0 i32))
         (= (& (load (p/cast (ptr u16)
                             (index (p/cast (ptr i8) (mut status)) 4)))
               (: 61440 u16))
            (: 49152 u16)))))

(defn nonblocking! [(fd i32)] (-> bool)
  (let [flags (transport/fcntl fd F-GETFL)]
    (and (>= flags (: 0 i32))
         (>= (transport/fcntl fd F-SETFL (| flags O-NONBLOCK)) (: 0 i32)))))

;;; ---- listening -----------------------------------------------------------------

;;; A server at PATH, or null if it can't have PATH, which includes another app already
;;; answering there. A socket left by a crash answers nothing and is replaced.
(defn listen! [(path (ptr i8))] (-> (ptr Server))
  (let [none (p/cast (ptr Server) 0)
        length (p/cast i64 (strlen path))]
    (cond (>= length 104)
            (do (transport/log! c"remote path-too-long" 0 0 0 0) none)
          (not (private-parent? path))
            (do
              (transport/log! c"remote directory-not-private" 0 0 0 0)
              none)
          (transport/session-running? path)
            (do (transport/log! c"remote already-served" 0 0 0 0) none)
          :else
            (let [fd
                    (transport/socket transport/AF-UNIX transport/SOCK-STREAM 0)
                  address (p/alloc-stack transport/SockaddrUn)]
              (when (socket-file? path) (unlink path) 0)
              (set! address (zeroed transport/SockaddrUn))
              (set! (.length address) (: 106 u8))
              (set! (.family address) (p/cast u8 transport/AF-UNIX))
              (memcpy (p/cast (ptr i8) (index (field address path) 0))
                      path
                      (p/cast u64 (+ length 1)))
              (if (or (< fd (: 0 i32))
                      (< (transport/fcntl fd
                                          transport/F-SETFD
                                          transport/FD-CLOEXEC)
                         (: 0 i32))
                      (not (nonblocking! fd))
                      (< (bind fd (p/cast (ptr i8) address) (: 106 u32))
                         (: 0 i32))
                      (< (listen fd (: 16 i32)) (: 0 i32)))
                  (do
                    (when (>= fd (: 0 i32)) (transport/close fd) 0)
                    (transport/log! c"remote bind-failed errno=%ld"
                                    (p/cast i64 (os/errno))
                                    0
                                    0
                                    0)
                    none)
                  (let [a (alloc/malloc-allocator)
                        s (alloc/box! a Server (zeroed Server))]
                    (set! (.listener s) fd)
                    (set! (.path s) (ArrayList::new [u8] a))
                    (wire/push-str! (field s path) (path-bytes path))
                    (push! (field s path) (: 0 u8))
                    (set! (.connections s)
                          (ArrayList::new [(ptr Connection)] a))
                    s))))))

;;; ---- the run loop --------------------------------------------------------------

;;; Runs on the main thread, inside the run loop. The work waits for the app's loop.
(defn socket-ready [(descriptor (ptr i8)) (types u64) (info (ptr i8))] (-> void)
  (let [s (p/cast (ptr Server) info)]
    (set! (.ready s) true)
    (when (not (nil? (.wake s)))
      (call-ptr (p/cast (fnptr (cc/C) [] void) (.wake s))))))

(defn watch-fd [(s (ptr Server)) (fd i32)] (-> Watch)
  (let [(mut context)
          (CFContext
            :version 0
            :info (p/cast (ptr i8) s)
            :retain (p/cast (ptr i8) 0)
            :release (p/cast (ptr i8) 0)
            :description (p/cast (ptr i8) 0))
        descriptor
          (CFFileDescriptorCreate (p/cast (ptr i8) 0)
                                  fd
                                  (: 0 i8)
                                  (p/cast (ptr i8) (fnptr-of socket-ready))
                                  (p/cast (ptr i8) (mut context)))
        source
          (CFFileDescriptorCreateRunLoopSource (p/cast (ptr i8) 0) descriptor 0)]
    (CFRunLoopAddSource (CFRunLoopGetMain)
                        source
                        (ns c"kCFRunLoopDefaultMode"))
    (Watch :descriptor descriptor :source source)))

(defn unwatch! [(w Watch)] (-> void)
  (when (not (nil? (.descriptor w)))
    (CFRunLoopSourceInvalidate (.source w))
    (CFFileDescriptorInvalidate (.descriptor w))
    (CFRelease (.source w))
    (CFRelease (.descriptor w))))

;;; Have the run loop report S's sockets from now on. WAKE is a C function that wakes
;;; the app's loop, since a run loop source alone doesn't end a wait for events.
(defn watch! [(s (ptr Server)) (wake (ptr i8))] (-> void)
  (set! (.wake s) wake)
  (set! (.watching s) true)
  (set! (.watch s) (watch-fd s (.listener s)))
  (CFFileDescriptorEnableCallBacks (.descriptor (.watch s)) READ-CALLBACK))

;;; ---- connections ---------------------------------------------------------------

(defn close-connection! [(c (ptr Connection))] (-> void)
  (unwatch! (.watch c))
  (transport/close (.fd c))
  (ArrayList::free! (field c input))
  (ArrayList::free! (field c output))
  (alloc/destroy [Connection] (alloc/malloc-allocator) c))

(defn accept-one! [(s (ptr Server)) (now f64)] (-> bool)
  (let [fd (accept (.listener s) (p/cast (ptr i8) 0) (p/cast (ptr u32) 0))]
    (if (< fd (: 0 i32))
        false
        (let [(mut uid) (zeroed u32)
              (mut gid) (zeroed u32)
              (mut yes) (: 1 i32)]
          (transport/fcntl fd transport/F-SETFD transport/FD-CLOEXEC)
          (transport/setsockopt fd
                                transport/SOL-SOCKET
                                transport/SO-NOSIGPIPE
                                (p/cast (ptr i8) (mut yes))
                                (: 4 u32))
          (if (or (not (nonblocking! fd))
                  (< (transport/getpeereid fd (mut uid) (mut gid)) (: 0 i32))
                  (!= (load uid) (getuid))
                  (>= (len (.connections s)) MAX-CONNECTIONS))
              (do (transport/close fd) true)
              (let [a (alloc/malloc-allocator)
                    c (alloc/box! a Connection (zeroed Connection))]
                (set! (.fd c) fd)
                (set! (.input c) (ArrayList::new [u8] a))
                (set! (.output c) (ArrayList::new [u8] a))
                (set! (.opened c) now)
                (set! (.state c) READING)
                (when (.watching s) (set! (.watch c) (watch-fd s fd)))
                (push! (field s connections) c)
                true))))))

;;; The newline ending the request in INPUT, or -1.
(defn newline-at [(input (slice u8))] (-> i64)
  (let [(mut found) -1]
    (for [i 0 (len input)]
      (when (and (< (load found) 0) (= (get input i) (: 10 u8)))
        (set! found i)))
    (load found)))

(defn reply! [(c (ptr Connection)) (bytes (slice u8))] (-> void)
  (wire/push-str! (field c output) bytes)
  (wire/push-byte! (field c output) (: 10 u8))
  (set! (.state c) WRITING))

(defn reply-failure! [(c (ptr Connection)) (problem (slice u8))] (-> void)
  (let [(mut out) (ArrayList::new [u8] (alloc/malloc-allocator))]
    (wire/push-failure! (mut out) problem)
    (reply! c (slice out))
    (ArrayList::free! (mut out))))

;;; Read what C has sent. A request ends at its first newline, or at the client's end
;;; of file, so `nc -U` and the like can talk to this too.
(defn read-request! [(c (ptr Connection))] (-> void)
  (let [(mut buffer) (zeroed (array u8 65536))
        (mut more) true]
    (while (and (load more) (= (.state c) READING))
      (let [got
              (transport/recv (.fd c)
                              (p/cast (ptr i8) (mut buffer))
                              (: 65536 isize)
                              (: 0 i32))]
        (cond (> got (: 0 isize))
                (do
                  (extend! (field c input)
                           (p/cast (ptr u8) (mut buffer))
                           (p/cast i64 got))
                  (cond (>= (newline-at (slice (.input c))) 0)
                          (set! (.state c) READY)
                        (> (len (.input c)) wire/MAX-REQUEST)
                          (reply-failure! c "Request is too long")
                        :else (do)))
              (= got (: 0 isize))
                (set! (.state c) (if (> (len (.input c)) 0) READY CLOSED))
              :else
                (do
                  (set! more false)
                  (when (!= (os/errno) EAGAIN) (set! (.state c) CLOSED))))))))

(defn write-reply! [(c (ptr Connection))] (-> void)
  (let [(mut more) true
        total (len (.output c))]
    (while (and (load more) (< (.sent c) total))
      (let [sent
              (transport/send (.fd c)
                              (p/cast (ptr i8)
                                      (index (data (slice (.output c)))
                                             (.sent c)))
                              (p/cast isize (- total (.sent c)))
                              (: 0 i32))]
        (if (> sent (: 0 isize))
            (set! (.sent c) (+ (.sent c) (p/cast i64 sent)))
            (do
              (set! more false)
              (when (!= (os/errno) EAGAIN) (set! (.state c) CLOSED))))))
    (when (and (= (.state c) WRITING) (>= (.sent c) total))
      (set! (.state c) CLOSED))))

;;; Ask the run loop about what C is waiting for. Callbacks are one-shot.
(defn rearm! [(c (ptr Connection))] (-> void)
  (when (not (nil? (.descriptor (.watch c))))
    (cond (= (.state c) READING)
            (CFFileDescriptorEnableCallBacks (.descriptor (.watch c))
                                             READ-CALLBACK)
          (= (.state c) WRITING)
            (CFFileDescriptorEnableCallBacks (.descriptor (.watch c))
                                             WRITE-CALLBACK)
          :else (do))))

(defn timed-out? [(c (ptr Connection)) (now f64)] (-> bool)
  (let [waited (- now (.opened c))]
    (or (and (= (.state c) READING) (> waited REQUEST-SECONDS))
        (and (= (.state c) WRITING) (> waited REPLY-SECONDS)))))

;;; Drop the connections that are finished, keeping the rest in order.
(defn sweep! [(s (ptr Server))] (-> void)
  (let [(mut kept) 0
        total (len (.connections s))]
    (for [i 0 total]
      (let [c (get (.connections s) i)]
        (if (= (.state c) CLOSED)
            (close-connection! c)
            (do
              (set! (mut (.connections s)) (load kept) c)
              (set! kept (+ (load kept) 1))))))
    (while (> (len (.connections s)) (load kept))
      (pop! [(ptr Connection)] (field s connections))
      (do))))

;;; Accept, read and write whatever is ready without blocking. NOW is in seconds.
(defn pump! [(s (ptr Server)) (now f64)] (-> void)
  (set! (.ready s) false)
  (while (accept-one! s now) (do))
  (for [i 0 (len (.connections s))]
    (let [c (get (.connections s) i)]
      (when (= (.state c) READING) (read-request! c))
      (when (= (.state c) WRITING) (write-reply! c))
      (when (timed-out? c now) (set! (.state c) CLOSED))))
  (sweep! s)
  (for [i 0 (len (.connections s))] (rearm! (get (.connections s) i)))
  (when (not (nil? (.descriptor (.watch s))))
    (CFFileDescriptorEnableCallBacks (.descriptor (.watch s)) READ-CALLBACK)))

;;; Whether pump! has anything to do: open connections are checked for their timeouts.
(defn due? [(s (ptr Server))] (-> bool)
  (or (.ready s) (> (len (.connections s)) 0)))

;;; The next client with a whole request, or null. Each is returned once, and must be
;;; answered with answer!.
(defn take-request! [(s (ptr Server))] (-> (ptr Connection))
  (let [(mut found) (p/cast (ptr Connection) 0)]
    (for [i 0 (len (.connections s))]
      (let [c (get (.connections s) i)]
        (when (and (nil? (p/cast (ptr i8) (load found))) (= (.state c) READY))
          (set! (.state c) SERVING)
          (set! found c))))
    (load found)))

;;; C's request, without the newline that ended it. Valid until answer!.
(defn request [(c (ptr Connection))] (-> (slice u8))
  (let [input (slice (.input c))
        end (newline-at input)]
    (if (>= end 0) (subslice input 0 end) input)))

;;; Send REPLY to C, as much as fits now. pump! sends the rest and closes the
;;; connection, and C may be gone by the time this returns.
(defn answer! [(s (ptr Server)) (c (ptr Connection)) (reply (slice u8))]
  (-> void)
  (reply! c reply)
  (write-reply! c)
  (rearm! c)
  (when (= (.state c) CLOSED) (sweep! s)))

;;; Stop serving: the socket file goes too, so a client sees that nothing is running.
(defn close! [(s (ptr Server))] (-> void)
  (for [i 0 (len (.connections s))]
    (close-connection! (get (.connections s) i)))
  (ArrayList::free! (field s connections))
  (unwatch! (.watch s))
  (transport/close (.listener s))
  (unlink (p/cast (ptr i8) (data (slice (.path s)))))
  (ArrayList::free! (field s path))
  (alloc/destroy [Server] (alloc/malloc-allocator) s))
