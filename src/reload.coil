(module jim.reload)
(import "jim.native" :use *)
(import "coil.primitive" :as p)

(extern dlopen :cc c [(ptr i8) i32] (-> (ptr i8)))

(extern dlsym :cc c [(ptr i8) (ptr i8)] (-> (ptr i8)))

(extern dlclose :cc c [(ptr i8)] (-> i32))

(defstruct Config
  [(duration f64)
   (sidebar f64)
   (accent-r f64)
   (accent-g f64)
   (accent-b f64)
   (canvas-r f64)
   (canvas-g f64)
   (canvas-b f64)
   (rail-r f64)
   (rail-g f64)
   (rail-b f64)
   (pane-r f64)
   (pane-g f64)
   (pane-b f64)
   (ink-r f64)
   (ink-g f64)
   (ink-b f64)
   (muted-r f64)
   (muted-g f64)
   (muted-b f64)
   (shadow-r f64)
   (shadow-g f64)
   (shadow-b f64)
   (edge-width f64)
   (edge-distance f64)
   (edge-strength f64)])

(defn defaults [] (-> Config)
  (Config
    :duration 0.42
    :sidebar 224.0
    :accent-r 0.4
    :accent-g 0.78
    :accent-b 0.96
    :canvas-r 0.055
    :canvas-g 0.07
    :canvas-b 0.095
    :rail-r 0.075
    :rail-g 0.09
    :rail-b 0.12
    :pane-r 0.105
    :pane-g 0.135
    :pane-b 0.18
    :ink-r 0.88
    :ink-g 0.91
    :ink-b 0.96
    :muted-r 0.51
    :muted-g 0.57
    :muted-b 0.65
    :shadow-r 0.005
    :shadow-g 0.009
    :shadow-b 0.018
    :edge-width 140.0
    :edge-distance 600.0
    :edge-strength 0.95))

(defn bounded? [(x f64) (low f64) (high f64)] (-> bool)
  (and (>= x low) (<= x high)))

(defn valid? [(c Config)] (-> bool)
  (and (bounded? (.duration c) 0.05 2.0)
       (and (bounded? (.sidebar c) 160.0 360.0)
            (and (bounded? (.accent-r c) 0.0 1.0)
                 (and (bounded? (.accent-g c) 0.0 1.0)
                      (and (bounded? (.accent-b c) 0.0 1.0)
                           (and (bounded? (.canvas-r c) 0.0 1.0)
                                (and (bounded? (.canvas-g c) 0.0 1.0)
                                     (and (bounded? (.canvas-b c) 0.0 1.0)
                                          (and (bounded? (.rail-r c) 0.0 1.0)
                                               (and (bounded? (.rail-g c) 0.0 1.0)
                                                    (and (bounded? (.rail-b c) 0.0 1.0)
                                                         (and (bounded? (.pane-r c) 0.0 1.0)
                                                              (and (bounded? (.pane-g c) 0.0 1.0)
                                                                   (and (bounded? (.pane-b c) 0.0 1.0)
                                                                        (and (bounded? (.ink-r c) 0.0 1.0)
                                                                             (and (bounded? (.ink-g c) 0.0 1.0)
                                                                                  (and (bounded? (.ink-b c) 0.0 1.0)
                                                                                       (and (bounded? (.muted-r c)
                                                                                                      0.0
                                                                                                      1.0)
                                                                                            (and (bounded? (.muted-g c)
                                                                                                           0.0
                                                                                                           1.0)
                                                                                                 (and (bounded? (.muted-b c)
                                                                                                                0.0
                                                                                                                1.0)
                                                                                                      (and (bounded? (.shadow-r c)
                                                                                                                     0.0
                                                                                                                     1.0)
                                                                                                           (and (bounded? (.shadow-g c)
                                                                                                                          0.0
                                                                                                                          1.0)
                                                                                                                (and (bounded? (.shadow-b c)
                                                                                                                               0.0
                                                                                                                               1.0)
                                                                                                                     (and (bounded? (.edge-width c)
                                                                                                                                    20.0
                                                                                                                                    240.0)
                                                                                                                          (and (bounded? (.edge-distance c)
                                                                                                                                         50.0
                                                                                                                                         4000.0)
                                                                                                                               (bounded? (.edge-strength c)
                                                                                                                                         0.0
                                                                                                                                         1.0)))))))))))))))))))))))))))

;;; Load a unique completed image, validate its ABI and values, then copy only
;;; plain data into the host. No code pointers survive dlclose.
(defn load-config! [(path (ptr i8)) (out (ptr Config))] (-> bool)
  (let [image (dlopen path 2)]
    (if (= (p/cast i64 image) 0)
        false
        (let [version (dlsym image c"jim_config_version")
              value (dlsym image c"jim_config_value")
              (mut accepted) false]
          (do
            (if (and (!= (p/cast i64 version) 0) (!= (p/cast i64 value) 0))
                (if (= (p/call-ptr (p/cast (fnptr c [] i64) version)) 2)
                    (let [f (p/cast (fnptr c [i64] f64) value)
                          c
                            (Config
                              :duration (p/call-ptr f 0)
                              :sidebar (p/call-ptr f 1)
                              :accent-r (p/call-ptr f 2)
                              :accent-g (p/call-ptr f 3)
                              :accent-b (p/call-ptr f 4)
                              :canvas-r (p/call-ptr f 5)
                              :canvas-g (p/call-ptr f 6)
                              :canvas-b (p/call-ptr f 7)
                              :rail-r (p/call-ptr f 8)
                              :rail-g (p/call-ptr f 9)
                              :rail-b (p/call-ptr f 10)
                              :pane-r (p/call-ptr f 11)
                              :pane-g (p/call-ptr f 12)
                              :pane-b (p/call-ptr f 13)
                              :ink-r (p/call-ptr f 14)
                              :ink-g (p/call-ptr f 15)
                              :ink-b (p/call-ptr f 16)
                              :muted-r (p/call-ptr f 17)
                              :muted-g (p/call-ptr f 18)
                              :muted-b (p/call-ptr f 19)
                              :shadow-r (p/call-ptr f 20)
                              :shadow-g (p/call-ptr f 21)
                              :shadow-b (p/call-ptr f 22)
                              :edge-width (p/call-ptr f 23)
                              :edge-distance (p/call-ptr f 24)
                              :edge-strength (p/call-ptr f 25))]
                      (if (valid? c) (do (store! out c) (store! accepted true)) 0))
                    0)
                0)
            (dlclose image)
            (load accepted))))))
