(module jim.atelier-ui)
(import "paper.flow" :use *)
(import "paper.platform" :as host)
(import "paper.lighting" :as light)
(import "paper.ffi" :use [sin cos])
(import "jim.atelier-model" :as model)
(import "jim.atelier-plugin" :as plugin)
(import "jim.native" :as n)
(import "jim.storage" :as storage)
(import "coil.primitive" :as p)

(defn lighting [] (-> (ptr light/Lighting))
  (p/alloc-static light/Lighting))

(defn stock-name [(i i64)] (-> (ptr i8))
  (case i 0
        c"Moss felt" 1
        c"Bookbinder's linen" 2
        c"Warm cork" 3
        c"Midnight suede" 4
        c"Walnut veneer" c"Clay cardstock"))

(defn desk-stock [(i i64)] (-> Material)
  (case i 0
        (felt 0x687460) 1
        (woven-linen 0xb8aa90) 2
        (cork 0xb69370) 3
        (suede 0x3d4f58) 4
        (wood-veneer 0x8c6950) (cardstock 0xb47d67)))

(defn tab-name [(i i64)] (-> (ptr i8))
  (case i 0 c"The desk" 1 c"Fieldnotes" 2 c"Materials" c"Workshop"))

;;; A custom stamped button avoids changing the material into generic chrome.
(defn stamp [(id i64) (r Rect) (title (ptr i8)) (selected bool)] (-> i64)
  (panel r
         6.0
         (if selected 26.0 22.0)
         (control-stock id (if selected (cotton 0xe8dec5) (kraft 0xc8b897))))
  (caption (inset r 12.0) 13.0 0x3c4638 3 title)
  (hit id r title))

(defn masthead [] (-> i64)
  (panel (rect 26.0 28.0 1228.0 104.0) 12.0 16.0 (laid-paper 0xe7dfcc))
  (panel (rect 26.0 28.0 8.0 104.0) 2.0 19.0 (leather 0xa6533a))
  (label 52.0 41.0 40.0 0x344034 1 c"jim")
  (label 129.0 52.0 12.0 0x696b58 2 c"/ ATELIER")
  (label 54.0 97.0 11.0 0x737260 0 c"A place to leave things in progress.")
  (for [i 0 4]
    (stamp (+ 10 i)
           (rect (+ 464.0 (* (cast f64 i) 164.0)) 62.0 150.0 44.0)
           (tab-name i)
           (= i (.page (model/state)))))
  (host/paper_drag_area (rect 240.0 28.0 850.0 29.0))
  0)

(defn rosette [(x f64) (y f64) (radius f64) (count i64) (blue? bool)] (-> i64)
  (disc (- x radius)
        (- y radius)
        (* radius 2.0)
        13.0
        (if blue? (cotton 0xb6c9c9) (cotton 0xd9ccaa)))
  (for [i 0 count]
    (let [angle (* (/ (cast f64 i) (cast f64 count)) 6.283185307179586)
          dx (cos angle)
          dy (sin angle)
          px (- 0.0 dy)
          py dx
          inner (* radius 0.16)
          outer (* radius 0.87)
          side (* radius 0.26)]
      (begin-sheet)
      (move-to (+ x (* dx inner)) (+ y (* dy inner)))
      (curve-to (+ x (+ (* dx (* radius 0.48)) (* px side)))
                (+ y (+ (* dy (* radius 0.48)) (* py side)))
                (+ x (+ (* dx outer) (* px side)))
                (+ y (+ (* dy outer) (* py side)))
                (+ x (* dx outer))
                (+ y (* dy outer)))
      (curve-to (+ x (- (* dx outer) (* px side)))
                (+ y (- (* dy outer) (* py side)))
                (+ x (- (* dx (* radius 0.48)) (* px side)))
                (+ y (- (* dy (* radius 0.48)) (* py side)))
                (+ x (* dx inner))
                (+ y (* dy inner)))
      (close-path)
      (finish-sheet (+ 20.0 (* (cast f64 (% i 3)) 3.0))
                    (if blue?
                        (case (% i 3) 0
                              (cotton 0x9fb9b8) 1
                              (laid-paper 0xd6d9c6) (recycled 0x6f9798))
                        (case (% i 3) 0
                              (cotton 0xd29a63) 1
                              (laid-paper 0xf0d3a0) (recycled 0xb97a52))))))
  (disc (- x (* radius 0.18))
        (- y (* radius 0.18))
        (* radius 0.36)
        31.0
        (kraft 0x6d7050))
  (disc (- x (* radius 0.075))
        (- y (* radius 0.075))
        (* radius 0.15)
        33.0
        (brushed-aluminum 0xc5b58d))
  0)

(defn terminal-bounds [] (-> Rect)
  (let [s (.terminal (model/state))]
    (rect (+ (.x s) 16.0) (+ (.y s) 55.0) 712.0 338.0)))

(defn terminal-slip [(live bool) (failed bool)] (-> i64)
  (let [s (.terminal (model/state))
        x (.x s)
        y (.y s)]
    (panel (rect (+ x 7.0) (+ y 8.0) 744.0 424.0) 7.0 10.0 (kraft 0xb6a987))
    (panel (rect x y 744.0 424.0) 7.0 18.0 (cotton 0xeee4cf))
    (label (+ x 18.0) (+ y 15.0) 11.0 0x7e735e 2 c"01 / WORKING TERMINAL")
    (label (+ x 526.0) (+ y 15.0) 10.0 0x7e735e 2 c"DRAG THIS EDGE")
    (hit 100 (rect x y 690.0 44.0) c"Move terminal slip")
    (stamp 41 (rect (+ x 698.0) (+ y 7.0) 34.0 34.0) c"−" false)
    (panel (terminal-bounds) 3.0 20.0 (smooth 0x171d22))
    (when (not live)
      (label (+ x 38.0)
             (+ y 88.0)
             22.0
             0xc9d0bb
             1
             (if failed c"The shell is waiting." c"Room for a running thought."))
      (caption (rect (+ x 38.0) (+ y 132.0) 570.0 66.0)
               14.0
               0x9ca99b
               2
               (if failed
                   c"Connection unavailable. Your session ID is preserved."
                   c"A real Ghostty terminal lives here.\nOpen a shell to begin; it stays alive when you leave."))
      (button 45
              (rect (+ x 38.0) (+ y 238.0) 192.0 44.0)
              (if failed c"Reconnect shell" c"Open a shell")
              false
              (cotton 0xcbd1b7)))
    (ink-height 22.0)
    (label (+ x 19.0)
           (+ y 402.0)
           10.0
           0x7f7765
           2
           c"PRIVATE SESSION / APP CLOSE DETACHES / SHELL KEEPS RUNNING")
    0))

(defn latest-note [] (-> (ptr i8))
  (let [notes (.notes (model/state))]
    (if (> (storage/count notes) 0)
        (n/utf8 (storage/at notes (- (storage/count notes) 1)))
        c"What if your tools felt like things you could pick up, set aside, and come back to?")))

(defn memo-slip [] (-> i64)
  (let [s (.memo (model/state))
        x (.x s)
        y (.y s)]
    (panel (rect (+ x 4.0) (+ y 5.0) 326.0 226.0) 2.0 12.0 (kraft 0xc3ac70))
    (panel (rect x y 326.0 226.0) 2.0 22.0 (washi 0xe9dba9))
    (panel (rect (+ x 118.0) (- y 8.0) 88.0 20.0)
           1.0
           25.0
           (woven-linen 0xc2b794))
    (label (+ x 24.0) (+ y 24.0) 10.0 0x8b7958 2 c"A LOOSE THOUGHT")
    (hit 101 (rect x y 276.0 50.0) c"Move note slip")
    (stamp 46 (rect (+ x 281.0) (+ y 8.0) 34.0 34.0) c"−" false)
    (ink-height 24.0)
    (for [i 0 5]
      (rule (+ x 23.0) (+ y (+ 82.0 (* (cast f64 i) 24.0))) 280.0 0xc9bf98))
    (caption (rect (+ x 24.0) (+ y 57.0) 277.0 124.0)
             20.0
             0x555740
             1
             (latest-note))
    (ink-height 24.0)
    (label (+ x 24.0) (+ y 196.0) 11.0 0x807453 0 c"Continue in Fieldnotes →")
    (hit 14 (rect x (+ y 180.0) 326.0 45.0) c"Open fieldnotes")
    0))

(defn specimen-slip [] (-> i64)
  (let [s (.specimen (model/state))
        x (.x s)
        y (.y s)]
    (panel (rect x y 310.0 240.0) 5.0 23.0 (laid-paper 0xe5dcc6))
    (with-elevation 12.0
                    (rosette (+ x 155.0)
                             (+ y 104.0)
                             78.0
                             (.value (plugin/state))
                             false))
    (ink-height 46.0)
    (label (+ x 22.0) (+ y 197.0) 10.0 0x77705d 2 c"SPECIMEN / 001")
    (label (+ x 188.0) (+ y 197.0) 11.0 0x77705d 1 c"grown in Coil")
    (hit 102 (rect x y 264.0 42.0) c"Move specimen slip")
    (with-elevation 4.0
                    (stamp 47
                           (rect (+ x 269.0) (+ y 7.0) 34.0 34.0)
                           c"−"
                           false))
    (ink-height 46.0)
    (hit 15 (rect x (+ y 166.0) 310.0 70.0) c"Open specimen workshop")
    0))

(defn desktop [(live bool) (failed bool)] (-> i64)
  (ink-height 8.0)
  (label 62.0 157.0 11.0 0xe0ddca 2 c"THE WORKING SURFACE")
  (label 914.0 143.0 10.0 0xe0ddca 2 (stock-name (.stock (model/state))))
  (when (.visible (.terminal (model/state))) (terminal-slip live failed))
  (when (.visible (.memo (model/state))) (memo-slip))
  (when (.visible (.specimen (model/state))) (specimen-slip))
  (panel (rect 54.0 721.0 1172.0 59.0) 10.0 14.0 (leather 0x514e40))
  (stamp 40 (rect 69.0 729.0 151.0 43.0) c"+ Terminal" false)
  (stamp 42 (rect 231.0 729.0 140.0 43.0) c"+ Note slip" false)
  (stamp 43 (rect 382.0 729.0 158.0 43.0) c"+ Specimen" false)
  (stamp 44 (rect 976.0 729.0 234.0 43.0) c"Gather the loose ends" false)
  (ink-height 25.0)
  (label 570.0 744.0 11.0 0xd4ccb7 1 c"Leave a little room for the unexpected.")
  0)

(defn notebook [] (-> i64)
  (panel (rect 52.0 166.0 1176.0 598.0) 12.0 10.0 (polished-leather 0x725442))
  (panel (rect 64.0 172.0 1150.0 578.0) 5.0 14.0 (kraft 0xc0ae8d))
  (panel (rect 73.0 175.0 565.0 561.0) 3.0 20.0 (laid-paper 0xefe6d2))
  (panel (rect 640.0 175.0 564.0 561.0) 3.0 20.0 (cotton 0xf2ead8))
  (panel (rect 630.0 175.0 18.0 561.0) 1.0 24.0 (woven-linen 0xc5b597))
  (panel (rect 1112.0 173.0 23.0 103.0) 1.0 25.0 (velvet 0xa5573f))
  (for [i 0 15]
    (rule 105.0 (+ 288.0 (* (cast f64 i) 26.0)) 486.0 0xd5d0bb)
    (rule 681.0 (+ 288.0 (* (cast f64 i) 26.0)) 479.0 0xdad4bf))
  (ink-height 26.0)
  (label 108.0 207.0 10.0 0x8a8069 2 c"JIM'S FIELDNOTES / OBSERVATIONS")
  (label 105.0 238.0 31.0 0x424b3a 1 c"Things worth keeping.")
  (let [notes (.notes (model/state))
        total (storage/count notes)
        page (.note-page (model/state))
        start (* page 3)]
    (if (= total 0)
        (do
          (caption (rect 108.0 319.0 446.0 160.0)
                   23.0
                   0x68705b
                   1
                   c"A notebook does not need a plan.\n\nA question, a fragment, a small discovery. Start anywhere.")
          (label 108.0 651.0 11.0 0x8b836e 2 c"YOUR FIRST PAGE IS STILL BLANK"))
        (for [i 0 3]
          (when (< (+ start i) total)
            (let [y (+ 309.0 (* (cast f64 i) 113.0))]
              (number 108.0 y 11.0 0x9c7356 (+ (+ start i) 1))
              (caption (rect 143.0 y 433.0 95.0)
                       19.0
                       0x4d5741
                       1
                       (n/utf8 (storage/at notes (+ start i))))))))
    (with-enabled (> page 0)
                  (stamp 51 (rect 108.0 684.0 100.0 36.0) c"← Earlier" false))
    (with-enabled (< (+ start 3) total)
                  (stamp 52 (rect 468.0 684.0 115.0 36.0) c"Later →" false)))
  (ink-height 26.0)
  (label 684.0 207.0 10.0 0x8a8069 2 c"ON THE NEXT PAGE")
  (label 681.0 239.0 31.0 0x424b3a 1 c"Catch a thought.")
  (input 500 (rect 682.0 319.0 473.0 62.0) c"What are you thinking about?")
  (button 50
          (rect 971.0 401.0 183.0 44.0)
          c"Keep this thought"
          false
          (recycled 0xc0c9a8))
  (ink-height 35.0)
  (label 685.0
         415.0
         12.0
         0x7c806a
         1
         (if (.saved (model/state))
             c"Written into your notebook."
             c"A little ink goes a long way."))
  (rosette 931.0 573.0 83.0 7 false)
  (ink-height 35.0)
  (label 685.0
         686.0
         10.0
         0x8a8069
         2
         c"SAVED LOCALLY / RETURN WHENEVER YOU LIKE")
  0)

(defn cabinet [] (-> i64)
  (panel (rect 48.0 165.0 1184.0 604.0) 13.0 9.0 (wood-veneer 0xa2805f))
  (panel (rect 66.0 182.0 1148.0 116.0) 5.0 17.0 (kraft 0xd6c7a8))
  (label 91.0
         201.0
         10.0
         0x7c725b
         2
         c"THE MATERIAL CABINET / SIX WORKING SURFACES")
  (label 89.0 231.0 34.0 0x3e4738 1 c"The surface changes the work.")
  (label 808.0
         250.0
         12.0
         0x766e5b
         0
         c"Choose a swatch. Take it back to your desk.")
  (for [i 0 6]
    (let [x (+ 69.0 (* (cast f64 (% i 3)) 382.0))
          y (+ 318.0 (* (cast f64 (/ i 3)) 216.0))]
      (panel (rect x y 374.0 205.0) 5.0 15.0 (rubber 0x514a3c))
      (panel (rect (+ x 9.0) (+ y 9.0) 356.0 139.0) 4.0 23.0 (desk-stock i))
      (begin-sheet)
      (rounded-path (rect (+ x 24.0) (+ y 27.0) 116.0 95.0) 2.0)
      (oval-path (rect (+ x 45.0) (+ y 45.0) 57.0 57.0))
      (finish-sheet 32.0 (cotton 0xece3cd))
      (panel (rect (+ x 162.0) (+ y 40.0) 171.0 62.0)
             3.0
             31.0
             (laid-paper 0xdac9a4))
      (label (+ x 178.0) (+ y 52.0) 10.0 0x756953 2 c"MATERIAL STUDY")
      (number (+ x 178.0) (+ y 69.0) 16.0 0x756953 (+ i 1))
      (stamp (+ 60 i)
             (rect (+ x 9.0) (+ y 157.0) 356.0 39.0)
             (stock-name i)
             (= i (.stock (model/state))))))
  0)

(defn workshop [] (-> i64)
  (panel (rect 48.0 165.0 1184.0 604.0) 10.0 9.0 (canvas 0x496775))
  (for [i 0 22] (rule 65.0 (+ 178.0 (* (cast f64 i) 27.0)) 1150.0 0x597684))
  (panel (rect 71.0 188.0 652.0 548.0) 4.0 17.0 (laid-paper 0xe3e3d1))
  (label 96.0 211.0 10.0 0x6e7b71 2 c"LIVE COIL / SPECIMEN BENCH")
  (label 93.0 242.0 36.0 0x34504d 1 c"Make a tool. Keep it alive.")
  (caption (rect 97.0 300.0 573.0 62.0)
           16.0
           0x65776b
           0
           c"A little source becomes a physical object on your desk. Change its form, save, and watch a new specimen arrive.")
  (panel (rect 96.0 381.0 600.0 132.0) 5.0 24.0 (cardstock 0xcbd6c9))
  (label 114.0 397.0 10.0 0x688073 2 c"plugins/rosette.coil")
  (label 115.0 430.0 18.0 0x36524b 2 c"(defn specimen [] (-> i64)")
  (number 139.0 462.0 20.0 0x9b6c4a (.value (plugin/state)))
  (label 179.0 463.0 18.0 0x36524b 2 c")")
  (stamp 70 (rect 96.0 536.0 178.0 44.0) c"Open source" false)
  (stamp 71 (rect 285.0 536.0 183.0 44.0) c"Compile & publish" false)
  (stamp 72
         (rect 479.0 536.0 216.0 44.0)
         (if (.paused (plugin/state)) c"Resume experiment" c"Pause experiment")
         (.paused (plugin/state)))
  (ink-height 36.0)
  (caption (rect 98.0 603.0 582.0 54.0)
           14.0
           0x607466
           0
           (if (.paused (plugin/state))
               c"Paused. Source watching and the active worker are suspended."
               (n/utf8 (.diagnostic (plugin/state)))))
  (stamp 73 (rect 96.0 674.0 225.0 38.0) c"Read diagnostic log" false)
  (ink-height 37.0)
  (label 470.0 685.0 10.0 0x6c7c70 2 c"NATIVE JIT / ISOLATED WORKER")
  (panel (rect 753.0 189.0 448.0 422.0) 5.0 14.0 (washi 0xc9d7d0))
  (rosette 977.0 383.0 160.0 (.value (plugin/state)) true)
  (ink-height 36.0)
  (label 781.0 566.0 11.0 0x53746e 2 c"SPECIMEN 001 / RADIAL PAPER")
  (label 1080.0 566.0 11.0 0x53746e 2 c"v")
  (number 1095.0 563.0 15.0 0x53746e (.generation (plugin/state)))
  (panel (rect 754.0 634.0 448.0 102.0) 5.0 18.0 (kraft 0xccc9aa))
  (label 777.0 650.0 17.0 0x536354 1 c"A failed experiment is still useful.")
  (caption (rect 777.0 682.0 400.0 40.0)
           12.0
           0x69725e
           0
           c"Rejected builds leave your last good specimen in place.\nYour desk and terminals keep going.")
  0)

(defn draw [(live bool) (failed bool)] (-> i64)
  (host/paper_begin 0x4d594d)
  (light/apply-light (lighting) (rect 0.0 0.0 1280.0 800.0))
  (panel (rect 0.0 0.0 1280.0 800.0)
         0.0
         3.0
         (case (.page (model/state)) 1
               (woven-linen 0x9b9b7d) 2
               (felt 0x69705e) 3
               (suede 0x354e59) (desk-stock (.stock (model/state)))))
  (masthead)
  (case (.page (model/state)) 0
        (desktop live failed) 1
        (notebook) 2
        (cabinet) (workshop))
  (light/popover (lighting) 900 (rect 1189.0 40.0 37.0 37.0))
  0)
