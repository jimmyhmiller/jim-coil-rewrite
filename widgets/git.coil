(module widgets.git)
(import "coil.alloc" :as alloc)
(import "coil.arraylist" :use *)
(import "coil.slice" :use *)
(import "coil.serde" :use *)
(import "coil.serde.derive" :use *)
(import "jim.widget-api" :use *)
(import "jim.widget-kit.text" :as text)
(import "jim.widget-kit.proc" :as proc)
(import "jim.widget-kit.live" :as live)

;;; Git status for the project: branch, changed files and recent commits. With
;;; Live on it follows the repository as it changes — edits, commits, checkouts
;;; made anywhere — by watching its files; git runs in the background.
(const MAX-FILES 12)

;;; What survives reloads and restarts.
(defstruct State [(live bool) (refreshes i64)])

(derive Serialize Deserialize State)

(defstruct Git
  [(status-job proc/Job)
   (log-job proc/Job)
   (status (ArrayList u8))
   (log (ArrayList u8))
   (repo (ArrayList u8))
   (outside live/Refresher)
   (state State)])

(defn refresh! [(g (ptr Git))] (-> void)
  (live/started! (field g outside))
  (when (not (proc/running? (field g status-job)))
    (proc/start! (field g status-job)
                 ["git" "status" "--porcelain=v1" "--branch"]
                 (slice (.repo g))
                 0)
    0)
  (when (not (proc/running? (field g log-job)))
    (proc/start! (field g log-job)
                 ["git" "log" "-6" "--format=%h %s"]
                 (slice (.repo g))
                 0)
    0)
  (set! (.refreshes (.state g)) (+ (.refreshes (.state g)) 1))
  (do))

(defn running? [(g (ptr Git))] (-> bool)
  (or (proc/running? (field g status-job)) (proc/running? (field g log-job))))

(defn poll! [(g (ptr Git))] (-> void)
  (when (and (proc/running? (field g status-job))
             (proc/poll! (field g status-job)))
    (text/set-str! (field g status) (proc/output (field g status-job)))
    0)
  (when (and (proc/running? (field g log-job)) (proc/poll! (field g log-job)))
    (text/set-str! (field g log) (proc/output (field g log-job)))
    0)
  (when (live/due? (field g outside) (running? g)) (refresh! g) 0)
  (do))

;;; Number of newline-terminated lines in TEXT.
(defn line-count [(text (slice u8))] (-> i64)
  (let [(mut n) 0]
    (for [i 0 (len text)]
      (when (= (get text i) (: 10 u8)) (set! n (+ (load n) 1))))
    (load n)))

(defn line [(text (slice u8)) (index i64)] (-> (slice u8))
  (let [(mut start) 0
        (mut seen) 0
        (mut end) (len text)]
    (for [i 0 (len text)]
      (when (= (get text i) (: 10 u8))
        (cond (= (load seen) index)
                (do (set! end i) (set! seen (+ (load seen) 1)) 0)
              (< (load seen) index)
                (do (set! start (+ i 1)) (set! seen (+ (load seen) 1)) 0)
              :else 0)))
    (subslice text
              (load start)
              (if (< (load end) (load start)) (load start) (load end)))))

(defn status-color [(code (slice u8))] (-> i64)
  (let [x (get code 0)
        y (get code 1)]
    (cond (= x (: 63 u8)) 0x9098a4
          (or (= x (: 68 u8)) (= y (: 68 u8))) 0xe08a8a
          (or (= x (: 65 u8)) (= x (: 82 u8))) 0x8fd18f
          :else 0xc79bf2)))

(defn status-label [(code (slice u8))] (-> (slice u8))
  (let [x (get code 0)
        y (get code 1)]
    (cond (= x (: 63 u8)) "new  "
          (or (= x (: 68 u8)) (= y (: 68 u8))) "del  "
          (= x (: 65 u8)) "add  "
          (= x (: 82 u8)) "ren  "
          :else "mod  ")))

(defn render-files! [(g (ptr Git)) (ui (ptr Ui))] (-> void)
  (let [text (slice (.status g))
        lines (line-count text)
        files (if (> lines 0) (- lines 1) 0)]
    (if (= files 0)
        (do (text! ui "Working tree clean" 12.0 0x8fd18f false) 0)
        (do
          (text! ui "" 11.0 0x9098a4 false)
          (append-i64! ui files)
          (append! ui (if (= files 1) " changed file" " changed files"))
          (for [i 1 (+ 1 (if (> files MAX-FILES) MAX-FILES files))]
            (let [l (line text i)]
              (when (> (len l) 3)
                (let [code (subslice l 0 2)]
                  (hstack! ui 6.0 0.0)
                  (text! ui (status-label code) 11.0 (status-color code) true)
                  (text! ui
                         (subslice l 3 (len l))
                         12.0
                         0xcfd2d8
                         false)
                  (end! ui)
                  0))
              0))
          (when (> files MAX-FILES)
            (text! ui "… and " 11.0 0x7f8794 false)
            (append-i64! ui (- files MAX-FILES))
            (append! ui " more")
            0)
          0))
    (do)))

(defn render-log! [(g (ptr Git)) (ui (ptr Ui))] (-> void)
  (let [text (slice (.log g))]
    (text! ui "Recent commits (last 6)" 11.0 0x9098a4 true)
    (for [i 0 (line-count text)]
      (let [l (line text i)]
        (when (> (len l) 8)
          (hstack! ui 8.0 0.0)
          (text! ui (subslice l 0 7) 12.0 0x66c7f5 false)
          (text! ui
                 (subslice l 8 (len l))
                 12.0
                 0xcfd2d8
                 false)
          (end! ui)
          0)
        0))
    (do)))

(impl Widget Git
  (render [(self (ptr Git)) (ui (ptr Ui))]
    (-> void)
    (let [status (slice (.status self))
          branch (line status 0)]
      (title! ui "git")
      (when (.live (.state self)) (watch! ui (slice (.repo self))) 0)
      (vstack! ui 8.0 14.0)
      (hstack! ui 10.0 0.0)
      (text! ui "⎇ git status" 15.0 0xcfd2d8 true)
      (text! ui
             (if (> (len branch) 3)
                 (subslice branch 3 (len branch))
                 "(no branch)")
             13.0
             0x66c7f5
             false)
      (end! ui)
      (hstack! ui 10.0 0.0)
      (button! ui "refresh" "Refresh")
      (toggle! ui "live" "Live" (.live (.state self)))
      (text! ui "refreshed " 11.0 0x7f8794 false)
      (append-i64! ui (.refreshes (.state self)))
      (append! ui "×")
      (end! ui)
      (divider! ui)
      (render-files! self ui)
      (divider! ui)
      (render-log! self ui)
      (end! ui)))
  (event [(self (ptr Git)) (e (ptr Event))]
    (-> void)
    (cond (tick? e) (poll! self)
          (clicked? e "refresh") (refresh! self)
          (toggled? e "live") (set! (.live (.state self)) (.checked e))
          (or (files-changed? e) (message? e "git.changed"))
            (when (.live (.state self)) (live/note! (field self outside)) 0)
          :else (do)))
  (save [(self (ptr Git)) (s (ptr Snapshot))]
    (-> void)
    (save-state! s (.state self)))
  (animating? [(self (ptr Git))]
    (-> bool)
    (or (running? self) (live/waiting? (field self outside))))
  (destroy! [(self (ptr Git))]
    (-> void)
    (proc/free! (field self status-job))
    (proc/free! (field self log-job))
    (free! (mut (.status self)))
    (free! (mut (.log self)))
    (free! (mut (.repo self)))
    (alloc/destroy [Git] (alloc/malloc-allocator) self)
    (do)))

(defn open [(saved (ptr Snapshot)) (state State)] (-> (ptr Git))
  (let [a (alloc/malloc-allocator)
        args (text/trim (get-text saved "jim.args" ""))
        g
          (alloc/box! a
                      Git
                      (Git
                        :status-job (proc/job-new (host saved))
                        :log-job (proc/job-new (host saved))
                        :status (ArrayList::new [u8] a)
                        :log (ArrayList::new [u8] a)
                        :repo
                          (text/owned (if (> (len args) 0)
                                          args
                                          (get-text saved "jim.dir" ".")))
                        :outside (live/refresher)
                        :state state))]
    (refresh! g)
    g))

(defn boot [(saved (ptr Snapshot)) (out (ptr (dyn Widget)))] (-> void)
  (match (load-state [State] saved)
    (Fresh [] (set! out (open saved (State :live true :refreshes 0))))
    (Loaded [state] (set! out (open saved state)))
    (Refused [] (do))))
